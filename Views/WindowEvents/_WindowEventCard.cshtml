@model LinkshellManagerDiscordApp.ViewModels.WindowEventRow
@using LinkshellManagerDiscordApp.Models
@{
    var linkshellId = (int)(ViewData["LinkshellId"] ?? 0);
    var canManage = (bool)(ViewData["CanManage"] ?? false);
    var isClosed = (bool)(ViewData["IsClosed"] ?? false);
    var alreadyPosted = Model.PostedToSheetAt.HasValue;
    var dkpFormId = $"window-event-form-{Model.Id}";

    string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value!;
    string FormatDkp(double? value) => value.HasValue
        ? value.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)
        : "";

    var effectiveDkpByCharacter = Model.CombinedMembers
        .GroupBy(m => m.CharacterName.Trim(), StringComparer.OrdinalIgnoreCase)
        .ToDictionary(g => g.Key, g => g.First().EffectiveDkpAmount, StringComparer.OrdinalIgnoreCase);
    var memberDkpStartIndex = 0;
    var memberDkpDefault = Model.DkpAmount ?? 1.5;
}

@* Collapsible: the header is the <summary>, everything below folds away. Every card starts
   COLLAPSED — a linkshell runs many attendance events at once and each carries a full roster
   table, so the page opens as a scannable list of headers. Native <details> needs no JS for
   that; the script at the bottom only adds memory, since this page is form-heavy (rename,
   close, post to sheet all reload it) and an officer mid-edit shouldn't have their card fold
   shut on every round-trip. *@
<details class="card fade d4 we-card" data-we-card="@Model.Id" style="margin-top:14px">
    <summary class="we-card__head" title="Click to expand or collapse this event">
        <div class="we-card__title-group">
            <span class="attendance-crystal" aria-hidden="true"></span>
            <h3 class="we-card__title">@Dash(Model.Name)</h3>
            <span class="we-card__meta">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                @Model.FirstCapturedDisplay
            </span>
            @if (Model.AllianceNumbers.Count > 1)
            {
                @* More than one is the healthy shape for a big camp: it means every alliance
                   fielded its own poster. One alliance on a 36-person turnout means somebody's
                   half of the raid is not being counted. *@
                <span class="tag we-alliance-chip">@Model.AllianceNumbers.Count alliances</span>
            }
            @if (Model.PendingSnapshotCount > 0)
            {
                <span class="tag warning">@Model.PendingSnapshotCount pending</span>
            }
            @if (isClosed)
            {
                <span class="tag">Closed</span>
            }
        </div>
        @* Expand/collapse affordance, centred between the title and the counts. The whole
           summary bar is clickable — this is the visual cue for it. *@
        <span class="we-card__caret" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </span>
        <div class="we-card__counts">
            <span class="we-count">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
                @Model.CombinedMemberCount member@(Model.CombinedMemberCount == 1 ? "" : "s")
            </span>
            <span class="we-count">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 9h18"/></svg>
                @Model.SnapshotCount snapshot@(Model.SnapshotCount == 1 ? "" : "s")
            </span>
        </div>
    </summary>

    @if (canManage)
    {
        <div class="we-card__controls">
            @* The name is the only editable field left (Default DKP is per-snapshot now), so it
               moved into the dialog below rather than sitting inline beside Close / Delete.
               The DKP form stays — it carries the per-member overrides and is what the Save /
               Post to DKP sheet buttons submit — but it now has no visible inputs of its own. *@
            @if (alreadyPosted)
            {
                <form id="@dkpFormId"
                      class="we-card__form"
                      asp-controller="WindowEvents" asp-action="EditPostedDetails"
                      asp-route-linkshellId="@linkshellId"
                      asp-route-windowEventId="@Model.Id"
                      method="post"
                      onsubmit="return confirm('Update DKP on the @(Model.CombinedMemberCount) already-posted row(s)? This rewrites the sheet and adjusts DKP totals.');">
                    @Html.AntiForgeryToken()
                </form>
            }
            else
            {
                <form id="@dkpFormId" class="we-card__form" method="post">
                    @Html.AntiForgeryToken()
                </form>
            }

            <div class="we-card__actions">
                <button type="button" class="btn sm" data-we-edit-open="@Model.Id">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
                    Edit Event
                </button>
                @if (isClosed)
                {
                    <form asp-controller="WindowEvents" asp-action="Reopen" asp-route-linkshellId="@linkshellId" asp-route-windowEventId="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn sm">Reopen</button>
                    </form>
                }
                else
                {
                    <form asp-controller="WindowEvents" asp-action="Close" asp-route-linkshellId="@linkshellId" asp-route-windowEventId="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn sm ghost">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/></svg>
                            Close Event
                        </button>
                    </form>
                }
                <form asp-controller="WindowEvents" asp-action="Delete" asp-route-linkshellId="@linkshellId" asp-route-windowEventId="@Model.Id" method="post"
                      onsubmit="return confirm('Are you sure you want to delete this event @(Model.Name ?? "(unnamed)") ?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn sm danger-outline" title="Delete Event" aria-label="Delete Event">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                        Delete Event
                    </button>
                </form>
            </div>
        </div>

        @* Edit event dialog. Native <dialog> so it needs no framework; the button above opens
           it via showModal(). Only the name is editable — Default DKP is per-snapshot now. *@
        <dialog class="we-edit-dialog" data-we-edit-dialog="@Model.Id">
            <form asp-controller="WindowEvents" asp-action="Rename" asp-route-linkshellId="@linkshellId" asp-route-windowEventId="@Model.Id"
                  method="post" class="we-edit-dialog__form">
                @Html.AntiForgeryToken()
                <h4 class="we-edit-dialog__title">Edit event</h4>
                <label class="we-edit-dialog__field">
                    <span>Event name</span>
                    <input class="input" type="text" name="name" value="@Model.Name" maxlength="128" required autofocus />
                </label>
                <div class="we-edit-dialog__actions">
                    <button type="button" class="btn sm ghost" data-we-edit-cancel>Cancel</button>
                    <button type="submit" class="btn sm primary">Save</button>
                </div>
            </form>
        </dialog>
    }

    <section class="we-roster">
        <div class="we-roster__subtitle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="14" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
            <span class="we-roster__subtitle-main">Combined roster</span>
            @* Distinct people across every counted snapshot — the row count of the table below, and
               so the number of members this event will actually pay. *@
            <span class="we-roster__subtitle-help">@Model.CombinedMemberCount member@(Model.CombinedMemberCount == 1 ? "" : "s")</span>
        </div>
        <div class="we-table__scroll">
            <table class="we-table">
                <thead>
                    <tr>
                        <th>Character</th>
                        <th>Jobs</th>
                        <th>Alliance</th>
                        <th>Zone</th>
                        @* Window / Misc / Both. It is what tells an officer why one person on this
                           roster is priced differently from the person above them. *@
                        <th>Source</th>
                        <th class="num">Snapshots</th>
                        <th class="num">Combined DKP</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var member in Model.CombinedMembers)
                {
                    <tr>
                        <td><strong>@member.CharacterName</strong></td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(member.MainJob))
                            {
                                <span class="we-job-pill">@(member.MainJob) @(member.MainJobLevel?.ToString())</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(member.SubJob))
                            {
                                <span class="we-job-pill we-job-pill--sub">@(member.SubJob) @(member.SubJobLevel?.ToString())</span>
                            }
                        </td>
                        <td>
                            @* Usually one chip. Two means they moved between alliances mid-camp,
                               which is worth seeing rather than flattening to whichever came last. *@
                            @if (member.AllianceNumbers.Count > 0)
                            {
                                foreach (var alliance in member.AllianceNumbers)
                                {
                                    <span class="tag we-alliance-chip">@alliance</span>
                                }
                            }
                            else
                            {
                                <span class="we-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(member.Zone))
                            {
                                <span class="we-zone">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                    @member.Zone.Replace('_', ' ')
                                </span>
                            }
                            else
                            {
                                <span class="we-muted">-</span>
                            }
                        </td>
                        <td>
                            <span class="tag we-credit-chip we-credit-chip--@member.CreditSource.ToLowerInvariant()">@member.CreditSource</span>
                        </td>
                        <td class="num">@member.SnapshotCount</td>
                        <td class="num">
                            @* Always show a value: fall back to the event's
                               default DKP (or the 1.5 baseline) when neither a
                               per-character override nor a saved WindowEvent
                               DkpAmount exists yet — matches the per-snapshot
                               input's seeded value so the column is never "-". *@
                            @FormatDkp(member.EffectiveDkpAmount ?? memberDkpDefault)
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (canManage)
        {
            <div class="we-roster__submit">
                @if (alreadyPosted)
                {
                    <span class="we-posted-meta">Posted to DKP sheet on <strong>@Model.PostedToSheetDisplay</strong></span>
                    <button type="submit" form="@dkpFormId" class="btn sm primary">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M12 19V5"/><polyline points="5 12 12 5 19 12"/></svg>
                        Update on DKP sheet
                    </button>
                }
                else if (Model.PendingSnapshotCount > 0)
                {
                    @* Posting is one-way and a pending capture is NOT in the roster above, so
                       publishing now would quietly short those people. The server refuses this
                       too — the disabled button is just the honest version of that answer. *@
                    <span class="we-posted-meta">
                        @Model.PendingSnapshotCount snapshot@(Model.PendingSnapshotCount == 1 ? "" : "s")
                        awaiting verification — confirm or reject before posting.
                    </span>
                    <button type="button" class="btn sm primary" disabled
                            title="Confirm or reject the pending snapshots first; their members are not in the roster above.">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M12 19V5"/><polyline points="5 12 12 5 19 12"/></svg>
                        Post to DKP sheet
                    </button>
                }
                else
                {
                    <button type="submit" form="@dkpFormId" class="btn sm primary"
                            @* Controller named explicitly: this partial now renders from EventController
                               (Event System page) as well as WindowEventsController, and an ambient-controller
                               Url.Action would post to /Event/PostToSheet and 404. *@
                            formaction="@Url.Action("PostToSheet", "WindowEvents", new { linkshellId, windowEventId = Model.Id })"
                            onclick="return confirm('Post @(Model.CombinedMemberCount) row(s) to the DKP sheet AttInput tab? This cannot be undone.');">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M12 19V5"/><polyline points="5 12 12 5 19 12"/></svg>
                        Post to DKP sheet
                    </button>
                }
            </div>
        }
    </section>

    @if (Model.Snapshots.Any())
    {
        @* Windows and Miscellaneous render as two labelled groups.
           ONE loop, deliberately. memberDkpStartIndex below is the MemberDkp[i] form index that
           binds every per-character DKP input on this card; splitting this into two foreach blocks
           and restarting the counter would silently overwrite half the overrides. Concatenating the
           two lists and emitting a heading when the kind changes gives the same two sections with
           no way to get that wrong. *@
        <section class="we-snapshots">
            @{
                var groupedSnapshots = Model.WindowSnapshots.Concat(Model.MiscSnapshots).ToList();
                var emittedWindowHead = false;
                var emittedMiscHead = false;
                @* An ungridded camp (Sky gods, farm NMs) has no window numbers to show, so calling
                   its captures "Windows" would promise a distinction it does not have. *@
                var windowGroupTitle = Model.HasWindowGrid ? "Windows" : "Captures";
            }
            @foreach (var snapshot in groupedSnapshots)
            {
                if (!snapshot.IsMisc && !emittedWindowHead)
                {
                    emittedWindowHead = true;
                    <div class="we-snapshots__group-head">
                        <span class="we-snapshots__group-title">@windowGroupTitle</span>
                        <span class="we-snapshots__group-count">@Model.WindowSnapshots.Count</span>
                    </div>
                }
                if (snapshot.IsMisc && !emittedMiscHead)
                {
                    emittedMiscHead = true;
                    <div class="we-snapshots__group-head we-snapshots__group-head--misc">
                        <span class="we-snapshots__group-title">Miscellaneous Posts</span>
                        <span class="we-snapshots__group-count">@Model.MiscSnapshotCount</span>
                        <span class="we-snapshots__group-help">
                            At the camp, outside any window.
                        </span>
                        @if (canManage)
                        {
                            @* Rides the card's existing DKP form, so Save / Post / Update all carry
                               it — no separate endpoint. Blank means misc-only members are paid
                               exactly what a window attendee is, which is the default. *@
                            <label class="we-misc-dkp">
                                <span>Misc DKP</span>
                                <input class="input we-dkp-input" type="number" step="0.25" min="0"
                                       name="miscDkpAmount" form="@dkpFormId"
                                       value="@FormatDkp(Model.MiscDkpAmount)"
                                       placeholder="@FormatDkp(memberDkpDefault)"
                                       title="DKP for members credited only by Misc posts. Blank pays them the same as a window attendee." />
                            </label>
                        }
                    </div>
                }

                var snapshotDeleteForm = $"snapshot-delete-{snapshot.Id}";
                var snapshotVerifyForm = $"snapshot-verify-{snapshot.Id}";
                var snapshotRejectForm = $"snapshot-reject-{snapshot.Id}";
                var snapshotSlotForm = $"snapshot-slot-{snapshot.Id}";
                @* Out-of-line forms, submitted by the buttons in the <summary> via form=. A form
                   nested inside a <summary> would be activated by the click that toggles the
                   details, so the markup has to sit outside it. *@
                if (canManage)
                {
                    <form id="@snapshotDeleteForm" asp-controller="WindowEvents" asp-action="DeleteSnapshot"
                          asp-route-linkshellId="@linkshellId" asp-route-snapshotId="@snapshot.Id"
                          method="post" class="we-hidden-form"
                          onsubmit="return confirm('Permanently delete this snapshot posted by @Dash(snapshot.CapturedByCharacterName)? This cannot be undone.');">
                        @Html.AntiForgeryToken()
                    </form>
                    if (!alreadyPosted)
                    {
                        @* Re-filing a POSTED event would move members between the window and misc
                           rates after the DKP was paid, and this action doesn't reconcile the
                           ledger — the server refuses it too. *@
                        <form id="@snapshotSlotForm" asp-controller="WindowEvents" asp-action="SetSnapshotSlot"
                              asp-route-linkshellId="@linkshellId" asp-route-snapshotId="@snapshot.Id"
                              method="post" class="we-hidden-form">
                            @Html.AntiForgeryToken()
                        </form>
                    }
                    if (snapshot.IsPending)
                    {
                        <form id="@snapshotVerifyForm" asp-controller="WindowEvents" asp-action="VerifySnapshot"
                              asp-route-linkshellId="@linkshellId" asp-route-snapshotId="@snapshot.Id"
                              method="post" class="we-hidden-form">
                            @Html.AntiForgeryToken()
                        </form>
                        <form id="@snapshotRejectForm" asp-controller="WindowEvents" asp-action="RejectSnapshot"
                              asp-route-linkshellId="@linkshellId" asp-route-snapshotId="@snapshot.Id"
                              method="post" class="we-hidden-form"
                              onsubmit="return confirm('Reject this capture? Its members will not be counted.');">
                            @Html.AntiForgeryToken()
                        </form>
                    }
                }
                <details class="we-snapshot@(snapshot.IsMisc ? " we-snapshot--misc" : "")">
                    <summary class="we-snapshot__head">
                        <span class="we-snapshot__caret" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><polyline points="9 6 15 12 9 18"/></svg>
                        </span>
                        <span class="we-snapshot__title">
                            @* Alliance first: on a multi-alliance camp it is what tells two
                               same-minute captures apart, so it has to lead the line. *@
                            <span class="tag we-alliance-chip">@snapshot.AllianceLabel</span>
                            @if (snapshot.IsMisc)
                            {
                                <span class="tag we-snapshot__misc">Misc</span>
                            }
                            else if (snapshot.WindowLabel is not null)
                            {
                                <span class="tag we-snapshot__window">@snapshot.WindowLabel</span>
                            }
                            <strong>@snapshot.CapturedAtDisplay</strong>
                            <span class="we-snapshot__meta">· posted by <strong>@Dash(snapshot.CapturedByCharacterName)</strong> · @snapshot.EntryCount member@(snapshot.EntryCount == 1 ? "" : "s")</span>
                            @if (snapshot.SnapshotStatus != AttendanceSnapshotStatuses.Active)
                            {
                                <span class="tag warning">@snapshot.SnapshotStatus</span>
                            }
                        </span>
                        @if (canManage)
                        {
                            <span class="we-snapshot__actions" onclick="event.stopPropagation()">
                                @if (!alreadyPosted)
                                {
                                    @* Filing is entirely manual now, so mis-filing is routine
                                       rather than exceptional — correcting it here beats
                                       detaching and hunting for the capture in the triage queue. *@
                                    <span class="we-slot-picker">
                                        <select class="form-select we-slot-picker__kind" name="slotKind"
                                                form="@snapshotSlotForm" aria-label="Slot kind">
                                            <option value="@AttendanceSnapshotSlotKinds.Window"
                                                    selected="@(!snapshot.IsMisc)">@windowGroupTitle</option>
                                            <option value="@AttendanceSnapshotSlotKinds.Misc"
                                                    selected="@snapshot.IsMisc">Misc</option>
                                        </select>
                                        @if (Model.HasWindowGrid)
                                        {
                                            <input class="input we-slot-picker__window" type="number"
                                                   name="windowNumber" form="@snapshotSlotForm"
                                                   min="1" max="@Model.WindowCount"
                                                   value="@(snapshot.WindowNumber?.ToString())"
                                                   placeholder="#" aria-label="Window number"
                                                   title="Window 1-@Model.WindowCount. Ignored when the slot is Misc." />
                                        }
                                        <button form="@snapshotSlotForm" type="submit" class="btn sm ghost">Move</button>
                                    </span>
                                }
                                @if (snapshot.IsPending)
                                {
                                    <button form="@snapshotVerifyForm" type="submit"
                                            class="btn sm primary">Confirm</button>
                                    <button form="@snapshotRejectForm" type="submit"
                                            class="btn sm ghost">Reject</button>
                                }
                                <button form="@snapshotDeleteForm" type="submit"
                                        class="btn sm danger-outline">Delete snapshot</button>
                            </span>
                        }
                    </summary>
                    @{
                        var snapshotEntriesViewData = new ViewDataDictionary(ViewData)
                        {
                            ["MemberDkpFormId"] = canManage ? dkpFormId : null,
                            ["MemberDkpEffectiveByCharacter"] = effectiveDkpByCharacter,
                            ["MemberDkpStartIndex"] = memberDkpStartIndex,
                            ["MemberDkpDefault"] = memberDkpDefault,
                        };
                        memberDkpStartIndex += snapshot.Entries.Count;
                    }
                    @* Full path: this card is rendered from the Event page as well as from
                       WindowEvents/History, and a bare name resolves against the executing
                       controller's folder. See the note in _AttendanceSections.cshtml. *@
                    @await Html.PartialAsync("~/Views/WindowEvents/_WindowSnapshotEntries.cshtml", snapshot, snapshotEntriesViewData)
                </details>
            }
        </section>
    }

    @* The "cascade Default DKP into every untouched per-row input" script lived here. It's gone
       with the input it watched — each snapshot row now carries its own DKP outright, which is
       the point of moving DKP to per-snapshot. *@

    @* Edit-event dialog wiring: the card's Edit button opens it, Cancel/backdrop close it. *@
    <script nonce="@Html.CspNonce()">
        (function () {
            var dialog = document.querySelector('dialog[data-we-edit-dialog="@Model.Id"]');
            var open = document.querySelector('button[data-we-edit-open="@Model.Id"]');
            if (!dialog || !open || typeof dialog.showModal !== 'function') return;
            open.addEventListener('click', function () { dialog.showModal(); });
            var cancel = dialog.querySelector('[data-we-edit-cancel]');
            if (cancel) cancel.addEventListener('click', function () { dialog.close(); });
            // Click outside the form (i.e. on the backdrop area of the dialog box) closes it.
            dialog.addEventListener('click', function (e) { if (e.target === dialog) dialog.close(); });
        })();
    </script>

    @* Remember open/closed across the full-page reloads every action on this card triggers. *@
    <script nonce="@Html.CspNonce()">
        (function () {
            var card = document.querySelector('details[data-we-card="@Model.Id"]');
            if (!card || !window.localStorage) return;
            var key = 'we-card-open:@Model.Id';
            try {
                var saved = window.localStorage.getItem(key);
                if (saved === 'open') { card.open = true; }
                else if (saved === 'closed') { card.open = false; }
            } catch (e) { /* private mode — fall back to the server-rendered default */ }
            card.addEventListener('toggle', function () {
                try { window.localStorage.setItem(key, card.open ? 'open' : 'closed'); } catch (e) { /* no-op */ }
            });
        })();
    </script>
</details>

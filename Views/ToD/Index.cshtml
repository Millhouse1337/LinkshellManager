@model LinkshellManagerDiscordApp.ViewModels.TodManagerViewModel

@{
    ViewData["Title"] = "ToD Tracker";
    var selectedLinkshellName = Model.Linkshells.FirstOrDefault(item => item.Id == Model.LinkshellId)?.LinkshellName ?? "Selected Linkshell";
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">ToD Tracker</h1>
        <div class="page-sub">
            <span>@selectedLinkshellName</span>
            <span>·</span>
            <span><span class="num">@Model.TodItems.Count</span> entries</span>
        </div>
    </div>

    <div class="page-actions">
        @if (Model.Linkshells.Any())
        {
            <a class="btn primary" asp-action="Create">+ Add ToD</a>
        }
    </div>
</div>

@if (!Model.Linkshells.Any())
{
    <div class="card fade d2">
        <div class="empty">Join a linkshell before submitting a ToD entry.</div>
    </div>
}
else
{
    <div class="card fade d2">
        <div class="card-head">
            <div class="card-title">Submitted ToDs</div>
            <span class="card-link">@selectedLinkshellName</span>
        </div>
        @if (TempData["PartySetupMessage"] is string psMsg && !string.IsNullOrWhiteSpace(psMsg))
        {
            <div class="alert" style="margin:0 0 12px;border:1px solid var(--accent);border-radius:var(--r-md);padding:8px 12px;color:var(--fg);font-size:13px">
                @psMsg
            </div>
        }
        @if (Model.TodItems.Any())
        {
            <div style="overflow-x:auto">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Day</th>
                            <th>ToD</th>
                            <th>Cooldown</th>
                            <th>Repop</th>
                            <th>Interval</th>
                            <th>Countdown</th>
                            <th style="text-align:right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            // Group by monster, then order the groups by the
                            // latest entry's repop time ascending so the mob
                            // closest to popping (or already Ready — past
                            // repop time) sits at the top of the list. Within
                            // each group the ordering of TodItems (Time desc)
                            // is preserved so .First() is still "latest kill".
                            var todGroups = Model.TodItems
                                .GroupBy(t => (t.MonsterName ?? string.Empty).Trim(), StringComparer.OrdinalIgnoreCase)
                                .OrderBy(g => g.First().RepopTimeUtc ?? DateTime.MaxValue);
                        }
                        @foreach (var group in todGroups)
                        {
                            var ordered = group.ToList();
                            var latest = ordered.First();
                            var history = ordered.Skip(1).Take(9).ToList();
                            var groupKey = "tod-history-" + latest.Id;
                            Model.AssignedPartySetupBoards.TryGetValue(group.Key, out var board);
                            <tr class="tod-latest-row" data-monster="@group.Key">
                                <td>
                                    <span style="color:var(--fg);font-weight:500">@latest.MonsterName</span>
                                    @if (ordered.Count > 1)
                                    {
                                        <span class="tag" style="margin-left:6px">@ordered.Count</span>
                                    }
                                    @if (board != null)
                                    {
                                        <button type="button" class="tag accent tod-setup-toggle"
                                                data-target="tod-setup-@board.Id"
                                                style="margin-left:6px;cursor:pointer;border:0;font:inherit">
                                            Setup: @board.Name
                                        </button>
                                    }
                                </td>
                                <td class="num">@(latest.DayNumber?.ToString() ?? "—")</td>
                                <td class="num">@latest.TodDisplay</td>
                                <td>@latest.Cooldown</td>
                                <td class="num">@latest.RepopTimeDisplay</td>
                                <td>@latest.Interval</td>
                                <td>
                                    @if (latest.RepopTimeUtc.HasValue)
                                    {
                                        <span class="countdown-timer num" data-end-utc="@latest.RepopTimeUtc.Value.ToString("O")" style="color:var(--fg)">—</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td style="text-align:right">
                                    <div style="display:inline-flex;gap:6px">
                                        @if (history.Count > 0)
                                        {
                                            <button type="button" class="btn sm tod-history-toggle" data-target="@groupKey">History (@history.Count)</button>
                                        }
                                        @if (latest.LootCount > 0)
                                        {
                                            <button type="button" class="btn sm view-loot-btn" data-id="@latest.Id">Loot</button>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(latest.ImagePath))
                                        {
                                            <a class="btn sm" href="@latest.ImagePath" target="_blank" rel="noopener">Screenshot</a>
                                        }
                                        <a class="btn sm" asp-action="Edit" asp-route-id="@latest.Id">Edit</a>
                                        <form asp-action="Delete" asp-route-id="@latest.Id" method="post" style="display:inline" onsubmit="return confirm('Delete this ToD entry?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn sm ghost" style="color:var(--danger)">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            @if (board != null)
                            {
                                <tr class="tod-setup-row d-none" id="tod-setup-@board.Id" data-monster="@group.Key">
                                    <td colspan="8" style="padding:14px 16px;background:var(--surface,#16161a)">
                                        <div style="font-weight:600;color:var(--fg);margin-bottom:4px">@board.Name</div>
                                        <div style="font-size:12px;color:var(--fg-3);margin-bottom:12px">
                                            Sign up for an open slot. You hold at most one slot per setup.
                                        </div>
                                        @foreach (var alliance in board.Alliances)
                                        {
                                            <div style="font-size:12px;text-transform:uppercase;letter-spacing:.04em;color:var(--fg-3);margin:10px 0 6px">@alliance.Name</div>
                                            <div style="display:flex;flex-wrap:wrap;gap:10px">
                                                @foreach (var party in alliance.Parties)
                                                {
                                                    <div style="flex:1 1 280px;min-width:260px;border:1px solid var(--border);border-radius:var(--r-md);padding:10px">
                                                        <div style="font-weight:600;color:var(--fg);margin-bottom:8px">@party.Name</div>
                                                        @foreach (var slot in party.Slots)
                                                        {
                                                            var mine = !slot.IsOpen && slot.SignedUpAppUserId == Model.CurrentAppUserId;
                                                            // The slot's hard requirements drive which sign-up inputs to
                                                            // show. A field the slot already pins is hidden (the controller
                                                            // takes the slot's value over any crafted form post); a field
                                                            // the slot leaves open is rendered as a dropdown the member
                                                            // fills in. Sub is optional even when unspecified.
                                                            var slotRequiresRole = !string.IsNullOrWhiteSpace(slot.Role);
                                                            var slotRequiresMain = !string.IsNullOrWhiteSpace(slot.MainJob);
                                                            var slotRequiresSub  = !string.IsNullOrWhiteSpace(slot.SubJob);
                                                            @* Stacked layout: requirement label on top, action area (form
                                                               or signed-up tag) below it, right-aligned. Keeps the layout
                                                               predictable inside narrow party cards regardless of how many
                                                               dropdowns the slot needs, instead of the dropdowns + Sign up
                                                               button wrapping unpredictably onto multiple rows. *@
                                                            <div style="display:flex;flex-direction:column;gap:6px;padding:8px 2px;border-top:1px solid var(--border)">
                                                                <div style="display:flex;align-items:center;gap:6px;color:var(--fg-1);font-size:13px;font-weight:500">
                                                                    @slot.Display
                                                                    @if (slot.IsPartyLeader)
                                                                    {
                                                                        <span class="tag" style="color:#1a1300;background:linear-gradient(180deg,#ffe27a,#f5b800);font-size:10px;padding:1px 6px">Leader</span>
                                                                    }
                                                                </div>
                                                                @if (slot.IsOpen)
                                                                {
                                                                    <form asp-controller="PartySetup" asp-action="SignUp" asp-route-id="@board.Id" asp-route-slotId="@slot.SlotId" method="post"
                                                                          style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;justify-content:flex-end">
                                                                        @Html.AntiForgeryToken()
                                                                        @if (!slotRequiresRole)
                                                                        {
                                                                            <select name="role" required class="form-select" style="height:30px;flex:1 1 90px;min-width:0;max-width:130px">
                                                                                <option value="">Role…</option>
                                                                                @foreach (var r in Model.SignUpRoleOptions)
                                                                                {
                                                                                    <option value="@r">@r</option>
                                                                                }
                                                                            </select>
                                                                        }
                                                                        @if (!slotRequiresMain)
                                                                        {
                                                                            <select name="mainJob" required class="form-select" style="height:30px;flex:1 1 80px;min-width:0;max-width:110px">
                                                                                <option value="">Main…</option>
                                                                                @foreach (var j in Model.SignUpMainJobOptions)
                                                                                {
                                                                                    <option value="@j">@j</option>
                                                                                }
                                                                            </select>
                                                                        }
                                                                        @if (!slotRequiresSub)
                                                                        {
                                                                            <select name="subJob" class="form-select" style="height:30px;flex:1 1 90px;min-width:0;max-width:120px">
                                                                                <option value="">Sub (opt)</option>
                                                                                @foreach (var j in Model.SignUpSubJobOptions)
                                                                                {
                                                                                    <option value="@j">@j</option>
                                                                                }
                                                                            </select>
                                                                        }
                                                                        <button type="submit" class="btn sm primary" style="flex:0 0 auto">Sign up</button>
                                                                    </form>
                                                                }
                                                                else if (mine)
                                                                {
                                                                    <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;justify-content:flex-end">
                                                                        <span class="tag accent">
                                                                            @slot.SignedUpCharacterName (you)
                                                                            @if (!string.IsNullOrEmpty(slot.SignedUpJobsDisplay))
                                                                            {
                                                                                <span style="opacity:.85;margin-left:4px">· @slot.SignedUpJobsDisplay</span>
                                                                            }
                                                                        </span>
                                                                        <form asp-controller="PartySetup" asp-action="Withdraw" asp-route-id="@board.Id" asp-route-slotId="@slot.SlotId" method="post" style="display:inline">
                                                                            @Html.AntiForgeryToken()
                                                                            <button type="submit" class="btn sm danger-outline">Withdraw</button>
                                                                        </form>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;justify-content:flex-end">
                                                                        <span class="tag">
                                                                            @slot.SignedUpCharacterName
                                                                            @if (!string.IsNullOrEmpty(slot.SignedUpJobsDisplay))
                                                                            {
                                                                                <span style="opacity:.85;margin-left:4px">· @slot.SignedUpJobsDisplay</span>
                                                                            }
                                                                        </span>
                                                                        @if (Model.CanManagePartiesForSelected)
                                                                        {
                                                                            <form asp-controller="PartySetup" asp-action="Withdraw" asp-route-id="@board.Id" asp-route-slotId="@slot.SlotId" method="post" style="display:inline"
                                                                                  onsubmit="return confirm('Clear @slot.SignedUpCharacterName from this slot?');">
                                                                                @Html.AntiForgeryToken()
                                                                                <button type="submit" class="btn sm ghost" style="color:var(--danger)">Clear</button>
                                                                            </form>
                                                                        }
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                        @if (!party.Slots.Any())
                                                        {
                                                            <div style="color:var(--fg-4);font-size:12px">No slots.</div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                        @if (!board.Alliances.Any())
                                        {
                                            <div class="empty">This setup has no alliances yet.</div>
                                        }
                                    </td>
                                </tr>
                            }
                            @foreach (var item in history)
                            {
                                <tr class="tod-history-row d-none" data-group="@groupKey">
                                    <td style="padding-left:28px;color:var(--fg-3)">↳ @item.MonsterName</td>
                                    <td class="num">@(item.DayNumber?.ToString() ?? "—")</td>
                                    <td class="num">@item.TodDisplay</td>
                                    <td>@item.Cooldown</td>
                                    <td class="num">@item.RepopTimeDisplay</td>
                                    <td>@item.Interval</td>
                                    <td>—</td>
                                    <td style="text-align:right">
                                        <div style="display:inline-flex;gap:6px">
                                            @if (item.LootCount > 0)
                                            {
                                                <button type="button" class="btn sm view-loot-btn" data-id="@item.Id">Loot</button>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                                            {
                                                <a class="btn sm" href="@item.ImagePath" target="_blank" rel="noopener">Screenshot</a>
                                            }
                                            <a class="btn sm" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline" onsubmit="return confirm('Delete this ToD entry?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn sm ghost" style="color:var(--danger)">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty">No ToD entries found for this linkshell yet.</div>
        }
    </div>

    <div class="card fade d3" style="margin-top:16px">
        <div class="card-head">
            <div class="card-title">Recent Claim Shield Captures</div>
            <span class="card-link">@selectedLinkshellName</span>
        </div>
        @if (Model.RecentClaimShieldCaptures.Any())
        {
            <div style="overflow-x:auto">
                <table class="table themed">
                    <thead>
                        <tr>
                            <th>Monster</th>
                            <th>Result</th>
                            <th style="text-align:right">Total Players</th>
                            <th>Captured</th>
                            <th>LS Members</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cs in Model.RecentClaimShieldCaptures)
                        {
                            <tr>
                                <td><span style="color:var(--fg);font-weight:500">@cs.MonsterName</span></td>
                                <td>
                                    @if (cs.Won)
                                    {
                                        <span class="tag success">Won</span>
                                    }
                                    else
                                    {
                                        <span class="tag warning">Lost</span>
                                    }
                                </td>
                                <td class="num" style="text-align:right">@cs.TotalPlayers</td>
                                <td class="num">@cs.CapturedAtDisplay</td>
                                <td>
                                    @if (cs.Members.Count == 0)
                                    {
                                        <span style="color:var(--fg-3)">—</span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--fg-3);font-size:12px">@cs.MatchedCount matched</span>
                                        <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:4px">
                                            @foreach (var member in cs.Members)
                                            {
                                                <span class="tag accent">@member</span>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty">No claim shield captures recorded yet. They are posted from the in-game addon.</div>
        }
    </div>
}

<div class="modal fade" id="viewLootModal" tabindex="-1" aria-labelledby="viewLootModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="viewLootModalLabel">Loot details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table class="themed">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Winner</th>
                            <th style="text-align:right">DKP spent</th>
                        </tr>
                    </thead>
                    <tbody id="loot-details-table-body"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/js/tod-manager.js" asp-append-version="true"></script>
}

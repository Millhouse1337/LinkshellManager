@model LinkshellManagerDiscordApp.ViewModels.ManageTeamViewModel
@{
    ViewData["Title"] = "Manage Team";
    var message = ViewBag.Message as string;
    var selectedLinkshell = Model.Linkshells.FirstOrDefault(l => l.Id == Model.SelectedLinkshellId);
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Manage Team</h1>
        <div class="page-sub">
            @if (selectedLinkshell != null)
            {
                <span>@selectedLinkshell.LinkshellName</span>
                <span class="dot"> · </span>
            }
            <span><span class="num">@Model.Members.Count</span> member@(Model.Members.Count == 1 ? "" : "s")</span>
        </div>
    </div>
    @if (Model.CanManage)
    {
        <div class="page-actions">
            <a class="btn primary" asp-action="SearchPlayers">+ Add members</a>
        </div>
    }
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="card fade d2">
        <div class="empty">
            <div style="font-size:15px;color:var(--fg);font-weight:500;margin-bottom:6px">@message</div>
        </div>
    </div>
}
else
{
    @if (Model.Linkshells.Count > 1)
    {
        <div class="card fade d2" style="padding:16px">
            <form asp-action="Index" method="get" class="form-grid">
                <div class="field">
                    <label for="selectedLinkshellId">Linkshell</label>
                    <select id="selectedLinkshellId" name="selectedLinkshellId" class="form-select" onchange="this.form.submit()">
                        @foreach (var linkshell in Model.Linkshells)
                        {
                            if (linkshell.Id == Model.SelectedLinkshellId)
                            {
                                <option value="@linkshell.Id" selected>@linkshell.LinkshellName</option>
                            }
                            else
                            {
                                <option value="@linkshell.Id">@linkshell.LinkshellName</option>
                            }
                        }
                    </select>
                </div>
            </form>
        </div>
    }

    <div class="card fade d3">
        <div class="card-head">
            <div class="card-title">Members</div>
        </div>
        @if (Model.Members.Count == 0)
        {
            <div class="empty">No members found for this linkshell.</div>
        }
        else
        {
            <table class="table themed">
                <thead>
                    <tr>
                        <th>Character</th>
                        <th>Rank</th>
                        <th>Status</th>
                        <th style="text-align:right">DKP</th>
                        <th>Joined</th>
                        @if (Model.CanManage)
                        {
                            <th style="text-align:right">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Model.Members)
                    {
                        <tr>
                            <td>@(member.CharacterName ?? member.AppUser?.CharacterName ?? "—")</td>
                            <td><span class="tag">@(member.Rank ?? "—")</span></td>
                            <td>@(member.Status ?? "—")</td>
                            <td class="num" style="text-align:right">@((member.LinkshellDkp ?? 0).ToString("N0"))</td>
                            <td style="font-size:12px;color:var(--fg-3)">
                                @(member.DateJoined.HasValue ? member.DateJoined.Value.ToString("MMM d, yyyy") : "—")
                            </td>
                            @if (Model.CanManage)
                            {
                                <td style="text-align:right">
                                    <button type="button" class="btn ghost sm js-modify"
                                            data-id="@member.Id"
                                            data-rank="@member.Rank"
                                            data-status="@member.Status"
                                            data-name="@(member.CharacterName ?? member.AppUser?.CharacterName)">
                                        Modify
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@if (Model.CanManage)
{
    <div class="modal fade" id="modifyModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="ModifyRankStatus" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title">Modify rank &amp; status</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="Id" id="modifyId" />
                        <div class="field" style="margin-bottom:12px">
                            <label>Character</label>
                            <div id="modifyName" style="color:var(--fg-3)"></div>
                        </div>
                        <div class="field" style="margin-bottom:12px">
                            <label for="modifyRank">Rank</label>
                            <select name="Rank" id="modifyRank" class="form-select" required>
                                @foreach (var rank in LinkshellManagerDiscordApp.ViewModels.ManageTeamViewModel.RankOptions)
                                {
                                    <option value="@rank">@rank</option>
                                }
                            </select>
                        </div>
                        <div class="field">
                            <label for="modifyStatus">Status</label>
                            <select name="Status" id="modifyStatus" class="form-select" required>
                                @foreach (var status in LinkshellManagerDiscordApp.ViewModels.ManageTeamViewModel.StatusOptions)
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn ghost" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn primary">Save changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var modalEl = document.getElementById('modifyModal');
                if (!modalEl) return;
                var modal = new bootstrap.Modal(modalEl);
                document.querySelectorAll('.js-modify').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        document.getElementById('modifyId').value = btn.dataset.id || '';
                        document.getElementById('modifyRank').value = btn.dataset.rank || 'Member';
                        document.getElementById('modifyStatus').value = btn.dataset.status || 'Active';
                        document.getElementById('modifyName').textContent = btn.dataset.name || '';
                        modal.show();
                    });
                });
            });
        </script>
    }
}

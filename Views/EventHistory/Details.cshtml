@model EventHistory
@{
    // HNM camps are priced per window, so every DKP/hour surface below is hidden for them.
    var isHnm = string.Equals(Model.EventType, "HNM", StringComparison.OrdinalIgnoreCase);
}
@{
    ViewData["Title"] = "History details";
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">@Model.EventName</h1>
        <div class="page-sub">
            @if (!string.IsNullOrWhiteSpace(Model.EventType))
            {
                <span>@Model.EventType</span>
                <span>·</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.EventLocation))
            {
                <span>@Model.EventLocation</span>
                <span>·</span>
            }
            <span>Completed</span>
        </div>
    </div>
    <div class="page-actions">
        <a class="btn ghost" asp-action="Index">Back to history</a>
    </div>
</div>

<div class="fade d2" style="display:flex;flex-direction:column;gap:16px">
    <div class="card">
        <div class="card-head">
            <div class="card-title">Event details</div>
        </div>
        <div style="padding:4px 16px 16px;display:grid;grid-template-columns:120px 1fr;gap:8px 16px;font-size:13px">
            <div style="color:var(--fg-3)">Type</div><div>@Model.EventType</div>
            <div style="color:var(--fg-3)">Location</div><div>@Model.EventLocation</div>
            <div style="color:var(--fg-3)">Started</div><div>@(Model.StartTime?.ToString("g") ?? "—")</div>
            <div style="color:var(--fg-3)">Ended</div><div>@(Model.EndTime?.ToString("g") ?? "—")</div>
            <div style="color:var(--fg-3)">Duration</div><div class="num">@((Model.Duration ?? 0).ToString("0.##")) h</div>
            @* HNM camps pay per WINDOW (open / close / kill / claim bonuses), never by the hour,
               so a DKP/hour row on one is noise that reads as a rate nobody set. *@
            @if (!isHnm)
            {
                <div style="color:var(--fg-3)">DKP/hour</div><div class="num">@(Model.DkpPerHour ?? 0)</div>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Details))
        {
            <div style="padding:12px 16px;border-top:1px solid var(--border);color:var(--fg-3);font-size:13px">@Model.Details</div>
        }
    </div>

    @if (ViewBag.CanEditHistory is true)
    {
        <div class="card">
            <div class="card-head">
                <div class="card-title">Edit event</div>
            </div>
            @if (TempData["EventHistoryStatus"] is string editStatus)
            {
                <div class="alert alert-success" style="margin:12px 16px 0">@editStatus</div>
            }
            <form asp-action="EditDetails" asp-route-id="@Model.Id" method="post"
                  style="padding:8px 16px 16px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 16px">
                <div class="field"><label>Event name</label><input class="input" name="eventName" value="@Model.EventName" /></div>
                <div class="field"><label>Type</label><input class="input" name="eventType" value="@Model.EventType" /></div>
                <div class="field"><label>Location</label><input class="input" name="eventLocation" value="@Model.EventLocation" /></div>
                <div class="field"><label>Duration (hours)</label><input class="input" type="number" step="0.01" min="0" name="duration" value="@(Model.Duration?.ToString("0.##"))" /></div>
                @* Omitted on an HNM: the field does not apply, and EventHistoryEditService reads
                   `input.DkpPerHour ?? oldRate`, so leaving it out is a no-op rather than a
                   rescale of every attendee's earned DKP. *@
                @if (!isHnm)
                {
                    <div class="field"><label>DKP / hour</label><input class="input" type="number" min="0" name="dkpPerHour" value="@(Model.DkpPerHour ?? 0)" /></div>
                }
                <div class="field" style="grid-column:1 / -1"><label>Details</label><textarea class="input" name="details" rows="2">@Model.Details</textarea></div>
                <div style="grid-column:1 / -1;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
                    @if (!isHnm)
                    {
                        <small style="color:var(--fg-3)">Changing <strong>DKP / hour</strong> rescales every attendee's earned DKP and adjusts their balance.</small>
                    }
                    else
                    {
                        <small style="color:var(--fg-3)">This camp pays per window, not by the hour.</small>
                    }
                    <button type="submit" class="btn primary sm">Save event</button>
                </div>
            </form>
        </div>
    }

    @{
        var canReconcile = ViewBag.CanReconcileActive is true;
        // The active-credit column / reconcile / tags only appear when the
        // linkshell has activity tracking enabled AND this event counts.
        var activityTrackingEnabled = ViewBag.ActivityTrackingEnabled is true;
        // Always show the Active Credit column (officers can edit it regardless of
        // whether activity tracking is on — credit still drives the roster's
        // active-credit streak). The "counts toward active" tag/note still reflect
        // the real per-linkshell tracking config.
        var countsTowardActive = activityTrackingEnabled && Model.CountsTowardActive;
        var showCredit = true;
        var participants = Model.AppUserEventHistories.OrderBy(p => p.CharacterName).ToList();
        var absentees = ViewBag.Absentees as List<LinkshellManagerDiscordApp.Models.AppUserLinkshell>
            ?? new List<LinkshellManagerDiscordApp.Models.AppUserLinkshell>();
        // HNM-style camps archive their posted windows at close; a timed event has none, and so
        // does any camp closed before the archive shipped.
        var windowArchive = ViewBag.WindowArchive as LinkshellManagerDiscordApp.Services.ArchivedWindowSet
            ?? LinkshellManagerDiscordApp.Services.ArchivedWindowSet.Empty;
        // The Windows column only earns its place on a windowed event.
        var showWindows = participants.Any(p => p.WindowsAttended.HasValue) || windowArchive.HasWindows;

        // DISPLAY ONLY. This column answers "how many windows did the NM run before it popped,
        // and how many was this member there for" — it deliberately does NOT reuse
        // AppUserEventHistory.WindowsAttended, which is the CREDIT count that
        // EventAttendanceDkpCalculator paid from. The two differ on purpose:
        //
        //   * The kill roster is a post taken when the mob dies, paid by the kill bonus rather
        //     than by a window (see the addon's Post Kill copy), so it is not a window and is
        //     excluded here.
        //   * Nothing below may feed a payout. Changing the credit count would move real DKP;
        //     this is a read of the archive and moves nothing.
        var countedWindows = windowArchive.Windows.Where(w => !w.IsKillWindow).ToList();
        var windowDenominator = countedWindows.Count > 0
            ? countedWindows.Count
            : (windowArchive.WindowCount > 0
                ? windowArchive.WindowCount
                : LinkshellManagerDiscordApp.Services.HnmConfig.GetWindowCount(Model.EventName));

        // [character] -> how many non-kill windows they were scanned in. Case-insensitive because
        // the archive stores whatever name the scan carried.
        var attendedWindowsByName = countedWindows
            .SelectMany(w => w.Attendees.Select(a => a.CharacterName))
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .GroupBy(name => name!, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.Count(), StringComparer.OrdinalIgnoreCase);

        // Falls back to the stored credit count only when there is no archive to read — a camp
        // closed before windows were archived has nothing else to show.
        Func<string?, int?, string> windowsCell = (characterName, storedCount) =>
        {
            if (countedWindows.Count > 0)
            {
                var seen = !string.IsNullOrWhiteSpace(characterName)
                    && attendedWindowsByName.TryGetValue(characterName!, out var n) ? n : 0;
                return $"{seen} of {windowDenominator}";
            }
            return storedCount.HasValue ? $"{storedCount} of {windowDenominator}" : "—";
        };
    }
    @if (windowArchive.HasWindows)
    {
        <div class="card">
            <div class="card-head">
                <div class="card-title">
                    Attendance windows <span class="tag">@windowArchive.Windows.Count</span>
                </div>
                <span class="tag" title="Distinct characters scanned across every window. Can exceed the participant list: the addon records who was standing there, which isn't always who joined on the site.">
                    @windowArchive.DistinctAttendeeCount scanned
                </span>
            </div>
            <div style="padding:10px 16px 0;font-size:12px;color:var(--fg-3)">
                What this camp actually posted, kept from before the event closed. DKP shows only where
                an officer priced that window explicitly — the camp's open/close bonuses aren't
                recoverable once the board is gone.
            </div>
            <div style="padding:12px 16px 16px;display:flex;flex-direction:column;gap:6px">
                @foreach (var window in windowArchive.Windows)
                {
                    <details style="border:1px solid var(--border);border-radius:8px;background:var(--surface)">
                        <summary style="padding:8px 12px;cursor:pointer;display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                            <strong>@window.Label</strong>
                            <span class="tag">@window.SequenceNumber of @windowArchive.WindowCount</span>
                            @if (window.IsClosingWindow)
                            {
                                <span class="tag accent" title="The window the officer marked as closing the camp out — the one the close bonus paid on.">closing</span>
                            }
                            @* No "kill" chip: the row's own Label already reads "Kill", so the chip
                               said the same word twice. The closing chip above is not the same case
                               — a closing window is still numbered and named like any other, so
                               nothing else on the row says it was the one the close bonus paid on. *@
                            @if (window.DkpAmount.HasValue)
                            {
                                <span class="tag success num">@window.DkpAmount.Value.ToString("0.##") DKP</span>
                            }
                            <span style="margin-left:auto;font-size:12px;color:var(--fg-3)">
                                @window.Attendees.Count present · @window.PostedAt.ToString("g")
                            </span>
                        </summary>
                        @if (window.Attendees.Count == 0)
                        {
                            <div style="padding:8px 12px;border-top:1px solid var(--border);font-size:12px;color:var(--fg-4)">
                                Nobody was scanned in this window.
                            </div>
                        }
                        else
                        {
                            <div style="padding:8px 12px;border-top:1px solid var(--border);display:flex;flex-wrap:wrap;gap:6px">
                                @foreach (var attendee in window.Attendees)
                                {
                                    // Both hoisted out of the markup: Razor attribute values are a bad
                                    // place for nested quotes and interpolation.
                                    var zoneTitle = attendee.Zone ?? "Zone not recorded";
                                    var altSuffix = attendee.MainCharacterName is null
                                        ? string.Empty
                                        : $" (alt of {attendee.MainCharacterName})";
                                    <span class="tag" title="@zoneTitle">@attendee.CharacterName@altSuffix</span>
                                }
                            </div>
                        }
                    </details>
                }
                @* The Tag roster, listed with the windows because that is where an officer looks for
                   "what did this camp record" — but it is NOT one of them, and none of the counts
                   above include it. A tag is evidence the addon read off chat, not a roster scan,
                   so a tagger can be here having appeared in no window at all. *@
                @if (windowArchive.TagRoster is { } tagRoster)
                {
                    <details style="border:1px solid var(--border);border-radius:8px;background:var(--surface)">
                        <summary style="padding:8px 12px;cursor:pointer;display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                            <strong>Tag</strong>
                            <span class="tag" title="Who landed an action on the mob, from this camp's Claim Shield. Earns the tag bonus; not a window, so it counts toward no window total.">not a window</span>
                            <span style="margin-left:auto;font-size:12px;color:var(--fg-3)">
                                @tagRoster.Taggers.Count tagged · @tagRoster.PostedAt.ToString("g")
                            </span>
                        </summary>
                        <div style="padding:8px 12px;border-top:1px solid var(--border);display:flex;flex-wrap:wrap;gap:6px">
                            @foreach (var tagger in tagRoster.Taggers)
                            {
                                <span class="tag" title="First tagged @tagger.VerifiedAt.ToString("g")">@tagger.CharacterName</span>
                            }
                        </div>
                    </details>
                }
            </div>
        </div>
    }

    <div class="card">
        <div class="card-head">
            <div class="card-title">Participants <span class="tag">@Model.AppUserEventHistories.Count</span></div>
            @if (countsTowardActive)
            {
                <span class="tag accent" title="This event counts toward active-member status">Counts toward active</span>
            }
        </div>

        @if (TempData["EventHistoryStatus"] is string statusMsg)
        {
            <div class="alert alert-success" style="margin:12px 16px 0">@statusMsg</div>
        }
        @if (activityTrackingEnabled && !Model.CountsTowardActive)
        {
            <div style="padding:10px 16px 0;font-size:12px;color:var(--fg-4)">This event doesn't count toward active-member status.</div>
        }
        else if (showCredit && canReconcile)
        {
            <div style="padding:10px 16px 0;font-size:12px;color:var(--fg-3)">
                Uncheck anyone who shouldn't get active-status credit for this event (e.g. attended only part of it), then Save.
                An unchecked member counts as an <strong>absence</strong> in their activity streak.
            </div>
        }

        @if (showCredit && canReconcile)
        {
            <form asp-action="SaveActiveCredits" asp-route-id="@Model.Id" method="post">
                <table class="table themed">
                    <thead>
                        <tr>
                            <th>Character</th>
                            <th>Job</th>
                            <th style="text-align:right">Duration</th>
                            @if (showWindows)
                            {
                                <th style="text-align:right" title="Spawn windows this camp ran before the pop, and how many this member was scanned in for. The kill roster is not a window and is not counted. Display only — DKP is not computed from this.">Windows</th>
                            }
                            <th style="text-align:right">DKP</th>
                            <th>Verification</th>
                            <th style="text-align:center">Active credit</th>
                            <th style="text-align:center" title="Absent = no active credit; counts toward the inactive threshold in this member's activity streak">Absent</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var participant in participants)
                        {
                            <tr>
                                <td style="font-weight:500">@participant.CharacterName</td>
                                <td>@participant.JobName/@participant.SubJobName</td>
                                <td style="text-align:right;font-family:var(--font-mono)">@((participant.Duration ?? 0).ToString("0.##")) h</td>
                                @if (showWindows)
                                {
                                    <td style="text-align:right;font-family:var(--font-mono)">
                                        @windowsCell(participant.CharacterName, participant.WindowsAttended)
                                    </td>
                                }
                                <td style="text-align:right;font-family:var(--font-mono)" class="num">@((participant.EventDkp ?? 0).ToString("0.##"))</td>
                                <td>@Html.Raw(VerificationTag(participant.IsVerified))</td>
                                <td style="text-align:center">
                                    <input type="checkbox" name="credited" value="@participant.Id" class="js-credit" data-pid="@participant.Id" @(participant.ActiveCredit ? "checked" : null) />
                                </td>
                                <td style="text-align:center">
                                    @* Absent is the inverse of Active credit — checking it unchecks credit (JS), so
                                       saving records an absence for this event in the member's activity streak. *@
                                    <input type="checkbox" class="js-absent" data-pid="@participant.Id" @(participant.ActiveCredit ? null : "checked") />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div style="padding:12px 16px;border-top:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
                    <span style="font-size:12px;color:var(--fg-3)">Credited the whole event by accident?</span>
                    <button type="submit" class="btn primary sm">Save active credit</button>
                </div>
            </form>
            <div style="padding:0 16px 12px;display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap">
                <form asp-action="ClearAbsences" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Stop this event counting toward active tracking, so members who missed it are not marked absent for it?');">
                    <button type="submit" class="btn ghost sm" title="Members who missed this event won't be marked absent for it (also stops it counting as active credit).">Undo absences for entire event</button>
                </form>
                <form asp-action="ClearActiveCredits" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Remove active-status credit from every attendee of this event? This cannot be auto-undone.');">
                    <button type="submit" class="btn danger sm">Undo active credit for entire event</button>
                </form>
            </div>

            @if (absentees.Count > 0)
            {
                <div style="padding:10px 16px 2px;font-weight:600;font-size:13px;border-top:1px solid var(--border)">Not at this event <span class="muted" style="font-weight:400">· absent (@absentees.Count)</span></div>
                <div style="padding:0 16px 8px;font-size:12px;color:var(--fg-3)">These members were absent for this event (counts toward their inactive threshold). Add one to credit them &amp; grant DKP — it records to their balance and the DKP ledger.</div>
                <div style="padding:0 16px 14px;display:flex;flex-direction:column;gap:6px">
                    @foreach (var m in absentees)
                    {
                        var name = m.CharacterName ?? m.AppUser?.CharacterName ?? m.AppUser?.UserName ?? "Member";
                        <form asp-action="AddParticipant" asp-route-id="@Model.Id" method="post"
                              style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;border:1px solid var(--border);border-radius:6px;padding:6px 10px">
                            <input type="hidden" name="appUserId" value="@m.AppUserId" />
                            <span style="font-weight:500;min-width:120px">@name</span>
                            <input type="checkbox" checked disabled title="Absent until you add them to the event" />
                            <span style="font-size:11px;color:var(--fg-4)">Absent</span>
                            <input type="text" name="jobType" class="form-control" placeholder="Role (opt)" style="width:84px" />
                            <input type="text" name="jobName" class="form-control" placeholder="Main (opt)" style="width:84px" />
                            <input type="text" name="subJobName" class="form-control" placeholder="Sub (opt)" style="width:84px" />
                            <label style="font-size:12px;color:var(--fg-3);display:flex;gap:4px;align-items:center">DKP
                                <input type="number" name="amount" value="0" step="@ViewBag.DkpStep" min="0" class="form-control num" style="width:80px;text-align:right" />
                            </label>
                            <button type="submit" class="btn primary sm" style="margin-left:auto">Add to Event</button>
                        </form>
                    }
                </div>
            }
            <script nonce="@Html.CspNonce()">
                // "Absent" is the visual inverse of "Active credit" — keep the paired
                // checkboxes in sync so saving active credit records the intended absence.
                (function () {
                    function pair(cls, otherCls) {
                        document.querySelectorAll('.' + cls).forEach(function (box) {
                            box.addEventListener('change', function () {
                                var other = document.querySelector('.' + otherCls + '[data-pid="' + box.getAttribute('data-pid') + '"]');
                                if (other) { other.checked = !box.checked; }
                            });
                        });
                    }
                    pair('js-absent', 'js-credit');
                    pair('js-credit', 'js-absent');
                })();
            </script>
        }
        else
        {
            <table class="table themed">
                <thead>
                    <tr>
                        <th>Character</th>
                        <th>Job</th>
                        <th style="text-align:right">Duration</th>
                        @if (showWindows)
                        {
                            <th style="text-align:right" title="Spawn windows this camp ran before the pop, and how many this member was scanned in for. The kill roster is not a window and is not counted. Display only — DKP is not computed from this.">Windows</th>
                        }
                        <th style="text-align:right">DKP</th>
                        <th>Verification</th>
                        @if (showCredit)
                        {
                            <th style="text-align:center">Active credit</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var participant in participants)
                    {
                        <tr>
                            <td style="font-weight:500">@participant.CharacterName</td>
                            <td>@participant.JobName/@participant.SubJobName</td>
                            <td style="text-align:right;font-family:var(--font-mono)">@((participant.Duration ?? 0).ToString("0.##")) h</td>
                            @if (showWindows)
                            {
                                <td style="text-align:right;font-family:var(--font-mono)">
                                    @windowsCell(participant.CharacterName, participant.WindowsAttended)
                                </td>
                            }
                            <td style="text-align:right;font-family:var(--font-mono)" class="num">@((participant.EventDkp ?? 0).ToString("0.##"))</td>
                            <td>@Html.Raw(VerificationTag(participant.IsVerified))</td>
                            @if (showCredit)
                            {
                                <td style="text-align:center">
                                    @if (participant.ActiveCredit)
                                    {
                                        <span class="tag success">✓ credited</span>
                                    }
                                    else
                                    {
                                        <span class="tag">no credit</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (ViewBag.CanEditHistory is true && participants.Count > 0)
    {
        <div class="card">
            <div class="card-head">
                <div class="card-title">Edit attendees</div>
            </div>
            <div style="padding:6px 16px 10px;font-size:12px;color:var(--fg-3)">
                Correct an attendee's earned DKP, or remove them entirely (refunds their DKP and adjusts their balance).
            </div>
            <table class="table themed">
                <thead>
                    <tr>
                        <th>Character</th>
                        <th style="text-align:right">Earned DKP</th>
                        <th style="text-align:right">Remove</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var participant in participants)
                    {
                        <tr>
                            <td style="font-weight:500">@participant.CharacterName</td>
                            <td style="text-align:right">
                                <form asp-action="SetParticipantDkp" asp-route-id="@Model.Id" method="post"
                                      style="display:inline-flex;gap:6px;align-items:center;justify-content:flex-end">
                                    <input type="hidden" name="participantId" value="@participant.Id" />
                                    <input class="input" type="number" step="@(((double)(ViewBag.DkpStep ?? 0.25)).ToString("0.##"))" min="0" name="amount"
                                           value="@((participant.EventDkp ?? 0).ToString("0.##"))"
                                           style="width:90px;text-align:right" />
                                    <button type="submit" class="btn ghost sm">Save</button>
                                </form>
                            </td>
                            <td style="text-align:right">
                                <form asp-action="RemoveParticipant" asp-route-id="@Model.Id" method="post"
                                      style="display:inline"
                                      onsubmit="return confirm('Remove @participant.CharacterName from this event and refund their DKP?');">
                                    <input type="hidden" name="participantId" value="@participant.Id" />
                                    <button type="submit" class="btn danger sm">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @{
        var comments = ViewBag.Comments as List<LinkshellManagerDiscordApp.Models.EventComment> ?? new List<LinkshellManagerDiscordApp.Models.EventComment>();
        var commentUserId = ViewBag.CommentUserId as string;
        var commentsCanManage = ViewBag.CommentsCanManage is true;
    }
    <div class="card">
        <div class="card-head">
            <div class="card-title">💬 Discussion <span class="tag">@comments.Count</span></div>
        </div>
        <div style="padding:8px 16px 12px">
            @if (comments.Count == 0)
            {
                <div style="color:var(--fg-3);font-size:13px;padding:4px 0">No comments yet — start the discussion.</div>
            }
            @foreach (var c in comments)
            {
                <div style="display:flex;gap:10px;align-items:baseline;padding:8px 0;border-top:1px solid var(--border)">
                    <div style="min-width:120px">
                        <div style="font-weight:600;@(c.IsAnonymous ? "color:var(--fg-3);font-style:italic" : "")">@(c.IsAnonymous ? "Anonymous" : (c.CharacterName ?? "Member"))</div>
                        <div style="font-size:11px;color:var(--fg-3)">@c.CreatedAt.ToString("MMM d, h:mm tt")</div>
                    </div>
                    <div style="flex:1;white-space:pre-wrap;word-break:break-word;font-size:13px">@c.Body</div>
                    @if (commentsCanManage || string.Equals(c.AppUserId, commentUserId, StringComparison.Ordinal))
                    {
                        <form asp-action="DeleteComment" asp-route-id="@Model.Id" method="post" style="display:inline">
                            <input type="hidden" name="commentId" value="@c.Id" />
                            <button type="submit" class="btn ghost sm" title="Delete">✕</button>
                        </form>
                    }
                </div>
            }
            <form asp-action="AddComment" asp-route-id="@Model.Id" method="post" style="margin-top:10px">
                <textarea class="input" name="body" rows="2" maxlength="2000" placeholder="Add to the discussion…" style="width:100%"></textarea>
                <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:6px">
                    <label style="display:inline-flex;align-items:center;gap:5px;font-size:12px;color:var(--fg-2)">
                        <input type="checkbox" name="isAnonymous" value="true" /> Post anonymously
                    </label>
                    <button type="submit" class="btn primary sm">Post</button>
                </div>
            </form>
        </div>
    </div>
</div>

@functions {
    static string VerificationTag(bool? isVerified) => isVerified switch
    {
        true => "<span class=\"tag success\">Verified</span>",
        false => "<span class=\"tag danger\">Denied</span>",
        _ => "<span class=\"tag\">Not reviewed</span>"
    };
}

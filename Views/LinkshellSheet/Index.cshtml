@model LinkshellManagerDiscordApp.ViewModels.LinkshellSheetViewModel
@{
    ViewData["Title"] = "Google Sheet";
    var readRange = Model.PreviewRange ?? "Main!B7:C200";
    var preview = Model.Preview;
}

@functions {
    // "2026-05-15 18:59" -> "May 15th 2026 06:59 pm". ConnectedAt is stored
    // UTC; we keep the UTC tag so the timestamp stays unambiguous without
    // pulling the user's timezone into this view.
    static string PrettyUtc(DateTime utc)
    {
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        var day = utc.Day;
        var suffix = (day % 100) is >= 11 and <= 13
            ? "th"
            : (day % 10) switch { 1 => "st", 2 => "nd", 3 => "rd", _ => "th" };
        var month = utc.ToString("MMMM", ci);
        var time = utc.ToString("hh:mm", ci);
        var meridiem = utc.ToString("tt", ci).ToLowerInvariant();
        return $"{month} {day}{suffix} {utc.Year} {time} {meridiem}";
    }
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Google Sheet Integration</h1>
        <div class="page-sub">
            <span>One-way sync from LSManager to a Google Sheet</span>
            @if (!string.IsNullOrWhiteSpace(Model.LinkshellName))
            {
                <span class="dot"> · </span>
                <span>@Model.LinkshellName</span>
            }
        </div>
    </div>
</div>

<style nonce="@Html.CspNonce()">
    /* Space the stacked step cards apart so each reads as its own block. */
    .sheet-cards > .card { margin-bottom: 16px; }
    .sheet-cards > .card:last-child { margin-bottom: 0; }

    /* Modern form rows: label above, input below, muted helper text. */
    .sheet-cards .form-row { display: flex; flex-direction: column; gap: 6px; }
    .sheet-cards .form-row + .form-row { margin-top: 14px; }
    .sheet-cards .form-row > label {
        font-size: 13px; font-weight: 500; color: var(--fg-2);
    }
    .sheet-cards .form-row > small { font-size: 12px; color: var(--fg-3); }
    .sheet-cards .form-row .input { width: 100%; max-width: 520px; }
</style>

<div class="sheet-cards">

@if (TempData["SheetImportError"] is string err)
{
    <div class="alert alert-danger fade d2">@err</div>
}
@if (TempData["SheetConfigError"] is string cfgErr)
{
    <div class="alert alert-danger fade d2">@cfgErr</div>
}
@if (TempData["SheetConfigSuccess"] is string ok)
{
    <div class="alert alert-success fade d2">@ok</div>
}
@if (TempData["SheetImportSuccess"] is string imp)
{
    <div class="alert alert-success fade d2">@imp</div>
}

@if (!Model.IsOAuthConfigured)
{
    <div class="card fade d2">
        <div class="card-head">
            <div class="card-title">Google OAuth not configured</div>
        </div>
        <div class="empty">
            The server admin must set <code>GoogleSheets:ClientId</code> and <code>GoogleSheets:ClientSecret</code> in app configuration to enable this feature.
        </div>
    </div>
}
else
{
    <div class="card fade d2">
        <div class="card-head">
            <div class="card-title">Step 1 — Connect Google account</div>
        </div>
        <div style="padding:12px 16px">
            @if (Model.IsOAuthConnected)
            {
                <p>
                    Connected as <strong>@Model.ConnectedGoogleEmail</strong>
                    @if (Model.ConnectedAt.HasValue)
                    {
                        <text> · since @PrettyUtc(Model.ConnectedAt.Value) UTC</text>
                    }
                </p>
                <form asp-action="Disconnect" asp-route-linkshellId="@Model.LinkshellId" method="post" style="display:inline">
                    <button type="submit" class="btn" onclick="return confirm('Disconnect Google? Sync will pause until you reconnect.');">Disconnect</button>
                </form>
                <form asp-action="Connect" asp-route-linkshellId="@Model.LinkshellId" method="post" style="display:inline;margin-left:6px">
                    <button type="submit" class="btn">Reconnect a different account</button>
                </form>
            }
            else
            {
                <p>Authorize LSManager to read and write spreadsheets you own. You'll see Google's consent screen — grant the Sheets permission to continue.</p>
                <form asp-action="Connect" asp-route-linkshellId="@Model.LinkshellId" method="post">
                    <button type="submit" class="btn btn-primary">Connect Google account</button>
                </form>
            }
        </div>
    </div>

    @if (Model.IsOAuthConnected)
    {
        <div class="card fade d3" style="border:1px solid @(Model.SheetSyncEnabled ? "rgba(74,222,128,0.4)" : "rgba(251,191,36,0.4)")">
            <div class="card-head">
                <div class="card-title">
                    Live sync:
                    @if (Model.SheetSyncEnabled)
                    {
                        <span style="color:#4ade80">ENABLED</span>
                    }
                    else
                    {
                        <span style="color:#fbbf24">DISABLED (safe)</span>
                    }
                </div>
            </div>
            <div style="padding:12px 16px">
                @if (Model.SheetSyncEnabled)
                {
                    <p>The app appends rows to your <code>AttInput</code> tab (attendance + window posts + event close) and new columns to your <code>ManualPoints</code> tab (one column per DKP audit). Your <code>Main</code> tab formulas roll the totals up automatically — column C is never overwritten.</p>
                    <form asp-action="ToggleSync" asp-route-linkshellId="@Model.LinkshellId" method="post">
                        <input type="hidden" name="enabled" value="false" />
                        <button type="submit" class="btn" onclick="return confirm('Disable live sync? The sheet will stop receiving DKP updates.');">Disable live sync</button>
                    </form>
                }
                else
                {
                    <p>Live sync is off. The app will not write to the sheet at all. Use this while you're still importing/reconciling members. Enable once you're confident your roster matches the sheet's character names.</p>
                    <form asp-action="ToggleSync" asp-route-linkshellId="@Model.LinkshellId" method="post">
                        <input type="hidden" name="enabled" value="true" />
                        <button type="submit" class="btn btn-primary">Enable live sync</button>
                    </form>
                }
            </div>
        </div>

        <div class="card fade d4">
            <div class="card-head">
                <div class="card-title">Step 2 — Configure spreadsheet</div>
            </div>
            <form asp-action="SaveConfig" asp-route-linkshellId="@Model.LinkshellId" method="post" style="padding:12px 16px">
                <div class="form-row">
                    <label>Spreadsheet ID</label>
                    <input class="input" type="text" name="spreadsheetId" value="@Model.SpreadsheetId" placeholder="e.g. 1YNfaF5AXbZoJdKrs21p29pfAl6Q9wJsQWafPztG3Nxk" />
                    <small>The long string between <code>/d/</code> and <code>/edit</code> in the sheet URL.</small>
                </div>
                <div class="form-row">
                    <label>Main tab name (optional)</label>
                    <input class="input" type="text" name="tabName" value="@Model.TabName" placeholder="Main" />
                    <small>Defaults to <code>Main</code>. Used for the reconciliation page's read of B7:L200.</small>
                </div>
                <div class="form-row">
                    <label>AttInput tab name (optional)</label>
                    <input class="input" type="text" name="attInputTabName" value="@Model.AttInputTabName" placeholder="AttInput" />
                    <small>Defaults to <code>AttInput</code>. The app appends one row per attendee/snapshot here. Your column-C formula is never overwritten.</small>
                </div>
                <div class="form-row">
                    <label>Default Entry Type for snapshots without a linked event (optional)</label>
                    <input class="input" type="text" name="attInputDefaultEntryType" value="@Model.AttInputDefaultEntryType" placeholder="e.g. Misc Camp" />
                    <small>Used for <code>/lsm now</code> snapshots when no event is linked. Examples: <code>Misc Camp</code>, <code>Kill</code>, <code>Kings Camp</code>, <code>Wyrms Camp</code>.</small>
                </div>
                <div class="form-row">
                    <label>ManualPoints tab name (optional)</label>
                    <input class="input" type="text" name="manualPointsTabName" value="@Model.ManualPointsTabName" placeholder="ManualPoints" />
                    <small>Defaults to <code>ManualPoints</code>. Each DKP audit adds a new column to this tab (header = <code>M/D Audit: reason</code>, value in the affected member's row).</small>
                </div>
                <div style="margin-top:12px">
                    <button type="submit" class="btn">Save</button>
                    @if (!string.IsNullOrWhiteSpace(Model.SpreadsheetId))
                    {
                        <a class="btn" target="_blank" href="https://docs.google.com/spreadsheets/d/@Model.SpreadsheetId/edit">Open sheet</a>
                    }
                </div>
            </form>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.SpreadsheetId))
        {
            <div class="card fade d4">
                <div class="card-head">
                    <div class="card-title">Step 3 — Import existing balances (optional)</div>
                </div>
                <form asp-action="ImportPreview" asp-route-linkshellId="@Model.LinkshellId" method="post" style="padding:12px 16px">
                    <input type="hidden" name="readRange" value="@readRange" />
                    <div>
                        <button type="submit" class="btn">Preview import</button>
                    </div>
                </form>

                @if (preview is not null)
                {
                    var willCreate = preview.MissingMembers.Count;
                    var willUpdate = preview.Updates.Count(u => !u.Matches);
                    var unchanged = preview.Updates.Count(u => u.Matches);
                    <div style="padding:8px 16px">
                        <div style="margin-bottom:8px;font-size:14px">
                            <span style="color:#4ade80">@unchanged unchanged</span> ·
                            <span style="color:#fbbf24">@willUpdate will update</span> ·
                            <span style="color:#60a5fa">@willCreate will create placeholder(s)</span>
                            · range <code>@preview.Range</code>
                        </div>

                        @if (preview.Updates.Count > 0)
                        {
                            <details open style="margin-top:8px">
                                <summary>Existing members in this linkshell that match the sheet (@preview.Updates.Count)</summary>
                                <table style="width:100%;border-collapse:collapse;font-size:13px;margin-top:6px">
                                    <thead><tr>
                                        <th style="text-align:left;padding:6px 10px">Character</th>
                                        <th style="text-align:right;padding:6px 10px">App DKP</th>
                                        <th style="text-align:right;padding:6px 10px">Sheet DKP</th>
                                        <th style="text-align:left;padding:6px 10px">Result</th>
                                    </tr></thead>
                                    <tbody>
                                    @foreach (var u in preview.Updates)
                                    {
                                        <tr style="border-top:1px solid var(--border,#222)">
                                            <td style="padding:6px 10px">@u.CharacterName</td>
                                            <td style="padding:6px 10px;text-align:right">@u.CurrentDkp.ToString("0.##")</td>
                                            <td style="padding:6px 10px;text-align:right">@u.SheetDkp.ToString("0.##")</td>
                                            <td style="padding:6px 10px">
                                                @if (u.Matches)
                                                {
                                                    <span style="color:#4ade80">✓ no change</span>
                                                }
                                                else
                                                {
                                                    <span style="color:#fbbf24">will update (@((u.SheetDkp - u.CurrentDkp).ToString("+0.##;-0.##;0"))) </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </details>
                        }

                        @if (preview.MissingMembers.Count > 0)
                        {
                            <details open style="margin-top:8px" id="missing-details">
                                <summary>Sheet characters not yet in this linkshell — will be created as placeholders (@preview.MissingMembers.Count)</summary>
                                <div style="display:flex;gap:8px;align-items:center;margin:8px 0;flex-wrap:wrap">
                                    <input type="text" id="missing-search" placeholder="Search character name…" autocomplete="off" style="flex:1;min-width:200px;max-width:320px;padding:4px 8px" />
                                    <span id="missing-count" style="font-size:12px;color:var(--fg-muted,#888)"></span>
                                </div>
                                <table style="width:100%;border-collapse:collapse;font-size:13px;margin-top:6px" id="missing-table">
                                    <thead><tr>
                                        <th style="text-align:left;padding:6px 10px">Character</th>
                                        <th style="text-align:right;padding:6px 10px">Sheet DKP</th>
                                    </tr></thead>
                                    <tbody>
                                    @foreach (var m in preview.MissingMembers)
                                    {
                                        <tr style="border-top:1px solid var(--border,#222)">
                                            <td style="padding:6px 10px">@m.CharacterName</td>
                                            <td style="padding:6px 10px;text-align:right">@m.SheetDkp.ToString("0.##")</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                                <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:8px;font-size:13px">
                                    <button type="button" class="btn sm" id="missing-prev">‹ Prev</button>
                                    <span id="missing-page-indicator" style="color:var(--fg-muted,#888)">Page 1 / 1</span>
                                    <button type="button" class="btn sm" id="missing-next">Next ›</button>
                                </div>
                            </details>
                            <script nonce="@Html.CspNonce()">
                                (function () {
                                    var PAGE_SIZE = 15;
                                    var table = document.getElementById('missing-table');
                                    if (!table) return;
                                    var rows = Array.prototype.slice.call(table.querySelectorAll('tbody tr'));
                                    var search = document.getElementById('missing-search');
                                    var indicator = document.getElementById('missing-page-indicator');
                                    var countLabel = document.getElementById('missing-count');
                                    var prev = document.getElementById('missing-prev');
                                    var next = document.getElementById('missing-next');
                                    var page = 0;
                                    var filter = '';

                                    function render() {
                                        var visible = filter
                                            ? rows.filter(function (r) {
                                                var cell = r.firstElementChild;
                                                return cell && cell.textContent.toLowerCase().indexOf(filter) !== -1;
                                            })
                                            : rows;
                                        var totalPages = Math.max(1, Math.ceil(visible.length / PAGE_SIZE));
                                        if (page >= totalPages) page = totalPages - 1;
                                        if (page < 0) page = 0;
                                        var start = page * PAGE_SIZE;
                                        var end = start + PAGE_SIZE;
                                        for (var i = 0; i < rows.length; i++) rows[i].style.display = 'none';
                                        var slice = visible.slice(start, end);
                                        for (var j = 0; j < slice.length; j++) slice[j].style.display = '';
                                        indicator.textContent = 'Page ' + (page + 1) + ' / ' + totalPages;
                                        countLabel.textContent = filter
                                            ? visible.length + ' matched of ' + rows.length
                                            : rows.length + ' total';
                                        prev.disabled = page === 0;
                                        next.disabled = page >= totalPages - 1;
                                    }

                                    search.addEventListener('input', function () {
                                        filter = search.value.trim().toLowerCase();
                                        page = 0;
                                        render();
                                    });
                                    prev.addEventListener('click', function () { page--; render(); });
                                    next.addEventListener('click', function () { page++; render(); });
                                    render();
                                })();
                            </script>
                        }

                        <form asp-action="ImportCommit" asp-route-linkshellId="@Model.LinkshellId" method="post" style="margin-top:12px">
                            <input type="hidden" name="readRange" value="@readRange" />
                            <button type="submit" class="btn btn-primary" onclick="return confirm('Commit the import? This will set member DKP balances to the sheet values, create placeholders for new names, and write SheetImport ledger entries.');">Commit import</button>
                        </form>
                    </div>
                }
            </div>

            <div class="card fade d5">
                <div class="card-head">
                    <div class="card-title">Manual resync</div>
                </div>
                <form asp-action="Resync" asp-route-linkshellId="@Model.LinkshellId" method="post" style="padding:12px 16px">
                    <p>Pushes the current DB state to the sheet. Useful if the sheet was edited manually.</p>
                    <button type="submit" class="btn">Resync now</button>
                </form>
            </div>

            <div class="card fade d6">
                <div class="card-head">
                    <div class="card-title">Reconcile members</div>
                </div>
                <div style="padding:12px 16px">
                    <p>Open the reconciliation page to review every sheet character side-by-side with Discord users in your linkshell — confirm each match one at a time so typos and renames don't silently divide records.</p>
                    <a class="btn btn-primary" asp-controller="LinkshellReconciliation" asp-action="Index" asp-route-linkshellId="@Model.LinkshellId">Reconcile members with sheet</a>
                </div>
            </div>
        }
    }
}

</div>@* /.sheet-cards *@

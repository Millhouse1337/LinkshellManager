@model LinkshellManagerDiscordApp.ViewModels.ManageTeamViewModel
@{
    ViewData["Title"] = "Invites";
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Invites</h1>
        <div class="page-sub">
            <span><span class="num">@Model.PendingInvites.Count</span> pending</span>
            @if (Model.CanManage)
            {
                <span class="dot"> · </span>
                <span><span class="num">@Model.SentInvites.Count</span> sent</span>
            }
        </div>
    </div>
    <div class="page-actions">
        <a class="btn ghost" asp-action="Index">Back to team</a>
    </div>
</div>

<div class="fade d2" style="display:grid;gap:16px">
    <div>
        <div class="card">
            <div class="card-head">
                <div class="card-title">Pending invites (for you)</div>
            </div>
            @if (Model.PendingInvites.Count == 0)
            {
                <div class="empty">No pending invites.</div>
            }
            else
            {
                <table class="table themed">
                    <thead>
                        <tr>
                            <th>Linkshell</th>
                            <th style="text-align:right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invite in Model.PendingInvites)
                        {
                            <tr>
                                <td>@(invite.Linkshell?.LinkshellName ?? "—")</td>
                                <td style="text-align:right">
                                    <div style="display:inline-flex;gap:6px;flex-wrap:wrap">
                                        <form asp-action="AcceptInvite" method="post" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="inviteId" value="@invite.Id" />
                                            <button type="submit" class="btn primary sm">Accept</button>
                                        </form>
                                        <form asp-action="DeclineInvite" method="post" style="display:inline"
                                              onsubmit="return confirm('Decline this invite?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="inviteId" value="@invite.Id" />
                                            <button type="submit" class="btn ghost sm" style="color:var(--danger)">Decline</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    @if (Model.CanManage)
    {
        <div>
            <div class="card">
                <div class="card-head">
                    <div class="card-title">Sent invites</div>
                </div>
                @if (Model.SentInvites.Count == 0)
                {
                    <div class="empty">No outstanding sent invites.</div>
                }
                else
                {
                    <table class="table themed">
                        <thead>
                            <tr>
                                <th>Character</th>
                                <th>Linkshell</th>
                                <th>Status</th>
                                <th style="text-align:right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var invite in Model.SentInvites)
                            {
                                <tr>
                                    <td>@(invite.AppUser?.CharacterName ?? "—")</td>
                                    <td>@(invite.Linkshell?.LinkshellName ?? "—")</td>
                                    <td><span class="tag">@invite.Status</span></td>
                                    <td style="text-align:right">
                                        <form asp-action="UndoInvite" method="post" style="display:inline"
                                              onsubmit="return confirm('Cancel this invite?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="inviteId" value="@invite.Id" />
                                            <button type="submit" class="btn ghost sm" style="color:var(--danger)">Undo</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
</div>

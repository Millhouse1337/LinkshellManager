@using System.Text.Json
@model LinkshellManagerDiscordApp.ViewModels.PartySetupEditorViewModel

@{
    var isEditMode = Model.Id > 0;
    var pageHeading = isEditMode ? "Edit Party Setup" : "New Party Setup";
    var formAction = isEditMode ? "Edit" : "Create";
    ViewData["Title"] = pageHeading;
    ViewData["BodyClass"] = "lsm-page";
    var linkshellName = Model.LinkshellName ?? "Selected Linkshell";

    var optionsJson = JsonSerializer.Serialize(new
    {
        roles = Model.RoleOptions,
        mainJobs = Model.MainJobOptions,
        subJobs = Model.SubJobOptions
    });
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">@pageHeading</h1>
        <div class="page-sub">
            <span>@linkshellName</span>
        </div>
    </div>
    <div class="page-actions">
        <a class="btn ghost" asp-action="Index">Cancel</a>
    </div>
</div>

<form asp-action="@formAction"
      asp-route-id="@(isEditMode ? (int?)Model.Id : null)"
      method="post" id="party-setup-form" novalidate
      data-options="@optionsJson"
      class="create-form fade d2">

    <div class="create-form__header">
        <div>
            <strong>@(isEditMode ? "Update party setup" : "Design party setup")</strong>
            <p>Plan the alliances, parties and slots you want for the next event. Each alliance can hold up to 3 parties.</p>
        </div>
        <span class="tag accent">@linkshellName</span>
    </div>

    @await Html.PartialAsync("_EditorBody", Model)

    <div class="create-form__actions" style="margin-top:14px">
        <button type="submit" class="btn primary">@(isEditMode ? "Save Party Setup" : "Create Party Setup")</button>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_EditorScripts")
}

@page
@model LinkshellManagerDiscordApp.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
    var returnUrl = Model.ReturnUrl ?? "/";
    var discordLoginHref = $"/auth/discord/login?returnUrl={Uri.EscapeDataString(returnUrl)}";
    var registerHref = string.IsNullOrWhiteSpace(Model.ReturnUrl)
        ? "/Identity/Account/Register"
        : $"/Identity/Account/Register?returnUrl={Uri.EscapeDataString(Model.ReturnUrl)}";
}

<div class="auth-card">
    <div class="auth-brand">
        <span class="brand-mark">LS</span>
        <span class="brand-name">LinkshellManager</span>
    </div>

    <h1 class="auth-title">Sign in</h1>
    <p class="auth-sub">
        Website access and the embedded Discord Activity both use the same Discord-linked account.
    </p>

    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <div class="auth-actions">
        <a class="btn primary" href="@discordLoginHref">Continue with Discord</a>
    </div>

    <div class="auth-meta">
        New here? <a href="@registerHref">Create an account</a>
    </div>
</div>

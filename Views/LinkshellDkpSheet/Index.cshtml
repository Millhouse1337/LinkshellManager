@model LinkshellManagerDiscordApp.ViewModels.LinkshellDkpSheetViewModel
@{
    ViewData["Title"] = "DKP Sheet";
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">DKP Sheet</h1>
        <div class="page-sub">
            <span>Read-only view of your linkshell's Google Sheet</span>
            @if (!string.IsNullOrWhiteSpace(Model.LinkshellName))
            {
                <span class="dot"> · </span>
                <span>@Model.LinkshellName</span>
            }
        </div>
    </div>
</div>

@if (!Model.IsConfigured)
{
    <div class="card fade d2">
        <div class="card-head">
            <div class="card-title">Sheet not configured</div>
        </div>
        <div class="empty" style="padding:16px">
            Your linkshell hasn't connected a Google Sheet yet. A Leader or Officer can set it up under
            <strong>Configurations → Google Sheet Integration</strong>.
        </div>
    </div>
}
else
{
    <div class="card fade d2" style="padding:12px 16px;font-size:13px;color:var(--fg-muted,#aaa)">
        Can't see the sheet below? Ask a Leader or Officer to share view access with your Google account,
        or sign in to Google in this browser and refresh.
        <a href="@Model.OpenInSheetsUrl" target="_blank" rel="noopener" style="margin-left:8px">Open in Google Sheets ↗</a>
    </div>

    <div class="card fade d3" style="padding:0;overflow:hidden">
        <iframe src="@Model.EmbedUrl"
                title="DKP Sheet"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                sandbox="allow-scripts allow-same-origin allow-popups allow-forms"
                style="width:100%;height:75vh;border:0;display:block"></iframe>
    </div>
}

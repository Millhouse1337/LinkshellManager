                Charts
                <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M9 6l6 6-6 6"/></svg>
            </button>
            <div id="nav-endgame" class="nav-sub">
                <a class="nav-sub-item @IsSubActive("Charts", "Sky")" asp-controller="Charts" asp-action="Sky">Sky</a>
                <a class="nav-sub-item @IsSubActive("Charts", "Sea")" asp-controller="Charts" asp-action="Sea">Sea</a>
                <a class="nav-sub-item @IsSubActive("Charts", "Dynamis")" asp-controller="Charts" asp-action="Dynamis">Dynamis</a>
                <a class="nav-sub-item @IsSubActive("Charts", "Limbus")" asp-controller="Charts" asp-action="Limbus">Limbus</a>
                <a class="nav-sub-item @IsSubActive("Charts", "HENM")" asp-controller="Charts" asp-action="HENM">HENM</a>
            </div>
        }

        <button type="button" class="nav-item nav-group @IsExpanded("Auction", "AuctionHistory")" data-target="#nav-auctions">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 4h14l-2 7H7z"/><path d="M6 11v9h12v-9"/></svg>
            Linkshell Auction
            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M9 6l6 6-6 6"/></svg>
        </button>
        <div id="nav-auctions" class="nav-sub">
            <a class="nav-sub-item @IsSubActive("Auction", "Index")" asp-controller="Auction" asp-action="Index">View Auctions</a>
            @if (Allow(p => p.CanManageAuctions))
            {
                <a class="nav-sub-item create @IsSubActive("Auction", "Create")" asp-controller="Auction" asp-action="Create">Create Auction</a>
            }
            <a class="nav-sub-item @IsSubActive("AuctionHistory")" asp-controller="AuctionHistory" asp-action="Index">Auction History</a>
        </div>

        @* Attendance snapshots used to be their own "Attendance System" group. They only ever come
           from HNM activity, so they now live under Event System: the open ones render on the Timed
           Events page itself, and only the archive/triage pages need their own links. *@
        <button type="button" class="nav-item nav-group @IsExpanded("Event", "EventHistory", "LinkshellAttendanceSnapshots", "WindowEvents", "LinkshellPendingSubmissions")" data-target="#nav-events">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 11h18"/></svg>
            Event System
            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M9 6l6 6-6 6"/></svg>
        </button>
        <div id="nav-events" class="nav-sub">
            <a class="nav-sub-item @IsSubActive("Event", "Index")" asp-controller="Event" asp-action="Index">All Events</a>
            @if (Allow(p => p.CanManageEvents))
            {
                <a class="nav-sub-item create @IsSubActive("Event", "Create")" asp-controller="Event" asp-action="Create">Create Timed Event</a>
            }
            @* Past Events and Attendance History are now sections of the Event System page, so
               these jump to their anchors rather than to the standalone pages (which still work,
               and are still where a Details back-link lands). No IsSubActive on them: it keys on
               controller + action only and the server never sees the fragment, so all three
               Event/Index rows would light up at once. *@
            <a class="nav-sub-item" asp-controller="Event" asp-action="Index" asp-fragment="past-events">Past Events</a>
            @if (showAttendanceNav && activeLinkshellId.HasValue)
            {
                <a class="nav-sub-item" asp-controller="Event" asp-action="Index" asp-fragment="attendance-archive">Attendance History</a>
                @if (Allow(p => p.CanManageTods) || Allow(p => p.CanModerateLiveEvent))
                {
                    <a class="nav-sub-item @IsSubActive("LinkshellPendingSubmissions")" asp-controller="LinkshellPendingSubmissions" asp-action="Index" asp-route-linkshellId="@activeLinkshellId.Value">Pending Submissions</a>
                }
            }
        </div>

        @if (showToDsNav)
        {
            <button type="button" class="nav-item nav-group @IsExpanded("Tod")" data-target="#nav-tods">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                ToD Tracker
                <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M9 6l6 6-6 6"/></svg>
            </button>
            <div id="nav-tods" class="nav-sub">
                <a class="nav-sub-item @IsSubActive("Tod", "Index")" asp-controller="Tod" asp-action="Index">View ToDs</a>
                @if (Allow(p => p.CanManageTods))
                {
                    <a class="nav-sub-item create @IsSubActive("Tod", "Create")" asp-controller="Tod" asp-action="Create">Add ToD</a>
                }
            </div>

        </button>
        <div id="nav-gil" class="nav-sub">
            <a class="nav-sub-item @IsSubActive("ManageFinances", "Index")" asp-controller="ManageFinances" asp-action="Index">Gil on hand</a>
            @if (Allow(p => p.CanManageTreasury))
            {
                <a class="nav-sub-item create @IsSubActive("ManageFinances", "Record")" asp-controller="ManageFinances" asp-action="Record">@TreasuryLabels.RecordAction</a>

@using LinkshellManagerDiscordApp.Models
@using LinkshellManagerDiscordApp.Services
@model LinkshellManagerDiscordApp.ViewModels.RecordTreasuryEntryViewModel
@{
    var editing = Model.Id != 0;
    ViewData["Title"] = editing ? "Edit draft" : TreasuryLabels.RecordAction;
    ViewData["BodyClass"] = "lsm-page";
    var action = editing ? "EditDraft" : "Record";
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">@ViewData["Title"]</h1>
        <div class="page-sub"><span>@TreasuryLabels.Section · @TreasuryLabels.Title</span></div>
    </div>
</div>

<div class="card fade d2" style="padding:20px">
    <form asp-action="@action" asp-route-id="@(editing ? Model.Id : (int?)null)" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-grid" style="grid-template-columns:repeat(3,minmax(0,1fr));column-gap:24px;align-items:end">
            <partial name="_TreasuryKindPicker" model="Model" />

            <div class="field">
                <label asp-for="Amount"></label>
                <input asp-for="Amount" class="form-control" type="text" inputmode="numeric" data-thousands
                       autocomplete="off" id="Amount" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="TransactionDate"></label>
                <input asp-for="TransactionDate" class="form-control" type="datetime-local"
                       value="@Model.TransactionDate.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="TransactionDate" class="text-danger"></span>
            </div>

            @* Type to filter the roster rather than typing a name from memory. data-owed carries
               what each is still due, so settling can fill the amount in. *@
            <div class="field" id="memberField">
                <label asp-for="Member"></label>
                <input asp-for="Member" class="form-control" maxlength="256" autocomplete="off"
                       list="memberOptions" placeholder="Search members…" />
                <datalist id="memberOptions">
                    @foreach (var option in Model.Roster)
                    {
                        <option value="@option.CharacterName" data-owed="@option.Owed"></option>
                    }
                </datalist>
                <div id="memberOwed" style="font-size:12px;color:var(--fg-3);margin-top:4px"></div>
                <span asp-validation-for="Member" class="text-danger"></span>
            </div>

            @* WHOSE MULE. The one question gil on hand could never be broken down by, asked at the
               only moment anyone knows the answer — a linkshell has no bank, and gil on hand is only
               the sum of what sits on people's characters.

               Deliberately a separate box from Member above: on a Gil Out to a member the two are
               different people, because the gil leaves the treasurer's mule and arrives at theirs.
               The label is set by the script from the chosen option's own wording, so it flips
               between "who's holding this gil" and "whose gil is this coming out of" with the
               direction. A datalist, not a select: gil regularly sits on a mule nobody has added to
               the roster. *@
            <div class="field" id="holderField">
                <label asp-for="Holder" id="holderLabel"></label>
                <input asp-for="Holder" class="form-control" maxlength="256" autocomplete="off"
                       list="holderOptions" placeholder="Search members…" />
                <datalist id="holderOptions">
                    @foreach (var option in Model.Roster)
                    {
                        <option value="@option.CharacterName"></option>
                    }
                </datalist>
                <span asp-validation-for="Holder" class="text-danger"></span>
            </div>

            <partial name="_TreasuryRecipients" model="Model" />
        </div>

        @* Free confidence for someone who just picked an option they are not sure about. *@
        <div id="preview" style="margin-top:16px;padding:10px 12px;border:1px solid var(--border);
                                border-radius:6px;font-size:13px;color:var(--fg-2)"></div>

        @* Confirm only. "Save as draft" is gone from every form: nobody was using it, and a
           half-recorded entry that looks recorded is a worse answer than one more click. Drafts
           already in the books keep their Confirm / Edit / Discard buttons in the transactions list
           — this only stops new ones being made, which is why the Confirm field still posts. *@
        <div style="display:flex;gap:8px;margin-top:20px;padding-top:16px;border-top:1px solid var(--border)">
            <button type="submit" name="Confirm" value="true" class="btn primary">@TreasuryLabels.ConfirmAction</button>
            <a class="btn ghost" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @* Shared with Fix.cshtml, which renders the same fields. *@
    <script src="~/js/treasury-record.js" asp-append-version="true" defer></script>
}

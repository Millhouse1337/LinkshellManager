@model LinkshellManagerDiscordApp.ViewModels.PartyBoardPanelViewModel
@*
    Live event party board (web). Officers get drag-drop + inline editing, driven by
    wwwroot/js/event-party-board.js (fetch → EventController.PartyBoardEdit endpoints →
    this partial is re-fetched to refresh just the board). Edit-only controls carry the
    `ps-edit-only` class (hidden until the JS toggles `.ps-editing` on the root); the
    sign-up forms carry `ps-view-only` (hidden while editing).
*@
<div class="event-ps-board" data-event-party-board
     data-event-id="@Model.EventId"
     data-linkshell-id="@Model.LinkshellId"
     data-can-manage="@(Model.CanManageParties ? "1" : "0")"
     data-return-url="@Model.ReturnUrl">

    @if (Model.CanManageParties)
    {
        <div class="ps-edit-bar">
            <button type="button" class="btn sm" data-board-edit-toggle>Edit layout</button>
            <span class="muted ps-edit-only" style="font-size:12px">Drag slots to rearrange. Changes save live to the channel board.</span>
        </div>
    }

    @if (!Model.Board.Alliances.Any())
    {
        <div class="event-ps-empty">This party setup has no alliances yet.</div>
    }

    @foreach (var alliance in Model.Board.Alliances)
    {
        var multiAlliance = Model.Board.Alliances.Count > 1;
        // Whether the current viewer holds a slot anywhere in this alliance (gates the
        // "Make me alliance lead" button, mirroring the Discord button's slot gate).
        var iHoldSlotHere = !string.IsNullOrEmpty(Model.CurrentUserId)
            && alliance.Parties.SelectMany(p => p.Slots).Any(s => s.SignedUpAppUserId == Model.CurrentUserId);
        var iAmAllianceLead = !string.IsNullOrEmpty(Model.CurrentUserId) && alliance.LeadAppUserId == Model.CurrentUserId;
        <div class="event-ps-alliance" data-alliance-id="@alliance.AllianceId">
            <div class="event-ps-alliance-title">
                <span class="ps-view-only">@alliance.Name</span>
                @if (multiAlliance && !string.IsNullOrEmpty(alliance.LeadCharacterName))
                {
                    <span class="event-ps-alliance-lead ps-view-only" title="Alliance lead">👑 Alliance Lead: @alliance.LeadCharacterName</span>
                }
                @* "Make me alliance lead" — shown to a member who holds a slot in this alliance
                   but isn't already its lead. Posts to MakeAllianceLead and reloads the board. *@
                @if (multiAlliance && iHoldSlotHere && !iAmAllianceLead)
                {
                    <form class="ps-view-only" asp-controller="Event" asp-action="MakeAllianceLead" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="eventId" value="@Model.EventId" />
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <button type="submit" class="btn xs" title="Take this alliance's lead">👑 Make me alliance lead</button>
                    </form>
                }
                @if (Model.CanManageParties)
                {
                    <input class="ps-rename ps-edit-only" type="text" value="@alliance.Name" placeholder="Alliance name" data-rename-alliance />
                    <button type="button" class="btn xs ghost ps-edit-only" data-add-party title="Add a party">+ Party</button>
                }
            </div>
            <div class="event-ps-party-grid">
                @foreach (var party in alliance.Parties)
                {
                    var partyHasLeader = party.Slots.Any(s => s.SignedUpIsPartyLeader);
                    <div class="event-ps-party" data-party-id="@party.PartyId">
                        <div class="event-ps-party__head">
                            <span class="ps-view-only">@party.Name</span>
                            @if (Model.CanManageParties)
                            {
                                <input class="ps-rename ps-rename--party ps-edit-only" type="text" value="@party.Name" placeholder="Party name" data-rename-party />
                            }
                            <span class="event-ps-party__count">@party.Slots.Count</span>
                            @if (Model.CanManageParties)
                            {
                                <button type="button" class="btn xs ghost ps-edit-only ps-remove-party" data-remove-party title="Remove party">✕</button>
                            }
                        </div>

                        <div class="event-ps-slots" data-slot-list>
                            @foreach (var slot in party.Slots)
                            {
                                var slotRequiresRole = !string.IsNullOrWhiteSpace(slot.Role);
                                var slotRequiresMain = !string.IsNullOrWhiteSpace(slot.MainJob);
                                var slotRequiresSub = !string.IsNullOrWhiteSpace(slot.SubJob);
                                <div class="event-ps-slot @(slot.IsPartyLeader ? "event-ps-slot--leader" : null)"
                                     data-slot-id="@slot.SlotId"
                                     data-role="@slot.Role" data-main="@slot.MainJob" data-sub="@slot.SubJob">
                                    <div class="event-ps-slot__label">
                                        @if (Model.CanManageParties)
                                        {
                                            <span class="ps-drag-handle ps-edit-only" data-drag-handle title="Drag to move slot" aria-hidden="true">⠿</span>
                                        }
                                        @if (slot.IsPartyLeader) { <span class="event-ps-leader-tag" title="Party leader">Leader</span> }
                                        <span>@slot.Display</span>
                                        @if (Model.CanManageParties)
                                        {
                                            <button type="button" class="ps-icon-btn ps-edit-only" data-edit-slot title="Change this slot's job">✎</button>
                                            <button type="button" class="ps-icon-btn ps-icon-btn--danger ps-edit-only" data-delete-slot title="Remove this slot">✕</button>
                                        }
                                    </div>

                                    @if (Model.CanManageParties)
                                    {
                                        <div class="ps-job-edit ps-edit-only" data-job-edit hidden>
                                            <select data-job-role>
                                                <option value="">Any role</option>
                                                @foreach (var r in Model.RoleOptions) { <option value="@r" selected="@(string.Equals(r, slot.Role, StringComparison.OrdinalIgnoreCase))">@r</option> }
                                            </select>
                                            <select data-job-main>
                                                <option value="">Any job</option>
                                                @foreach (var j in Model.MainJobOptions) { <option value="@j" selected="@(string.Equals(j, slot.MainJob, StringComparison.OrdinalIgnoreCase))">@j</option> }
                                            </select>
                                            <select data-job-sub>
                                                <option value="">Player's choice</option>
                                                @foreach (var j in Model.SubJobOptions) { <option value="@j" selected="@(string.Equals(j, slot.SubJob, StringComparison.OrdinalIgnoreCase))">@j</option> }
                                            </select>
                                            <button type="button" class="btn xs primary" data-job-save>Save</button>
                                            <button type="button" class="btn xs" data-job-cancel>Cancel</button>
                                        </div>
                                    }

                                    @if (slot.IsOpen)
                                    {
                                        <form class="event-ps-slot__controls ps-view-only" asp-controller="Event" asp-action="SignUpPartySlot" asp-route-eventId="@Model.EventId" asp-route-slotId="@slot.SlotId" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                            @if (Model.SignupCharacters.Count > 1)
                                            {
                                                <select name="selectedCharacter" class="form-select" title="Sign up as">@foreach (var c in Model.SignupCharacters) { <option value="@c">@c</option> }</select>
                                            }
                                            @if (!slotRequiresRole)
                                            {
                                                <select name="role" required class="form-select"><option value="">Role…</option>@foreach (var r in Model.RoleOptions) { <option value="@r">@r</option> }</select>
                                            }
                                            @if (!slotRequiresMain)
                                            {
                                                <select name="mainJob" required class="form-select"><option value="">Main…</option>@foreach (var j in Model.MainJobOptions) { <option value="@j">@j</option> }</select>
                                            }
                                            @if (!slotRequiresSub)
                                            {
                                                <select name="subJob" class="form-select"><option value="">Sub (opt)</option>@foreach (var j in Model.SubJobOptions) { <option value="@j">@j</option> }</select>
                                            }
                                            <button type="submit" name="asLeader" value="false" class="btn primary sm">Sign up</button>
                                            @if (!partyHasLeader)
                                            {
                                                <button type="submit" name="asLeader" value="true" class="btn sm" title="Claim this party's leader spot">👑 Leader</button>
                                            }
                                        </form>
                                        <div class="ps-edit-only event-ps-slot__open-label">Open</div>
                                    }
                                    else
                                    {
                                        <div class="event-ps-slot__controls">
                                            <span class="event-ps-chip @(slot.SignedUpAppUserId == Model.CurrentUserId ? "event-ps-chip--mine" : null)">
                                                @if (slot.SignedUpIsPartyLeader) { <span title="Party leader">👑</span> }
                                                @slot.SignedUpCharacterName@(slot.SignedUpAppUserId == Model.CurrentUserId ? " (you)" : "")
                                                @if (!string.IsNullOrEmpty(slot.SignedUpJobsDisplay)) { <span class="muted">· @slot.SignedUpJobsDisplay</span> }
                                            </span>
                                            @if (Model.CanManageParties)
                                            {
                                                <select class="ps-move-select ps-edit-only" data-move-member title="Move this member">
                                                    <option value="">Move…</option>
                                                    <option value="also">→ Also Attending</option>
                                                </select>
                                                <form class="ps-view-only" asp-controller="Event" asp-action="WithdrawPartySlot" asp-route-eventId="@Model.EventId" asp-route-slotId="@slot.SlotId" method="post" style="display:inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                                    <button type="submit" class="btn ghost sm" style="color:var(--danger)" title="Free this slot and move them to Also Attending while the event is live">Withdraw from Slot</button>
                                                </form>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            @if (!party.Slots.Any()) { <div class="event-ps-empty" data-empty-slot>No slots.</div> }
                        </div>

                        @if (Model.CanManageParties)
                        {
                            <button type="button" class="btn xs ghost ps-edit-only ps-add-slot" data-add-slot title="Add a slot">+ Slot</button>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @* Also Attending always renders (underneath the parties) so the section is visible
       even when empty, and the no-slot self sign-up lives in its header. *@
    <div class="event-ps-alliance-title" style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
        <span>Also attending <span class="muted" style="font-weight:400;text-transform:none;letter-spacing:0">· no slot</span></span>
        @* No-slot self sign-up for this event (mirrors the Discord/Activity "Join (no slot)"):
           join the roster without claiming a party slot. event-party-board.js submits it via
           fetch so the page doesn't reload. *@
        <form class="ps-view-only" asp-controller="Event" asp-action="SignUp" method="post"
              style="display:inline-flex;gap:6px;margin-left:auto;align-items:center">
            @Html.AntiForgeryToken()
            <input type="hidden" name="eventId" value="@Model.EventId" />
            @if (Model.SignupCharacters.Count > 1)
            {
                <select name="characterName" class="form-select" title="Sign up as">@foreach (var c in Model.SignupCharacters) { <option value="@c">@c</option> }</select>
            }
            <button type="submit" class="btn sm" title="Join the roster without claiming a party slot">Join (No Slot)</button>
        </form>
    </div>
    <div class="event-ps-also" style="display:flex;flex-wrap:wrap;gap:8px;padding:4px 4px 8px">
        @if (Model.AlsoAttending.Count == 0)
        {
            <span class="muted" style="font-size:12px">No one is attending without a slot yet.</span>
        }
        @foreach (var a in Model.AlsoAttending)
        {
                var jobBits = new List<string>();
                if (!string.IsNullOrWhiteSpace(a.JobType)) { jobBits.Add(a.JobType!); }
                if (!string.IsNullOrWhiteSpace(a.JobName)) { jobBits.Add(string.IsNullOrWhiteSpace(a.SubJobName) ? a.JobName! : $"{a.JobName}/{a.SubJobName}"); }
                <span class="event-ps-chip @(a.AppUserId == Model.CurrentUserId ? "event-ps-chip--mine" : null)" data-also-app-user="@a.AppUserId">
                    @a.CharacterName@(a.AppUserId == Model.CurrentUserId ? " (you)" : "")
                    @if (jobBits.Count > 0) { <span class="muted">· @string.Join(" - ", jobBits)</span> }
                    @if (Model.CanManageParties && !string.IsNullOrEmpty(a.AppUserId))
                    {
                        @* Officers can assign an Also-Attending member to an open slot WITHOUT
                           entering Edit layout, so this is NOT ps-edit-only. Options are filled
                           by event-party-board.js (populateMoveTargets, on init + after refresh). *@
                        <select class="ps-move-select" data-seat-member title="Assign this member to an open slot">
                            <option value="">Assign to slot…</option>
                        </select>
                    }
                </span>
        }
    </div>
</div>

@{
    var nudgeJson = TempData["SignupNudge"] as string;
    LinkshellManagerDiscordApp.ViewModels.SignupNudgePayload? nudge = null;
    if (!string.IsNullOrEmpty(nudgeJson))
    {
        try { nudge = System.Text.Json.JsonSerializer.Deserialize<LinkshellManagerDiscordApp.ViewModels.SignupNudgePayload>(nudgeJson); }
        catch { nudge = null; }
    }
}
@if (nudge is not null)
{
    var spot = string.Equals(nudge.SuggestedRequirement, "open", StringComparison.OrdinalIgnoreCase)
        ? "an open spot"
        : $"an open {nudge.SuggestedRequirement} spot";
    <div class="ps-nudge-overlay" id="ps-nudge-overlay" style="position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;padding:16px">
        <div class="card" style="max-width:460px;width:100%">
            <div class="card-head"><div class="card-title">Fill earlier alliances first</div></div>
            <div style="padding:14px 16px;display:flex;flex-direction:column;gap:14px">
                <div style="font-size:13px;color:var(--fg-3)">
                    There's still <strong style="color:var(--fg)">@spot</strong> in
                    <strong style="color:var(--fg)">@nudge.SuggestedLocation</strong>. Filling earlier alliances
                    first keeps parties together — take that slot, or sign up where you chose.
                </div>
                <div style="display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap">
                    <form asp-controller="Event" asp-action="SignUpPartySlot" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="eventId" value="@nudge.EventId" />
                        <input type="hidden" name="slotId" value="@nudge.OriginalSlotId" />
                        <input type="hidden" name="role" value="@nudge.Role" />
                        <input type="hidden" name="mainJob" value="@nudge.MainJob" />
                        <input type="hidden" name="subJob" value="@nudge.SubJob" />
                        <input type="hidden" name="asLeader" value="@nudge.AsLeader.ToString().ToLowerInvariant()" />
                        <input type="hidden" name="selectedCharacter" value="@nudge.SelectedCharacter" />
                        <input type="hidden" name="returnUrl" value="@nudge.ReturnUrl" />
                        <input type="hidden" name="force" value="true" />
                        <button type="submit" class="btn ghost sm">Sign up here anyway</button>
                    </form>
                    <form asp-controller="Event" asp-action="SignUpPartySlot" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="eventId" value="@nudge.EventId" />
                        <input type="hidden" name="slotId" value="@nudge.SuggestedSlotId" />
                        <input type="hidden" name="role" value="@nudge.Role" />
                        <input type="hidden" name="mainJob" value="@nudge.MainJob" />
                        <input type="hidden" name="subJob" value="@nudge.SubJob" />
                        <input type="hidden" name="selectedCharacter" value="@nudge.SelectedCharacter" />
                        <input type="hidden" name="returnUrl" value="@nudge.ReturnUrl" />
                        <button type="submit" class="btn primary sm">Take @nudge.SuggestedLocation</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

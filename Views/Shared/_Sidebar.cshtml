@using LinkshellManagerDiscordApp.Services
@{
    var activeLinkshellId = ViewData["ActiveLinkshellId"] as int?;
    var activeLinkshellName = ViewData["ActiveLinkshellName"] as string;
    var activeLinkshellInitials = ViewData["ActiveLinkshellInitials"] as string;
    var activeRole = ViewData["ActiveRole"] as string;
    var perms = ViewData["ActivePermissions"] as LinkshellRole;

    // Memberships for the linkshell switcher + the page to return to after a switch.
    var userLinkshells = ViewData["UserLinkshells"] as List<LinkshellManagerDiscordApp.Models.AppUserLinkshell>
        ?? new List<LinkshellManagerDiscordApp.Models.AppUserLinkshell>();
    var switchReturnUrl = ViewContext.HttpContext.Request.Path + ViewContext.HttpContext.Request.QueryString;

    string LinkshellInitials(string? name)
    {
        var initials = string.Concat((name ?? "LS")
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(w => w[0])).ToUpperInvariant();
        if (string.IsNullOrEmpty(initials)) { initials = "LS"; }
        return initials.Length > 2 ? initials[..2] : initials;
    }

    var currentController = (ViewContext.RouteData.Values["controller"] as string) ?? "";
    var currentAction = (ViewContext.RouteData.Values["action"] as string) ?? "";

    string IsOn(params string[] controllers) =>
        controllers.Any(c => string.Equals(c, currentController, StringComparison.OrdinalIgnoreCase))
            ? "active"
            : "";

    string IsExpanded(params string[] controllers) =>
        controllers.Any(c => string.Equals(c, currentController, StringComparison.OrdinalIgnoreCase))
            ? "expanded"
            : "";

    string IsSubActive(string controller, params string[] actions) =>
        string.Equals(controller, currentController, StringComparison.OrdinalIgnoreCase)
        && (actions.Length == 0 || actions.Any(a => string.Equals(a, currentAction, StringComparison.OrdinalIgnoreCase)))
            ? "active"
            : "";

    // When the user has no active linkshell yet, perms is null — show
    // everything so they can navigate to create or join one. Once a linkshell
    // is selected, gate by the matching LinkshellRole flag.
    bool Allow(Func<LinkshellRole, bool> selector) => perms is null || selector(perms);

    // Linkshell Type gating. The snapshot Attendance pages folded into the Event System group, so
    // that group is now shown to EVERY type — hiding it from HNM Only would strand exactly the
    // linkshells that live on snapshots. Sky/Sea/Dynamis still hides the attendance SUB-ITEMS, since
    // those linkshells run timed events only. Unknown/null fail-opens to Both.
    var activeLinkshellType =
        LinkshellManagerDiscordApp.Models.LinkshellTypes.Normalize(
            ViewData["ActiveLinkshellType"] as string);
    var showAttendanceNav =
        activeLinkshellType != LinkshellManagerDiscordApp.Models.LinkshellTypes.SkySeaDynamis;
    // ToDs are available to every linkshell type; the per-linkshell feature
    // toggle below remains the visibility control.
    var showToDsNav = true;

    // Feature Toggles (Customize page): unchecked hides the group. Fail-open
    // to shown when there's no active linkshell, matching Allow(...) above.
    // Missions isn't built yet — force its nav off until it ships, regardless of the stored flag.
    // (Was: ViewData["ActiveEnableMissions"].)
    var showMissionsNav = false;
    var showEndgameNav = ViewData["ActiveEnableEndgame"] as bool? ?? true;
}
<aside class="sidebar">
    <a class="brand" asp-controller="Dashboard" asp-action="Index">
        <div class="brand-mark">L</div>
        <div class="brand-name">LinkshellManager</div>
    </a>

    <div class="ls-switcher" data-ls-switcher>
        <button type="button" class="ls-switch" data-ls-toggle aria-haspopup="true" aria-expanded="false">
            <div class="ls-avatar">@(string.IsNullOrEmpty(activeLinkshellInitials) ? "LS" : activeLinkshellInitials)</div>
            <div class="ls-meta">
                <div class="ls-name">@(activeLinkshellName ?? "No linkshell")</div>
                <div class="ls-role">@(activeRole ?? "Member")</div>
            </div>
            <div class="ls-switch-icon">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 6l3 3 3-3M5 10l3-3 3 3" opacity="0.6"/></svg>
            </div>
        </button>

        <div class="ls-menu" data-ls-menu hidden>
            @if (userLinkshells.Count > 0)
            {
                <div class="ls-menu-group">
                    <div class="ls-menu-label">Switch linkshell</div>
                    @foreach (var m in userLinkshells)
                    {
                        <form asp-controller="Linkshell" asp-action="Switch" method="post" class="ls-menu-form">
                            <input type="hidden" name="linkshellId" value="@m.LinkshellId" />
                            <input type="hidden" name="returnUrl" value="@switchReturnUrl" />
                            <button type="submit" class="ls-menu-item @(m.LinkshellId == activeLinkshellId ? "active" : "")">
                                <span class="ls-menu-avatar">@LinkshellInitials(m.Linkshell?.LinkshellName)</span>
                                <span class="ls-menu-text">
                                    <span class="ls-menu-name">@(m.Linkshell?.LinkshellName ?? "Unnamed linkshell")</span>
                                    <span class="ls-menu-role">@(m.Rank ?? "Member")</span>
                                </span>
                                @if (m.LinkshellId == activeLinkshellId)
                                {
                                    <svg class="ls-menu-check" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8l3.5 3.5L13 5"/></svg>
                                }
                            </button>
                        </form>
                    }
                </div>
                <div class="ls-menu-sep"></div>
            }
            <a class="ls-menu-link" asp-controller="Linkshell" asp-action="Index">Manage linkshells</a>
            <a class="ls-menu-link" asp-controller="Linkshell" asp-action="Create">Create linkshell</a>
        </div>
    </div>

    <nav class="nav-section">
        <a class="nav-item @IsOn("Dashboard")" asp-controller="Dashboard" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
            Dashboard
        </a>

        <button type="button" class="nav-item nav-group @IsExpanded("Announcement")" data-target="#nav-announcements">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M3 5h18v4H3zM3 11h18v4H3zM3 17h18v3H3z"/></svg>
            Announcements
            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M9 6l6 6-6 6"/></svg>
        </button>
        <div id="nav-announcements" class="nav-sub">
            <a class="nav-sub-item @IsSubActive("Announcement", "Index")" asp-controller="Announcement" asp-action="Index">View Announcements</a>
            @if (Allow(p => p.CanManageAnnouncements))
            {
                <a class="nav-sub-item create @IsSubActive("Announcement", "Create")" asp-controller="Announcement" asp-action="Create">Create Announcement</a>
            }
        </div>

        <button type="button" class="nav-item nav-group @IsExpanded("Rule")" data-target="#nav-rules">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 4h11l3 3v13H5z"/><path d="M8 10h8M8 14h8M8 18h5"/></svg>
            Rules
            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M9 6l6 6-6 6"/></svg>
        </button>
        <div id="nav-rules" class="nav-sub">
            <a class="nav-sub-item @IsSubActive("Rule", "Index")" asp-controller="Rule" asp-action="Index">View Rules</a>
            @if (Allow(p => p.CanManageRules))
            {
                <a class="nav-sub-item create @IsSubActive("Rule", "Create")" asp-controller="Rule" asp-action="Create">Create Rule</a>
            }
        </div>

        @if (showMissionsNav)
        {
            <button type="button" class="nav-item nav-group" data-target="#nav-missions">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 22V3l7 4 7-4v19"/></svg>
                Missions
                <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M9 6l6 6-6 6"/></svg>
            </button>
            <div id="nav-missions" class="nav-sub">
                <a class="nav-sub-item" href="#">Rise of the Zilart</a>
                <a class="nav-sub-item" href="#">Chains of Promathia</a>
                <a class="nav-sub-item" href="#">Treasures of Aht Urhgan</a>
            </div>
        }
    </nav>

    <nav class="nav-section">

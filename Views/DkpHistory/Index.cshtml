@model LinkshellManagerDiscordApp.ViewModels.DkpHistoryViewModel
@{
    ViewData["Title"] = "DKP History";
    ViewData["BodyClass"] = "lsm-page";
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">DKP History</h1>
        <div class="page-sub">
            <span>Earned and spent ledger</span>
            @if (!string.IsNullOrWhiteSpace(Model.SelectedLinkshellName))
            {
                <span>·</span>
                <span>@Model.SelectedLinkshellName</span>
            }
        </div>
    </div>
    <div class="page-actions">
        <a class="btn ghost" asp-controller="Dashboard" asp-action="Index">Back to dashboard</a>
    </div>
</div>

<div class="fade d2" style="display:grid;gap:16px">
    <div>
        <div class="card">
            <div class="card-head">
                <div class="card-title">Filters</div>
            </div>
            <div style="padding:4px 16px 16px">
                @if (!Model.Linkshells.Any())
                {
                    <div class="empty">Join a linkshell to unlock DKP History.</div>
                }
                else
                {
                    <form method="get">
                        <div class="field">
                            <label for="appUserId">Member</label>
                            <select class="form-select" id="appUserId" name="appUserId">
                                @foreach (var member in Model.Members)
                                {
                                    @if (Model.SelectedAppUserId == member.AppUserId)
                                    {
                                        <option value="@member.AppUserId" selected>@member.CharacterName (@member.CurrentBalance.ToString("0.##") DKP)</option>
                                    }
                                    else
                                    {
                                        <option value="@member.AppUserId">@member.CharacterName (@member.CurrentBalance.ToString("0.##") DKP)</option>
                                    }
                                }
                            </select>
                        </div>
                    </form>

                    <div style="margin-top:16px;padding-top:12px;border-top:1px solid var(--border);display:grid;grid-template-columns:110px 1fr;gap:8px 12px;font-size:13px">
                        <div style="color:var(--fg-3)">Member</div><div>@Model.SelectedMemberName</div>
                        <div style="color:var(--fg-3)">Balance</div><div class="num" style="font-weight:600">@Model.CurrentBalance.ToString("0.##")</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div>
        <div class="card">
            <div class="card-head">
                <div class="card-title">Ledger <span class="tag">@Model.TotalEntryCount</span></div>
                @if (Model.Entries.Any())
                {
                    <input type="search" id="ledgerSearch" class="form-control" placeholder="Search ledger…"
                           autocomplete="off" style="max-width:260px" />
                }
            </div>
            @if (!Model.Entries.Any())
            {
                <div class="empty">No DKP transactions recorded for this member yet.</div>
            }
            else
            {
                <table class="table themed" id="ledgerTable">
                    <thead>
                        <tr>
                            <th>When</th>
                            <th>Entry</th>
                            <th>Event</th>
                            <th>Details</th>
                            <th style="text-align:right">Amount</th>
                            <th style="text-align:right">Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.Entries)
                        {
                            // Tag classification: "LootSpent" + auction/event flat-spend types are
                            // negative debits; loot-edit pair surfaces with a distinct "Edited" tag
                            // so officers can see at a glance which entries came from a correction.
                            var isLootEditRefund = entry.EntryType == "LootEditRefund";
                            var isLootEditSpent = entry.EntryType == "LootEditSpent";
                            var isLootDeleteRefund = entry.EntryType == "LootDeleteRefund";
                            var isLootEdit = isLootEditRefund || isLootEditSpent;
                            var isSpent = entry.Amount < 0;
                            var amountColor = entry.Amount >= 0 ? "var(--success)" : "var(--danger)";
                            <tr>
                                <td style="font-size:12px;color:var(--fg-3)">@(entry.OccurredAt?.ToString("g") ?? "—")</td>
                                <td>
                                    @if (isLootEditRefund)
                                    {
                                        <span class="tag" title="Refund applied during a loot edit">Edit refund</span>
                                    }
                                    else if (isLootEditSpent)
                                    {
                                        <span class="tag warn" title="New debit applied during a loot edit">Edit spend</span>
                                    }
                                    else if (isLootDeleteRefund)
                                    {
                                        <span class="tag" title="Refund applied when a loot record was deleted">Delete refund</span>
                                    }
                                    else if (isSpent)
                                    {
                                        <span class="tag danger">Spent</span>
                                    }
                                    else
                                    {
                                        <span class="tag success">Earned</span>
                                    }
                                </td>
                                <td>
                                    <div style="font-weight:500">@(entry.EventName ?? "Unknown event")</div>
                                    <div style="color:var(--fg-4);font-size:11px">
                                        @(entry.EventType ?? "Event") · @(entry.EventLocation ?? "—")
                                    </div>
                                    @if (entry.EventStartTime.HasValue || entry.EventEndTime.HasValue)
                                    {
                                        <div style="color:var(--fg-4);font-size:11px">@(entry.EventStartTime?.ToString("g") ?? "—") → @(entry.EventEndTime?.ToString("g") ?? "—")</div>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(entry.ItemName))
                                    {
                                        <div style="font-weight:500">@entry.ItemName</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(entry.Details))
                                    {
                                        <div style="color:var(--fg-4);font-size:11px">@entry.Details</div>
                                    }
                                    @if (isLootEdit && !string.IsNullOrWhiteSpace(entry.EditReason))
                                    {
                                        <div style="color:var(--fg-3);font-size:11px;font-style:italic;margin-top:2px">Reason: @entry.EditReason</div>
                                    }
                                </td>
                                <td style="text-align:right;font-family:var(--font-mono);color:@amountColor">@entry.Amount.ToString("+0.##;-0.##;0")</td>
                                <td style="text-align:right;font-family:var(--font-mono)" class="num">@entry.RunningBalance.ToString("0.##")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="empty" id="ledgerNoResults" hidden>No entries match your search.</div>
                <div class="pagination-bar" id="ledgerPagination" hidden>
                    <div class="pagination-bar__summary" id="ledgerPageSummary"></div>
                    <div class="pagination-bar__actions" id="ledgerPageActions"></div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script nonce="@Html.CspNonce()">
        (function () {
            // Member filter: reload the ledger for the picked member. Wired here
            // (not via inline onchange) because the CSP is nonce-locked and blocks
            // inline event-handler attributes. Runs before the table early-return
            // below so it works even when the current member has no entries.
            var memberSelect = document.getElementById('appUserId');
            if (memberSelect) {
                memberSelect.addEventListener('change', function () {
                    if (memberSelect.form) { memberSelect.form.submit(); }
                });
            }

            var PAGE_SIZE = 10;
            var searchInput = document.getElementById('ledgerSearch');
            var table = document.getElementById('ledgerTable');
            var pagination = document.getElementById('ledgerPagination');
            var summary = document.getElementById('ledgerPageSummary');
            var actions = document.getElementById('ledgerPageActions');
            var noResults = document.getElementById('ledgerNoResults');
            if (!table) { return; }

            var rows = Array.prototype.slice.call(table.querySelectorAll('tbody > tr'));
            var page = 1;
            var term = '';

            function filtered() {
                if (!term) { return rows; }
                return rows.filter(function (r) {
                    return (r.textContent || '').toLowerCase().indexOf(term) !== -1;
                });
            }

            function makeBtn(label, targetPage, opts) {
                opts = opts || {};
                var b = document.createElement('button');
                b.type = 'button';
                b.className = 'btn sm ' + (opts.primary ? 'primary' : 'ghost') + (opts.disabled ? ' disabled' : '');
                b.textContent = label;
                if (opts.disabled) {
                    b.disabled = true;
                } else {
                    b.addEventListener('click', function () { page = targetPage; render(); });
                }
                return b;
            }

            function render() {
                var list = filtered();
                var totalPages = Math.max(1, Math.ceil(list.length / PAGE_SIZE));
                if (page > totalPages) { page = totalPages; }
                if (page < 1) { page = 1; }

                rows.forEach(function (r) { r.style.display = 'none'; });
                var start = (page - 1) * PAGE_SIZE;
                list.slice(start, start + PAGE_SIZE).forEach(function (r) { r.style.display = ''; });

                if (noResults) { noResults.hidden = list.length !== 0; }

                if (!pagination) { return; }
                if (list.length <= PAGE_SIZE) {
                    pagination.hidden = true;
                    summary.textContent = '';
                    actions.innerHTML = '';
                    return;
                }
                pagination.hidden = false;
                summary.innerHTML = 'Page <span class="num">' + page + '</span> of <span class="num">' + totalPages + '</span>';
                actions.innerHTML = '';
                actions.appendChild(makeBtn('Previous', page - 1, { disabled: page <= 1 }));
                for (var p = 1; p <= totalPages; p++) {
                    actions.appendChild(makeBtn(String(p), p, { primary: p === page }));
                }
                actions.appendChild(makeBtn('Next', page + 1, { disabled: page >= totalPages }));
            }

            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    term = (searchInput.value || '').trim().toLowerCase();
                    page = 1;
                    render();
                });
            }

            render();
        })();
    </script>
}

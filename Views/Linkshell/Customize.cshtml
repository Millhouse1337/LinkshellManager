@model LinkshellCustomizeViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Customize Linkshell";
    ViewData["BodyClass"] = "lsm-page";
    var savedMessage = TempData["CustomizeSaved"] as string;
    var errorMessage = TempData["CustomizeError"] as string;
    var antiforgeryTokens = Antiforgery.GetAndStoreTokens(Context);
    var canManageRolesValue = Model.CanManageRoles.ToString().ToLowerInvariant();
    // Only greet a fresh arrival with the "Which linkshell?" modal. Suppress it
    // on reloads we caused ourselves: after a save (saved/error message / POST
    // re-render) or a linkshell switch (?switched=1).
    var skipEntryModal = !string.IsNullOrEmpty(savedMessage)
        || !string.IsNullOrEmpty(errorMessage)
        || string.Equals(Context.Request.Method, "POST", StringComparison.OrdinalIgnoreCase)
        || Context.Request.Query.ContainsKey("switched");
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Customize Linkshell</h1>
        <div class="page-sub">
            @if (Model.ManageableLinkshells.Count > 0 && !string.IsNullOrWhiteSpace(Model.LinkshellName))
            {
                <span>@Model.LinkshellName</span>
            }
            else
            {
                <span>Settings</span>
            }
        </div>
    </div>
    <div class="page-actions">
        <a class="btn ghost" asp-controller="Linkshell" asp-action="Index">Back to linkshells</a>
    </div>
</div>

@if (Model.ManageableLinkshells.Count == 0)
{
    <div class="card fade d2">
        <div class="empty">
            <div style="padding:32px 16px;text-align:center;color:var(--fg-3)">
                You're not a Leader or Officer in any linkshell, so there's nothing here to customize yet.
            </div>
        </div>
    </div>
    return;
}

@if (!string.IsNullOrEmpty(savedMessage))
{
    <div class="alert alert-success fade d2" style="margin-bottom:16px">@savedMessage</div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger fade d2" style="margin-bottom:16px">@errorMessage</div>
}

<div class="card fade d2" style="margin-bottom:16px">
    <div class="card-head">
        <div class="card-title">Linkshell</div>
    </div>
    <form method="get" asp-action="Customize" style="padding:12px 16px;display:flex;gap:8px;align-items:center;flex-wrap:wrap">
        <select class="form-select" name="id" style="min-width:240px;flex:1 1 240px">
            @foreach (var linkshell in Model.ManageableLinkshells)
            {
                if (linkshell.Id == Model.LinkshellId)
                {
                    <option value="@linkshell.Id" selected>@linkshell.LinkshellName</option>
                }
                else
                {
                    <option value="@linkshell.Id">@linkshell.LinkshellName</option>
                }
            }
        </select>
        @* Tells the reloaded page this was a deliberate switch, so the
           "Which linkshell?" modal stays closed. *@
        <input type="hidden" name="switched" value="1" />
        <button class="btn primary sm" type="submit" style="white-space:nowrap">Switch Linkshell</button>
    </form>
</div>

<form asp-action="Customize" method="post" class="fade d2" id="customizeForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="LinkshellId" />

    <div class="card" style="margin-bottom:16px">
        <div class="card-head">
            <div class="card-title">Linkshell Type</div>
        </div>
        <div style="padding:8px 16px 16px;display:flex;flex-direction:column;gap:10px">
            <div style="font-size:12px;color:var(--fg-3)">Tells the addon and website which content this linkshell runs.</div>
            <label style="display:flex;gap:10px;align-items:flex-start">
                <input type="radio" asp-for="LinkshellType" value="SkySeaDynamis" />
                <span>
                    <strong>Sky/Sea/Dynamis etc..</strong>
                    <div style="color:var(--fg-3);font-size:12px">Timed-event experience only. Addon shows Create Event, timed presets, Queued &amp; Active events. No HNM presets; website hides the Attendance / Window Events nav.</div>
                </span>
            </label>
            <label style="display:flex;gap:10px;align-items:flex-start">
                <input type="radio" asp-for="LinkshellType" value="HnmOnly" />
                <span>
                    <strong>HNM Only</strong>
                    <div style="color:var(--fg-3);font-size:12px">HNM snapshot sessions only. Addon hides Create Event, Queued &amp; Active, and shows only HNM presets. Website hides the Event System nav.</div>
                </span>
            </label>
            <label style="display:flex;gap:10px;align-items:flex-start">
                <input type="radio" asp-for="LinkshellType" value="Both" />
                <span>
                    <strong>Both</strong>
                    <div style="color:var(--fg-3);font-size:12px">Everything — timed events and HNM. Default.</div>
                </span>
            </label>
            <div style="display:flex;justify-content:flex-end;margin-top:8px">
                <button class="btn primary" type="submit">Save changes</button>
            </div>
        </div>
    </div>

    <div class="card" style="margin-bottom:16px">
        <div class="card-head">
            <div class="card-title">Loot Structure</div>
        </div>
        <div style="padding:8px 16px 16px;display:flex;flex-direction:column;gap:14px">
            <div style="display:flex;gap:32px;flex-wrap:wrap;align-items:flex-start">
                <div style="flex:1 1 300px;display:flex;flex-direction:column;gap:10px">
                    <div style="font-size:12px;color:var(--fg-3)">Choose how loot is awarded for this linkshell.</div>
                    <label style="display:flex;gap:10px;align-items:flex-start">
                        <input type="radio" asp-for="LootStructure" value="Dkp" id="loot-dkp" />
                        <span>
                            <strong>DKP</strong>
                            <div style="color:var(--fg-3);font-size:12px">Time-based DKP earned per event, spent on loot.</div>
                        </span>
                    </label>
                    <label style="display:flex;gap:10px;align-items:flex-start">
                        <input type="radio" asp-for="LootStructure" value="LootCouncil" id="loot-council" />
                        <span>
                            <strong>Loot Council</strong>
                            <div style="color:var(--fg-3);font-size:12px">Leader decides; DKP is not tracked.</div>
                        </span>
                    </label>
                    <label style="display:flex;gap:10px;align-items:flex-start">
                        <input type="radio" asp-for="LootStructure" value="Hybrid" id="loot-hybrid" />
                        <span>
                            <strong>Percentage Based</strong>
                            <div style="color:var(--fg-3);font-size:12px">DKP earned as usual; loot deducts a percentage of the winner's balance.</div>
                        </span>
                    </label>

                    <div id="dkp-rounding-row" style="display:flex;flex-direction:column;gap:4px;max-width:320px;margin-top:8px">
                        <label asp-for="DkpRoundingIncrement">DKP rounding increment</label>
                        <select class="form-select" asp-for="DkpRoundingIncrement">
                            <option value="Quarter">Nearest Quarter (0.25)</option>
                            <option value="Half">Nearest Half (0.5)</option>
                        </select>
                    </div>
                </div>

                <div style="flex:1 1 360px;display:flex;flex-direction:column;gap:8px;border-left:1px solid var(--border);padding-left:32px">
                    <div class="card-title" style="font-size:14px">Feature Toggles</div>
                    <div style="font-size:12px;color:var(--fg-3)">Hide sections your linkshell doesn't use.</div>
                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:6px 16px">
                        <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" class="switch" asp-for="EnableEndgame" /> Endgame tab</label>
                        <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" class="switch" asp-for="EnableHnmSection" /> HNM tab</label>
                        <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" class="switch" asp-for="EnableMissions" /> Missions tab</label>
                        <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" class="switch" asp-for="EnableAuctions" /> Auctions tab</label>
                        <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" class="switch" asp-for="EnableToDs" /> ToDs tab</label>
                        <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" class="switch" asp-for="EnableEvents" /> Events tab</label>
                        <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" class="switch" asp-for="EnableDkp" /> DKP tab</label>
                        <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" class="switch" asp-for="EnableItems" /> Items tile on dashboard</label>
                        <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" class="switch" asp-for="EnableRevenue" /> Revenue tile on dashboard</label>
                    </div>
                </div>
            </div>

            <div style="display:flex;justify-content:flex-end;border-top:1px solid var(--border);padding-top:14px">
                <button class="btn primary" type="submit">Save changes</button>
            </div>
        </div>
    </div>

    <div class="card" style="margin-bottom:16px">
        <div class="card-head">
            <div class="card-title">Hide ToD Mobs</div>
        </div>
        <div style="padding:12px 16px;display:flex;flex-direction:column;gap:10px">
            <div style="font-size:12px;color:var(--fg-3)">Toggle a monster on to hide it from the Tracked Windows panel on the Dashboard and ToDs tab.</div>
            @{
                var hiddenSet = new HashSet<string>(Model.HiddenTodMonsters ?? new List<string>(), StringComparer.OrdinalIgnoreCase);
            }
            @foreach (var group in LinkshellManagerDiscordApp.ViewModels.LinkshellCustomizeViewModel.TodMonsterGroups)
            {
                <details style="border:1px solid var(--border);border-radius:8px;background:var(--surface)">
                    <summary style="cursor:pointer;padding:8px 12px;font-weight:600;font-size:13px">@group.Label</summary>
                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:6px 16px;padding:8px 12px 12px">
                        @foreach (var name in group.Names)
                        {
                            <label style="display:flex;gap:8px;align-items:center">
                                <input type="checkbox" class="switch" name="HiddenTodMonsters" value="@name" checked="@hiddenSet.Contains(name)" />
                                @name
                            </label>
                        }
                    </div>
                </details>
            }
            <div style="display:flex;justify-content:flex-end;border-top:1px solid var(--border);padding-top:14px">
                <button class="btn primary" type="submit">Save changes</button>
            </div>
        </div>
    </div>

    <div class="card" style="margin-bottom:16px">
        <div class="card-head">
            <div class="card-title">Discord Integration</div>
        </div>
        <div style="padding:8px 16px 16px;display:flex;flex-direction:column;gap:10px">
            <div style="font-size:12px;color:var(--fg-3)">
                Add as many channels as you like and give each one a name, then tick what each
                channel should receive. In Discord: Channel Settings &rarr; Integrations &rarr;
                Webhooks &rarr; New Webhook &rarr; Copy URL.
            </div>
            <div id="discordWebhookRows" style="display:flex;flex-direction:column;gap:10px;max-width:680px">
                @for (var i = 0; i < Model.DiscordWebhooks.Count; i++)
                {
                    <div class="discord-webhook-row" style="display:flex;gap:8px;align-items:flex-start">
                        <div style="display:flex;flex-direction:column;gap:4px;width:170px">
                            <input class="input" type="text" data-field="Name" name="DiscordWebhooks[@i].Name"
                                   value="@Model.DiscordWebhooks[i].Name" placeholder="Name (e.g. Main LS)"
                                   maxlength="64" autocomplete="off" />
                        </div>
                        <div style="display:flex;flex-direction:column;gap:4px;flex:1">
                            <input class="input" type="url" data-field="Url" name="DiscordWebhooks[@i].Url"
                                   value="@Model.DiscordWebhooks[i].Url"
                                   placeholder="https://discord.com/api/webhooks/..." autocomplete="off" />
                            @Html.ValidationMessage($"DiscordWebhooks[{i}].Url", new { @class = "text-danger", style = "font-size:12px" })
                        </div>
                        @{
                            var wh = Model.DiscordWebhooks[i];
                            var selectedPurpose = !string.IsNullOrEmpty(wh.Purpose)
                                ? wh.Purpose!
                                : DiscordWebhookInput.PurposeFor(
                                    wh.PostAttendanceSnapshot, wh.PostTodBoard, wh.PostDkpSpendLog, wh.PostAuctions);
                        }
                        <select class="input" data-field="Purpose" name="DiscordWebhooks[@i].Purpose"
                                style="width:170px;margin-top:0"
                                title="What this channel receives">
                            <option value="@DiscordWebhookInput.PurposeNone"
                                    selected="@(selectedPurpose == DiscordWebhookInput.PurposeNone)">— No posts —</option>
                            <option value="@DiscordWebhookInput.PurposeDkpTracking"
                                    selected="@(selectedPurpose == DiscordWebhookInput.PurposeDkpTracking)">DKP Tracking</option>
                            <option value="@DiscordWebhookInput.PurposePopTracker"
                                    selected="@(selectedPurpose == DiscordWebhookInput.PurposePopTracker)">Pop Tracker</option>
                            <option value="@DiscordWebhookInput.PurposeSpentPoints"
                                    selected="@(selectedPurpose == DiscordWebhookInput.PurposeSpentPoints)">Spent Points</option>
                            <option value="@DiscordWebhookInput.PurposeAuctions"
                                    selected="@(selectedPurpose == DiscordWebhookInput.PurposeAuctions)">Auctions</option>
                        </select>
                        <button type="button" class="btn ghost sm discord-webhook-remove"
                                style="margin-top:5px" title="Remove this webhook">Remove</button>
                    </div>
                }
            </div>
            <div>
                <button type="button" class="btn ghost sm" id="discordWebhookAdd">+ Add webhook</button>
            </div>
            <span style="color:var(--fg-3);font-size:12px">
                Clear a row's URL (or Remove it) and save to delete that webhook. No webhooks = Discord posting disabled.
                Each channel receives one thing — pick it from the dropdown.
                <strong>DKP Tracking</strong> posts each <code>/lsm now</code> attendance snapshot
                (party-grouped embed) to that channel.
                <strong>Pop Tracker</strong> keeps a single, always-current ToD list in that channel
                (one message that's edited in place whenever a ToD changes — never re-posted).
                <strong>Spent Points</strong> posts every DKP spend (auction win, loot-edit, adjustment)
                to that channel as it happens — one embed per batch of spends.
                <strong>Auctions</strong> posts an embed when an auction opens and another with the
                final results when it closes.
            </span>
            <div style="display:flex;justify-content:flex-end;margin-top:8px">
                <button class="btn primary" type="submit">Save changes</button>
            </div>
        </div>
    </div>

</form>

<!-- Discord Server Lock. Standalone card (its own POST forms) so it isn't tied
     to the main customize save. Mirrors the Activity's "Lock to this server". -->
<div class="card fade d2" id="discordLockCard" style="margin-bottom:16px">
    <div class="card-head">
        <div class="card-title">Discord Server Lock</div>
    </div>
    <div style="padding:8px 16px 16px;display:flex;flex-direction:column;gap:12px;max-width:560px">
        <div style="font-size:12px;color:var(--fg-3)">
            Lock this linkshell to a single Discord server. While locked, only members of that
            server can open the linkshell in the Discord Activity. This matches the Activity's
            <strong>Lock to this server</strong> control.
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.LockedToDiscordGuildId))
        {
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                <span class="tag success">Locked</span>
                <span style="font-size:13px;color:var(--fg-2)">
                    Currently locked to
                    <strong>@(string.IsNullOrWhiteSpace(Model.LockedToDiscordGuildName) ? Model.LockedToDiscordGuildId : Model.LockedToDiscordGuildName)</strong>
                </span>
            </div>
            <form method="post" asp-action="UnlockGuild" class="lsm-confirm-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="linkshellId" value="@Model.LinkshellId" />
                <button class="btn warn sm" type="submit">Remove lock</button>
            </form>
        }
        else
        {
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                <span class="tag">Not locked</span>
                <span style="font-size:13px;color:var(--fg-3)">Any member can open this linkshell from any server.</span>
            </div>
        }

        <form method="post" asp-action="LockGuild" class="lsm-confirm-form"
              style="display:flex;flex-direction:column;gap:8px;border-top:1px solid var(--border);padding-top:12px">
            @Html.AntiForgeryToken()
            <input type="hidden" name="linkshellId" value="@Model.LinkshellId" />
            @if (Model.EligibleGuilds.Count > 0)
            {
                <div class="field">
                    <label for="lockGuildSelect">Server</label>
                    <select class="form-select" id="lockGuildSelect" name="guildId" style="width:100%">
                        @foreach (var guild in Model.EligibleGuilds)
                        {
                            <option value="@guild.Id" selected="@(guild.Id == Model.LockedToDiscordGuildId)">@guild.Name</option>
                        }
                    </select>
                </div>
                <div style="font-size:12px;color:var(--fg-3)">Servers where you and the LSM bot are both members.</div>
            }
            else
            {
                <div class="field">
                    <label for="lockGuildInput">Discord server ID</label>
                    <input class="input" id="lockGuildInput" type="text" name="guildId"
                           inputmode="numeric" pattern="[0-9]*" maxlength="20" autocomplete="off"
                           placeholder="e.g. 123456789012345678" />
                </div>
                <div style="font-size:12px;color:var(--fg-3)">
                    No servers found automatically. Make sure the LSM bot is in your server, then enter its
                    numeric ID (in Discord, with Developer Mode on, right-click the server &rarr; Copy Server ID).
                </div>
            }
            <div>
                <button class="btn primary" type="submit">
                    @(string.IsNullOrWhiteSpace(Model.LockedToDiscordGuildId) ? "Lock to this server" : "Change locked server")
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Discord Channels (Phase 2): the bot posts event/auction/loot announcements
     DIRECTLY to these channels so they can carry interactive sign-up buttons
     (unlike the webhook rows above, which Discord strips components from). -->
<div class="card fade d2" id="discordChannelsCard" style="margin-bottom:16px">
    <div class="card-head">
        <div class="card-title">Discord Channels (bot posts here)</div>
    </div>
    <div style="padding:8px 16px 16px;display:flex;flex-direction:column;gap:12px;max-width:640px">
        <div style="font-size:12px;color:var(--fg-3)">
            The LSM bot posts announcements here so members can sign up to a job right inside Discord.
            <strong>HENM</strong> events post to the HENM channel, <strong>KSNM</strong> to the KSNM channel,
            and everything else to <strong>Other events</strong>. Requires the bot to be in your server with
            permission to send messages in the chosen channels.
        </div>

        @if (string.IsNullOrWhiteSpace(Model.DiscordChannelGuildId))
        {
            <div style="font-size:12px;color:var(--fg-3)">
                Tip: lock this linkshell to a Discord server (above) so the bot can list your channels in a
                dropdown. You can still paste channel IDs manually below.
            </div>
        }
        else if (Model.AvailableChannels.Count == 0)
        {
            <div style="font-size:12px;color:var(--fg-3)">
                Couldn't list channels automatically (make sure the LSM bot is in your server). Paste channel
                IDs manually below — in Discord, with Developer Mode on, right-click a channel &rarr; Copy Channel ID.
            </div>
        }

        <form method="post" asp-action="SaveDiscordChannels" class="lsm-confirm-form"
              style="display:flex;flex-direction:column;gap:10px">
            @Html.AntiForgeryToken()
            <input type="hidden" name="linkshellId" value="@Model.LinkshellId" />
            @foreach (var row in Model.DiscordChannels)
            {
                <div class="field">
                    <label>@row.Label</label>
                    @if (Model.AvailableChannels.Count > 0)
                    {
                        <select class="form-select" name="channelIds[@row.Purpose]">
                            <option value="">— none —</option>
                            @foreach (var channel in Model.AvailableChannels)
                            {
                                <option value="@channel.Id" selected="@(channel.Id == row.ChannelId)">#@channel.Name</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input class="input" type="text" name="channelIds[@row.Purpose]" value="@row.ChannelId"
                               inputmode="numeric" pattern="[0-9]*" maxlength="20" autocomplete="off"
                               placeholder="Channel ID (or leave blank)" />
                    }
                </div>
            }
            <div>
                <button class="btn primary" type="submit">Save channels</button>
            </div>
        </form>
    </div>
</div>

<script nonce="@Html.CspNonce()">
    (function () {
        var rows = document.getElementById('discordWebhookRows');
        var addBtn = document.getElementById('discordWebhookAdd');
        if (!rows || !addBtn) { return; }

        // Renumber every row's bound fields (by data-field) so the model
        // binder sees a contiguous DiscordWebhooks[0..n] collection after
        // add/remove. Covers Name, Url and the Purpose <select>.
        function reindex() {
            var list = rows.querySelectorAll('.discord-webhook-row');
            for (var i = 0; i < list.length; i++) {
                list[i].querySelectorAll('[data-field]').forEach(function (el) {
                    var f = el.getAttribute('data-field');
                    var prop = /Hidden$/.test(f) ? f.replace(/Hidden$/, '') : f;
                    el.setAttribute('name', 'DiscordWebhooks[' + i + '].' + prop);
                });
            }
        }

        // Reset a cloned row to empty so an added webhook starts blank.
        function resetRow(row) {
            row.querySelectorAll('input').forEach(function (input) {
                if (input.type === 'checkbox') { input.checked = false; }
                else { input.value = ''; }
            });
            // The Purpose dropdown back to its first option ("— No posts —").
            row.querySelectorAll('select').forEach(function (sel) { sel.selectedIndex = 0; });
            row.querySelectorAll('.text-danger').forEach(function (el) { el.textContent = ''; });
        }

        addBtn.addEventListener('click', function () {
            var first = rows.querySelector('.discord-webhook-row');
            if (!first) { return; }
            var clone = first.cloneNode(true);
            resetRow(clone);
            rows.appendChild(clone);
            reindex();
        });

        rows.addEventListener('click', function (evt) {
            var btn = evt.target.closest('.discord-webhook-remove');
            if (!btn) { return; }
            var list = rows.querySelectorAll('.discord-webhook-row');
            if (list.length > 1) {
                btn.closest('.discord-webhook-row').remove();
            } else {
                // Keep one row; clearing its URL + saving deletes the webhook.
                resetRow(list[0]);
            }
            reindex();
        });
    })();
</script>

<div class="card fade d2 permissions-config-card" id="permissionsConfigCard" style="margin-top:16px"
     data-linkshellid="@Model.LinkshellId"
     data-can-manage-roles="@canManageRolesValue"
     data-csrf-header="@antiforgeryTokens.HeaderName"
     data-csrf-token="@antiforgeryTokens.RequestToken">
    <div class="card-head">
        <div class="card-title">Permissions</div>
        <div class="page-actions">
            <span id="permissionsStatus" class="permissions-status">Loading roles...</span>
            @if (Model.CanManageRoles)
            {
                <button type="button" class="btn primary sm" id="permissionsNewRoleBtn" style="white-space:nowrap">+ New Role</button>
            }
        </div>
    </div>
    <div id="permissionsError" class="alert alert-danger permissions-error" style="display:none"></div>
    <div class="permissions-table-wrap" id="permissionsTableWrap">
        <div class="empty">Loading roles...</div>
    </div>

    @if (Model.CanManageRoles)
    {
        <form id="roleEditForm" class="role-edit-form" style="display:none">
            <div class="role-edit-form__header">
                <strong id="roleEditTitle">Edit role</strong>
                <button type="button" class="btn ghost sm" id="roleEditCancelBtn">Cancel</button>
            </div>
            <label class="field">
                <span>Role name</span>
                <input type="text" class="form-control" id="roleEditName" maxlength="64" required />
            </label>
            <div class="role-edit-form__permissions" id="rolePermissionFields"></div>
            <div class="role-edit-form__actions">
                <button type="submit" class="btn primary" id="roleEditSaveBtn">Save changes</button>
                <button type="button" class="btn ghost" id="roleEditCancelBtnBottom">Cancel</button>
            </div>
        </form>
    }
</div>


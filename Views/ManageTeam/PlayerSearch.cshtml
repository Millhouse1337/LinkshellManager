@model LinkshellManagerDiscordApp.ViewModels.ManageTeamViewModel
@{
    ViewData["Title"] = "Add members";
    var filter = string.IsNullOrWhiteSpace(Model.Filter) ? "all" : Model.Filter!.Trim().ToLowerInvariant();
    var selectedLinkshell = Model.Linkshells.FirstOrDefault(l => l.Id == Model.SelectedLinkshellId);
    var serverTied = !string.IsNullOrWhiteSpace(selectedLinkshell?.DiscordGuildId);
    var addMemberError = TempData["AddMemberError"] as string;
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Add members</h1>
        <div class="page-sub"><span>Browse players and add them straight to your linkshell</span></div>
    </div>
    <div class="page-actions">
        <a class="btn ghost" asp-action="Index">Back to team</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(addMemberError))
{
    <div class="card fade d1" style="margin-bottom:12px;border-color:var(--danger)">
        <div class="empty" style="color:var(--danger)">@addMemberError</div>
    </div>
}

<div class="card fade d2" style="padding:16px">
    @* GET so search/filter/linkshell are shareable + bookmarkable and paginate
       cleanly. Resets to page 1 on every new search. *@
    <form asp-action="SearchPlayers" method="get" class="form-grid"
          style="display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end">
        <div class="field" style="flex:1 1 220px">
            <label for="selectedLinkshellName">Linkshell</label>
            @* Locked here on purpose — the active linkshell is switched from the
               side nav or Customize Linkshell, never from this search form. The
               id still posts via the hidden field. *@
            <input type="text" id="selectedLinkshellName" class="form-control" readonly tabindex="-1"
                   aria-readonly="true"
                   title="Switch your active linkshell from the side nav or Customize Linkshell"
                   value="@(Model.Linkshells.FirstOrDefault(l => l.Id == Model.SelectedLinkshellId)?.LinkshellName ?? "Selected Linkshell")"
                   style="border-color:var(--danger);color:var(--danger);cursor:not-allowed;background:rgba(248,113,113,0.08)" />
            <input type="hidden" name="selectedLinkshellId" value="@Model.SelectedLinkshellId" />
        </div>
        <div class="field" style="flex:2 1 240px">
            <label for="search">Search players</label>
            <input id="search" name="search" class="form-control" value="@Model.SearchTerm"
                   placeholder="Character name or username" autocomplete="off" />
        </div>
        <div class="field" style="flex:1 1 160px">
            <label for="filter">Show</label>
            <select id="filter" name="filter" class="form-select">
                <option value="all" selected="@(filter == "all")">Everyone</option>
                <option value="unaffiliated" selected="@(filter == "unaffiliated")">No linkshell</option>
                <option value="affiliated" selected="@(filter == "affiliated")">Has a linkshell</option>
            </select>
        </div>
        <div class="field">
            <button type="submit" class="btn primary">Search</button>
        </div>
    </form>
</div>

<div class="card fade d3" style="margin-top:16px">
    <div class="card-head">
        <div class="card-title">Results</div>
        <div class="card-sub"><span class="num">@Model.TotalCount</span> eligible</div>
    </div>
    @if (Model.Candidates.Count == 0)
    {
        <div class="empty">
            <span>No eligible players match the current filters. Members, already-invited players, and (for a server-locked linkshell) non-members of that server are hidden.</span>
        </div>
    }
    else
    {
        <table class="table themed">
            <thead>
                <tr>
                    <th>Character</th>
                    <th>Current linkshell</th>
                    <th style="text-align:right">Add</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var candidate in Model.Candidates)
                {
                    <tr>
                        <td>
                            @candidate.DisplayName
                            @if (!string.IsNullOrWhiteSpace(candidate.UserName) && candidate.UserName != candidate.DisplayName)
                            {
                                <span class="muted" style="color:var(--fg-3);font-size:12px"> · @candidate.UserName</span>
                            }
                        </td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(candidate.PrimaryLinkshellName))
                            {
                                <span class="tag">Unaffiliated</span>
                            }
                            else
                            {
                                <span>@candidate.PrimaryLinkshellName</span>
                            }
                        </td>
                        <td style="text-align:right">
                            <form asp-action="SendInvite" method="post" style="display:inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="UserId" value="@candidate.Id" />
                                <input type="hidden" name="LinkshellId" value="@Model.SelectedLinkshellId" />
                                <input type="hidden" name="search" value="@Model.SearchTerm" />
                                <input type="hidden" name="filter" value="@filter" />
                                <input type="hidden" name="page" value="@Model.PageNumber" />
                                <button type="submit" class="btn primary sm">Add to linkshell</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.TotalPages > 1)
        {
            <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;padding:12px 16px">
                @if (Model.PageNumber > 1)
                {
                    <a class="btn ghost sm"
                       asp-action="SearchPlayers"
                       asp-route-selectedLinkshellId="@Model.SelectedLinkshellId"
                       asp-route-search="@Model.SearchTerm"
                       asp-route-filter="@filter"
                       asp-route-page="@(Model.PageNumber - 1)">Prev</a>
                }
                else
                {
                    <span></span>
                }
                <span class="muted" style="color:var(--fg-3);font-size:12px">
                    Page @Model.PageNumber of @Model.TotalPages · @Model.TotalCount eligible
                </span>
                @if (Model.PageNumber < Model.TotalPages)
                {
                    <a class="btn ghost sm"
                       asp-action="SearchPlayers"
                       asp-route-selectedLinkshellId="@Model.SelectedLinkshellId"
                       asp-route-search="@Model.SearchTerm"
                       asp-route-filter="@filter"
                       asp-route-page="@(Model.PageNumber + 1)">Next</a>
                }
                else
                {
                    <span></span>
                }
            </div>
        }
    }
</div>

@if (serverTied)
{
    <div class="card fade d3" style="margin-top:16px">
        <div class="card-head">
            <div class="card-title">From your Discord server</div>
            <div class="card-sub"><span class="num">@Model.DiscordRoster.Count</span> available</div>
        </div>
        @if (Model.DiscordRoster.Count == 0)
        {
            <div class="empty">
                <span>No one new to add — everyone in the server is already a member or invited. (If this looks wrong, make sure the LSM bot is in the server with the Server Members intent enabled.)</span>
            </div>
        }
        else
        {
            <table class="table themed">
                <thead>
                    <tr>
                        <th>Discord member</th>
                        <th>Account</th>
                        <th style="text-align:right">Add</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var candidate in Model.DiscordRoster)
                    {
                        <tr>
                            <td>
                                <span style="display:inline-flex;align-items:center;gap:8px">
                                    @if (!string.IsNullOrWhiteSpace(candidate.AvatarUrl))
                                    {
                                        <img src="@candidate.AvatarUrl" alt="" width="24" height="24" style="border-radius:50%;display:block" />
                                    }
                                    <span>@candidate.DisplayName</span>
                                </span>
                            </td>
                            <td>
                                @if (candidate.HasAccount)
                                {
                                    <span class="tag">Has account</span>
                                }
                                else
                                {
                                    <span class="muted" style="color:var(--fg-3);font-size:12px">New · joins on first sign-in</span>
                                }
                            </td>
                            <td style="text-align:right">
                                <form asp-action="AddDiscordMember" method="post" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="linkshellId" value="@Model.SelectedLinkshellId" />
                                    <input type="hidden" name="discordUserId" value="@candidate.DiscordUserId" />
                                    <input type="hidden" name="search" value="@Model.SearchTerm" />
                                    <input type="hidden" name="filter" value="@filter" />
                                    <input type="hidden" name="page" value="@Model.PageNumber" />
                                    <button type="submit" class="btn primary sm">@(candidate.HasAccount ? "Add to linkshell" : "Invite")</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

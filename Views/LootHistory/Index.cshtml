@model LinkshellManagerDiscordApp.ViewModels.LootHistoryIndexViewModel
@{
    ViewData["Title"] = "Loot History";
    ViewData["BodyClass"] = "lsm-page";
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Loot History</h1>
        <div class="page-sub">
            <span>All recorded loot</span>
            @if (!string.IsNullOrWhiteSpace(Model.SelectedLinkshellName))
            {
                <span>·</span>
                <span>@Model.SelectedLinkshellName</span>
            }
        </div>
    </div>
    <div class="page-actions">
        <a class="btn ghost" asp-controller="Dashboard" asp-action="Index">Back to dashboard</a>
    </div>
</div>

@if (TempData["LootHistoryMessage"] is string flash && !string.IsNullOrWhiteSpace(flash))
{
    <div class="card fade d1" style="border:1px solid var(--accent);padding:12px 14px;margin-bottom:12px">
        <div style="color:var(--fg);font-size:14px">@flash</div>
    </div>
}

<div class="fade d2" style="display:grid;gap:16px">
    <div>
        <div class="card">
            <div class="card-head">
                <div class="card-title">Filters</div>
            </div>
            <div style="padding:4px 16px 16px">
                <div class="field" style="margin:0">
                    <label for="q">Search loot</label>
                    <input class="form-control" id="q" name="q" value="@Model.QueryFilter"
                           maxlength="64" autocomplete="off"
                           placeholder="Filter by winner or item name…" />
                    <div class="muted" style="font-size:11px;margin-top:6px">
                        Matches a winner's name or an item name as you type — no button needed.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div>
        <div class="card">
            <div class="card-head" style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
                <div class="card-title">Loot entries <span class="tag">@Model.TotalCount</span></div>
            </div>
            @if (Model.SelectedLinkshellId is null || Model.SelectedLinkshellId == 0)
            {
                <div class="empty">Join a linkshell to view Loot History.</div>
            }
            else if (!Model.Entries.Any())
            {
                <div class="empty">No loot records match the current filters.</div>
            }
            else
            {
                <table class="table themed">
                    <thead>
                        <tr>
                            <th>When</th>
                            <th>Source</th>
                            <th>Context</th>
                            <th>Item</th>
                            <th>Winner</th>
                            <th class="num">DKP</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.Entries)
                        {
                            <tr>
                                <td>@(entry.OccurredAt?.ToString("g") ?? "—")</td>
                                <td>
                                    @if (entry.Source == "Tod")
                                    {
                                        <span class="tag default">ToD</span>
                                    }
                                    else
                                    {
                                        <span class="tag accent">Event</span>
                                    }
                                </td>
                                <td>@(entry.Context ?? "—")</td>
                                <td>@(entry.ItemName ?? "—")</td>
                                <td>@(entry.ItemWinner ?? "—")</td>
                                <td class="num">@(entry.WinningDkpSpent?.ToString() ?? "—")</td>
                                <td>
                                    @if (entry.IsEdited)
                                    {
                                        <span class="tag warn" title="@entry.LastEditReason">
                                            Edited
                                            @if (!string.IsNullOrWhiteSpace(entry.EditedByCharacterName))
                                            {
                                                @:by @entry.EditedByCharacterName
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="muted" style="font-size:11px">—</span>
                                    }
                                </td>
                                <td>
                                    @if (Model.CanEdit)
                                    {
                                        var editAction = entry.Source == "Tod" ? "EditTod" : "EditEvent";
                                        var deleteAction = entry.Source == "Tod" ? "DeleteTod" : "DeleteEvent";
                                        // Plain text in data-confirm (Razor HTML-encodes it). The
                                        // confirm() guard is wired in the nonce'd script below because
                                        // CSP is nonce-only — inline onsubmit handlers are blocked.
                                        var confirmText = $"Delete this loot record?\n\n{entry.ItemName ?? "(item)"} -> {entry.ItemWinner ?? "(winner)"} ({(entry.WinningDkpSpent?.ToString() ?? "0")} DKP)\n\nThe winner will be refunded the DKP this loot spent. This cannot be undone.";
                                        <div style="display:flex;gap:6px;justify-content:flex-end">
                                            <a class="btn sm" asp-action="@editAction" asp-route-lootDetailId="@entry.LootDetailId">Edit</a>
                                            <form method="post" asp-action="@deleteAction" asp-route-lootDetailId="@entry.LootDetailId"
                                                  style="display:inline" data-confirm="@confirmText">
                                                <button type="submit" class="btn sm danger-outline">Delete</button>
                                            </form>
                                        </div>
                                    }
                                </td>
                            </tr>
                            @if (entry.IsEdited && !string.IsNullOrWhiteSpace(entry.LastEditReason))
                            {
                                <tr>
                                    <td colspan="8" style="padding-top:0;color:var(--fg-3);font-size:11px;font-style:italic">
                                        Reason: @entry.LastEditReason
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                @if (Model.TotalPages > 1)
                {
                    <div style="display:flex;align-items:center;gap:8px;padding:12px 16px;border-top:1px solid var(--border)">
                        @if (Model.PageNumber > 1)
                        {
                            <a class="btn sm" asp-action="Index"                               asp-route-q="@Model.QueryFilter"
                               asp-route-page="@(Model.PageNumber - 1)">Prev</a>
                        }
                        <span class="muted" style="font-size:12px">Page @Model.PageNumber of @Model.TotalPages</span>
                        @if (Model.PageNumber < Model.TotalPages)
                        {
                            <a class="btn sm" asp-action="Index"                               asp-route-q="@Model.QueryFilter"
                               asp-route-page="@(Model.PageNumber + 1)">Next</a>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

<script nonce="@Html.CspNonce()">
    (function () {
        var q = document.getElementById('q');

        // Live filtering without an "Apply" button: rebuild the query string
        // and navigate. A normal GET keeps server-side paging correct, and
        // omitting `page` resets to page 1 whenever the filter changes.
        // (No <form> wrapper — the per-row delete forms can't be nested.)
        function applyFilters() {
            var params = new URLSearchParams();
            var qv = q ? q.value.trim() : '';
            if (qv) { params.set('q', qv); }
            var qs = params.toString();
            window.location.href = window.location.pathname + (qs ? ('?' + qs) : '');
        }

        var timer = null;
        if (q) {
            q.addEventListener('input', function () {
                if (timer) { clearTimeout(timer); }
                timer = setTimeout(applyFilters, 400);
            });
            q.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    if (timer) { clearTimeout(timer); timer = null; }
                    applyFilters();
                }
            });
            // Keep typing smooth across the reload: re-focus the box and put
            // the caret at the end when it came back with a value.
            if (q.value) {
                q.focus();
                var v = q.value; q.value = ''; q.value = v;
            }
        }
        // CSP is nonce-only (no inline handlers), so the delete confirmation
        // is wired here rather than via an onsubmit attribute. Capture phase
        // so it runs before the form's default submit.
        document.addEventListener('submit', function (e) {
            var f = e.target;
            if (f && f.matches && f.matches('form[data-confirm]')) {
                if (!window.confirm(f.getAttribute('data-confirm'))) {
                    e.preventDefault();
                }
            }
        }, true);
    })();
</script>

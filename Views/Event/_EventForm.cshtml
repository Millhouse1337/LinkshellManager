@model EventViewModel
@{
    // Mirror the Discord Activity's eventTypeOptions list exactly so both UIs pick from
    // the same vocabulary. "Other" is appended in the markup and reveals a free-text input.
    var currentEventType = Model.Event.EventType ?? string.Empty;
    // "HNM" events are created automatically by the in-game addon (never by hand), so
    // it's not offered as a manual create option. Keep it selectable only when editing
    // an existing HNM event so its type still displays and round-trips on save.
    var eventTypeOptions = new List<string> { "Sky", "Sea", "HENM", "Limbus", "Dynamis", "BCNM", "KSNM" };
    // HNM signup boards are roster-only / no-DKP. Offer "HNM" as a create option when the
    // linkshell has opted into HNM Outside Sign Up (parity with the Discord Activity). Always
    // keep it selectable when editing an existing HNM event so its type round-trips on save.
    if ((Model.HnmOutsideSignupEnabled
            || string.Equals(currentEventType, "HNM", StringComparison.OrdinalIgnoreCase))
        && !eventTypeOptions.Contains("HNM"))
    {
        eventTypeOptions.Insert(2, "HNM");
    }
    var isHnmEvent = string.Equals(currentEventType, "HNM", StringComparison.OrdinalIgnoreCase);
    var isKnownEventType = eventTypeOptions.Any(option =>
        string.Equals(option, currentEventType, StringComparison.OrdinalIgnoreCase));
    var initialPickerValue = string.IsNullOrEmpty(currentEventType) ? string.Empty
        : (isKnownEventType ? currentEventType : "Other");
    var initialOtherValue = isKnownEventType ? string.Empty : currentEventType;

    // Edit-mode auto-tick: if we're editing a saved event (Id > 0) and the field is null,
    // pre-check the matching "Not specified" checkbox so addon-created HNM events (which
    // have null EndTime + Duration) display correctly. On Create (Id == 0) all boxes
    // start unchecked.
    var isEditMode             = Model.Event.Id > 0;
    var endTimeNotSpecified    = isEditMode && Model.Event.EndTime is null;
    var durationNotSpecified   = isEditMode && Model.Event.Duration is null;
    var partySetupNotSpecified = isEditMode && !Model.PartySetupId.HasValue;
    // A LIVE (commenced) event's party board is now edited inline on the board, so the
    // setup picker is omitted while editing one (matches the Activity edit-live-event
    // modal). A hidden input preserves the current PartySetupId so saving the event
    // details doesn't clear it.
    var isLiveEdit = isEditMode && Model.Event.CommencementStartTime.HasValue;
    // "No DKP" runs award nothing -- modelled as DkpPerHour == 0. Pre-tick the
    // toggle when editing such an event so it round-trips.
    var noDkp                  = Model.Event.DkpPerHour == 0;
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger" style="margin-bottom:12px"></div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:14px 16px;align-items:start">
    @if (isEditMode)
    {
        <div class="field" style="display:flex;flex-direction:column">
            <label for="Event_LinkshellId">Linkshell</label>
            <select class="form-select" id="Event_LinkshellId" name="Event.LinkshellId">
                @foreach (var linkshell in Model.Linkshells)
                {
                    if (linkshell.Id == Model.Event.LinkshellId)
                    {
                        <option value="@linkshell.Id" selected>@linkshell.LinkshellName</option>
                    }
                    else
                    {
                        <option value="@linkshell.Id">@linkshell.LinkshellName</option>
                    }
                }
            </select>
        </div>
    }
    else
    {
        <input type="hidden" id="Event_LinkshellId" name="Event.LinkshellId" value="@Model.Event.LinkshellId" />
    }
    <div class="field" style="display:flex;flex-direction:column">
        <label for="Event_EventName">Event name</label>
        <input class="form-control" id="Event_EventName" name="Event.EventName" value="@Model.Event.EventName" />
    </div>
    <div class="field" style="display:flex;flex-direction:column">
        <label for="event-type-picker">Event type</label>
        <div style="display:flex;gap:8px">
            <select class="form-select" id="event-type-picker" style="flex:1;min-width:0">
                <option value="" disabled selected="@(string.IsNullOrEmpty(initialPickerValue))">Select event type</option>
                @foreach (var option in eventTypeOptions)
                {
                    if (string.Equals(option, initialPickerValue, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@option" selected>@option</option>
                    }
                    else
                    {
                        <option value="@option">@option</option>
                    }
                }
                @if (initialPickerValue == "Other")
                {
                    <option value="Other" selected>Other</option>
                }
                else
                {
                    <option value="Other">Other</option>
                }
            </select>
            <input class="form-control" type="text" id="event-type-other"
                   placeholder="Specify event type" value="@initialOtherValue"
                   style="flex:1;min-width:0;@(initialPickerValue == "Other" ? string.Empty : "display:none")" />
        </div>
        <input type="hidden" id="event-type-hidden" name="Event.EventType" value="@currentEventType" />
    </div>
    @{
        var monsterValue = Model.Event.AssignedMonsterName ?? string.Empty;
        // Options already carry the combined "Base/Stronger" label, so a stored value matches
        // an option directly; "Other" only when it isn't one of the known options.
        var monsterIsKnown = Model.MonsterOptions.Any(m => string.Equals(m, monsterValue, StringComparison.OrdinalIgnoreCase));
        var monsterPickerValue = string.IsNullOrEmpty(monsterValue) ? string.Empty : (monsterIsKnown ? monsterValue : "Other");
        var monsterOtherValue = monsterIsKnown ? string.Empty : monsterValue;
    }
    @* HNM signup board: monster picker (revealed by the event-type JS when HNM is chosen).
       Posts Event.AssignedMonsterName; "Other" reveals a free-text input. Merge pairs are
       shown as one combined "Base/Stronger" entry; the Day input only changes what the
       sign-up board prints (server-side), not this list. *@
    <div class="field" id="hnm-monster-field" style="@(isHnmEvent ? "display:flex" : "display:none");flex-direction:column">
        <label for="hnm-monster-picker">Monster</label>
        <div style="display:flex;gap:8px">
            <select class="form-select" id="hnm-monster-picker" style="flex:1;min-width:0">
                <option value="" disabled selected="@(string.IsNullOrEmpty(monsterPickerValue))">Select a monster</option>
                @foreach (var m in Model.MonsterOptions)
                {
                    <option value="@m" selected="@(string.Equals(m, monsterPickerValue, StringComparison.OrdinalIgnoreCase))">@m</option>
                }
                <option value="Other" selected="@(monsterPickerValue == "Other")">Other</option>
            </select>
            <input class="form-control" type="text" id="hnm-monster-other"
                   placeholder="Monster name" value="@monsterOtherValue"
                   style="flex:1;min-width:0;@(monsterPickerValue == "Other" ? string.Empty : "display:none")" />
        </div>
        <input type="hidden" id="hnm-monster-hidden" name="Event.AssignedMonsterName" value="@monsterValue" />
    </div>
    @* Day number (HNM only). Controls what the SIGN-UP BOARD prints for a merge pair:
       days 1–3 show just the base monster; day 4+ (and no day) show the combined pair. *@
    <div class="field" id="hnm-day-field" style="@(isHnmEvent ? "display:flex" : "display:none");flex-direction:column">
        <label for="Event_DayNumber">Day</label>
        <input class="form-control" type="number" min="1" step="1" id="Event_DayNumber"
               name="Event.DayNumber" value="@(Model.Event.DayNumber?.ToString())" placeholder="e.g. 3" />
        <span style="font-size:12px;color:var(--fg-3)">
            On the sign-up board, days 1–3 show just the base monster (e.g. Adamantoise); day 4+ shows the combined pair (Adamantoise/Aspidochelone).
        </span>
    </div>
    <div class="field" style="display:flex;flex-direction:column">
        <label for="Event_EventLocation">Location</label>
        <input class="form-control" id="Event_EventLocation" name="Event.EventLocation" value="@Model.Event.EventLocation" />
    </div>
    <div class="field" style="display:flex;flex-direction:column">
        <label for="Event_StartTime">Start</label>
        <input class="form-control" id="Event_StartTime" name="Event.StartTime" type="datetime-local" step="1" value="@(Model.Event.StartTime?.ToString("yyyy-MM-ddTHH:mm:ss"))" />
        @* Auto-start: a background service stamps the event live at its Start time
           so nobody has to click Start. HNM events ignore this (addon-driven).
           Hidden "false" makes an unchecked box post false (MVC checkbox pattern). *@
        <label id="hnm-hide-autostart" style="display:flex;gap:6px;align-items:center;font-size:12px;color:var(--fg-3);margin:6px 0 0">
            <input type="checkbox" name="Event.AutoStart" value="true" @(Model.Event.AutoStart ? "checked" : null) />
            <input type="hidden" name="Event.AutoStart" value="false" />
            Auto start at start time
        </label>
    </div>
    <div class="field" style="display:flex;flex-direction:column">
        <label for="Event_EndTime">End</label>
        <div style="display:flex;gap:8px;align-items:center">
            <input class="form-control" id="Event_EndTime" name="Event.EndTime" type="datetime-local" step="1" value="@(Model.Event.EndTime?.ToString("yyyy-MM-ddTHH:mm:ss"))" style="flex:1;min-width:0" />
            <label style="display:flex;gap:6px;align-items:center;font-size:12px;color:var(--fg-3);white-space:nowrap;margin:0">
                <input type="checkbox" id="Event_EndTime_NotSpecified" @(endTimeNotSpecified ? "checked" : null) />
                Not specified
            </label>
        </div>
    </div>
    <div class="field" style="display:flex;flex-direction:column">
        <label for="Event_Duration">Duration (hours)</label>
        <div style="display:flex;gap:8px;align-items:center">
            <div class="num-stepper" style="flex:1;min-width:0">
                <input class="form-control num-stepper__input" id="Event_Duration" name="Event.Duration" type="number" step="0.25" min="0" value="@Model.Event.Duration" />
                <button type="button" class="num-stepper__btn" data-stepper-dec aria-label="Decrease duration">&minus;</button>
                <button type="button" class="num-stepper__btn" data-stepper-inc aria-label="Increase duration">+</button>
            </div>
            <label style="display:flex;gap:6px;align-items:center;font-size:12px;color:var(--fg-3);white-space:nowrap;margin:0">
                <input type="checkbox" id="Event_Duration_NotSpecified" @(durationNotSpecified ? "checked" : null) />
                Not specified
            </label>
        </div>
    </div>
    <div class="field" style="display:flex;flex-direction:column">
        <label for="Event_DkpPerHour">DKP/hour</label>
        <div style="display:flex;gap:8px;align-items:center">
            <div class="num-stepper" style="flex:1;min-width:0">
                <input class="form-control num-stepper__input" id="Event_DkpPerHour" name="Event.DkpPerHour" type="number" min="0" step="1" value="@Model.Event.DkpPerHour" />
                <button type="button" class="num-stepper__btn" data-stepper-dec aria-label="Decrease DKP per hour">&minus;</button>
                <button type="button" class="num-stepper__btn" data-stepper-inc aria-label="Increase DKP per hour">+</button>
            </div>
            <label style="display:flex;gap:6px;align-items:center;font-size:12px;color:var(--fg-3);white-space:nowrap;margin:0">
                <input type="checkbox" id="Event_NoDkp" @(noDkp ? "checked" : null) />
                No DKP
            </label>
        </div>
    </div>
    <div class="field" id="hnm-hide-countsactive" style="display:flex;flex-direction:column;grid-column:1/-1">
        @* Activity tracking: when checked, attendees of this event earn active-member
           credit (reconciled at close). Hidden "false" makes an unchecked box post
           false (MVC checkbox pattern), same as Auto start above. *@
        <label style="display:flex;gap:6px;align-items:center;font-size:13px;color:var(--fg-2);margin:0">
            <input type="checkbox" name="Event.CountsTowardActive" value="true" @(Model.Event.CountsTowardActive ? "checked" : null) />
            <input type="hidden" name="Event.CountsTowardActive" value="false" />
            Counts toward active-member status
        </label>
        <span style="font-size:11px;color:var(--fg-4);margin-top:2px">Attendees get active credit (checked by default; reconcile per member when the event closes).</span>
    </div>

    @{
        var repeatLeadValue = Model.RepeatLeadHours ?? 1;
        var monsterIsOther = monsterPickerValue == "Other";
    }
    @* HNM signup board: optionally re-post the board before the next predicted pop
       when a new ToD for the monster is recorded. Disabled for a free-text "Other"
       monster (recurrence needs an exact ToD match). Revealed by the JS for HNM. *@
    <div class="field" id="hnm-repeat-field" style="@(isHnmEvent ? "display:flex" : "display:none");flex-direction:column;grid-column:1/-1">
        <label style="display:flex;gap:6px;align-items:center;font-size:13px;color:var(--fg-2);margin:0">
            <input type="checkbox" name="RepeatOnTod" value="true" id="hnm-repeat-toggle" @(Model.RepeatOnTod ? "checked" : null) />
            <input type="hidden" name="RepeatOnTod" value="false" />
            Repeat post when ToD is updated
        </label>
        <span style="font-size:11px;color:var(--fg-4);margin-top:2px">When a new ToD for this monster is recorded, re-post the signup board ahead of the next pop.</span>
        <div id="hnm-lead-field" style="@(Model.RepeatOnTod ? "display:flex" : "display:none");flex-direction:column;gap:6px;margin-top:8px;max-width:320px">
            <label for="RepeatLeadHours" style="font-size:12px;color:var(--fg-3);margin:0">Recreate this many hours before pop</label>
            <input class="form-control" type="number" min="0" max="168" step="1" name="RepeatLeadHours" id="RepeatLeadHours" value="@repeatLeadValue" />
        </div>
        <small id="hnm-repeat-other-note" style="font-size:11px;color:var(--fg-4);margin-top:6px;@(monsterIsOther ? string.Empty : "display:none")">
            Enter the custom monster name above to enable this. Recurrence re-posts when a new ToD is logged under that exact name.
        </small>
    </div>
    <div class="field" style="display:flex;flex-direction:column;grid-column:1/-1">
        <label for="Event_Details">Details</label>
        <textarea class="form-control" id="Event_Details" name="Event.Details" rows="4">@Model.Event.Details</textarea>
    </div>
</div>

<script nonce="@Html.CspNonce()">
    (function () {
        var picker = document.getElementById('event-type-picker');
        var other  = document.getElementById('event-type-other');
        var hidden = document.getElementById('event-type-hidden');
        if (!picker || !other || !hidden) return;

        var partySelect = document.getElementById('PartySetupId');

        // HNM signup-board controls: the monster picker + repeat-on-ToD toggle, plus
        // the fields hidden when HNM is chosen (the server forces their values).
        var monsterField    = document.getElementById('hnm-monster-field');
        var monsterPicker   = document.getElementById('hnm-monster-picker');
        var monsterOther    = document.getElementById('hnm-monster-other');
        var monsterHidden   = document.getElementById('hnm-monster-hidden');
        var dayField        = document.getElementById('hnm-day-field');
        var repeatField     = document.getElementById('hnm-repeat-field');
        var repeatToggle    = document.getElementById('hnm-repeat-toggle');
        var leadField       = document.getElementById('hnm-lead-field');
        var repeatOtherNote = document.getElementById('hnm-repeat-other-note');
        function fieldOf(id) { var e = document.getElementById(id); return e ? e.closest('.field') : null; }
        var endField    = fieldOf('Event_EndTime');
        var durField    = fieldOf('Event_Duration');
        var dkpField    = fieldOf('Event_DkpPerHour');
        var autostart   = document.getElementById('hnm-hide-autostart');
        var countsField = document.getElementById('hnm-hide-countsactive');
        function setShown(el, shown) { if (el) el.style.display = shown ? '' : 'none'; }

        // Show only party setups whose type matches the chosen event type, plus
        // universal ("Any") and untyped/legacy setups (so nothing existing
        // disappears). With no event type chosen yet, all are shown. The
        // already-linked setup is always kept so editing an event never silently
        // unlinks a setup whose type doesn't match the event.
        function filterPartySetups() {
            if (!partySelect) return;
            var selected = (hidden.value || '').trim().toLowerCase();
            for (var i = 0; i < partySelect.options.length; i++) {
                var opt = partySelect.options[i];
                if (opt.value === '') continue; // keep the placeholder
                var t = (opt.getAttribute('data-event-type') || '').trim().toLowerCase();
                var show = opt.selected || selected === '' || t === '' || t === 'any' || t === selected;
                opt.hidden = !show;
                opt.disabled = !show;
            }
        }

        function isOtherMonster() { return !!monsterPicker && monsterPicker.value === 'Other'; }

        function syncRepeatLead() {
            setShown(leadField, !!repeatToggle && repeatToggle.checked && !repeatToggle.disabled);
        }

        function syncMonster() {
            if (!monsterPicker || !monsterHidden) return;
            if (isOtherMonster()) {
                if (monsterOther) { monsterOther.style.display = ''; monsterHidden.value = monsterOther.value; }
            } else {
                if (monsterOther) monsterOther.style.display = 'none';
                monsterHidden.value = monsterPicker.value || '';
            }
            // Repeat-on-ToD keys on an exact (case-insensitive) ToD name match. For a
            // custom "Other" monster that's the typed name, so it's allowed once a
            // non-empty name is entered; disabled (with a prompt) while it's blank.
            var needName = isOtherMonster() && (!monsterOther || monsterOther.value.trim() === '');
            if (repeatToggle) { repeatToggle.disabled = needName; if (needName) repeatToggle.checked = false; }
            setShown(repeatOtherNote, needName);
            syncRepeatLead();
        }

        function applyHnm(isHnm) {
            setShown(monsterField, isHnm);
            setShown(dayField, isHnm);
            setShown(repeatField, isHnm);
            // These are hidden for HNM (the server nulls/zeros them server-side).
            setShown(endField, !isHnm);
            setShown(durField, !isHnm);
            setShown(dkpField, !isHnm);
            setShown(autostart, !isHnm);
            setShown(countsField, !isHnm);
            if (isHnm) syncMonster();
        }

        function isHnm() { return (hidden.value || '').trim().toUpperCase() === 'HNM'; }

        function sync() {
            if (picker.value === 'Other') {
                other.style.display = '';
                hidden.value = other.value;
            } else {
                other.style.display = 'none';
                hidden.value = picker.value;
            }
            applyHnm(isHnm());
            filterPartySetups();
        }

        picker.addEventListener('change', sync);
        other.addEventListener('input', function () { hidden.value = other.value; applyHnm(isHnm()); filterPartySetups(); });
        if (monsterPicker) monsterPicker.addEventListener('change', syncMonster);
        if (monsterOther) monsterOther.addEventListener('input', function () { if (monsterHidden && isOtherMonster()) monsterHidden.value = monsterOther.value; syncMonster(); });
        if (repeatToggle) repeatToggle.addEventListener('change', syncRepeatLead);

        sync();
    })();
</script>

<script nonce="@Html.CspNonce()">
    // Start / End / Duration sync — mirrors the Discord Activity logic so editing
    // any two of the three keeps the third in step.
    //   Start changes: recompute Duration if End is set, else recompute End if Duration is set.
    //   End changes:   recompute Duration.
    //   Duration changes: recompute End.
    // The "Not specified" checkboxes blank + disable their fields so the form posts
    // an empty value (= null on the server side).
    (function () {
        var startEl    = document.getElementById('Event_StartTime');
        var endEl      = document.getElementById('Event_EndTime');
        var durationEl = document.getElementById('Event_Duration');
        var endNs      = document.getElementById('Event_EndTime_NotSpecified');
        var durNs      = document.getElementById('Event_Duration_NotSpecified');
        if (!startEl || !endEl || !durationEl || !endNs || !durNs) return;

        function pad(n) { return String(n).padStart(2, '0'); }
        function formatLocal(date) {
            return date.getFullYear() + '-' + pad(date.getMonth() + 1) + '-' + pad(date.getDate())
                 + 'T' + pad(date.getHours()) + ':' + pad(date.getMinutes());
        }
        function parseLocal(value) {
            if (!value) return null;
            var d = new Date(value);
            return isNaN(d.getTime()) ? null : d;
        }

        function recomputeDurationFromStartEnd() {
            if (durNs.checked || endNs.checked) return;
            var start = parseLocal(startEl.value);
            var end   = parseLocal(endEl.value);
            if (!start || !end) return;
            var hours = (end - start) / 3600000;
            if (hours < 0) return;
            durationEl.value = (Math.round(hours * 100) / 100).toString();
        }

        function recomputeEndFromStartDuration() {
            if (endNs.checked || durNs.checked) return;
            var start = parseLocal(startEl.value);
            var hours = parseFloat(durationEl.value);
            if (!start || isNaN(hours) || hours < 0) return;
            var end = new Date(start.getTime() + hours * 3600000);
            endEl.value = formatLocal(end);
        }

        function onStartEdited() {
            if (!endNs.checked && endEl.value) {
                recomputeDurationFromStartEnd();
            } else if (!durNs.checked && durationEl.value !== '') {
                recomputeEndFromStartDuration();
            }
        }
        // Listen on both `input` (fires while typing / picker ticks) and `change`
        // (fires on commit). The `input` handler is what makes Duration update
        // live before the user clicks off the field.
        startEl.addEventListener('input', onStartEdited);
        startEl.addEventListener('change', onStartEdited);
        endEl.addEventListener('input', recomputeDurationFromStartEnd);
        endEl.addEventListener('change', recomputeDurationFromStartEnd);
        durationEl.addEventListener('input', recomputeEndFromStartDuration);
        durationEl.addEventListener('change', recomputeEndFromStartDuration);

        function applyEndNotSpecified() {
            if (endNs.checked) {
                endEl.value = '';
                endEl.disabled = true;
            } else {
                endEl.disabled = false;
                recomputeEndFromStartDuration();
            }
        }
        function applyDurationNotSpecified() {
            if (durNs.checked) {
                durationEl.value = '';
                durationEl.disabled = true;
            } else {
                durationEl.disabled = false;
                if (durationEl.value === '') durationEl.value = '1';
                recomputeEndFromStartDuration();
            }
        }
        endNs.addEventListener('change', applyEndNotSpecified);
        durNs.addEventListener('change', applyDurationNotSpecified);

        // Initial load: only reflect the "Not specified" checkboxes' disabled
        // state. Do NOT auto-fill Duration or recompute End -- End starts blank
        // by default; the Start/End/Duration sync only kicks in once the user
        // edits one of the fields.
        if (endNs.checked) { endEl.value = ''; endEl.disabled = true; }
        if (durNs.checked) { durationEl.value = ''; durationEl.disabled = true; }
    })();
</script>

<script nonce="@Html.CspNonce()">
    // Custom +/- steppers (native number-input arrows are hidden site-wide
    // because they can't be themed on the dark UI) plus the "No DKP" toggle.
    (function () {
        document.querySelectorAll('.num-stepper').forEach(function (wrap) {
            var input = wrap.querySelector('.num-stepper__input');
            if (!input) return;
            var step = parseFloat(input.getAttribute('step')) || 1;
            var min  = input.hasAttribute('min') ? parseFloat(input.getAttribute('min')) : null;
            function bump(dir) {
                if (input.disabled || input.readOnly) return;
                var cur = parseFloat(input.value);
                if (isNaN(cur)) cur = (min !== null ? min : 0);
                var next = Math.round((cur + dir * step) * 100) / 100;
                if (min !== null && next < min) next = min;
                input.value = next;
                // Re-run the Start/End/Duration sync wired on these inputs.
                input.dispatchEvent(new Event('input', { bubbles: true }));
                input.dispatchEvent(new Event('change', { bubbles: true }));
            }
            var dec = wrap.querySelector('[data-stepper-dec]');
            var inc = wrap.querySelector('[data-stepper-inc]');
            if (dec) dec.addEventListener('click', function () { bump(-1); });
            if (inc) inc.addEventListener('click', function () { bump(1); });
        });

        // "No DKP": zero + lock DKP/hour so the event posts DkpPerHour = 0
        // (a no-dkp run). Unchecking restores an editable value.
        var noDkp = document.getElementById('Event_NoDkp');
        var dkp   = document.getElementById('Event_DkpPerHour');
        if (noDkp && dkp) {
            var dkpWrap = dkp.closest('.num-stepper');
            function applyNoDkp() {
                if (noDkp.checked) {
                    dkp.value = '0';
                    dkp.readOnly = true;
                    if (dkpWrap) dkpWrap.classList.add('is-disabled');
                } else {
                    dkp.readOnly = false;
                    if (dkpWrap) dkpWrap.classList.remove('is-disabled');
                    if (dkp.value === '' || dkp.value === '0') dkp.value = '1';
                }
            }
            noDkp.addEventListener('change', applyNoDkp);
            applyNoDkp();
        }
    })();
</script>

@if (isLiveEdit)
{
    @* Live event: the party board is edited inline on the board itself. Keep the
       current setup id so saving the event details doesn't null it out. *@
    <input type="hidden" name="PartySetupId" value="@Model.PartySetupId" />
}
else
{
<div style="display:flex;justify-content:space-between;align-items:center;margin-top:20px;margin-bottom:12px;gap:12px;flex-wrap:wrap">
    <div style="display:flex;align-items:center;gap:12px">
        <h2 style="font-size:14px;font-weight:600;color:var(--fg);margin:0">Party setup <span style="color:var(--fg-3);font-weight:400">(optional)</span></h2>
        <label style="display:flex;gap:6px;align-items:center;font-size:12px;color:var(--fg-3);margin:0">
            <input type="checkbox" id="party_setup_not_specified" @(partySetupNotSpecified ? "checked" : null) />
            Do Not Include
        </label>
    </div>
    @* Opens the inline "New Party Setup" modal (rendered outside this form by the
       host page); on save it auto-selects the fresh setup in the dropdown below. *@
    @if (Model.PartySetupEditor is not null)
    {
        <button type="button" class="btn sm ps-open-create-modal">+ Create New Party Setup</button>
    }
</div>

<div id="party-setup-row" class="field" style="display:flex;flex-direction:column;max-width:520px">
    <label for="PartySetupId">Linked party setup</label>
    <select class="form-select" id="PartySetupId" name="PartySetupId">
        <option value="">— Select party setup —</option>
        @foreach (var option in Model.AvailablePartySetups)
        {
            var label = string.IsNullOrWhiteSpace(option.AssignedMonsterName)
                ? option.Name
                : $"{option.Name} — {option.AssignedMonsterName}";
            if (Model.PartySetupId == option.Id)
            {
                <option value="@option.Id" data-event-type="@option.EventType" selected>@label</option>
            }
            else
            {
                <option value="@option.Id" data-event-type="@option.EventType">@label</option>
            }
        }
    </select>
    @if (Model.AvailablePartySetups.Count == 0)
    {
        <small style="color:var(--fg-4);font-size:11px;margin-top:4px">No party setups exist for this linkshell yet. Create one from the Party Setup page first.</small>
    }
</div>

@* Live preview of the selected party setup, rendered to match the View Party
   Setup page (alliance card -> party columns -> requirement rows). Populated by
   JS from /PartySetup/Preview when a setup is picked; hidden otherwise. *@
<div id="ps-preview" class="ps-preview" style="display:none;margin-top:14px"></div>
}

<script nonce="@Html.CspNonce()">
    // "Do Not Include" toggle: when checked, hide the dropdown, blank the value,
    // and disable the select so it posts back as null PartySetupId. Also renders
    // a live preview of the selected setup matching the View Party Setup page.
    (function () {
        var notSpecified = document.getElementById('party_setup_not_specified');
        var row          = document.getElementById('party-setup-row');
        var select       = document.getElementById('PartySetupId');
        var preview      = document.getElementById('ps-preview');
        if (!notSpecified || !row || !select) return;

        var leaderSvg = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 7.5l4.6 3.2L12 3.5l4.9 7.2 4.6-3.2-1.9 11.5H4.4L2.5 7.5z"/></svg>';

        function clearPreview() {
            if (preview) { preview.style.display = 'none'; preview.innerHTML = ''; }
        }
        function el(tag, cls, text) {
            var e = document.createElement(tag);
            if (cls) e.className = cls;
            if (text != null) e.textContent = text;
            return e;
        }

        function renderPreview(data) {
            if (!preview) return;
            preview.innerHTML = '';
            if (!data || !data.alliances || !data.alliances.length) { clearPreview(); return; }
            data.alliances.forEach(function (alliance) {
                var card = el('div', 'card ps-preview__card');
                var head = el('div', 'card-head');
                head.appendChild(el('div', 'card-title', alliance.name));
                head.appendChild(el('span', 'card-link', (alliance.parties ? alliance.parties.length : 0) + ' parties'));
                card.appendChild(head);

                var cols = el('div', 'ps-preview__parties');
                (alliance.parties || []).forEach(function (party) {
                    var col = el('div', 'ps-preview__party');
                    var title = el('div', 'ps-preview__party-name');
                    title.appendChild(document.createTextNode(party.name + ' '));
                    title.appendChild(el('span', 'tag', String((party.slots || []).length)));
                    col.appendChild(title);

                    var table = el('table', 'table');
                    var thead = document.createElement('thead');
                    var hr = document.createElement('tr');
                    var thNum = el('th', null, '#'); thNum.style.width = '32px';
                    hr.appendChild(thNum);
                    hr.appendChild(el('th', null, 'Requirement'));
                    thead.appendChild(hr);
                    table.appendChild(thead);

                    var tbody = document.createElement('tbody');
                    (party.slots || []).forEach(function (slot) {
                        var tr = document.createElement('tr');
                        if (slot.isLeader) tr.className = 'ps-leader-row';
                        tr.appendChild(el('td', 'num', String(slot.position)));
                        var tdReq = el('td', null);
                        tdReq.appendChild(document.createTextNode(slot.display));
                        if (slot.isLeader) {
                            var ltag = el('span', 'ps-leader-tag');
                            ltag.title = 'Party leader';
                            ltag.innerHTML = leaderSvg + ' Leader';
                            tdReq.appendChild(ltag);
                        }
                        tr.appendChild(tdReq);
                        tbody.appendChild(tr);
                    });
                    table.appendChild(tbody);
                    col.appendChild(table);
                    cols.appendChild(col);
                });
                card.appendChild(cols);
                preview.appendChild(card);
            });
            preview.style.display = '';
        }

        function loadPreview() {
            if (!preview) return;
            var id = select.value;
            if (!id || notSpecified.checked) { clearPreview(); return; }
            fetch('/PartySetup/Preview?id=' + encodeURIComponent(id),
                  { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
                .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
                .then(renderPreview)
                .catch(clearPreview);
        }

        function apply() {
            if (notSpecified.checked) {
                row.style.display = 'none';
                select.value = '';
                select.disabled = true;
                clearPreview();
            } else {
                row.style.display = '';
                select.disabled = false;
                loadPreview();
            }
        }
        notSpecified.addEventListener('change', apply);
        select.addEventListener('change', loadPreview);
        apply();
    })();
</script>

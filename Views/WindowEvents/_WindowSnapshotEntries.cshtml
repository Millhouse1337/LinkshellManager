@model LinkshellManagerDiscordApp.ViewModels.WindowSnapshotRow
@{
    string FormatDkp(double? value) => value.HasValue
        ? value.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)
        : "";

    // When the parent (window event card) passes a form id, render an
    // editable per-character DKP column wired to that form. Unlinked
    // snapshots on the index page omit these keys so the column is hidden.
    var formId = ViewData["MemberDkpFormId"] as string;
    var effectiveDkpByCharacter = ViewData["MemberDkpEffectiveByCharacter"]
        as IDictionary<string, double?>;
    var startIndex = (int)(ViewData["MemberDkpStartIndex"] ?? 0);
    var fallbackDkp = ViewData["MemberDkpDefault"] as double?;
    var showDkpInputs = !string.IsNullOrEmpty(formId);

    // Officer roster editing (add/remove people). Gated to non-closed
    // contexts: unlinked snapshots and open events. Closed/historical
    // events stay read-only so already-posted sheet rows aren't desynced.
    var linkshellId = (int)(ViewData["LinkshellId"] ?? 0);
    var canManage = (bool)(ViewData["CanManage"] ?? false);
    var isClosed = (bool)(ViewData["IsClosed"] ?? false);
    var canEditRoster = canManage && !isClosed && linkshellId > 0;
}

@if (canEditRoster)
{
    @foreach (var entry in Model.Entries)
    {
        <form id="snap-@Model.Id-del-@entry.Id" asp-action="DeleteSnapshotEntry"
              asp-route-linkshellId="@linkshellId" asp-route-snapshotId="@Model.Id"
              asp-route-entryId="@entry.Id" method="post" class="we-hidden-form"
              onsubmit="return confirm('Remove @entry.CharacterName from this snapshot?');">
            @Html.AntiForgeryToken()
        </form>
    }

    // Add-person form lives outside the table (a <form> can't be a tbody
    // child); the input and button sit in the last table row and bind to
    // it via the HTML form= attribute, same as the Remove buttons above.
    <form id="snap-@Model.Id-add" asp-action="AddSnapshotEntry"
          asp-route-linkshellId="@linkshellId" asp-route-snapshotId="@Model.Id"
          method="post" class="we-hidden-form">
        @Html.AntiForgeryToken()
    </form>
}

<div class="we-table__scroll we-table__scroll--snapshot">
    <table class="we-table we-table--snapshot">
        <thead>
            <tr>
                <th>Character</th>
                <th>Jobs</th>
                <th>Zone</th>
                @if (showDkpInputs)
                {
                    <th class="num">DKP</th>
                }
                @if (canEditRoster)
                {
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
        @{ var rowIndex = 0; }
        @foreach (var entry in Model.Entries)
        {
            <tr>
                <td><strong>@entry.CharacterName</strong></td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(entry.MainJob))
                    {
                        <span class="we-job-pill">@(entry.MainJob)@(entry.MainJobLevel?.ToString())</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(entry.SubJob))
                    {
                        <span class="we-job-pill we-job-pill--sub">@(entry.SubJob)@(entry.SubJobLevel?.ToString())</span>
                    }
                </td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(entry.Zone))
                    {
                        <span class="we-zone">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            @entry.Zone.Replace('_', ' ')
                        </span>
                    }
                    else
                    {
                        <span class="we-muted">-</span>
                    }
                </td>
                @if (showDkpInputs)
                {
                    double? overrideDkp = null;
                    if (effectiveDkpByCharacter is not null &&
                        !string.IsNullOrWhiteSpace(entry.CharacterName) &&
                        effectiveDkpByCharacter.TryGetValue(entry.CharacterName.Trim(), out var found))
                    {
                        overrideDkp = found;
                    }
                    // No saved value yet -> seed with the event default so the
                    // input mirrors the Default DKP value above. The parent
                    // card's inline sync script keeps these "follower" rows
                    // updated until the officer edits an individual row.
                    var followsDefault = !overrideDkp.HasValue;
                    var displayDkp = overrideDkp ?? fallbackDkp;
                    var formIndex = startIndex + rowIndex;
                    <td class="num">
                        <input type="hidden"
                               name="MemberDkp[@formIndex].CharacterName"
                               value="@entry.CharacterName"
                               form="@formId" />
                        <input class="input js-member-dkp we-dkp-input"
                               type="number"
                               name="MemberDkp[@formIndex].DkpAmount"
                               value="@FormatDkp(displayDkp)"
                               step="0.25" min="0"
                               title="Defaults to the event's Default DKP. Edit to override for this character."
                               data-window-event-form="@formId"
                               data-follows-default="@(followsDefault ? "true" : "false")"
                               form="@formId" />
                    </td>
                }
                @if (canEditRoster)
                {
                    <td class="num">
                        <button form="snap-@Model.Id-del-@entry.Id" type="submit"
                                class="btn sm danger-outline" title="Remove @entry.CharacterName from this snapshot">
                            Remove
                        </button>
                    </td>
                }
            </tr>
            rowIndex++;
        }
        @if (canEditRoster)
        {
            // Span every column except the trailing actions column so the
            // name field gets the full width and the button lines up under
            // the Remove buttons.
            var addInputColspan = 3 + (showDkpInputs ? 1 : 0);
            <tr class="we-add-row">
                <td colspan="@addInputColspan">
                    @* list= binds to the shared #we-roster-options datalist
                       rendered once on the Attendance Events page, giving a
                       live typeahead filter over the entire linkshell roster.
                       Free text is still allowed (server creates/links). *@
                    <input class="input" type="text" name="characterName"
                           placeholder="Add a character by name…" maxlength="256" required
                           autocomplete="off" list="we-roster-options" form="snap-@Model.Id-add"
                           style="width:100%;max-width:280px" />
                </td>
                <td class="num">
                    <button type="submit" class="btn sm primary" form="snap-@Model.Id-add"
                            style="white-space:nowrap">+ Add person</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>


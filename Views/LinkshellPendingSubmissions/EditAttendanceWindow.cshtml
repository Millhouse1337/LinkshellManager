@model LinkshellManagerDiscordApp.ViewModels.EditPendingAttendanceWindowViewModel
@{
    ViewData["Title"] = "Review Pending Attendance";
    ViewData["BodyClass"] = "lsm-page";
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Review Pending Attendance</h1>
        <div class="page-sub">
            <span>Submitted by @Model.SubmittedByDisplay</span>
            <span class="dot"> · </span>
            <span>@Model.SubmittedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</span>
            @if (!string.IsNullOrWhiteSpace(Model.EventName))
            {
                <span class="dot"> · </span>
                <span>Event: @Model.EventName · Window @Model.WindowIndex</span>
            }
        </div>
    </div>
</div>

<form asp-action="ApproveAttendanceWindow" asp-route-linkshellId="@Model.LinkshellId" asp-route-submissionId="@Model.SubmissionId" method="post" class="create-form fade d2">
    @Html.AntiForgeryToken()

    <div class="create-form__header">
        <div>
            <strong>Members reported in this window</strong>
            <p>Uncheck any names that shouldn't be credited. On approve, the remaining names are credited via the existing attendance flow (DKP applies at event close).</p>
        </div>
    </div>

    <table style="width:100%;border-collapse:collapse;font-size:13px">
        <thead>
            <tr>
                <th style="padding:8px 12px">Include</th>
                <th style="text-align:left;padding:8px 12px">Character</th>
                <th style="text-align:left;padding:8px 12px">Main</th>
                <th style="text-align:left;padding:8px 12px">Sub</th>
            </tr>
        </thead>
        <tbody>
        @for (var i = 0; i < Model.Members.Count; i++)
        {
            var m = Model.Members[i];
            <tr style="border-top:1px solid var(--border,#222)">
                <td style="text-align:center;padding:6px 12px">
                    <input type="hidden" name="Members[@i].Id" value="@m.Id" />
                    <input type="checkbox" name="Members[@i].Include" value="true" checked="@(m.Include ? "checked" : null)" />
                    <input type="hidden" name="Members[@i].Include" value="false" />
                </td>
                <td style="padding:6px 12px">@m.CharacterName</td>
                <td style="padding:6px 12px">@(m.MainJob ?? "—")@(m.MainJobLevel.HasValue ? $" {m.MainJobLevel}" : "")</td>
                <td style="padding:6px 12px">@(m.SubJob ?? "—")@(m.SubJobLevel.HasValue ? $" {m.SubJobLevel}" : "")</td>
            </tr>
        }
        </tbody>
    </table>

    <div class="create-form__actions" style="margin-top:14px">
        <button type="submit" class="btn btn-primary">Approve</button>
        <button type="submit" class="btn" formaction="@Url.Action("RejectAttendanceWindow", new { linkshellId = Model.LinkshellId, submissionId = Model.SubmissionId })" onclick="return confirm('Reject this submission?');">Reject</button>
        <a class="btn" asp-action="Index" asp-route-linkshellId="@Model.LinkshellId">Back to queue</a>
    </div>
</form>

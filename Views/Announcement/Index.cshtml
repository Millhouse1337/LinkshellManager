@using LinkshellManagerDiscordApp.Utils
@model IEnumerable<LinkshellManagerDiscordApp.ViewModels.AnnouncementViewModel>
@{
    ViewData["Title"] = "Announcements";
    ViewData["BodyClass"] = "lsm-page";
    var canManage = (bool)(ViewBag.CanManage ?? false);
    var linkshellName = ViewBag.LinkshellName as string;
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Announcements</h1>
        <div class="page-sub">
            @if (!string.IsNullOrWhiteSpace(linkshellName))
            {
                <span>@linkshellName</span>
                <span class="dot"> · </span>
            }
            <span><span class="num">@Model.Count()</span> announcement@(Model.Count() == 1 ? "" : "s")</span>
        </div>
    </div>
    @if (canManage)
    {
        <div class="page-actions">
            <a class="btn primary" asp-action="Create">+ Create announcement</a>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="card fade d2">
        <div class="empty">
            <div style="font-size:15px;color:var(--fg);font-weight:500;margin-bottom:6px">No announcements yet</div>
            <div style="margin-bottom:12px">
                @if (canManage)
                {
                    <span>Post an announcement to share news with your linkshell.</span>
                }
                else
                {
                    <span>No announcements have been posted for your linkshell.</span>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="rule-list fade d2">
        @{ var annIndex = 0; }
        @foreach (var announcement in Model)
        {
            var badge = RuleContent.Badge(announcement.Category, annIndex);
            var blocks = RuleContent.Parse(announcement.AnnouncementDetails);
            annIndex++;
            <article class="rule-card @badge.Accent">
                <div class="rule-ico">@badge.Icon</div>

                <div class="rule-content">
                    <h3>@announcement.AnnouncementTitle</h3>
                    @if (blocks.Count == 0)
                    {
                        <p>@announcement.AnnouncementDetails</p>
                    }
                    @foreach (var block in blocks)
                    {
                        if (block.IsList)
                        {
                            <ul class="@(block.Items.Count > 4 ? "cols" : null)">
                                @foreach (var item in block.Items)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p>@block.Text</p>
                        }
                    }
                </div>

                <div class="rule-meta">
                    @if (!string.IsNullOrWhiteSpace(announcement.Category))
                    {
                        <span class="rule-tag">@announcement.Category</span>
                    }
                    <span class="rule-by">
                        @if (!string.IsNullOrWhiteSpace(announcement.CreatedByCharacterName))
                        {
                            <span>Posted by @announcement.CreatedByCharacterName</span>
                            <span class="dot"> · </span>
                        }
                        <span>@announcement.CreatedAt.ToString("MMM d, yyyy")</span>
                    </span>
                    @if (announcement.CanManage)
                    {
                        <div class="rule-tools">
                            <a class="rule-iconbtn" asp-action="Edit" asp-route-id="@announcement.Id" title="Edit" aria-label="Edit announcement">✎</a>
                            <form asp-action="Delete" asp-route-id="@announcement.Id" method="post" style="display:inline"
                                  onsubmit="return confirm('Delete this announcement?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="rule-iconbtn danger" title="Delete" aria-label="Delete announcement">🗑</button>
                            </form>
                        </div>
                    }
                </div>
            </article>
        }
    </div>
}

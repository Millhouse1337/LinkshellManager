@model LinkshellManagerDiscordApp.ViewModels.PartySetupEditorViewModel
@{
    // Reusable inner body of the party-setup editor form — shared by the full
    // Create/Edit page (Create.cshtml) and the inline "Create New Party Setup"
    // modal on the event form. The wrapping <form> (id="party-setup-form",
    // data-options, action/AJAX + the submit button) is supplied by the host.
    var isEditMode = Model.Id > 0;
    var linkshellName = Model.LinkshellName ?? "Selected Linkshell";

    // Group the flat slot list back into alliance -> party -> slot so the initial
    // DOM matches what party-setup.js expects. A brand-new setup has no slots, so
    // scaffold one empty Alliance 1 / Party 1 the user can add slots to.
    var allianceGroups = Model.Slots
        .GroupBy(s => s.AllianceIndex)
        .OrderBy(g => g.Key)
        .ToList();

    var alliances = new List<(string Name, List<(string Name, List<LinkshellManagerDiscordApp.ViewModels.PartySetupSlotInput> Slots)> Parties)>();
    if (allianceGroups.Count == 0)
    {
        alliances.Add(("Alliance 1",
            new List<(string, List<LinkshellManagerDiscordApp.ViewModels.PartySetupSlotInput>)> { ("Party 1", new List<LinkshellManagerDiscordApp.ViewModels.PartySetupSlotInput>()) }));
    }
    else
    {
        var ai0 = 0;
        foreach (var ag in allianceGroups)
        {
            var aName = ag.Select(x => x.AllianceName).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n))
                        ?? $"Alliance {ai0 + 1}";
            var parties = new List<(string, List<LinkshellManagerDiscordApp.ViewModels.PartySetupSlotInput>)>();
            var pi0 = 0;
            foreach (var pg in ag.GroupBy(x => x.PartyIndex).OrderBy(g => g.Key))
            {
                var pName = pg.Select(x => x.PartyName).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n))
                            ?? $"Party {pi0 + 1}";
                parties.Add((pName, pg.OrderBy(x => x.SlotIndex).ToList()));
                pi0++;
            }
            alliances.Add((aName, parties));
            ai0++;
        }
    }
    var flat = 0;
}

@Html.AntiForgeryToken()
@if (isEditMode)
{
    <input asp-for="Id" type="hidden" />
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger"
     style="display:@(ViewData.ModelState.IsValid ? "none" : "block"); margin-bottom:14px;"></div>

<div class="create-form__grid">
    <label>
        <span>Name</span>
        <input asp-for="Name" placeholder="e.g. Nidhogg Standard" required />
        <span asp-validation-for="Name" class="create-form__error"></span>
    </label>

    @{
        var monsterIsKnown = string.IsNullOrEmpty(Model.AssignedMonsterName)
            || Model.MonsterOptions.Any(m => string.Equals(m, Model.AssignedMonsterName, StringComparison.OrdinalIgnoreCase));
        var monsterPick = string.IsNullOrEmpty(Model.AssignedMonsterName)
            ? string.Empty
            : (monsterIsKnown ? Model.AssignedMonsterName! : "Other");
        var monsterCustomValue = monsterIsKnown ? string.Empty : Model.AssignedMonsterName;
        var showMonsterInitially = string.Equals(Model.EventType, "HNM", StringComparison.OrdinalIgnoreCase);
    }

    <label>
        <span>Event type</span>
        <select asp-for="EventType" id="ps-event-type">
            @foreach (var t in Model.EventTypeOptions)
            {
                <option value="@t"
                        selected="@(string.Equals(t, Model.EventType, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                    @t
                </option>
            }
            <option value="HNM"
                    selected="@(string.Equals("HNM", Model.EventType, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                HNM
            </option>
        </select>
        <span asp-validation-for="EventType" class="create-form__error"></span>
    </label>

    @* The monster picker is revealed only once Event Type = HNM (see script). *@
    <label id="ps-monster-field" style="@(showMonsterInitially ? null : "display:none")">
        <span>Assigned monster</span>
        <select asp-for="AssignedMonsterName" id="ps-monster-select">
            <option value="">— Unassigned —</option>
            @foreach (var monster in Model.MonsterOptions)
            {
                <option value="@monster"
                        selected="@(string.Equals(monster, monsterPick, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                    @monster
                </option>
            }
            <option value="Other"
                    selected="@(string.Equals("Other", monsterPick, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                Other (custom)
            </option>
        </select>
        <input asp-for="AssignedMonsterCustom" id="ps-monster-custom" class="input"
               value="@monsterCustomValue" placeholder="Name the monster" maxlength="256"
               style="margin-top:6px;@(string.Equals(monsterPick, "Other", StringComparison.OrdinalIgnoreCase) ? string.Empty : "display:none")" />
        <span asp-validation-for="AssignedMonsterName" class="create-form__error"></span>
    </label>

    <label>
        <span>Notes (optional)</span>
        <input asp-for="Notes" placeholder="Anything the raid should know" />
        <span asp-validation-for="Notes" class="create-form__error"></span>
    </label>
</div>

<div id="alliances-container" class="ps-alliances">
    @for (var aIdx = 0; aIdx < alliances.Count; aIdx++)
    {
        var allianceName = alliances[aIdx].Name;
        var partiesList = alliances[aIdx].Parties;
        <section class="ps-alliance create-form__section" data-alliance="@aIdx">
            <div class="create-form__section-head ps-alliance-head">
                <label class="ps-name-field">
                    <span>Alliance</span>
                    <input type="text" class="input ps-alliance-name" value="@allianceName"
                           placeholder="Alliance name" maxlength="64" />
                </label>
                <div class="ps-head-actions">
                    <button type="button" class="btn sm ghost ps-add-party">+ Add party</button>
                    <button type="button" class="btn sm danger-outline ps-remove-alliance">Remove alliance</button>
                </div>
            </div>
            <div class="ps-parties">
                @for (var pIdx = 0; pIdx < partiesList.Count; pIdx++)
                {
                    var partyName = partiesList[pIdx].Name;
                    var partySlots = partiesList[pIdx].Slots;
                    <div class="ps-party create-form__item" data-party="@pIdx">
                        <div class="ps-party-head">
                            <input type="text" class="input ps-party-name" value="@partyName"
                                   placeholder="Party name" maxlength="64" />
                            <div class="ps-party-head-actions">
                                <button type="button" class="btn sm danger-outline ps-remove-party">Remove</button>
                            </div>
                        </div>
                        <div class="ps-slots">
                            @for (var sIdx = 0; sIdx < partySlots.Count; sIdx++)
                            {
                                var slot = partySlots[sIdx];
                                <div class="ps-slot@(slot.IsPartyLeader ? " is-leader" : "")" data-slot="@sIdx">
                                    <input type="hidden" data-field="AllianceIndex" name="Slots[@flat].AllianceIndex" value="@aIdx" />
                                    <input type="hidden" data-field="PartyIndex" name="Slots[@flat].PartyIndex" value="@pIdx" />
                                    <input type="hidden" data-field="SlotIndex" name="Slots[@flat].SlotIndex" value="@sIdx" />
                                    <input type="hidden" data-field="AllianceName" name="Slots[@flat].AllianceName" value="@allianceName" />
                                    <input type="hidden" data-field="PartyName" name="Slots[@flat].PartyName" value="@partyName" />
                                    <input type="hidden" data-field="IsPartyLeader" name="Slots[@flat].IsPartyLeader" value="@(slot.IsPartyLeader ? "true" : "false")" />

                                    <button type="button" class="ps-leader-btn@(slot.IsPartyLeader ? " active" : "")"
                                            title="Set as party leader" aria-label="Set as party leader"
                                            aria-pressed="@(slot.IsPartyLeader ? "true" : "false")">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 7.5l4.6 3.2L12 3.5l4.9 7.2 4.6-3.2-1.9 11.5H4.4L2.5 7.5z"/></svg>
                                    </button>

                                    @{
                                        var selectedRole = slot.RequirementType == LinkshellManagerDiscordApp.ViewModels.PartySetupSlotRequirementTypes.Any
                                            ? "Any Role"
                                            : (slot.Role ?? string.Empty);
                                    }
                                    <select data-field="Role" name="Slots[@flat].Role" class="form-select ps-slot__sel ps-slot__role">
                                        <option value="">Select role</option>
                                        <option value="Any Role" selected="@(string.Equals(selectedRole, "Any Role", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Any Role</option>
                                        @foreach (var r in Model.RoleOptions)
                                        {
                                            <option value="@r" selected="@(string.Equals(r, selectedRole, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@r</option>
                                        }
                                    </select>
                                    <select data-field="MainJob" name="Slots[@flat].MainJob" class="form-select ps-slot__sel ps-slot__job">
                                        <option value="">Select main job</option>
                                        @foreach (var j in Model.MainJobOptions)
                                        {
                                            <option value="@j" selected="@(string.Equals(j, slot.MainJob, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@j</option>
                                        }
                                    </select>
                                    <select data-field="SubJob" name="Slots[@flat].SubJob" class="form-select ps-slot__sel ps-slot__job">
                                        <option value="">Any sub job</option>
                                        @foreach (var j in Model.SubJobOptions)
                                        {
                                            <option value="@j" selected="@(string.Equals(j, slot.SubJob, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@j</option>
                                        }
                                    </select>
                                    <span class="ps-slot__any d-none" data-role="any" aria-hidden="true">— Anything —</span>
                                    <button type="button" class="btn sm ghost ps-duplicate-slot ps-slot__dup"
                                            title="Duplicate this slot below" aria-label="Duplicate this slot below">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
                                    </button>
                                    <button type="button" class="btn sm ghost ps-remove-slot ps-slot__remove"
                                            title="Remove slot" aria-label="Remove slot">&times;</button>
                                </div>
                                flat++;
                            }
                        </div>
                        <div class="ps-add-slot-row@(partySlots.Count >= 6 ? " d-none" : "")">
                            <button type="button" class="btn sm ghost ps-add-slot">+ Add slot</button>
                        </div>
                    </div>
                }
            </div>
        </section>
    }
</div>

<div style="margin-top:14px">
    <button type="button" class="btn sm ghost" id="ps-add-alliance">+ Add alliance</button>
</div>

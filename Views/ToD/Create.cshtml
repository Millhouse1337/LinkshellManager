@using System.Text.Json
@model LinkshellManagerDiscordApp.ViewModels.TodManagerViewModel

@{
    // This view always receives a populated model from the ToD controller, but
    // Razor types `Model` as framework-nullable, so its dropdown/option closures
    // would otherwise emit nullable-deref noise. Silence it for this view only.
#pragma warning disable CS8602
    var isEditMode = (Model.Tod?.Id ?? 0) > 0;
    var pageHeading = isEditMode ? "Edit ToD" : "Add ToD";
    var formHeader = isEditMode ? "Update ToD" : "Submit ToD";
    var formAction = isEditMode ? "Edit" : "Create";
    // Tod.Cooldown / Tod.Interval are stored as labels ("22 Hour", "45 Min"); the form edits them
    // as a number + a unit. Split them here with the same rule TodDurationFormat.Split uses, so a
    // value never echoes back in a different unit than it was saved in.
    var cooldownMinutes = LinkshellManagerDiscordApp.Utils.TodDurationFormat.TryParseMinutes(
        Model.Tod?.Cooldown, LinkshellManagerDiscordApp.Utils.TodDurationFormat.HoursUnit, out var parsedCooldown)
        ? parsedCooldown
        : 22 * 60;
    var (cooldownValue, cooldownUnit) = LinkshellManagerDiscordApp.Utils.TodDurationFormat.Split(cooldownMinutes);
    var hasInterval = LinkshellManagerDiscordApp.Utils.TodDurationFormat.TryParseMinutes(
        Model.Tod?.Interval, LinkshellManagerDiscordApp.Utils.TodDurationFormat.MinutesUnit, out var parsedInterval);
    var (intervalValue, intervalUnit) = hasInterval
        ? LinkshellManagerDiscordApp.Utils.TodDurationFormat.Split(parsedInterval)
        : (0, LinkshellManagerDiscordApp.Utils.TodDurationFormat.MinutesUnit);
    ViewData["Title"] = pageHeading;
    ViewData["BodyClass"] = "lsm-page";
    var selectedLinkshellName = Model.Linkshells.FirstOrDefault(item => item.Id == Model.LinkshellId)?.LinkshellName ?? "Selected Linkshell";
    // camelCase, because the browser reads this back as JS: serialized with the default policy the
    // payload came out PascalCase, every `timing.cooldownMinutes` read as undefined, and picking a
    // monster BLANKED the cooldown and interval instead of pre-filling them.
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

@* (A `.show-spinner` opt-in used to live here, putting the native up/down arrows back on the Day
   field. Day and Popped on window are plain number inputs now, like their counterparts on the
   Activity's Log ToD form -- the native spinner renders as a light block on this dark theme. *@

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">@pageHeading</h1>
        <div class="page-sub">
            <span>@selectedLinkshellName</span>
        </div>
    </div>
</div>

@if (!Model.Linkshells.Any())
{
    <div class="card fade d2">
        <div class="empty">Join a linkshell before submitting a ToD entry.</div>
    </div>
}
else
{
    <form asp-action="@formAction"
          asp-route-id="@(isEditMode ? (int?)Model.Tod!.Id : null)"
          method="post" id="tod-form" novalidate
          enctype="multipart/form-data"
          data-character-names="@JsonSerializer.Serialize(Model.CharacterNames)"
          data-monster-timings="@JsonSerializer.Serialize(Model.MonsterTimings, jsonOptions)"
          class="create-form fade d2">
        @Html.AntiForgeryToken()
        <input asp-for="Tod.LinkshellId" type="hidden" />
        @if (isEditMode)
        {
            <input asp-for="Tod.Id" type="hidden" />
        }

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"
             style="display:@(ViewData.ModelState.IsValid ? "none" : "block"); margin-bottom:14px;"></div>

        <div class="create-form__header">
            <div>
                <strong>@formHeader</strong>
                <p>Log a kill and calculate the next repop window. Loot is recorded in the Loot section.</p>
            </div>
            <span class="tag accent">@selectedLinkshellName</span>
        </div>

        <div class="create-form__rows">
            @{
                // Model is always supplied by the action; capture Tod once as
                // non-null so the dropdown logic below stays free of null noise.
                var tod = Model!.Tod;
                // The option COVERING the stored name: the one it is, or -- since the three
                // NQ/HQ pairs are offered as one combined entry -- the one whose combined
                // label contains it. A ToD saved before the pairs were combined holds a bare
                // half ("Aspidochelone"); matching only on equality would leave it selecting
                // nothing and quietly demote a curated monster to a free-text "Other".
                var monsterOption = string.IsNullOrWhiteSpace(tod.MonsterName)
                    ? null
                    : Model.MonsterOptions.FirstOrDefault(m =>
                        string.Equals(m, tod.MonsterName, StringComparison.OrdinalIgnoreCase)
                        || m.Split('/').Any(half =>
                            string.Equals(half.Trim(), tod.MonsterName, StringComparison.OrdinalIgnoreCase)));
                var isCustomMonster = !string.IsNullOrWhiteSpace(tod.MonsterName) && monsterOption is null;
                var customMonsterValue = isCustomMonster
                    ? tod.MonsterName
                    : Model.CustomMonsterName;
                // Which of the conditional fields the picked monster actually answers for, so the
                // FIRST render already matches what the script does on every later change: Day and
                // HQ are merge-pair questions (only the three NQ/HQ families have a pop cycle), and
                // a pop window only means something on a monster with a spawn grid.
                LinkshellManagerDiscordApp.ViewModels.TodMonsterTimingHint? selectedHint = null;
                if (monsterOption is not null)
                {
                    Model.MonsterTimings.TryGetValue(monsterOption, out selectedHint);
                }
                var showDayNumber = selectedHint?.HasHqVariant == true;
                var showPopWindow = selectedHint?.HasSpawnGrid == true;
            }
            @* Lead row: the monster (plus its free-text name when "Other"), the day it is on, and
               whether the pop was HQ -- the same monster/day/HQ shape the Activity's form opens with. *@
            <div class="create-form__row">
                <label>
                    <span>Monster</span>
                    <select asp-for="Tod.MonsterName" id="monster-select" required>
                        <option value="">Select monster name</option>
                        @foreach (var monster in Model.MonsterOptions)
                        {
                            <option value="@monster"
                                    selected="@(string.Equals(monster, monsterOption, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                @monster
                            </option>
                        }
                        <option value="@TodManagerViewModel.OtherMonster" selected="@(isCustomMonster ? "selected" : null)">
                            Other (enter a name)
                        </option>
                    </select>
                    <span asp-validation-for="Tod.MonsterName" class="create-form__error"></span>
                </label>

                <label id="custom-monster-wrap" class="@(isCustomMonster ? "" : "d-none")">
                    <span>Monster name</span>
                    <input asp-for="CustomMonsterName" id="custom-monster-input" type="text"
                           maxlength="64" autocomplete="off" placeholder="Type the monster's name"
                           value="@customMonsterValue" />
                    <span asp-validation-for="CustomMonsterName" class="create-form__error"></span>
                </label>

                <label id="day-number-wrap" class="create-form__field--narrow @(showDayNumber ? "" : "d-none")">
                    <span>Day</span>
                    <input asp-for="Tod.DayNumber" id="day-number" type="number" min="1" step="1"
                           placeholder="—"
                           title="The monster's day in its cycle. Blank = not specified." />
                </label>

                <label class="create-form__field--auto">
                    <span>HQ</span>
                    <span class="create-form__toggle">
                        @* The shared pill toggle (site.css .switch) -- still a native checkbox, so
                           asp-for binding is unchanged; it just reads as the Activity's HQ switch. *@
                        <input asp-for="Tod.Hq" type="checkbox" class="switch" id="tod-hq" />
                        <span>Yes</span>
                    </span>
                </label>
            </div>

            @* Which window it popped on, and whether we claimed it. *@
            <div class="create-form__row create-form__row--pair">
                <label id="pop-window-wrap" class="@(showPopWindow ? "" : "d-none")">
                    <span>Popped on window</span>
                    <input asp-for="Tod.PopWindow" id="pop-window" type="number" min="1" step="1"
                           placeholder="—"
                           title="Which window the monster popped on. Blank = not recorded." />
                </label>

                <label>
                    <span>Claim</span>
                    <select asp-for="Tod.Claim" id="claim-select">
                        <option value="" selected="@(Model.Tod.Claim == null ? "selected" : null)">Not Specified</option>
                        <option value="true" selected="@(Model.Tod.Claim == true ? "selected" : null)">Yes</option>
                        <option value="false" selected="@(Model.Tod.Claim == false ? "selected" : null)">No</option>
                    </select>
                </label>
            </div>

            @* Time of death, and the cooldown it is measured from. *@
            <div class="create-form__row create-form__row--pair">
                <label>
                    <span>Time of death</span>
                    <input asp-for="Tod.Time" type="datetime-local" step="1" id="tod-time"
                           value="@Model.Tod.Time?.ToString("yyyy-MM-ddTHH:mm:ss")" />
                    <span asp-validation-for="Tod.Time" class="create-form__error"></span>
                </label>

                <label>
                    <span>Cooldown</span>
                    <span class="create-form__duration">
                        <input asp-for="CooldownValue" id="cooldown-value" type="number" min="1" step="1"
                               value="@cooldownValue" required
                               title="Pre-filled from this monster's configured cooldown. Change it for this ToD only." />
                        <select asp-for="CooldownUnit" id="cooldown-unit">
                            <option value="hours" selected="@(cooldownUnit == "hours" ? "selected" : null)">hours</option>
                            <option value="mins" selected="@(cooldownUnit == "mins" ? "selected" : null)">mins</option>
                        </select>
                    </span>
                    <span asp-validation-for="Tod.Cooldown" class="create-form__error"></span>
                </label>
            </div>

            @* The check cadence, and the fine seconds offset on top of the cooldown. *@
            <div class="create-form__row create-form__row--pair">
                <label>
                    <span>Interval</span>
                    <span class="create-form__duration">
                        @* Blank rather than a literal 0 when nothing is recorded, so the field
                           reads as its "Not specified" placeholder the way the Activity's does. *@
                        <input asp-for="IntervalValue" id="interval-value" type="number" min="1" step="1"
                               value="@(hasInterval ? intervalValue.ToString() : string.Empty)" placeholder="Not specified"
                               title="Pre-filled from this monster's configured cadence. Leave blank to record no interval." />
                        <select asp-for="IntervalUnit" id="interval-unit">
                            <option value="hours" selected="@(intervalUnit == "hours" ? "selected" : null)">hours</option>
                            <option value="mins" selected="@(intervalUnit == "mins" ? "selected" : null)">mins</option>
                        </select>
                    </span>
                    <span asp-validation-for="Tod.Interval" class="create-form__error"></span>
                </label>

                <label>
                    <span>Additional seconds</span>
                    <input asp-for="AdditionalSeconds" id="additional-seconds" type="number" min="0" step="1"
                           value="@Model.Tod.AdditionalSeconds" placeholder="0"
                           title="Extra seconds added on top of the cooldown when calculating the repop time" />
                </label>
            </div>

            @* Calculated repop: the summary on the left, the read-only repop time on the right. *@
            <div class="create-form__row create-form__repop">
                <div class="create-form__repop-info">
                    <div class="create-form__repop-label">Calculated repop</div>
                    <strong class="create-form__repop-value" id="repop-summary">Pick a date and time to calculate the next repop window.</strong>
                </div>
                <label>
                    <span>Repop time</span>
                    <input asp-for="Tod.RepopTime" type="datetime-local" step="1" id="repop-time"
                           value="@Model.Tod.RepopTime?.ToString("yyyy-MM-ddTHH:mm:ss")" readonly />
                </label>
            </div>
        </div>

        <div class="create-form__section">
            <div class="create-form__section-head">
                <h3>Screenshot (optional)</h3>
                <p style="margin:4px 0 0;color:var(--fg-4);font-size:12px">PNG, JPG, or WEBP. 5 MB max. Attached to the ToD record and viewable in the ToD details.</p>
            </div>
            @if (isEditMode && !string.IsNullOrWhiteSpace(Model.Tod?.ImagePath))
            {
                <div id="existing-image" style="margin-bottom:10px">
                    <div style="font-size:12px;color:var(--fg-4);margin-bottom:4px">Current screenshot:</div>
                    <a href="@Model.Tod.ImagePath" target="_blank" rel="noopener">
                        <img src="@Model.Tod.ImagePath" alt="Current screenshot"
                             style="max-width:280px;max-height:200px;border-radius:6px;border:1px solid var(--border,#222);display:block" />
                    </a>
                    <label style="display:inline-flex;align-items:center;gap:6px;margin-top:6px;font-size:12px;color:var(--fg-4)">
                        <input type="checkbox" name="clearImage" value="true" />
                        Remove this screenshot on save
                    </label>
                </div>
            }
            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                @if (isEditMode && !string.IsNullOrWhiteSpace(Model.Tod?.ImagePath))
                {
                    <span style="font-size:12px;color:var(--fg-4)">Replace screenshot:</span>
                }
                @* Native input is visually hidden (still posts + accessible);
                   the styled label is the modern, app-consistent trigger. *@
                <input type="file" name="UploadImage" id="upload-image"
                       accept="image/png,image/jpeg,image/webp"
                       style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);border:0" />
                <label for="upload-image" class="btn sm" style="cursor:pointer">Choose file</label>
                <span id="upload-image-name" style="font-size:12px;color:var(--fg-3)">No file chosen</span>
            </div>
            <div id="upload-image-preview" style="display:none;margin-top:10px">
                <img id="upload-image-thumb" alt="Screenshot preview"
                     style="max-width:280px;max-height:200px;border-radius:6px;border:1px solid var(--border,#222);display:block" />
                <button type="button" id="upload-image-clear"
                        style="margin-top:6px;padding:4px 10px;font-size:12px;background:transparent;border:1px solid var(--border,#222);border-radius:4px;color:var(--fg-4);cursor:pointer">
                    Remove screenshot
                </button>
            </div>
        </div>
        <script nonce="@Html.CspNonce()">
            (function () {
                var input = document.getElementById('upload-image');
                var preview = document.getElementById('upload-image-preview');
                var thumb = document.getElementById('upload-image-thumb');
                var clearBtn = document.getElementById('upload-image-clear');
                var nameLabel = document.getElementById('upload-image-name');
                if (!input || !preview || !thumb || !clearBtn) return;
                var currentUrl = null;

                function show(file) {
                    if (currentUrl) { URL.revokeObjectURL(currentUrl); currentUrl = null; }
                    currentUrl = URL.createObjectURL(file);
                    thumb.src = currentUrl;
                    preview.style.display = 'block';
                    if (nameLabel) nameLabel.textContent = file.name;
                }
                function hide() {
                    if (currentUrl) { URL.revokeObjectURL(currentUrl); currentUrl = null; }
                    thumb.removeAttribute('src');
                    preview.style.display = 'none';
                    input.value = '';
                    if (nameLabel) nameLabel.textContent = 'No file chosen';
                }

                input.addEventListener('change', function () {
                    var f = input.files && input.files[0];
                    if (f) show(f); else hide();
                });
                clearBtn.addEventListener('click', hide);
            })();
        </script>

        <script nonce="@Html.CspNonce()">
            (function () {
                var sel = document.getElementById('monster-select');
                var wrap = document.getElementById('custom-monster-wrap');
                var box = document.getElementById('custom-monster-input');
                if (!sel || !wrap || !box) return;
                function sync() {
                    var isOther = sel.value === '@TodManagerViewModel.OtherMonster';
                    wrap.classList.toggle('d-none', !isOther);
                    if (isOther) { box.focus(); } else { box.value = ''; }
                }
                sel.addEventListener('change', sync);
            })();
        </script>

        @* Loot is recorded in the dedicated Loot section, not here. *@
        <div class="create-form__actions" style="margin-top:14px">
            <button type="submit" class="btn primary">@(Model.CanCreateImmediately ? "Submit ToD" : "Submit for Approval")</button>
        </div>
        @if (!Model.CanCreateImmediately)
        {
            <p style="margin-top:8px;color:var(--fg-4);font-size:12px">Your submission will be reviewed by an officer before it goes live.</p>
        }
    </form>
}

@section Scripts {
    <script src="~/js/tod-manager.js" asp-append-version="true"></script>
}

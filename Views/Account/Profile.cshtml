@model ProfileViewModel
@using LinkshellManagerDiscordApp.Utils
@using System.Text.Json
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Profile";
    ViewData["BodyClass"] = "lsm-page";
    var antiforgeryTokens = Antiforgery.GetAndStoreTokens(Context);
    // Config consumed by profile-ratings.js (reuses the Activity job-rating API).
    var ratingsConfig = JsonSerializer.Serialize(new
    {
        linkshellId = Model.PrimaryLinkshellId,
        myAppUserId = Model.MyAppUserId,
        jobs = EventJobCatalog.MainJobOptions,
        relicOptions = JobRelicCatalog.Options,
        members = Model.RatingTeammates.Select(t => new { t.AppUserId, t.Name, t.Alt1, t.Alt2 })
    }, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
    var imageSource = Model.ProfileImageData is { Length: > 0 }
        ? $"data:image/png;base64,{Convert.ToBase64String(Model.ProfileImageData)}"
        : null;
    var displayName = string.IsNullOrWhiteSpace(Model.CharacterName) ? "Profile" : Model.CharacterName;
    var initials = string.IsNullOrWhiteSpace(Model.CharacterName)
        ? "?"
        : new string(Model.CharacterName!.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0]))
            .ToArray());
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Profile</h1>
        <div class="page-sub"><span>Your Discord-linked account</span></div>
    </div>
    <div class="page-actions">
        <a class="btn ghost" asp-controller="Dashboard" asp-action="Index">Back to dashboard</a>
    </div>
</div>

<div class="card fade d2" style="padding:20px;max-width:1100px;margin:0 auto">
    <form asp-action="UpdateProfile" method="post">
        <div asp-validation-summary="All" class="text-danger" style="margin-bottom:12px"></div>
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:20px;padding-bottom:16px;border-bottom:1px solid var(--border)">
            @if (imageSource is not null)
            {
                <img src="@imageSource" alt="Profile" style="width:72px;height:72px;border-radius:999px;object-fit:cover;border:1px solid var(--border)" />
            }
            else
            {
                <div aria-hidden="true" style="width:72px;height:72px;border-radius:999px;border:1px solid var(--border);background:var(--bg-2);color:var(--fg-2);display:flex;align-items:center;justify-content:center;font-weight:600;font-size:24px;letter-spacing:1px">@initials</div>
            }
            <div>
                <div style="font-weight:500;color:var(--fg)">@displayName</div>
                <div style="font-size:12px;color:var(--fg-3)">Profile image syncs from Discord</div>
            </div>
        </div>

        <div class="form-grid" style="grid-template-columns:repeat(2,minmax(0,1fr));column-gap:24px;align-items:start">
            <div class="field">
                <label asp-for="CharacterName"></label>
                <input asp-for="CharacterName" class="form-control" />
            </div>
            <div class="field">
                <label asp-for="TimeZone">Time zone (IANA)</label>
                <select asp-for="TimeZone" class="form-select">
                    <option value="">— Use server time —</option>
                    @foreach (var tz in Model.AvailableTimeZones)
                    {
                        <option value="@tz">@tz</option>
                    }
                </select>
            </div>
        </div>

        <div style="margin-top:16px;padding-top:12px;border-top:1px solid var(--border)">
            <div style="font-weight:500;color:var(--fg);margin-bottom:6px">Link Alternate Characters</div>
            <div style="font-size:12px;color:var(--fg-3);margin-bottom:10px">Add up to two extra characters tied to this account. Linkshell members can see them, but every action you take is still recorded under your main character.</div>
            <div class="form-grid" style="grid-template-columns:repeat(2,minmax(0,1fr));column-gap:24px;align-items:start">
                <div class="field">
                    <label asp-for="AltCharacterName1">Alternate character 1</label>
                    <input asp-for="AltCharacterName1" class="form-control" maxlength="64" placeholder="Optional alt character" />
                </div>
                <div class="field">
                    <label asp-for="AltCharacterName2">Alternate character 2</label>
                    <input asp-for="AltCharacterName2" class="form-control" maxlength="64" placeholder="Optional alt character" />
                </div>
            </div>
        </div>

        @if (Model.HasLinkshell)
        {
            var mainTabLabel = string.IsNullOrWhiteSpace(Model.CharacterName) ? "Main" : Model.CharacterName;
            var hasAlt1 = !string.IsNullOrWhiteSpace(Model.AltCharacterName1);
            var hasAlt2 = !string.IsNullOrWhiteSpace(Model.AltCharacterName2);

            <div style="margin-top:16px;padding-top:12px;border-top:1px solid var(--border)">
                <div style="font-weight:500;color:var(--fg);margin-bottom:6px">My Jobs</div>
                <div style="font-size:12px;color:var(--fg-3);margin-bottom:12px">
                    Set the level of each job you have (0 = not leveled, max @ProfileJobLevels.MaxLevel). These are
                    shared with your linkshells and the in-game addon's "can equip" loot filter.
                </div>

                @* Character tabs — main always; an alt tab appears once it's named.
                   All panels stay in the DOM so the form still submits every grid;
                   the script below just toggles which one is visible. *@
                <div class="jobtabs" role="tablist" style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px">
                    <button type="button" class="btn sm primary jobtab" data-jobtab="main">@mainTabLabel</button>
                    @if (hasAlt1)
                    {
                        <button type="button" class="btn sm jobtab" data-jobtab="alt1">@Model.AltCharacterName1</button>
                    }
                    @if (hasAlt2)
                    {
                        <button type="button" class="btn sm jobtab" data-jobtab="alt2">@Model.AltCharacterName2</button>
                    }
                </div>

                @{
                    // One descriptor per character panel (level + merited + merit
                    // notes + a JS ratings container, then a crafts grid). Alt panels
                    // are added only once the alt is named.
                    var jobPanels = new List<(string Key, int Slot, string Title, string JobsPrefix, string StrongPrefix, string MeritPrefix, string CraftsPrefix, List<int> Levels, List<bool> Strongs, List<string> Merits, List<int> Crafts, bool Hidden)>
                    {
                        ("main", 0, mainTabLabel, "JobLevels", "StrongJobs", "MeritJobs", "CraftLevels", Model.JobLevels, Model.StrongJobs, Model.MeritJobs, Model.CraftLevels, false)
                    };
                    if (hasAlt1)
                    {
                        jobPanels.Add(("alt1", 1, Model.AltCharacterName1!, "Alt1JobLevels", "Alt1StrongJobs", "Alt1MeritJobs", "Alt1CraftLevels", Model.Alt1JobLevels, Model.Alt1StrongJobs, Model.Alt1MeritJobs, Model.Alt1CraftLevels, true));
                    }
                    if (hasAlt2)
                    {
                        jobPanels.Add(("alt2", 2, Model.AltCharacterName2!, "Alt2JobLevels", "Alt2StrongJobs", "Alt2MeritJobs", "Alt2CraftLevels", Model.Alt2JobLevels, Model.Alt2StrongJobs, Model.Alt2MeritJobs, Model.Alt2CraftLevels, true));
                    }
                }

                @foreach (var p in jobPanels)
                {
                    <div class="jobtab-panel" data-jobpanel="@p.Key" hidden="@(p.Hidden ? "hidden" : null)">
                        <div style="font-size:13px;font-weight:500;color:var(--fg);margin-bottom:10px;padding-bottom:8px;border-bottom:1px solid var(--border)">@p.Title job levels &amp; ratings</div>
                        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:12px">
                            @for (var i = 0; i < EventJobCatalog.MainJobOptions.Length; i++)
                            {
                                var level = i < p.Levels.Count ? p.Levels[i] : 0;
                                var strong = i < p.Strongs.Count && p.Strongs[i];
                                var merit = i < p.Merits.Count ? p.Merits[i] : "";
                                <div class="jobcard" data-slot="@p.Slot" data-job="@i">
                                    <div style="display:flex;align-items:center;justify-content:space-between;gap:8px">
                                        <span style="font-size:12px;font-weight:600">@EventJobCatalog.MainJobOptions[i]</span>
                                        <input type="number" class="form-control" name="@(p.JobsPrefix)[@i]"
                                               value="@level" min="0" max="@ProfileJobLevels.MaxLevel" step="1" inputmode="numeric" style="width:64px;text-align:center" />
                                    </div>
                                    <label class="job-strong" title="Mark this job as merited" style="display:inline-flex;align-items:center;gap:5px;margin-top:8px;font-size:11px">
                                        <input type="checkbox" name="@(p.StrongPrefix)[@i]" value="true" @(strong ? "checked" : "") />
                                        <input type="hidden" name="@(p.StrongPrefix)[@i]" value="false" />
                                        <span>★ Merited</span>
                                    </label>
                                    <input type="text" class="form-control" name="@(p.MeritPrefix)[@i]"
                                           value="@merit" maxlength="500" placeholder="Describe merits" style="font-size:11px;margin-top:6px" />
                                    <div class="job-ratings" data-slot="@p.Slot" data-job="@i" style="margin-top:8px"></div>
                                </div>
                            }
                        </div>

                        <div style="font-size:13px;font-weight:500;color:var(--fg);margin:18px 0 10px;padding-bottom:8px;border-bottom:1px solid var(--border)">@p.Title crafts</div>
                        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:10px 16px">
                            @for (var c = 0; c < CraftCatalog.Names.Count; c++)
                            {
                                var clvl = c < p.Crafts.Count ? p.Crafts[c] : 0;
                                <div class="field" style="margin:0">
                                    <label style="font-size:12px">@CraftCatalog.Names[c]</label>
                                    <input type="number" class="form-control" name="@(p.CraftsPrefix)[@c]"
                                           value="@clvl" min="0" max="110" step="1" inputmode="numeric" />
                                </div>
                            }
                        </div>

                        <div class="peer-feedback" data-slot="@p.Slot" data-name="@p.Title" style="margin-top:18px"></div>
                    </div>
                }
            </div>
        }

        <div style="display:flex;gap:8px;margin-top:20px;padding-top:16px;border-top:1px solid var(--border)">
            <button type="submit" class="btn primary">Save profile</button>
            <a class="btn ghost" asp-controller="Dashboard" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@if (Model.HasLinkshell && Model.PrimaryLinkshellId > 0)
{
    <div class="card fade d3" id="rateTeammatesCard" style="padding:20px;max-width:1100px;margin:16px auto 0">
        <div style="margin-bottom:12px">
            <div style="font-size:11px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:var(--accent)">Feedback</div>
            <h2 style="font-size:18px;font-weight:600;margin:4px 0 0">Rate teammates</h2>
            <div style="font-size:12px;color:var(--fg-3);margin-top:4px">Rate another member's gear &amp; skill per job, and leave a short note. They see anonymous averages and an AI summary.</div>
        </div>
        <div class="field" style="max-width:340px">
            <label for="rateMemberSearch" style="font-size:12px">Search member</label>
            <input id="rateMemberSearch" class="form-control" placeholder="Filter by character name…" autocomplete="off" />
        </div>
        <div class="field" style="max-width:340px;margin-top:10px">
            <label for="rateMemberSelect" style="font-size:12px">Member</label>
            <select id="rateMemberSelect" class="form-select"></select>
        </div>
        <div class="field" id="rateCharacterField" style="max-width:340px;margin-top:10px;display:none">
            <label for="rateCharacterSelect" style="font-size:12px">Character</label>
            <select id="rateCharacterSelect" class="form-select"></select>
        </div>
        <div id="rateGrid" style="margin-top:14px"></div>
        <div id="rateComment" style="margin-top:14px;display:none">
            <label for="rateCommentBox" style="font-size:12px;font-weight:500">Note about this teammate (private to them, anonymous)</label>
            <textarea id="rateCommentBox" class="form-control" rows="3" maxlength="1000" placeholder="e.g. Great on WHM, needs gear on BLM…"></textarea>
            <button type="button" class="btn ghost sm" id="rateCommentSave" style="margin-top:8px">Save note</button>
            <span id="rateCommentStatus" style="font-size:11px;color:var(--fg-3);margin-left:8px"></span>
        </div>
    </div>
}

@{
    // The addon step only counts toward onboarding when the addon is available
    // (global kill-switch off).
    var totalSteps = Model.AddonAvailable ? 3 : 2;
    var completedSteps =
        (Model.ProfileComplete ? 1 : 0) +
        (Model.HasLinkshell ? 1 : 0) +
        (Model.AddonAvailable && Model.AddonConfigured ? 1 : 0);
}

<div class="card fade d3" style="padding:20px;max-width:720px;margin:16px auto 0">
    <div style="display:flex;justify-content:space-between;align-items:start;margin-bottom:16px">
        <div>
            <div style="font-size:11px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:var(--accent)">Onboarding</div>
            <h2 style="font-size:18px;font-weight:600;margin:4px 0 0">Next Steps</h2>
        </div>
        <span class="tag">@completedSteps/@totalSteps</span>
    </div>

    <ul style="list-style:none;padding:0;margin:0;display:grid;gap:8px">
        <li style="display:flex;gap:12px;align-items:start;padding:12px;border:1px solid var(--border);border-radius:8px">
            @if (Model.ProfileComplete)
            {
                <span class="tag success">Done</span>
            }
            else
            {
                <span class="tag">1</span>
            }
            <div>
                <div style="font-weight:500;color:var(--fg)">Finish your operator profile</div>
                <div style="font-size:12px;color:var(--fg-3);margin-top:2px">Set your character name and time zone so roster and event timing are accurate.</div>
            </div>
        </li>
        <li style="display:flex;gap:12px;align-items:start;padding:12px;border:1px solid var(--border);border-radius:8px">
            @if (Model.HasLinkshell)
            {
                <span class="tag success">Done</span>
            }
            else
            {
                <span class="tag">2</span>
            }
            <div style="flex:1">
                <div style="font-weight:500;color:var(--fg)">Create or join a linkshell</div>
                <div style="font-size:12px;color:var(--fg-3);margin-top:2px">Linkshell membership unlocks invites, roster controls, and event management.</div>
                @if (!Model.HasLinkshell)
                {
                    <div style="margin-top:8px">
                        <a class="btn ghost sm" asp-controller="Linkshell" asp-action="Index">Browse linkshells</a>
                        <a class="btn primary sm" asp-controller="Linkshell" asp-action="Create" style="margin-left:6px">Create linkshell</a>
                    </div>
                }
            </div>
        </li>
        @if (Model.AddonAvailable)
        {
            <li style="display:flex;gap:12px;align-items:start;padding:12px;border:1px solid var(--border);border-radius:8px">
                @if (Model.AddonConfigured)
                {
                    <span class="tag success">Done</span>
                }
                else
                {
                    <span class="tag">3</span>
                }
                <div style="flex:1">
                    <div style="font-weight:500;color:var(--fg)">Set up the addon</div>
                    <div style="font-size:12px;color:var(--fg-3);margin-top:2px">Pair the in-game addon to this account so kills, attendance, and loot drops post automatically.</div>
                    @if (!Model.AddonConfigured && Model.HasLinkshell)
                    {
                        <div style="margin-top:8px">
                            <a class="btn primary sm" asp-controller="Linkshell" asp-action="Customize">Open pairing</a>
                        </div>
                    }
                </div>
            </li>
        }
    </ul>
</div>

@section Scripts {
    <script nonce="@Html.CspNonce()">
        (function () {
            var tabs = document.querySelectorAll('.jobtab');
            var panels = document.querySelectorAll('.jobtab-panel');
            if (!tabs.length) { return; }
            tabs.forEach(function (tab) {
                tab.addEventListener('click', function () {
                    var target = tab.getAttribute('data-jobtab');
                    tabs.forEach(function (t) { t.classList.toggle('primary', t === tab); });
                    panels.forEach(function (p) {
                        p.hidden = p.getAttribute('data-jobpanel') !== target;
                    });
                    if (window.LSMProfileRatings) { window.LSMProfileRatings.onTabShown(target); }
                });
            });
        })();
    </script>
    @if (Model.HasLinkshell && Model.PrimaryLinkshellId > 0)
    {
        <script type="application/json" id="profile-ratings-config" nonce="@Html.CspNonce()">@Html.Raw(ratingsConfig)</script>
        <script nonce="@Html.CspNonce()">
            window.LSM_CSRF_HEADER = '@antiforgeryTokens.HeaderName';
            window.LSM_CSRF_TOKEN = '@antiforgeryTokens.RequestToken';
        </script>
        <script src="~/js/profile-ratings.js" asp-append-version="true" defer></script>
    }
}

        <button type="button" class="nav-item nav-group @IsExpanded("ManageItem")" data-target="#nav-items">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 2l3 7h7l-5.5 4.5L18 21l-6-4-6 4 1.5-7.5L2 9h7z"/></svg>
            Items
            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M9 6l6 6-6 6"/></svg>
        </button>
        <div id="nav-items" class="nav-sub">
            <a class="nav-sub-item @IsSubActive("ManageItem", "Index")" asp-controller="ManageItem" asp-action="Index">View Items</a>
            @if (Allow(p => p.CanManageInventory))
            {
                <a class="nav-sub-item create @IsSubActive("ManageItem", "AddItem")" asp-controller="ManageItem" asp-action="AddItem">Add Item</a>
            }
        </div>
    </nav>

    <nav class="nav-section">
        <div class="nav-label">Pages</div>
        <a class="nav-item @IsSubActive("Account", "Profile")" asp-controller="Account" asp-action="Profile">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-7 8-7s8 3 8 7"/></svg>
            Profile

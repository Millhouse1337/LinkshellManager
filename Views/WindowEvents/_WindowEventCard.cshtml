@model LinkshellManagerDiscordApp.ViewModels.WindowEventRow
@using LinkshellManagerDiscordApp.Models
@{
    var linkshellId = (int)(ViewData["LinkshellId"] ?? 0);
    var canManage = (bool)(ViewData["CanManage"] ?? false);
    var isClosed = (bool)(ViewData["IsClosed"] ?? false);
    var alreadyPosted = Model.PostedToSheetAt.HasValue;
    var dkpFormId = $"window-event-form-{Model.Id}";

    string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value!;
    string FormatDkp(double? value) => value.HasValue
        ? value.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)
        : "";

    var effectiveDkpByCharacter = Model.CombinedMembers
        .GroupBy(m => m.CharacterName.Trim(), StringComparer.OrdinalIgnoreCase)
        .ToDictionary(g => g.Key, g => g.First().EffectiveDkpAmount, StringComparer.OrdinalIgnoreCase);
    var memberDkpStartIndex = 0;
    var memberDkpDefault = Model.DkpAmount ?? 1.5;
}

<article class="card fade d4 we-card" style="margin-top:14px">
    <header class="we-card__head">
        <div class="we-card__title-group">
            <span class="attendance-crystal" aria-hidden="true"></span>
            <h3 class="we-card__title">@Dash(Model.Name)</h3>
            <span class="we-card__meta">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                @Model.FirstCapturedDisplay
            </span>
            @if (Model.DuplicateSnapshotCount > 0)
            {
                <span class="tag warning">@Model.DuplicateSnapshotCount duplicate review</span>
            }
            @if (isClosed)
            {
                <span class="tag">Closed</span>
            }
        </div>
        <div class="we-card__counts">
            <span class="we-count">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
                @Model.CombinedMemberCount member@(Model.CombinedMemberCount == 1 ? "" : "s")
            </span>
            <span class="we-count">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 9h18"/></svg>
                @Model.SnapshotCount snapshot@(Model.SnapshotCount == 1 ? "" : "s")
            </span>
        </div>
    </header>

    @if (canManage)
    {
        <div class="we-card__controls">
            <form asp-action="Rename" asp-route-linkshellId="@linkshellId" asp-route-windowEventId="@Model.Id"
                  method="post" class="we-action-form we-rename-form">
                @Html.AntiForgeryToken()
                <input class="input we-rename-input" type="text" name="name" value="@Model.Name" maxlength="128" required />
                <button type="submit" class="btn sm">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
                    Rename
                </button>
            </form>
            @if (alreadyPosted)
            {
                <form id="@dkpFormId"
                      class="we-card__form"
                      asp-action="EditPostedDetails"
                      asp-route-linkshellId="@linkshellId"
                      asp-route-windowEventId="@Model.Id"
                      method="post"
                      onsubmit="return confirm('Update DKP / Entry Type on the @(Model.CombinedMemberCount) already-posted row(s)? This rewrites cells J and K in the sheet and adjusts DKP totals.');">
                    @Html.AntiForgeryToken()
                    <label class="we-field">
                        <span class="we-field__label">Default DKP</span>
                        <input class="input we-field__input" type="number" name="dkpAmount" step="0.25" min="0"
                               value="@(Model.DkpAmount?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "1.5")"
                               required />
                    </label>
                    <label class="we-field">
                        <span class="we-field__label">Entry type</span>
                        <select class="form-select we-field__select" name="entryType" required>
                            <option value="">(select)</option>
                            @foreach (var type in WindowEventEntryTypes.All)
                            {
                                <option value="@type" selected="@(Model.EntryType == type)">@type</option>
                            }
                        </select>
                    </label>
                </form>
            }
            else
            {
                <form id="@dkpFormId" class="we-card__form" method="post">
                    @Html.AntiForgeryToken()
                    <label class="we-field">
                        <span class="we-field__label">Default DKP</span>
                        <input class="input we-field__input" type="number" name="dkpAmount" step="0.25" min="0"
                               value="@(Model.DkpAmount?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "1.5")"
                               required />
                    </label>
                    <label class="we-field">
                        <span class="we-field__label">Entry type</span>
                        <select class="form-select we-field__select" name="entryType" required>
                            <option value="">(select)</option>
                            @foreach (var type in WindowEventEntryTypes.All)
                            {
                                <option value="@type" selected="@(Model.EntryType == type)">@type</option>
                            }
                        </select>
                    </label>
                </form>
            }

            <div class="we-card__actions">
                @if (isClosed)
                {
                    <form asp-action="Reopen" asp-route-linkshellId="@linkshellId" asp-route-windowEventId="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn sm">Reopen</button>
                    </form>
                }
                else
                {
                    <form asp-action="Close" asp-route-linkshellId="@linkshellId" asp-route-windowEventId="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn sm ghost">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/></svg>
                            Close Event
                        </button>
                    </form>
                }
                <form asp-action="Delete" asp-route-linkshellId="@linkshellId" asp-route-windowEventId="@Model.Id" method="post"
                      onsubmit="return confirm('Are you sure you want to delete this event @(Model.Name ?? "(unnamed)") ?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn sm danger-outline" title="Delete Event" aria-label="Delete Event">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                        Delete Event
                    </button>
                </form>
            </div>
        </div>
    }

    <section class="we-roster">
        <div class="we-roster__subtitle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="14" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
            <span class="we-roster__subtitle-main">Combined roster</span>
            <span class="we-roster__subtitle-help">— excludes duplicates and ignored snapshots</span>
        </div>
        <div class="we-table__scroll">
            <table class="we-table">
                <thead>
                    <tr>
                        <th>Character</th>
                        <th>Jobs</th>
                        <th>Zone</th>
                        <th class="num">Snapshots</th>
                        <th class="num">Combined DKP</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var member in Model.CombinedMembers)
                {
                    <tr>
                        <td><strong>@member.CharacterName</strong></td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(member.MainJob))
                            {
                                <span class="we-job-pill">@(member.MainJob)@(member.MainJobLevel?.ToString())</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(member.SubJob))
                            {
                                <span class="we-job-pill we-job-pill--sub">@(member.SubJob)@(member.SubJobLevel?.ToString())</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(member.Zone))
                            {
                                <span class="we-zone">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                    @member.Zone.Replace('_', ' ')
                                </span>
                            }
                            else
                            {
                                <span class="we-muted">-</span>
                            }
                        </td>
                        <td class="num">@member.SnapshotCount</td>
                        <td class="num">
                            @* Always show a value: fall back to the event's
                               default DKP (or the 1.5 baseline) when neither a
                               per-character override nor a saved WindowEvent
                               DkpAmount exists yet — matches the per-snapshot
                               input's seeded value so the column is never "-". *@
                            @FormatDkp(member.EffectiveDkpAmount ?? memberDkpDefault)
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (canManage)
        {
            <div class="we-roster__submit">
                @if (alreadyPosted)
                {
                    <span class="we-posted-meta">Posted to DKP sheet on <strong>@Model.PostedToSheetDisplay</strong></span>
                    <button type="submit" form="@dkpFormId" class="btn sm primary">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M12 19V5"/><polyline points="5 12 12 5 19 12"/></svg>
                        Update on DKP sheet
                    </button>
                }
                else
                {
                    <button type="submit" form="@dkpFormId" class="btn sm primary"
                            formaction="@Url.Action("PostToSheet", new { linkshellId, windowEventId = Model.Id })"
                            onclick="return confirm('Post @(Model.CombinedMemberCount) row(s) to the DKP sheet AttInput tab? This cannot be undone.');">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M12 19V5"/><polyline points="5 12 12 5 19 12"/></svg>
                        Post to DKP sheet
                    </button>
                }
            </div>
        }
    </section>

    @if (Model.Snapshots.Any())
    {
        <section class="we-snapshots">
            @foreach (var snapshot in Model.Snapshots)
            {
                var snapshotDeleteForm = $"snapshot-delete-{snapshot.Id}";
                if (canManage)
                {
                    <form id="@snapshotDeleteForm" asp-action="DeleteSnapshot"
                          asp-route-linkshellId="@linkshellId" asp-route-snapshotId="@snapshot.Id"
                          method="post" class="we-hidden-form"
                          onsubmit="return confirm('Permanently delete this snapshot posted by @Dash(snapshot.CapturedByCharacterName)? This cannot be undone.');">
                        @Html.AntiForgeryToken()
                    </form>
                }
                <details class="we-snapshot">
                    <summary class="we-snapshot__head">
                        <span class="we-snapshot__caret" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><polyline points="9 6 15 12 9 18"/></svg>
                        </span>
                        <span class="we-snapshot__title">
                            <strong>@snapshot.CapturedAtDisplay</strong>
                            <span class="we-snapshot__meta">· posted by <strong>@Dash(snapshot.CapturedByCharacterName)</strong> · @snapshot.EntryCount member@(snapshot.EntryCount == 1 ? "" : "s")</span>
                            @if (snapshot.SnapshotStatus != AttendanceSnapshotStatuses.Active)
                            {
                                <span class="tag warning">@snapshot.SnapshotStatus</span>
                            }
                        </span>
                        @if (canManage)
                        {
                            <span class="we-snapshot__actions" onclick="event.stopPropagation()">
                                <button form="@snapshotDeleteForm" type="submit"
                                        class="btn sm danger-outline">Delete snapshot</button>
                            </span>
                        }
                    </summary>
                    @{
                        var snapshotEntriesViewData = new ViewDataDictionary(ViewData)
                        {
                            ["MemberDkpFormId"] = canManage ? dkpFormId : null,
                            ["MemberDkpEffectiveByCharacter"] = effectiveDkpByCharacter,
                            ["MemberDkpStartIndex"] = memberDkpStartIndex,
                            ["MemberDkpDefault"] = memberDkpDefault,
                        };
                        memberDkpStartIndex += snapshot.Entries.Count;
                    }
                    @await Html.PartialAsync("_WindowSnapshotEntries", snapshot, snapshotEntriesViewData)
                </details>
            }
        </section>
    }

    @if (canManage)
    {
        // Keeps per-row DKP inputs in sync with the Default DKP value above
        // for any row the officer hasn't manually touched. Once an officer
        // edits an individual row, that row stops following the default.
        <script>
            (function () {
                var form = document.getElementById('@dkpFormId');
                if (!form) return;
                var defaultInput = form.querySelector('input[name="dkpAmount"]');
                if (!defaultInput) return;
                var followers = document.querySelectorAll(
                    'input.js-member-dkp[data-window-event-form="@dkpFormId"]');
                followers.forEach(function (f) {
                    f.addEventListener('input', function () {
                        f.dataset.followsDefault = 'false';
                    });
                });
                defaultInput.addEventListener('input', function () {
                    followers.forEach(function (f) {
                        if (f.dataset.followsDefault === 'true') {
                            f.value = defaultInput.value;
                        }
                    });
                });
            })();
        </script>
    }
</article>

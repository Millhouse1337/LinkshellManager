@using LinkshellManagerDiscordApp.Services
@model DkpImportPreviewViewModel
@{
    ViewData["Title"] = "Review DKP Import";
    ViewData["BodyClass"] = "lsm-page";

    string KindLabel(DkpImportRowKind k) => k switch
    {
        DkpImportRowKind.Create => "New",
        DkpImportRowKind.Update => "Update",
        DkpImportRowKind.Ambiguous => "Skipped",
        _ => "Skipped",
    };
    string KindColor(DkpImportRowKind k) => k switch
    {
        DkpImportRowKind.Create => "var(--green-main)",
        DkpImportRowKind.Update => "var(--blue-main)",
        _ => "var(--orange-main)",
    };
    string Num(double v) => v.ToString("0.##");
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Review DKP Import</h1>
        <div class="page-sub"><span>@Model.LinkshellName · @Model.Preview.SourceLabel</span></div>
    </div>
    <div class="page-actions">
        <a class="btn ghost" asp-action="Customize" asp-route-id="@Model.LinkshellId">Cancel</a>
    </div>
</div>

<div class="card fade d2" style="margin-bottom:16px">
    <div class="card-head">
        <div class="card-title">Summary</div>
    </div>
    <div style="padding:12px 16px;display:flex;gap:18px;flex-wrap:wrap;font-size:13px">
        <span><strong style="color:var(--blue-main)">@Model.Preview.UpdateCount</strong> existing member(s) to update</span>
        <span><strong style="color:var(--green-main)">@Model.Preview.CreateCount</strong> new member(s) to create</span>
        @if (Model.Preview.AmbiguousCount > 0)
        {
            <span><strong style="color:var(--orange-main)">@Model.Preview.AmbiguousCount</strong> ambiguous (skipped)</span>
        }
        @if (Model.Preview.ClampedCount > 0)
        {
            <span><strong style="color:var(--orange-main)">@Model.Preview.ClampedCount</strong> negative balance(s) will import as 0</span>
        }
    </div>
</div>

<div class="card fade d3" style="margin-bottom:16px">
    <div class="card-head">
        <div class="card-title">Rows</div>
    </div>
    <div style="padding:4px 8px 12px;overflow-x:auto">
        <table class="table" style="width:100%">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Status</th>
                    <th style="text-align:right">Current DKP</th>
                    <th style="text-align:right">Total</th>
                    <th style="text-align:right">Spent</th>
                    <th>Note</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Preview.Rows)
                {
                    var c = KindColor(row.Kind);
                    var tagStyle = $"color:{c};border-color:color-mix(in srgb, {c} 35%, transparent);background:color-mix(in srgb, {c} 14%, transparent)";
                    <tr>
                        <td>
                            @row.Name
                            @if (!string.IsNullOrWhiteSpace(row.MatchedExistingName) && !string.Equals(row.MatchedExistingName, row.Name, StringComparison.OrdinalIgnoreCase))
                            {
                                <span style="color:var(--text-muted);font-size:11px"> → @row.MatchedExistingName</span>
                            }
                        </td>
                        <td>
                            <span class="tag" style="@tagStyle">@KindLabel(row.Kind)</span>
                        </td>
                        <td style="text-align:right">
                            @if (row.Kind == DkpImportRowKind.Update)
                            {
                                <span style="color:var(--text-muted)">@Num(row.OldCurrent)</span> <span style="color:var(--text-muted)">→</span> <strong>@Num(row.NewCurrent)</strong>
                            }
                            else
                            {
                                <strong>@Num(row.NewCurrent)</strong>
                            }
                        </td>
                        <td style="text-align:right">@Num(row.NewTotal)</td>
                        <td style="text-align:right">@Num(row.NewSpent)</td>
                        <td style="color:var(--text-muted);font-size:11px">@row.Note</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<form method="post" asp-action="CommitDkpImport" class="fade d3" style="display:flex;gap:10px;align-items:center">
    @Html.AntiForgeryToken()
    <input type="hidden" name="linkshellId" value="@Model.LinkshellId" />
    <input type="hidden" name="sourceLabel" value="@Model.Preview.SourceLabel" />
    <input type="hidden" name="rowsJson" value="@Model.RowsJson" />
    <button type="submit" class="btn primary">Confirm import</button>
    <a class="btn ghost" asp-action="Customize" asp-route-id="@Model.LinkshellId">Cancel</a>
</form>

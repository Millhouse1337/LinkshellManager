@model DataAdminIndexViewModel
@{
    ViewData["Title"] = "Data Admin";
    ViewData["BodyClass"] = "lsm-page";
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Data Admin</h1>
        <div class="page-sub">
            <span><span class="num">@Model.ShownCount</span> of @Model.CatalogCount tables shown</span>
            <span class="tag accent">Super admin</span>
        </div>
    </div>
    <div class="page-actions">
        <a class="btn primary" asp-action="Tables">Choose tables</a>
    </div>
</div>

<partial name="~/Views/DataAdmin/_Flash.cshtml" />

@if (Model.Groups.Count == 0)
{
    <div class="card fade d2">
        <div class="empty">
            <div style="font-size:15px;color:var(--fg);font-weight:500;margin-bottom:6px">No tables are shown yet</div>
            <div style="margin-bottom:12px">Pick the tables you want to browse and edit. They are grouped by what deletes them, so related tables stay together.</div>
            <a class="btn primary" asp-action="Tables">Choose tables</a>
        </div>
    </div>
}
else
{
    foreach (var group in Model.Groups)
    {
        <div class="card fade d2" style="margin-bottom:16px">
            <div class="card-head">
                <div class="card-title">@group.RootName</div>
                <span class="tag">@group.Cards.Count table@(group.Cards.Count == 1 ? "" : "s")</span>
            </div>
            <table class="table themed">
                <thead>
                    <tr>
                        <th>Table</th>
                        <th>Database table</th>
                        <th>Access</th>
                        <th style="text-align:right">Rows</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var card in group.Cards)
                    {
                        <tr>
                            <td style="font-weight:500">@card.DisplayName</td>
                            <td class="muted" style="font-size:12px">@card.TableName</td>
                            <td>
                                <div style="display:flex;flex-wrap:wrap;gap:4px">
                                    @if (!card.CanCreate && !card.CanEdit && !card.CanDelete)
                                    {
                                        <span class="tag">Read-only</span>
                                    }
                                    else
                                    {
                                        if (card.CanCreate) { <span class="tag success">Add</span> }
                                        if (card.CanEdit) { <span class="tag success">Edit</span> }
                                        if (card.CanDelete) { <span class="tag warning">Delete</span> }
                                    }
                                    @if (card.DiscordSideEffect is not null)
                                    {
                                        <span class="tag accent" title="@card.DiscordSideEffect">Discord</span>
                                    }
                                </div>
                            </td>
                            <td class="num" style="text-align:right">@card.RowCount.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@using LinkshellManagerDiscordApp.Utils
@model IEnumerable<LinkshellManagerDiscordApp.ViewModels.RuleViewModel>
@{
    ViewData["Title"] = "Rules";
    ViewData["BodyClass"] = "lsm-page";
    var canManage = (bool)(ViewBag.CanManage ?? false);
    var linkshellName = ViewBag.LinkshellName as string;
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Rules</h1>
        <div class="page-sub">
            @if (!string.IsNullOrWhiteSpace(linkshellName))
            {
                <span>@linkshellName</span>
                <span class="dot"> · </span>
            }
            <span><span class="num">@Model.Count()</span> rule@(Model.Count() == 1 ? "" : "s")</span>
        </div>
    </div>
    @if (canManage)
    {
        <div class="page-actions">
            <a class="btn primary" asp-action="Create">+ Create rule</a>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="card fade d2">
        <div class="empty">
            <div style="font-size:15px;color:var(--fg);font-weight:500;margin-bottom:6px">No rules yet</div>
            <div style="margin-bottom:12px">
                @if (canManage)
                {
                    <span>Add rules so members know what's expected.</span>
                }
                else
                {
                    <span>Your linkshell hasn't published any rules.</span>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="rule-list fade d2">
        @{ var ruleIndex = 0; }
        @foreach (var rule in Model)
        {
            var badge = RuleContent.Badge(rule.Category, ruleIndex);
            var blocks = RuleContent.Parse(rule.RuleDetails);
            ruleIndex++;
            <article class="rule-card @badge.Accent">
                <div class="rule-ico">@badge.Icon</div>

                <div class="rule-content">
                    <h3>@rule.RuleTitle</h3>
                    @if (blocks.Count == 0)
                    {
                        <p>@rule.RuleDetails</p>
                    }
                    @foreach (var block in blocks)
                    {
                        if (block.IsList)
                        {
                            <ul class="@(block.Items.Count > 4 ? "cols" : null)">
                                @foreach (var item in block.Items)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p>@block.Text</p>
                        }
                    }
                </div>

                <div class="rule-meta">
                    @if (!string.IsNullOrWhiteSpace(rule.Category))
                    {
                        <span class="rule-tag">@rule.Category</span>
                    }
                    <span class="rule-by">
                        @if (!string.IsNullOrWhiteSpace(rule.CreatedByCharacterName))
                        {
                            <span>Added by @rule.CreatedByCharacterName</span>
                            <span class="dot"> · </span>
                        }
                        <span>@rule.CreatedAt.ToString("MMM d, yyyy")</span>
                    </span>
                    @if (rule.CanManage)
                    {
                        <div class="rule-tools">
                            <a class="rule-iconbtn" asp-action="Edit" asp-route-id="@rule.Id" title="Edit" aria-label="Edit rule">✎</a>
                            <form asp-action="Delete" asp-route-id="@rule.Id" method="post" style="display:inline"
                                  onsubmit="return confirm('Delete this rule?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="rule-iconbtn danger" title="Delete" aria-label="Delete rule">🗑</button>
                            </form>
                        </div>
                    }
                </div>
            </article>
        }
    </div>
}

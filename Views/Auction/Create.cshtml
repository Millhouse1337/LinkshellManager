@model LinkshellManagerDiscordApp.ViewModels.AuctionViewModel
@{
    ViewData["Title"] = "Create Auction";
    ViewData["BodyClass"] = "lsm-page";
    var sourceItemsJson = System.Text.Json.JsonSerializer.Serialize(Model.SourceItems);
}

<style>
    /* Centre each item-row column above its input (Source / Item name /
       Item type / Starting DKP). Scoped to auction rows so other create
       forms keep their existing left-aligned labels. */
    .auction-item-row .create-form__grid > label > span {
        text-align: center;
    }
    .auction-item-row .create-form__grid > label.create-form__field--full > span {
        text-align: left; /* Notes spans the row -- keep its label flush left */
    }
</style>

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Create auction</h1>
        <div class="page-sub"><span>Schedule the window, add item rows, and manually start it when you are ready</span></div>
    </div>
</div>

<form asp-action="Create" method="post" id="auctionForm" class="create-form fade d2">
    <input asp-for="LinkshellId" type="hidden" />

    <div class="create-form__grid">
        <label>
            <span>Title</span>
            <input asp-for="Auction.AuctionTitle" required />
            <span asp-validation-for="Auction.AuctionTitle" class="create-form__error"></span>
        </label>
        <label>
            <span>Start time</span>
            <input asp-for="Auction.StartTime" type="datetime-local" required />
            <span asp-validation-for="Auction.StartTime" class="create-form__error"></span>
        </label>
        <label>
            <span>End time</span>
            <input asp-for="Auction.EndTime" type="datetime-local" required />
            <span asp-validation-for="Auction.EndTime" class="create-form__error"></span>
        </label>
    </div>

    <div class="create-form__section">
        <div class="create-form__section-head">
            <h3>Items</h3>
            <button type="button" class="btn ghost sm" id="addAuctionItemButton">+ Add item</button>
        </div>

        <div id="auctionItems" class="create-form__items">
            @for (var i = 0; i < Model.AuctionItems.Count; i++)
            {
                <div class="create-form__item auction-item-row" data-index="@i">
                    <input asp-for="AuctionItems[i].Id" type="hidden" />
                    @* SourceItemId (int?) is posted via this hidden input; the
                       visible Source select is UI-only and drives the hidden
                       field + the Gil-amount field via JS. The "gil" sentinel
                       never reaches the int? binder. *@
                    <input asp-for="AuctionItems[i].SourceItemId" type="hidden" class="auction-item-source-id" />
                    <div class="create-form__grid">
                        <label>
                            <span>Source</span>
                            <select class="auction-item-source"
                                    data-current-source="@(Model.AuctionItems[i].GilAmount.HasValue ? "gil" : (Model.AuctionItems[i].SourceItemId?.ToString() ?? ""))">
                                <option value="">External (not from inventory)</option>
                                <option value="gil">Gil (sell for DKP)</option>
                                @foreach (var option in Model.SourceItems)
                                {
                                    <option value="@option.Id"
                                            data-name="@option.ItemName"
                                            data-type="@option.ItemType">
                                        @option.ItemName (@option.Quantity on hand)
                                    </option>
                                }
                            </select>
                        </label>
                        <label class="auction-item-name-field">
                            <span>Item name</span>
                            <input asp-for="AuctionItems[i].ItemName" class="auction-item-name" />
                            <span asp-validation-for="AuctionItems[i].ItemName" class="create-form__error"></span>
                        </label>
                        <label class="auction-item-gil-field">
                            <span>Gil amount</span>
                            <input asp-for="AuctionItems[i].GilAmount" type="number" min="1" class="auction-item-gil" />
                            <span asp-validation-for="AuctionItems[i].GilAmount" class="create-form__error"></span>
                        </label>
                        <label>
                            <span>Item type</span>
                            <input asp-for="AuctionItems[i].ItemType" class="auction-item-type" />
                        </label>
                        <label>
                            <span>Starting DKP</span>
                            <input asp-for="AuctionItems[i].StartingBidDkp" type="number" min="0" />
                            <span asp-validation-for="AuctionItems[i].StartingBidDkp" class="create-form__error"></span>
                        </label>
                        <label class="create-form__field--full">
                            <span>Notes</span>
                            <input asp-for="AuctionItems[i].Notes" />
                        </label>
                    </div>
                    <div class="create-form__item-actions">
                        <button type="button" class="btn ghost sm remove-auction-item">Remove row</button>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="create-form__actions">
        <button type="submit" class="btn primary">Create auction</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script nonce="@Html.CspNonce()">
        (() => {
            const itemsContainer = document.getElementById('auctionItems');
            const addItemButton = document.getElementById('addAuctionItemButton');
            const sourceItems = @Html.Raw(sourceItemsJson);

            const renumberRows = () => {
                const rows = itemsContainer.querySelectorAll('.auction-item-row');
                rows.forEach((row, index) => {
                    row.dataset.index = index;
                    row.querySelectorAll('input, select, label, span').forEach((element) => {
                        ['name', 'id', 'for'].forEach((attribute) => {
                            const value = element.getAttribute(attribute);
                            if (!value) { return; }
                            element.setAttribute(attribute, value
                                .replace(/AuctionItems\[\d+\]/g, `AuctionItems[${index}]`)
                                .replace(/AuctionItems_\d+__/g, `AuctionItems_${index}__`));
                        });
                    });
                });
            };

            const buildSourceOptions = () => {
                const externalLabel = '<option value="">External (not from inventory)</option>';
                const gilLabel = '<option value="gil">Gil (sell for DKP)</option>';
                const escape = (value) => String(value ?? '')
                    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
                const options = sourceItems.map((option) =>
                    `<option value="${option.Id}" data-name="${escape(option.ItemName)}" data-type="${escape(option.ItemType ?? '')}">${escape(option.ItemName)} (${option.Quantity} on hand)</option>`);
                return externalLabel + gilLabel + options.join('');
            };

            // Drive the row's hidden SourceItemId + Gil-amount field + name/type
            // locking from the visible Source select:
            //   "gil"  -> show Gil amount, clear+disable name/type/source id
            //   <id>   -> inventory item: copy + lock name/type, set source id
            //   ""     -> external: free-text name/type, no source id, no gil
            const applySourceSelection = (row) => {
                const sourceSelect = row.querySelector('.auction-item-source');
                const sourceIdInput = row.querySelector('.auction-item-source-id');
                const nameInput = row.querySelector('.auction-item-name');
                const nameField = row.querySelector('.auction-item-name-field');
                const typeInput = row.querySelector('.auction-item-type');
                const gilField = row.querySelector('.auction-item-gil-field');
                const gilInput = row.querySelector('.auction-item-gil');
                if (!sourceSelect || !nameInput || !typeInput) { return; }
                const value = sourceSelect.value;
                const selectedOption = sourceSelect.options[sourceSelect.selectedIndex];

                if (value === 'gil') {
                    // Gil items are auto-named "<amount> gil" server-side, so the
                    // Item name field is hidden; show the Gil amount instead.
                    if (sourceIdInput) { sourceIdInput.value = ''; }
                    nameInput.value = '';
                    if (nameField) { nameField.style.display = 'none'; }
                    typeInput.value = 'Gil';
                    typeInput.readOnly = true;
                    if (gilField) { gilField.style.display = ''; }
                    return;
                }

                // Non-gil: show the name field, hide + clear the gil amount.
                if (nameField) { nameField.style.display = ''; }
                if (gilField) { gilField.style.display = 'none'; }
                if (gilInput) { gilInput.value = ''; }

                if (value) {
                    if (sourceIdInput) { sourceIdInput.value = value; }
                    nameInput.value = selectedOption?.dataset?.name ?? '';
                    typeInput.value = selectedOption?.dataset?.type ?? '';
                    nameInput.readOnly = true;
                    typeInput.readOnly = true;
                } else {
                    if (sourceIdInput) { sourceIdInput.value = ''; }
                    nameInput.readOnly = false;
                    typeInput.readOnly = false;
                }
            };

            // Initialize existing rows: restore each select to its persisted
            // source (data-current-source survives a validation re-render).
            itemsContainer.querySelectorAll('.auction-item-row').forEach((row) => {
                const sourceSelect = row.querySelector('.auction-item-source');
                if (sourceSelect) {
                    const current = sourceSelect.dataset.currentSource ?? '';
                    if (current) { sourceSelect.value = current; }
                }
                applySourceSelection(row);
            });

            addItemButton.addEventListener('click', () => {
                const index = itemsContainer.querySelectorAll('.auction-item-row').length;
                const wrapper = document.createElement('div');
                wrapper.className = 'create-form__item auction-item-row';
                wrapper.dataset.index = index;
                wrapper.innerHTML = `
                    <input type="hidden" name="AuctionItems[${index}].Id" value="0" />
                    <input type="hidden" id="AuctionItems_${index}__SourceItemId" name="AuctionItems[${index}].SourceItemId" class="auction-item-source-id" />
                    <div class="create-form__grid">
                        <label>
                            <span>Source</span>
                            <select class="auction-item-source">${buildSourceOptions()}</select>
                        </label>
                        <label class="auction-item-name-field">
                            <span>Item name</span>
                            <input id="AuctionItems_${index}__ItemName" name="AuctionItems[${index}].ItemName" class="auction-item-name" />
                        </label>
                        <label class="auction-item-gil-field" style="display:none">
                            <span>Gil amount</span>
                            <input id="AuctionItems_${index}__GilAmount" name="AuctionItems[${index}].GilAmount" type="number" min="1" class="auction-item-gil" />
                        </label>
                        <label>
                            <span>Item type</span>
                            <input id="AuctionItems_${index}__ItemType" name="AuctionItems[${index}].ItemType" class="auction-item-type" />
                        </label>
                        <label>
                            <span>Starting DKP</span>
                            <input id="AuctionItems_${index}__StartingBidDkp" name="AuctionItems[${index}].StartingBidDkp" type="number" min="0" />
                        </label>
                        <label class="create-form__field--full">
                            <span>Notes</span>
                            <input id="AuctionItems_${index}__Notes" name="AuctionItems[${index}].Notes" />
                        </label>
                    </div>
                    <div class="create-form__item-actions">
                        <button type="button" class="btn ghost sm remove-auction-item">Remove row</button>
                    </div>`;
                itemsContainer.appendChild(wrapper);
                applySourceSelection(wrapper);
            });

            itemsContainer.addEventListener('change', (event) => {
                const select = event.target.closest('.auction-item-source');
                if (!select) { return; }
                const row = select.closest('.auction-item-row');
                if (row) { applySourceSelection(row); }
            });

            itemsContainer.addEventListener('click', (event) => {
                const trigger = event.target.closest('.remove-auction-item');
                if (!trigger) { return; }
                const rows = itemsContainer.querySelectorAll('.auction-item-row');
                if (rows.length <= 1) { return; }
                trigger.closest('.auction-item-row')?.remove();
                renumberRows();
            });
        })();
    </script>
}

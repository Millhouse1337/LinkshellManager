@using System.Globalization
@using System.Security.Claims
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@model EventViewModel
@{
    ViewData["Title"] = "Active event";
    var mainJobOptions = LinkshellManagerDiscordApp.Utils.EventJobCatalog.MainJobOptions;
    var subJobOptions = LinkshellManagerDiscordApp.Utils.EventJobCatalog.SubJobOptions;
    var jobTypeOptions = LinkshellManagerDiscordApp.Utils.EventJobCatalog.JobTypeOptions;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var biddableDkp = ViewBag.BiddableDkp as Dictionary<string, double> ?? new Dictionary<string, double>();
    // The DKP pool this event earns into and buys its loot from. Null when the linkshell hasn't
    // split its DKP — every pool-aware label below then renders exactly as it always has.
    var eventPoolName = ViewBag.EventPoolName as string;
    string ToLocalIso(DateTime? value) => value?.ToString("yyyy-MM-ddTHH:mm:ss", CultureInfo.InvariantCulture) ?? string.Empty;
    // HNM-typed events get the multi-window roster card (display only — see supportsBreakRoom
    // below for the break/timer gate, which is a different question).
    var isHnmEvent = string.Equals(Model.Event.EventType, "HNM", StringComparison.OrdinalIgnoreCase);
    // Whether the Break Room applies: the Timer + Progress columns and the whole Actions column
    // (Take Break / Force Break / Resume / Verify / Deny). False for windowed camps, which credit
    // per posted window and so have no clock to pause. Server-computed via
    // Services/EventBreakPolicy, replacing this view's old local `EventType == "HNM"` test —
    // that missed multi-window boards carrying a non-HNM type (the addon's NMS / HENM preset
    // categories), which kept their break controls while the Activity and addon hid them.
    var supportsBreakRoom = Model.SupportsBreakRoom;
    var antiforgeryTokens = Antiforgery.GetAndStoreTokens(Context);
    var isAlreadyParticipant = !string.IsNullOrWhiteSpace(currentUserId)
        && Model.AppUserEvents.Any(p => p.AppUserId == currentUserId);
    // Characters the current member can sign up as (main + alts). Picker only
    // renders when there's more than one.
    var signupCharacters = ViewBag.SignupCharacters as List<string> ?? new List<string>();
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">@Model.Event.EventName</h1>
        <div class="page-sub">
            @if (!string.IsNullOrWhiteSpace(Model.Event.EventType))
            {
                <span>@Model.Event.EventType</span>
                <span>·</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Event.EventLocation))
            {
                <span>@Model.Event.EventLocation</span>
                <span>·</span>
            }
            <span class="live-dot">Live</span>
        </div>
    </div>
    <div class="page-actions">
        <a class="btn ghost" asp-action="Index">Back to events</a>
    </div>
</div>

<style>
    /* Party Board (live event sign-up board) — same look as the queued board on
       the Events index. 3 parties per alliance row; the slot-count renders as a
       pill (otherwise "Party 1" + "6" read as "Party 16"). */
    .event-ps-alliance-title {
        font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
        color: var(--accent); margin: 14px 0 8px;
    }
    .event-ps-alliance-lead {
        font-size: 12px; font-weight: 600; letter-spacing: 0; text-transform: none; color: var(--fg);
    }
    .event-ps-party-grid {
        display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px;
    }
    @@media (max-width: 760px) { .event-ps-party-grid { grid-template-columns: 1fr; } }
    .event-ps-party {
        border: 1px solid var(--border); border-radius: var(--r-md);
        padding: 10px; background: var(--surface);
    }
    .event-ps-party__head {
        display: flex; align-items: center; gap: 8px; font-weight: 600; color: var(--fg);
        font-size: 13px; padding-bottom: 8px; border-bottom: 1px solid var(--border); margin-bottom: 8px;
    }
    .event-ps-party__count {
        margin-left: auto; padding: 2px 8px; border-radius: 999px;
        background: rgba(148, 163, 184, 0.14); font-size: 11px; color: var(--fg-3); font-weight: 600;
    }
    .event-ps-slot {
        display: flex; flex-direction: column; gap: 7px; padding: 8px 10px;
        border-radius: var(--r-sm); background: var(--bg-elev); border: 1px solid var(--border);
        margin-bottom: 6px;
    }
    .event-ps-slot--leader {
        border-color: rgba(245, 197, 24, 0.42);
        background: linear-gradient(180deg, rgba(245, 197, 24, 0.06), transparent 60%), var(--bg-elev);
    }
    .event-ps-slot__label {
        display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: var(--fg);
    }
    .event-ps-leader-tag {
        display: inline-flex; align-items: center; gap: 4px; padding: 1px 7px; border-radius: 999px;
        font-size: 10.5px; font-weight: 700; color: #1a1300;
        background: linear-gradient(180deg, #ffe27a, #f5b800);
        box-shadow: 0 0 6px rgba(245, 197, 24, 0.4);
    }
    .event-ps-slot__controls {
        display: flex; align-items: center; gap: 6px; flex-wrap: wrap; justify-content: flex-end;
    }
    .event-ps-slot__controls select.form-select {
        flex: 1 1 90px; max-width: 130px; height: 32px; padding: 0 8px; font-size: 12.5px;
    }
    .event-ps-chip {
        display: inline-flex; align-items: center; gap: 5px; padding: 5px 10px; border-radius: 999px;
        font-size: 12px; font-weight: 600; color: #cdd9ff;
        background: rgba(124, 92, 255, 0.18); border: 1px solid rgba(124, 92, 255, 0.45);
    }
    .event-ps-chip--mine {
        background: rgba(124, 92, 255, 0.32); color: #f0ecff;
        border-color: rgba(124, 92, 255, 0.65);
        box-shadow: 0 0 12px rgba(124, 92, 255, 0.25);
    }
    .event-ps-chip .muted { opacity: 0.82; font-weight: 500; }
    .event-ps-empty { padding: 14px; color: var(--fg-3); font-size: 12.5px; }
    /* Officer board editing: edit-only controls hidden until the panel toggles .ps-editing. */
    .event-ps-board .ps-edit-only { display: none; }
    .event-ps-board.ps-editing .ps-edit-only { display: inline-flex; }
    .event-ps-board.ps-editing .ps-view-only { display: none; }
    .event-ps-board.ps-editing .event-ps-slot { border-style: dashed; }
    .event-ps-slot.ps-dragging { opacity: 0.4; }
    .ps-edit-bar { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
    .ps-drag-handle { cursor: grab; user-select: none; color: var(--fg-3); padding: 0 4px; }
    .ps-icon-btn { margin-left: auto; border: 0; background: transparent; cursor: pointer; color: var(--fg-2);
        font-size: 12px; padding: 2px 5px; border-radius: 4px; }
    .ps-icon-btn + .ps-icon-btn { margin-left: 0; }
    .ps-icon-btn--danger { color: var(--danger); }
    .ps-icon-btn:hover { background: rgba(124, 92, 255, 0.12); }
    .ps-rename { padding: 3px 8px; font-size: 12px; border: 1px solid var(--border); border-radius: 6px;
        background: var(--surface-2); color: var(--fg); max-width: 160px; }
    .ps-job-edit { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; padding: 6px 0 2px; }
    .ps-job-edit select { font-size: 12px; padding: 3px 6px; }
    .ps-move-select { font-size: 12px; padding: 3px 6px; max-width: 150px; border: 1px solid var(--border);
        border-radius: 6px; background: var(--surface-2); color: var(--fg); }
    .btn.xs { padding: 2px 8px; font-size: 11px; }
    .lsm-toast { position: fixed; top: 20px; left: 50%; transform: translateX(-50%); z-index: 1000;
        display: flex; align-items: center; gap: 14px; max-width: 520px; padding: 12px 16px;
        border-radius: 10px; background: var(--surface-2); border: 1px solid var(--border);
        box-shadow: 0 8px 30px rgba(0,0,0,.45); font-size: 13px; color: var(--fg); }
    .lsm-toast--error { border-color: var(--danger); }
    .lsm-toast__close { background: none; border: 0; color: var(--fg-3); cursor: pointer; font-size: 18px; line-height: 1; padding: 0; }
</style>

@if (TempData["LootError"] is string lootError && !string.IsNullOrWhiteSpace(lootError))
{
    <div class="lsm-toast lsm-toast--error" data-lsm-toast role="alert">
        <span>@lootError</span>
        <button type="button" class="lsm-toast__close" data-lsm-toast-close aria-label="Dismiss">&times;</button>
    </div>
}

<div class="card fade d2"
     data-live-event-dashboard
     data-event-start-local="@ToLocalIso(Model.CommencementStartTime)"
     data-dkp-per-hour="@(Model.Event.DkpPerHour?.ToString(CultureInfo.InvariantCulture) ?? "0")"
     data-planned-hours="@(Model.Event.Duration?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)"
     style="padding:20px;margin-bottom:16px;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:16px">
    <div>
        <div style="font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--fg-3)">Global timer</div>
        <div style="font-size:13px;color:var(--fg-3);margin-top:2px">Runs from the moment the event went live.</div>
    </div>
    <div style="font-family:var(--font-mono);font-size:32px;font-weight:600;color:var(--fg);letter-spacing:0.02em" data-live-event-timer>00:00:00</div>
</div>

<div class="fade d2">
    <div class="col">
        <div class="card">
            <div class="card-head">
                <div class="card-title">Event details</div>
            </div>
            <div style="padding:4px 16px 16px;display:grid;grid-template-columns:120px 1fr;gap:8px 16px;font-size:13px">
                <div style="color:var(--fg-3)">Type</div><div>@Model.Event.EventType</div>
                <div style="color:var(--fg-3)">Location</div><div>@Model.Event.EventLocation</div>
                <div style="color:var(--fg-3)">Started</div><div>@(Model.CommencementStartTime?.ToString("g") ?? "Not started")</div>
                <div style="color:var(--fg-3)">End</div><div>@(Model.Event.EndTime?.ToString("g") ?? "Not specified")</div>
                <div style="color:var(--fg-3)">Duration</div><div class="num">@(Model.Event.Duration is not null ? $"{Model.Event.Duration:0.##} h" : "Not specified")</div>
                <div style="color:var(--fg-3)">DKP/hour</div><div class="num">@(Model.Event.DkpPerHour ?? 0)</div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Event.Details))
            {
                <div style="padding:12px 16px;border-top:1px solid var(--border);color:var(--fg-3);font-size:13px">@Model.Event.Details</div>
            }
        </div>

        @if (isHnmEvent)
        {
            <div class="card" style="margin-top:16px">
                <div class="card-head">
                    <div class="card-title">
                        Attendance Windows
                        @* The Post Kill roster is counted separately: it is not one of the camp's
                           roster reads, and folding it in made a 2-post camp read "3 of 2" the
                           moment it was filed. *@
                        @{
                            var postedCampWindows = Model.AttendanceWindows.Count(w => !w.IsKillWindow);
                            var hasKillRoster = Model.AttendanceWindows.Any(w => w.IsKillWindow);
                        }
                        <span class="tag">@postedCampWindows@(Model.WindowCount > 1 ? $" of {Model.WindowCount}" : string.Empty)</span>
                        @if (hasKillRoster)
                        {
                            <span class="tag">+ kill</span>
                        }
                    </div>
                </div>
                @if (Model.AttendanceWindowTabs.Count == 0)
                {
                    <div class="empty">
                        Tabs will appear here as windows are posted from the lsm addon.
                    </div>
                }
                else
                {
                    @* One tab per window the camp has SAT THROUGH (EventController
                       .BuildAttendanceWindowTabs) — a window that was reached but never posted is
                       dimmed rather than dropped, because that gap is what tells an officer to go
                       back and file one. Opens on the LAST posted window, not the first tab: on a
                       25-window wyrm the first tab is usually an unrecorded one, and landing there
                       would hide the roster the officer came to read. *@
                    var windowTabs = Model.AttendanceWindowTabs;
                    var lastPostedIndex = windowTabs.FindLastIndex(tab => tab.Window is not null);
                    var activeTabIndex = lastPostedIndex >= 0 ? lastPostedIndex : windowTabs.Count - 1;
                    <div style="padding:0 16px 16px" data-attendance-windows>
                        <ul class="nav nav-tabs" role="tablist"
                            style="display:flex;flex-wrap:wrap;flex-direction:row;list-style:none;padding-left:0;margin:0;gap:6px">
                            @for (var i = 0; i < windowTabs.Count; i++)
                            {
                                var tab = windowTabs[i];
                                @* Keyed on the SEQUENCE, not the window id: an unposted tab has no
                                   row and so no id to key on. *@
                                var paneId = $"window-pane-{tab.SequenceNumber}";
                                var isActive = i == activeTabIndex;
                                <li class="nav-item" role="presentation"
                                    style="list-style:none;display:inline-block;width:auto;padding:0;background:transparent">
                                    <a class="nav-link @(isActive ? "active" : string.Empty)"
                                       data-window-tab="@paneId" href="#@paneId" role="tab"
                                       aria-controls="@paneId" aria-selected="@(isActive ? "true" : "false")"
                                       title="@(tab.Window is { } posted ? $"Posted {posted.PostedAt:g}" : "No roster posted for this window")"
                                       style="display:inline-flex;flex-direction:column;align-items:flex-start;gap:2px@(tab.Window is null ? ";opacity:.55" : string.Empty)">
                                        <span style="display:inline-flex;align-items:center;gap:6px">
                                            @tab.Label
                                            <span class="tag">@tab.AttendeeCount</span>
                                        </span>
                                        <span style="font-size:11px;color:var(--fg-3);font-weight:400">
                                            @(tab.Window is { } postedAtWindow
                                                ? postedAtWindow.PostedAt.ToString("MMM d, h:mm tt")
                                                : "Not posted")
                                        </span>
                                    </a>
                                </li>
                            }
                        </ul>
                        @* Each window carries its OWN resolved value (EventAttendanceWindowViewModel
                           .DkpAmount) — an officer's explicit price when they set one, otherwise the
                           camp's open / close bonus for that sequence. This used to read
                           Model.Event.DkpPerHour, the column HnmStandardCampFinalizer ignores outright,
                           so this page and the Discord Activity showed two different numbers for the
                           same window. Editing lives in the Activity; this page reports. *@
                        <div class="tab-content" style="margin-top:12px">
                            @for (var i = 0; i < windowTabs.Count; i++)
                            {
                                var tab = windowTabs[i];
                                var paneId = $"window-pane-{tab.SequenceNumber}";
                                var isActive = i == activeTabIndex;

                                if (tab.Window is null)
                                {
                                    @* Reached but never recorded. Say what happened and what to do
                                       about it — "no attendees" would read as "nobody showed up",
                                       which is a different and much less alarming fact. *@
                                    <div class="tab-pane fade @(isActive ? "show active" : string.Empty)"
                                         id="@paneId" role="tabpanel">
                                        <div class="empty">
                                            No roster was posted for @tab.Label — this window came and went
                                            without a snapshot. Post it from the lsm addon's window tab to
                                            record who was there.
                                        </div>
                                    </div>
                                    continue;
                                }

                                var window = tab.Window;
                                var windowDkp = window.DkpAmount ?? 0;
                                var windowTotal = windowDkp * window.Attendees.Count;
                                <div class="tab-pane fade @(isActive ? "show active" : string.Empty)"
                                     id="@paneId" role="tabpanel">
                                    <div style="display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin-bottom:8px">
                                        <div style="font-size:11px;color:var(--fg-3)">
                                            Posted @window.PostedAt.ToString("g")
                                        </div>
                                        @* Which window closes the camp out. Ticking it is the ONLY
                                           thing that pays the close bonus — it used to be guessed
                                           as "the newest window posted", which is what put a close
                                           bonus on every window of every camp. A Post Kill roster
                                           is filed after the close and pays through the kill bonus,
                                           so it is never offered the box. *@
                                        @if (Model.CanMarkClosingWindow && !window.IsKillWindow)
                                        {
                                            <label style="display:inline-flex;align-items:center;gap:6px;font-size:11px;color:var(--fg-3);cursor:pointer">
                                                <input type="checkbox"
                                                       data-mark-closing-window="@window.Id"
                                                       @(window.IsClosingWindow ? "checked" : string.Empty) />
                                                Closing window
                                            </label>
                                        }
                                        else if (window.IsClosingWindow)
                                        {
                                            <span class="badge">Closing window</span>
                                        }
                                        @if (window.IsKillWindow)
                                        {
                                            <span class="badge">Post Kill roster</span>
                                        }
                                        @if (windowDkp > 0)
                                        {
                                            @* "for", not "awarded": on an HNM camp this is staged
                                               for officer review at End Camp, not credited yet. *@
                                            <div style="font-size:12px;color:var(--fg-2)">
                                                <strong>@windowDkp.ToString("0.##") DKP</strong>
                                                <span style="color:var(--fg-3)">/ attendee × @window.Attendees.Count =</span>
                                                <strong style="color:var(--accent)">@windowTotal.ToString("0.##") DKP</strong>
                                                <span style="color:var(--fg-3)">for this window</span>
                                            </div>
                                        }
                                    </div>
                                    @if (window.Attendees.Count == 0)
                                    {
                                        <div class="empty">No attendees recorded for this window.</div>
                                    }
                                    else
                                    {
                                        <table class="table themed">
                                            <thead>
                                                <tr>
                                                    <th>Character</th>
                                                    <th>Job</th>
                                                    <th style="text-align:right">DKP earned</th>
                                                    <th>Verified by</th>
                                                    <th style="text-align:right;width:90px">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var attendee in window.Attendees)
                                                {
                                                    <tr data-window-attendee-row="@attendee.Id">
                                                        @* The character the scan actually SAW, with
                                                           their main beside it when that was an alt
                                                           — the same "(alt of X)" the addon prints
                                                           in-game, so the two rosters read alike. *@
                                                        <td>
                                                            @attendee.CharacterName
                                                            @if (!string.IsNullOrWhiteSpace(attendee.MainCharacterName))
                                                            {
                                                                <span style="color:var(--fg-3);font-size:12px">(alt of @attendee.MainCharacterName)</span>
                                                            }
                                                        </td>
                                                        <td>@attendee.JobName/@attendee.SubJobName</td>
                                                        @* An em dash is a real answer, not missing
                                                           data: a middle window on a Standard camp
                                                           pays nobody. *@
                                                        <td style="text-align:right;font-family:var(--font-mono)">
                                                            @(window.DkpAmount is { } amount ? amount.ToString("0.##") : "—")
                                                        </td>
                                                        <td style="color:var(--fg-3);font-size:12px">@attendee.VerifiedBy</td>
                                                        <td style="text-align:right">
                                                            <button type="button" class="btn ghost sm"
                                                                    data-remove-window-attendee="@attendee.Id"
                                                                    title="Remove from this window">
                                                                Remove
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                </div>
                            }
                        </div>

                        @* Claim Shield: who from the linkshell actually landed an action on the mob
                           before the lottery resolved. Sits at the BOTTOM of this card, under the
                           snapshots, because it is evidence about the same camp.

                           No longer read-only evidence — this list is WHO GETS THE CLAIM BONUS.
                           Both finalizers gate the claim on a tag here rather than on having been
                           scanned in the close window, so what is on screen is part of the payout. *@
                        @if (Model.ClaimShieldCaptures.Count > 0)
                        {
                            @* Per-MEMBER, not per-capture: a contested pop produces several
                               lotteries and someone can tag in more than one, but the bonus is paid
                               once. Adding up the captures would overstate what the camp owes. *@
                            var paidNames = Model.ClaimShieldCaptures
                                .SelectMany(c => c.Members)
                                .Where(m => m.Matched && !string.IsNullOrWhiteSpace(m.CharacterName))
                                .Select(m => m.CharacterName.Trim())
                                .Distinct(StringComparer.OrdinalIgnoreCase)
                                .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
                                .ToList();
                            <div style="margin-top:16px;border-top:1px solid var(--border);padding-top:12px">
                                <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
                                    <h4 style="margin:0;font-size:13px">Claim Shield</h4>
                                    <span class="badge">@Model.ClaimShieldCaptures.Count</span>
                                </div>
                                @if (paidNames.Count > 0)
                                {
                                    <div style="font-size:12px;color:var(--fg-2);margin-bottom:10px">
                                        @paidNames.Count @(paidNames.Count == 1 ? "member" : "members")
                                        tagged this camp and will earn the claim bonus when it is ended
                                        and posted — <strong>@string.Join(", ", paidNames)</strong>.
                                    </div>
                                }
                                @foreach (var capture in Model.ClaimShieldCaptures)
                                {
                                    <div style="margin-bottom:10px">
                                        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px">
                                            <span class="badge">@(capture.Won ? "WON" : "LOST")</span>
                                            <strong>@capture.MonsterName</strong>
                                            <span style="font-size:11px;color:var(--fg-3)">
                                                @capture.CapturedAtUtc.ToString("g")
                                                · @capture.Members.Count of ours
                                                · @capture.TotalPlayers in the lottery
                                            </span>
                                        </div>
                                        @if (capture.Members.Count == 0)
                                        {
                                            <div class="empty" style="margin-top:6px">
                                                No linkshell member landed an action before the lottery resolved.
                                            </div>
                                        }
                                        else
                                        {
                                            <ul style="margin:6px 0 0;padding-left:18px;font-size:12px;color:var(--fg-2)">
                                                @foreach (var member in capture.Members)
                                                {
                                                    @* The sentence IS the record — falling back to
                                                       the bare name only happens on captures from
                                                       before actions were stored. *@
                                                    <li>
                                                        @(string.IsNullOrWhiteSpace(member.ActionMessage)
                                                            ? member.CharacterName
                                                            : member.ActionMessage)
                                                        @if (!member.Matched)
                                                        {
                                                            <span class="badge">not on roster — not paid</span>
                                                        }
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (Model.LinkedPartySetupBoard is { } board)
        {
            var slotNames = new HashSet<string>(
                board.Alliances.SelectMany(a => a.Parties).SelectMany(p => p.Slots)
                    .Where(s => !s.IsOpen && !string.IsNullOrWhiteSpace(s.SignedUpCharacterName))
                    .Select(s => s.SignedUpCharacterName!.Trim()),
                StringComparer.OrdinalIgnoreCase);
            var panelVm = new LinkshellManagerDiscordApp.ViewModels.PartyBoardPanelViewModel
            {
                EventId = Model.Event.Id,
                LinkshellId = Model.Event.LinkshellId,
                Board = board,
                CanManageParties = ViewBag.CanManageParties is true,
                CurrentUserId = currentUserId,
                IsLive = Model.Event.CommencementStartTime != null,
                SignupCharacters = signupCharacters,
                RoleOptions = ViewBag.SignUpRoleOptions as List<string> ?? jobTypeOptions.ToList(),
                MainJobOptions = ViewBag.SignUpMainJobOptions as List<string> ?? mainJobOptions.ToList(),
                SubJobOptions = ViewBag.SignUpSubJobOptions as List<string> ?? subJobOptions.ToList(),
                ReturnUrl = Url.Action("Start", "Event", new { eventId = Model.Event.Id }) ?? string.Empty,
                AlsoAttending = Model.AppUserEvents
                    .Where(p => !string.IsNullOrWhiteSpace(p.CharacterName) && !slotNames.Contains(p.CharacterName!.Trim()))
                    .Select(p => new LinkshellManagerDiscordApp.ViewModels.PartyBoardPanelViewModel.AlsoAttendingRow
                    {
                        AppUserId = p.AppUserId,
                        CharacterName = p.CharacterName,
                        JobType = p.JobType,
                        JobName = p.JobName,
                        SubJobName = p.SubJobName
                    })
                    .ToList()
            };
            <div class="card" style="margin-top:16px">
                <div class="card-head">
                    <div class="card-title" style="display:inline-flex;align-items:center;gap:8px">
                        Party Board
                        <button type="button" class="btn ghost sm" data-party-board-toggle aria-expanded="true" aria-controls="partyBoardPanel" title="Hide / show the party board" style="padding:0 4px;line-height:1">
                            <svg data-party-board-chevron viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transition:transform .15s">
                                <polyline points="6 9 12 15 18 9"/>
                            </svg>
                        </button>
                    </div>
                    <span class="muted" style="font-size:12px">Claim an open slot to late-join, or use “Edit layout” to rearrange.</span>
                </div>
                <div class="event-ps-panel" id="partyBoardPanel" style="padding:12px 16px">
                    @await Html.PartialAsync("_PartyBoardPanel", panelVm)
                </div>
            </div>
        }

        @* order:-1 floats the Participants card to the top of the stack (between the
           global timer and Event details) while keeping its markup here. *@
        <div class="card" style="order:-1">
            <div class="card-head">
                <div class="card-title">Participants <span class="tag">@Model.AppUserEvents.Count</span></div>
            </div>
            @if (Model.AppUserEvents.Count == 0)
            {
                <div class="empty">No participants yet.</div>
            }
            else
            {
                <table class="table themed">
                    <thead>
                        <tr>
                            <th>Character</th>
                            <th>Job</th>
                            @if (supportsBreakRoom)
                            {
                                <th>Timer</th>
                                <th style="width:140px">Progress</th>
                            }
                            <th style="text-align:right">DKP</th>
                            <th>Status</th>
                            @if (supportsBreakRoom)
                            {
                                <th style="text-align:right">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var participant in Model.AppUserEvents)
                        {
                            <tr data-live-participant
                                data-participant-start-local="@ToLocalIso(participant.StartTime)"
                                data-participant-resume-local="@ToLocalIso(participant.ResumeTime)"
                                data-participant-base-hours="@(participant.Duration?.ToString(CultureInfo.InvariantCulture) ?? "0")"
                                data-participant-on-break="@((participant.IsOnBreak == true).ToString().ToLowerInvariant())">
                                <td>
                                    <div style="font-weight:500">
                                        @participant.CharacterName
                                        @if (participant.AppUserId != null && biddableDkp.TryGetValue(participant.AppUserId, out var pBid))
                                        {
                                            var biddableTitle = eventPoolName is null
                                                ? "Biddable DKP now = balance − bids they're winning − DKP spent on loot this event"
                                                : $"Spendable {eventPoolName} DKP now = their {eventPoolName} balance − bids they're winning from it − DKP spent on loot this event";
                                            <span class="tag" style="font-size:11px;font-weight:400" title="@biddableTitle">
                                                @pBid.ToString("0.##") biddable@(eventPoolName is null ? "" : $" · {eventPoolName}")
                                            </span>
                                        }
                                    </div>
                                    <div style="color:var(--fg-4);font-size:11px">@(participant.StartTime?.ToString("g") ?? "Pending")</div>
                                </td>
                                <td>
                                    <div>@participant.JobName/@participant.SubJobName</div>
                                    <div style="color:var(--fg-4);font-size:11px">@(participant.JobType ?? "Role")</div>
                                </td>
                                @if (supportsBreakRoom)
                                {
                                    <td style="font-family:var(--font-mono);font-size:12px" data-live-participant-timer>00:00:00</td>
                                    <td>
                                        <div data-live-participant-progress-wrap style="height:6px;background:var(--surface-2);border-radius:3px;overflow:hidden">
                                            <div data-live-participant-progress style="height:100%;width:0%;background:var(--accent);transition:width 0.5s"></div>
                                        </div>
                                        <span data-live-participant-progress-na style="display:none;font-size:11px;color:var(--fg-3)" title="This event has no planned duration, so there's nothing to measure progress against.">— open-ended</span>
                                    </td>
                                }
                                <td style="text-align:right;font-family:var(--font-mono)" data-live-participant-dkp>0.00</td>
                                <td>
                                    @if (participant.IsOnBreak == true)
                                    {
                                        <span class="tag warning">On break</span>
                                        @if (participant.WithdrewFromEvent)
                                        {
                                            <span class="tag danger" title="Withdrew from the event — kept here so they can resume if they return">Not returning</span>
                                        }
                                    }
                                    else if (participant.IsVerified == true)
                                    {
                                        <span class="tag success">Verified</span>
                                    }
                                    else if (participant.IsVerified == false)
                                    {
                                        <span class="tag danger">Denied</span>
                                    }
                                    else
                                    {
                                        <span class="tag">Pending</span>
                                    }
                                </td>
                                @if (supportsBreakRoom)
                                {
                                <td style="text-align:right">
                                    <div style="display:flex;justify-content:flex-end;gap:4px;flex-wrap:wrap">
                                        @if (participant.AppUserId == currentUserId)
                                        {
                                            @if (participant.IsOnBreak == true)
                                            {
                                                <form asp-action="ReturnFromBreak" method="post" style="display:inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="eventId" value="@Model.Event.Id" />
                                                    <button class="btn ghost sm" type="submit">Return</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="TakeBreak" method="post" style="display:inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="eventId" value="@Model.Event.Id" />
                                                    <button class="btn ghost sm" type="submit">Take Break</button>
                                                </form>
                                            }
                                        }
                                        else
                                        {
                                            @* Officer moderation: force another member on/off break. *@
                                            @if (participant.IsOnBreak == true)
                                            {
                                                <form asp-action="ForceResume" method="post" style="display:inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="eventId" value="@Model.Event.Id" />
                                                    <input type="hidden" name="participantId" value="@participant.Id" />
                                                    <button class="btn ghost sm" type="submit" title="Resume this member from break">Resume</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="ForceBreak" method="post" style="display:inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="eventId" value="@Model.Event.Id" />
                                                    <input type="hidden" name="participantId" value="@participant.Id" />
                                                    <button class="btn ghost sm" type="submit" title="Send this member to the break room">Break</button>
                                                </form>
                                            }
                                        }
                                        @if (participant.IsVerified is null)
                                        {
                                            <form asp-action="VerifyUser" method="post" style="display:inline">
                                                <input type="hidden" name="eventId" value="@Model.Event.Id" />
                                                <input type="hidden" name="characterName" value="@participant.CharacterName" />
                                                <input type="hidden" name="isVerified" value="true" />
                                                <button class="btn ghost sm" type="submit">Present</button>
                                            </form>
                                            <form asp-action="VerifyUser" method="post" style="display:inline">
                                                <input type="hidden" name="eventId" value="@Model.Event.Id" />
                                                <input type="hidden" name="characterName" value="@participant.CharacterName" />
                                                <input type="hidden" name="isVerified" value="false" />
                                                <button class="btn ghost sm" type="submit">Absent</button>
                                            </form>
                                        }
                                        @if (participant.IsVerified == false)
                                        {
                                            @* Reopen a denied attendee back to Pending so they can be re-judged. *@
                                            <form asp-action="UndoVerification" method="post" style="display:inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="eventId" value="@Model.Event.Id" />
                                                <input type="hidden" name="characterName" value="@participant.CharacterName" />
                                                <button class="btn ghost sm" type="submit">Undo Denied Attendance</button>
                                            </form>
                                        }
                                    </div>
                                    @if (participant.StatusLedgerEntries.Count > 0)
                                    {
                                        <div style="margin-top:8px;display:flex;flex-direction:column;gap:4px;font-size:11px;color:var(--fg-3)">
                                            @foreach (var entry in participant.StatusLedgerEntries)
                                            {
                                                <div style="display:flex;justify-content:flex-end;align-items:flex-start;gap:6px">
                                                    <div style="text-align:right">
                                                        @if (entry.ActionType == "BreakStart")
                                                        {
                                                            <div style="color:var(--fg);font-weight:500">Break started</div>
                                                        }
                                                        else if (entry.ActionType == "BreakReturn")
                                                        {
                                                            <div style="color:var(--fg);font-weight:500">Returned</div>
                                                        }
                                                        <div>@entry.OccurredAt.ToString("g")</div>
                                                        @if (entry.VerifiedAt.HasValue)
                                                        {
                                                            <div>Verified by @(entry.VerifiedBy ?? "Officer")</div>
                                                        }
                                                        else if (entry.DeniedAt.HasValue)
                                                        {
                                                            <div style="color:var(--danger)">Denied by @(entry.DeniedBy ?? "Officer")</div>
                                                        }
                                                        else if (entry.RequiresVerification)
                                                        {
                                                            <div>Awaiting verify</div>
                                                        }
                                                    </div>
                                                    @if (entry.ActionType == "BreakReturn" && entry.RequiresVerification && !entry.VerifiedAt.HasValue)
                                                    {
                                                        <form asp-action="VerifyReturn" method="post" style="display:inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="eventId" value="@Model.Event.Id" />
                                                            <input type="hidden" name="ledgerEntryId" value="@entry.Id" />
                                                            <button class="btn ghost sm" type="submit">Verify</button>
                                                        </form>
                                                        <form asp-action="DenyReturn" method="post" style="display:inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="eventId" value="@Model.Event.Id" />
                                                            <input type="hidden" name="ledgerEntryId" value="@entry.Id" />
                                                            <button class="btn ghost sm" type="submit" style="color:var(--danger)">Deny</button>
                                                        </form>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    @* Quick join / Loot log / Complete this event sit in a row UNDER the full-width
       Party Board now (auto-fit wraps them on narrow screens). *@
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px;margin-top:16px;align-items:start">
        <div class="card">
            <div class="card-head">
                <div class="card-title">Quick join</div>
            </div>
            <form asp-action="QuickJoin" method="post" style="padding:4px 16px 16px">
                <input type="hidden" name="eventId" value="@Model.Event.Id" />
                @if (signupCharacters.Count > 1)
                {
                    <div class="field" style="margin-bottom:10px">
                        <label>Character</label>
                        <select class="form-select" name="characterName">
                            @foreach (var c in signupCharacters) { <option value="@c">@c</option> }
                        </select>
                    </div>
                }
                <div class="form-grid" style="grid-template-columns:repeat(3,minmax(0,1fr));align-items:end">
                    <div class="field">
                        <label>Main job</label>
                        <select class="form-select" name="jobName" required>
                            <option value="">Select main job</option>
                            @foreach (var jobOption in mainJobOptions)
                            {
                                <option value="@jobOption">@jobOption</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>Sub job</label>
                        <select class="form-select" name="subJobName" required>
                            <option value="">Select sub job</option>
                            @foreach (var jobOption in subJobOptions)
                            {
                                <option value="@jobOption">@jobOption</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>Role</label>
                        <select class="form-select" name="jobType" required>
                            <option value="">Select role</option>
                            @foreach (var jobTypeOption in jobTypeOptions)
                            {
                                <option value="@jobTypeOption">@jobTypeOption</option>
                            }
                        </select>
                    </div>
                </div>
                @if (!isAlreadyParticipant)
                {
                    <button class="btn primary" type="submit" style="margin-top:12px">Join active event</button>
                }
                else
                {
                    <div class="muted" style="margin-top:12px;font-size:12px">You're already attached to this event.</div>
                }
            </form>
        </div>

        <div class="card">
            <div class="card-head">
                <div class="card-title">Loot log</div>
            </div>
            <form asp-action="SubmitLootDetails" method="post" style="padding:4px 16px 12px;border-bottom:1px solid var(--border)">
                <input type="hidden" name="eventId" value="@Model.Event.Id" />
                <div class="form-grid" style="grid-template-columns:repeat(3,minmax(0,1fr));align-items:end">
                    <div class="field"><label>Item</label><input class="form-control" name="itemName" required maxlength="200" /></div>
                    <div class="field">
                        <label>Winner</label>
                        <select class="form-select" name="itemWinner" required>
                            <option value="">Select event member</option>
                            @foreach (var participantName in Model.AppUserEvents
                                .Select(item => item.CharacterName)
                                .Where(name => !string.IsNullOrWhiteSpace(name))
                                .Distinct()
                                .OrderBy(name => name))
                            {
                                <option value="@participantName">@participantName</option>
                            }
                        </select>
                    </div>
                    <div class="field"><label>DKP spent</label><input class="form-control" name="winningDkpSpent" type="number" min="0" step="1" value="0" required /></div>
                </div>
                <button class="btn ghost sm" type="submit" style="margin-top:12px">+ Add loot</button>
            </form>
            @if (Model.EventLootDetails.Count == 0)
            {
                <div class="empty">No loot logged yet.</div>
            }
            else
            {
                <table class="table themed">
                    <thead><tr><th>Item</th><th>Winner</th><th style="text-align:right">DKP</th></tr></thead>
                    <tbody>
                        @foreach (var loot in Model.EventLootDetails)
                        {
                            <tr>
                                <td>@loot.ItemName</td>
                                <td>@loot.ItemWinner</td>
                                <td style="text-align:right" class="num">@loot.WinningDkpSpent</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="card" style="border-color:var(--warning)">
            <div style="padding:16px;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px">
                <div>
                    <div style="font-size:14px;font-weight:600;color:var(--fg);margin-bottom:4px">Complete this event</div>
                    <div style="font-size:12px;color:var(--fg-3)">Roll it into event history, calculate participant DKP, and update linkshell totals.</div>
                </div>
                <form asp-action="EndEvent" method="post">
                    <input type="hidden" name="eventId" value="@Model.Event.Id" />
                    <button class="btn primary" type="submit" style="background:var(--warning);border-color:var(--warning);color:#000">End event</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script nonce="@Html.CspNonce()">
        // Loot/validation toast: auto-dismiss after a few seconds or on close.
        (() => {
            const toast = document.querySelector('[data-lsm-toast]');
            if (!toast) return;
            const dismiss = () => toast.remove();
            const closeBtn = toast.querySelector('[data-lsm-toast-close]');
            if (closeBtn) closeBtn.addEventListener('click', dismiss);
            setTimeout(dismiss, 6000);
        })();
    </script>
    <script nonce="@Html.CspNonce()">
        // CSRF globals for the party-board editor's fetch() POSTs (event-party-board.js).
        window.LSM_CSRF_HEADER = '@antiforgeryTokens.HeaderName';
        window.LSM_CSRF_TOKEN = '@antiforgeryTokens.RequestToken';
    </script>
    <script src="~/js/event-party-board.js" nonce="@Html.CspNonce()" defer></script>
    <script nonce="@Html.CspNonce()">
        // Party Board: chevron toggle to hide/show the live sign-up board.
        (() => {
            const btn = document.querySelector('[data-party-board-toggle]');
            const panel = document.getElementById('partyBoardPanel');
            if (!btn || !panel) return;
            const chevron = btn.querySelector('[data-party-board-chevron]');
            btn.addEventListener('click', () => {
                const collapsed = panel.style.display === 'none';
                panel.style.display = collapsed ? '' : 'none';
                btn.setAttribute('aria-expanded', collapsed ? 'true' : 'false');
                if (chevron) chevron.style.transform = collapsed ? '' : 'rotate(-90deg)';
            });
        })();
    </script>
    <script nonce="@Html.CspNonce()">
        // Attendance Windows: vanilla-JS tab switcher + per-row Remove. The
        // Bootstrap data-toggle="tab" plugin wasn't switching panes here (likely
        // a JS-load order quirk), so we wire it up ourselves — toggles `active`
        // on the link and `show active` on the matching pane, and posts a DELETE
        // when the Remove button is clicked.
        (() => {
            const containers = document.querySelectorAll('[data-attendance-windows]');
            if (containers.length === 0) return;

            const activate = (container, paneId) => {
                container.querySelectorAll('[data-window-tab]').forEach((link) => {
                    const isMatch = link.dataset.windowTab === paneId;
                    link.classList.toggle('active', isMatch);
                    link.setAttribute('aria-selected', isMatch ? 'true' : 'false');
                });
                container.querySelectorAll('.tab-pane').forEach((pane) => {
                    const isMatch = pane.id === paneId;
                    pane.classList.toggle('active', isMatch);
                    pane.classList.toggle('show', isMatch);
                });
            };

            containers.forEach((container) => {
                container.querySelectorAll('[data-window-tab]').forEach((link) => {
                    link.addEventListener('click', (e) => {
                        e.preventDefault();
                        activate(container, link.dataset.windowTab);
                    });
                });

                container.querySelectorAll('[data-remove-window-attendee]').forEach((btn) => {
                    btn.addEventListener('click', async () => {
                        const id = btn.dataset.removeWindowAttendee;
                        if (!id) return;
                        if (!window.confirm('Remove this attendee from the window? They will need to be re-posted to count.')) return;
                        btn.disabled = true;
                        try {
                            const res = await fetch(`/api/addon/management/window-attendees/${id}`, {
                                method: 'DELETE',
                                credentials: 'same-origin',
                                headers: { '@antiforgeryTokens.HeaderName': '@antiforgeryTokens.RequestToken' }
                            });
                            if (res.ok) {
                                const row = btn.closest('[data-window-attendee-row]');
                                if (row) row.remove();
                            } else {
                                btn.disabled = false;
                                window.alert('Could not remove attendee. ' + (res.status === 403 ? 'Not authorized.' : `HTTP ${res.status}`));
                            }
                        } catch (err) {
                            btn.disabled = false;
                            window.alert('Network error removing attendee.');
                        }
                    });
                });

                // "Closing window" tick. Reloads on success rather than patching the DOM: marking
                // one window UNMARKS another, and the server also clears this window's explicit
                // price so the close bonus can come through — three rows change, not one.
                container.querySelectorAll('[data-mark-closing-window]').forEach((box) => {
                    box.addEventListener('change', async () => {
                        const id = box.dataset.markClosingWindow;
                        if (!id) return;
                        const desired = box.checked;
                        box.disabled = true;
                        try {
                            const res = await fetch(`/api/addon/management/attendance-windows/${id}/closing`, {
                                method: 'PATCH',
                                credentials: 'same-origin',
                                headers: {
                                    'Content-Type': 'application/json',
                                    '@antiforgeryTokens.HeaderName': '@antiforgeryTokens.RequestToken'
                                },
                                body: JSON.stringify({ isClosingWindow: desired })
                            });
                            if (res.ok) {
                                window.location.reload();
                                return;
                            }
                            // Put the box back where it was: the server refused, so the camp's
                            // close is still whatever it was before the click.
                            box.checked = !desired;
                            box.disabled = false;
                            let message = `HTTP ${res.status}`;
                            try {
                                const payload = await res.json();
                                if (payload && payload.error) message = payload.error;
                            } catch (parseErr) { /* keep the status */ }
                            window.alert('Could not set the closing window. ' + message);
                        } catch (err) {
                            box.checked = !desired;
                            box.disabled = false;
                            window.alert('Network error setting the closing window.');
                        }
                    });
                });
            });
        })();
    </script>

    <script nonce="@Html.CspNonce()">
        (() => {
            const dashboard = document.querySelector('[data-live-event-dashboard]');
            if (!dashboard) { return; }

            const parseLocalDate = (value) => {
                if (!value) { return null; }
                const parsed = new Date(value);
                return Number.isNaN(parsed.getTime()) ? null : parsed;
            };

            const formatElapsed = (totalMilliseconds) => {
                const totalSeconds = Math.max(0, Math.floor(totalMilliseconds / 1000));
                const hours = Math.floor(totalSeconds / 3600);
                const minutes = Math.floor((totalSeconds % 3600) / 60);
                const seconds = totalSeconds % 60;
                return [hours, minutes, seconds].map(value => value.toString().padStart(2, '0')).join(':');
            };

            const eventStart = parseLocalDate(dashboard.dataset.eventStartLocal);
            const dkpPerHour = Number.parseFloat(dashboard.dataset.dkpPerHour || '0') || 0;
            const plannedHours = Number.parseFloat(dashboard.dataset.plannedHours || '');
            const timerTarget = dashboard.querySelector('[data-live-event-timer]');
            const participantRows = Array.from(document.querySelectorAll('[data-live-participant]'));

            const update = () => {
                const now = new Date();
                const eventElapsedMs = eventStart ? Math.max(0, now.getTime() - eventStart.getTime()) : 0;

                if (timerTarget) {
                    timerTarget.textContent = formatElapsed(eventElapsedMs);
                }

                for (const row of participantRows) {
                    const participantStart = parseLocalDate(row.dataset.participantStartLocal);
                    const participantResume = parseLocalDate(row.dataset.participantResumeLocal);
                    const participantBaseHours = Number.parseFloat(row.dataset.participantBaseHours || '0') || 0;
                    const participantOnBreak = row.dataset.participantOnBreak === 'true';
                    const segmentStart = participantResume || participantStart || eventStart;
                    const participantElapsedMs = (participantBaseHours * 3600000)
                        + (participantOnBreak ? 0 : (segmentStart ? Math.max(0, now.getTime() - segmentStart.getTime()) : 0));
                    const participantDkp = (participantElapsedMs / 3600000) * dkpPerHour;
                    // Progress = how far through the PLANNED duration we are. Open-ended
                    // events (no planned end) have nothing to measure against, so we show
                    // an "open-ended" note instead of a fabricated bar (the old fallback —
                    // participant's share of elapsed time — read as an inaccurate ~50%).
                    const hasDuration = Number.isFinite(plannedHours) && plannedHours > 0;
                    const progress = hasDuration
                        ? Math.min(100, (participantElapsedMs / (plannedHours * 3600000)) * 100)
                        : 0;

                    const timerCell = row.querySelector('[data-live-participant-timer]');
                    const dkpCell = row.querySelector('[data-live-participant-dkp]');
                    const progressBar = row.querySelector('[data-live-participant-progress]');
                    const progressWrap = row.querySelector('[data-live-participant-progress-wrap]');
                    const progressNa = row.querySelector('[data-live-participant-progress-na]');

                    if (timerCell) { timerCell.textContent = formatElapsed(participantElapsedMs); }
                    if (dkpCell) { dkpCell.textContent = participantDkp.toFixed(2); }
                    if (hasDuration) {
                        if (progressWrap) { progressWrap.style.display = ''; }
                        if (progressNa) { progressNa.style.display = 'none'; }
                        if (progressBar) { progressBar.style.width = `${progress}%`; }
                    } else {
                        if (progressWrap) { progressWrap.style.display = 'none'; }
                        if (progressNa) { progressNa.style.display = ''; }
                    }
                }
            };

            update();
            window.setInterval(update, 1000);

            // Background tabs throttle setInterval down to ~once per minute, so
            // re-sync the timers whenever the tab regains visibility — otherwise
            // the elapsed clock visibly skips when the user comes back.
            document.addEventListener('visibilitychange', () => {
                if (document.visibilityState === 'visible') { update(); }
            });
        })();
    </script>
}

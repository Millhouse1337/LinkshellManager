@{
    ViewData["Title"] = "LinkshellManager";
    Layout = "_Layout";

    // Signed in, the page sits in the app shell (sidebar + top bar), which already carries the
    // brand and the account menu: drop the page's own top bar and the "sign in" closing card.
    // Signed out, FullBleed tells the layout to skip the centred .auth-shell wrapper.
    var isSignedIn = User.Identity?.IsAuthenticated ?? false;
    ViewData["BodyClass"] = "landing-content";
    ViewData["FullBleed"] = true;
    var showLauncherDownload = ViewData["ShowLauncherDownload"] as bool? ?? false;
    // Built here rather than written into the href, so Razor never has to decide what the @ means.
    const string fontsHref = "https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Figtree:wght@400;500;600&display=swap";
}

@section Styles {
    @* Cinzel (headings) and Figtree (body) come from Google Fonts, the one external asset host
       the CSP in Program.cs allows. Cinzel falls back to Georgia and Figtree to the site's Geist. *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="@fontsHref" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
}

<div class="landing @(isSignedIn ? "landing--app" : null)">
    @if (!isSignedIn)
    {
        <header class="landing-nav">
            <a class="landing-brand" href="~/">
                <span class="landing-diamond" aria-hidden="true"></span>
                <span>Linkshell Manager</span>
            </a>
            <nav class="landing-links" aria-label="Main">
                <a class="landing-section-link" href="#features">Features</a>
                <a class="landing-section-link" href="#addon">Addon</a>
                <a class="landing-signin" asp-controller="Account" asp-action="Login">Sign in</a>
            </nav>
        </header>
    }

    <section class="landing-hero">
        @* Decorative: the headline carries the message. Eager + high priority because this is the
           largest thing on the first screen. *@
        <img class="landing-hero-art" src="~/images/landing-hero.jpg" asp-append-version="true"
             alt="" width="2560" height="1440" fetchpriority="high" />
        <div class="landing-hero-copy">
            <p class="landing-eyebrow">For linkshell leaders</p>
            <h1>Run your linkshell from anywhere.</h1>
            <p class="landing-lede">
                One Discord login for the website and the Discord Activity — the same account, members
                and event history follow you in both places.
            </p>
            <div class="landing-actions">
                <a class="landing-btn landing-btn--gold" asp-controller="Account" asp-action="Login">
                    Launch in Discord <span class="landing-btn-arrow" aria-hidden="true">→</span>
                </a>
                <a class="landing-btn landing-btn--ghost" asp-controller="Dashboard" asp-action="Index">Open the website</a>
                @* This is the only page reachable without an account, so it is where a tester
                   without Discord finds the launcher. *@
                @if (showLauncherDownload)
                {
                    <a class="landing-btn landing-btn--ghost" asp-controller="Launcher" asp-action="Download">Download launcher</a>
                }
            </div>
        </div>
    </section>

    <section id="features" class="landing-section" aria-labelledby="landing-features-title">
        <div class="landing-section-head">
            <h2 id="landing-features-title">One account. Three places to use it.</h2>
            <p>Manage on the web, play inside Discord, and let the addon handle attendance in game.</p>
        </div>

        <div class="landing-surfaces">
            <article class="landing-surface">
                <p class="landing-surface-kicker">I · Website</p>
                <h3>Full management</h3>
                <p>Sign in with Discord to manage linkshells, create events, review history and configure your account.</p>
                <a class="landing-surface-link" asp-controller="Dashboard" asp-action="Index">Open website <span aria-hidden="true">→</span></a>
            </article>

            <article class="landing-surface">
                <p class="landing-surface-kicker">II · Discord Activity</p>
                <h3>Right in voice chat</h3>
                <p>Launch from any voice channel. Nothing to install, no separate login.</p>
                <a class="landing-surface-link" asp-controller="Account" asp-action="Login">Launch Activity <span aria-hidden="true">→</span></a>
            </article>

            <article id="addon" class="landing-surface">
                <p class="landing-surface-kicker">III · Attendance Addon</p>
                <h3>Captured in game</h3>
                <p>Pair the addon with your account to record attendance from live sessions — event history stays in sync with your linkshell.</p>
                <a class="landing-surface-link" asp-controller="Linkshell" asp-action="GameAddon">Get the addon <span aria-hidden="true">→</span></a>
            </article>
        </div>
    </section>

    @if (!isSignedIn)
    {
        <section class="landing-closing" aria-labelledby="landing-closing-title">
            <div class="landing-closing-card">
                <h2 id="landing-closing-title">Gather your linkshell.</h2>
                <p>Sign in with Discord — your account works everywhere from the first login.</p>
                <a class="landing-btn landing-btn--discord" asp-controller="Account" asp-action="Login">Sign in with Discord</a>
            </div>
        </section>
    }

    <footer class="landing-footer">
        <span class="landing-footer-brand">Linkshell Manager</span>
        <nav aria-label="Legal">
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            <a asp-controller="Home" asp-action="Terms">Terms</a>
        </nav>
    </footer>
</div>

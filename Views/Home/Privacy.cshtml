@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Privacy Policy</h1>
        <div class="page-sub"><span>Effective date: May 3, 2026</span></div>
    </div>
</div>

<div class="card fade d2" style="padding:24px;max-width:860px">
    <div style="display:grid;gap:18px;color:var(--fg-3);font-size:14px;line-height:1.65">
        <section>
            <h2 style="font-size:18px;color:var(--fg);margin:0 0 8px">1. Overview</h2>
            <p style="margin:0">
                LinkshellManager helps linkshells manage rosters, events, attendance, DKP, loot, auctions,
                ToDs, announcements, rules, and related gameplay activity. This policy explains what information
                is collected and how it is used.
            </p>
        </section>

        <section>
            <h2 style="font-size:18px;color:var(--fg);margin:0 0 8px">2. Information We Collect</h2>
            <p style="margin:0">
                LSManager may collect Discord account identifiers, Discord username/profile information,
                character names, alt character names, profile images, time zone, linkshell membership, roles,
                event signups, attendance records, DKP entries, loot records, auction activity, messages,
                rules, announcements, addon pairing labels, addon tokens, and basic server logs.
            </p>
        </section>

        <section>
            <h2 style="font-size:18px;color:var(--fg);margin:0 0 8px">3. Discord Login</h2>
            <p style="margin:0">
                LSManager uses Discord OAuth to sign users in and to connect the Discord Activity to the same
                local account. Discord access tokens are used to verify identity and are not intended for sale
                or unrelated tracking.
            </p>
        </section>

        <section>
            <h2 style="font-size:18px;color:var(--fg);margin:0 0 8px">4. In-Game Addon Data</h2>
            <p style="margin:0">
                If you pair the in-game addon, it may send attendance, event, ToD, loot, roster, and related
                linkshell activity to LSManager. Pairing tokens are used to connect the addon to the selected
                linkshell and can be revoked from the app.
            </p>
        </section>

        <section>
            <h2 style="font-size:18px;color:var(--fg);margin:0 0 8px">5. How Information Is Used</h2>
            <p style="margin:0">
                Information is used to provide LSManager features, authenticate users, show linkshell data,
                calculate DKP and attendance, manage permissions, troubleshoot problems, secure the service,
                and keep website, Discord Activity, and addon data synchronized.
            </p>
        </section>

        <section>
            <h2 style="font-size:18px;color:var(--fg);margin:0 0 8px">6. Sharing</h2>
            <p style="margin:0">
                Linkshell data is visible to users according to their linkshell membership and permissions.
                LSManager does not sell personal information. Data may be shared if required to operate the
                service, comply with law, investigate abuse, or protect users and the service.
            </p>
        </section>

        <section>
            <h2 style="font-size:18px;color:var(--fg);margin:0 0 8px">7. Cookies and Security</h2>
            <p style="margin:0">
                LSManager uses cookies for sign-in, session management, antiforgery protection, and secure
                operation in browser and Discord iframe contexts. Keep your Discord account secure and do not
                share addon pairing codes or tokens.
            </p>
        </section>

        <section>
            <h2 style="font-size:18px;color:var(--fg);margin:0 0 8px">8. Data Retention</h2>
            <p style="margin:0">
                Linkshell and gameplay records may be retained while the linkshell uses LSManager. Some records,
                such as event history, DKP, loot, and attendance, are part of the linkshell audit trail and may
                remain until an administrator deletes them or the service operator removes them.
            </p>
        </section>

        <section>
            <h2 style="font-size:18px;color:var(--fg);margin:0 0 8px">9. Your Choices</h2>
            <p style="margin:0">
                You may update your profile information in the app. Linkshell leaders and officers manage
                linkshell membership and role permissions. Addon tokens can be revoked from the addon token
                management area.
            </p>
        </section>

        <section>
            <h2 style="font-size:18px;color:var(--fg);margin:0 0 8px">10. Contact</h2>
            <p style="margin:0">
                For privacy questions or data requests, contact the LSManager operator or administrator who
                provided access to your linkshell.
            </p>
        </section>
    </div>
</div>

@using LinkshellManagerDiscordApp.Services
@model LinkshellManagerDiscordApp.ViewModels.ChartBossCardContext
@{
    var boss = Model.Boss;
    var isMiniNm = boss.Kind == ChartBossKinds.MiniNm;
    var isFinal = boss.Kind == ChartBossKinds.Final;
    var hasRewards = boss.Rewards.Count > 0 || !string.IsNullOrWhiteSpace(boss.ReferenceNote);

    // Theme keys are unique across the WHOLE catalog, so this is a stable per-card element id even
    // on a board with two finales. Using the boss name would break on spaces and apostrophes.
    var rewardsId = $"chart-rewards-{boss.ThemeKey}";
    // Same reasoning, same guarantee: "San d'Oria" would not survive as an element id.
    var keyItemId = $"chart-keyitem-{boss.ThemeKey}";
    var tracksKeyItem = !string.IsNullOrWhiteSpace(boss.KeyItemName);
}

@* Every kind is a grid card of the same width; kind picks the chrome only — the tag (stock vs item
   count) and the footer (totals vs a finale's reward drawer). Twin of the @for in the Activity's
   chart-board-section.component.html. *@
<article class="card chart-card @(isFinal ? "chart-final" : null) is-@boss.ThemeKey">
    <div class="card-head">
        <div class="chart-card__heading">
            <img class="chart-card__emblem" src="@boss.EmblemPath" alt="@boss.Boss" loading="lazy" />
            <div>
                <div class="chart-card__name">@boss.Boss</div>
                @* Which card this one's drops feed, in the TARGET card's hue rather than this card's:
                   is-@LeadsToThemeKey re-sets --boss on the badge itself, and every .is-* rule in
                   lsm-theme.css sets nothing but --boss. Both values must be present — an arrow the
                   catalog could not resolve renders nothing rather than a badge with no hue. *@
                @if (!string.IsNullOrWhiteSpace(boss.LeadsTo) && !string.IsNullOrWhiteSpace(boss.LeadsToThemeKey))
                {
                    <div class="chart-card__leads-to is-@boss.LeadsToThemeKey" aria-label="Drops feed @boss.LeadsTo">
                        <span aria-hidden="true">→</span>@boss.LeadsTo
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(boss.Subtitle))
                {
                    <div class="chart-card__subtitle">@boss.Subtitle</div>
                }
                @* The key item this card grants. A card that grants none renders nothing - the one
                   board-level key item belongs to no card at all, so it lives only in the grid. *@
                @if (tracksKeyItem)
                {
                    <div class="chart-card__subtitle chart-card__keyitem">@boss.KeyItemName</div>
                }
            </div>
        </div>
        @* A Mini NM is farmed rather than popped, so stock is the headline, not item count. *@
        @if (isMiniNm)
        {
            <span class="tag chart-count">@boss.TotalQuantity held</span>
        }
        else if (!Model.Board.AllowsPopItems && !Model.Board.AllowsDropItems)
        {
            @* A board that tracks no items has nothing to count here. Dynamis and Limbus headline
               outstanding requests instead, which is what those cards are about now. *@
            <span class="tag chart-count">@boss.PendingRequestCount requested</span>
        }
        else
        {
            <span class="tag chart-count">@boss.TotalItems @(boss.TotalItems == 1 ? "Item" : "Items")</span>
        }
    </div>

    @* Requests tied to THIS card. Board-level ones ("anywhere") count toward none, which is exactly
       what leaving the zone blank said. Suppressed on a board whose header already shows the count. *@
    @if (boss.PendingRequestCount > 0 && (Model.Board.AllowsPopItems || Model.Board.AllowsDropItems))
    {
        <div class="chart-card__requests">
            <span class="tag accent">@boss.PendingRequestCount requested</span>
        </div>
    }

    <partial name="_ChartBossTable" model="Model" />

    @if (isFinal)
    {
        @* Reference text, not tracked data, so it hangs off a collapsed strip: open it stretches the
           row, closed the finale is exactly as tall as the cards beside it. Reuses the page's
           generic .chart-toggle / .chart-drawer script. *@
        if (hasRewards)
        {
            <div class="chart-card__footer chart-rewards__bar">
                <button type="button" class="chart-rewards__toggle chart-toggle" data-target="@rewardsId">
                    <span class="chart-rewards__chevron">›</span> Rewards
                </button>
                <strong>@boss.Rewards.Count</strong>
            </div>
            <aside id="@rewardsId" class="chart-rewards chart-drawer" hidden>
                <ul>
                    @foreach (var reward in boss.Rewards)
                    {
                        <li><span>◈</span> @reward</li>
                    }
                </ul>
                @if (!string.IsNullOrWhiteSpace(boss.ReferenceNote))
                {
                    <div class="chart-rewards__note">@boss.ReferenceNote</div>
                }
            </aside>
        }
    }
    else
    {
        @* Every non-finale card, Mini NM included. A Mini NM used to skip this, which left it shorter
           than the cards beside it and its grid row with a hole in it. Its header already headlines
           stock, so "Total Qty" repeats that one number — a card the same shape as its neighbours is
           worth the repetition. *@
        <div class="chart-card__footer">
            <span>Total Items: <strong>@boss.TotalItems</strong></span>
            <span>Total Qty: <strong>@boss.TotalQuantity</strong></span>
        </div>
    }

    @* ---- Key item progress, on the card that grants it.
         A count plus a drawer naming exactly who is still short, because "3 of 14" answers how far
         along the linkshell is and the list answers who to chase - and only the second one is
         actionable. The drawer reuses the page's generic .chart-toggle / .chart-drawer script, so a
         card is only ever as tall as its neighbours when it is closed.

         The stored fact is "has it"; this list is its inverse against the live roster, which is why
         somebody who joins tomorrow appears here with no backfill. ---- *@
    @if (tracksKeyItem)
    {
        <div class="chart-card__footer chart-rewards__bar">
            <button type="button" class="chart-rewards__toggle chart-toggle" data-target="@keyItemId">
                <span class="chart-rewards__chevron">›</span> Key item
            </button>
            <strong>@boss.KeyItemHaveCount of @boss.KeyItemTotalMembers have it</strong>
        </div>
        <aside id="@keyItemId" class="chart-rewards chart-drawer" hidden>
            @if (boss.KeyItemMissing.Count == 0)
            {
                <div class="chart-rewards__note">Everybody on the roster has @boss.KeyItemName.</div>
            }
            else
            {
                <div class="chart-rewards__note">Still needed by @boss.KeyItemMissing.Count:</div>
                <ul>
                    @foreach (var name in boss.KeyItemMissing)
                    {
                        <li><span>◈</span> @name</li>
                    }
                </ul>
            }
        </aside>
    }
</article>

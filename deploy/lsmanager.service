[Unit]
Description=LSManager (LinkshellManagerDiscordApp)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=lsmanager
Group=lsmanager
WorkingDirectory=/var/www/lsmanager
ExecStart=/usr/bin/dotnet /var/www/lsmanager/LinkshellManagerDiscordApp.dll
Restart=always
RestartSec=5
KillSignal=SIGINT
SyslogIdentifier=lsmanager
EnvironmentFile=/etc/lsmanager/env

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# /var/lib/lsmanager holds the Data Protection key ring (Google refresh tokens,
# auth cookies). It lives outside the deploy artifact dir so keys survive the
# deploy script swapping /var/www/lsmanager on every release.
ReadWritePaths=/var/www/lsmanager /var/log/lsmanager /var/lib/lsmanager

[Install]
WantedBy=multi-user.target

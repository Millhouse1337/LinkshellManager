@model LinkshellManagerDiscordApp.ViewModels.MemberProfileViewModel
@{
    ViewData["Title"] = "Member profile";
    ViewData["BodyClass"] = "lsm-page";

    string InitialsFor(string? name)
    {
        var initials = string.Concat((name ?? "?")
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(w => w[0])).ToUpperInvariant();
        if (string.IsNullOrEmpty(initials)) { initials = "?"; }
        return initials.Length > 2 ? initials[..2] : initials;
    }

    // Main + each named alt, as labeled characters to render.
    var characters = new List<(string Label, bool IsAlt, IReadOnlyList<int> Levels, IReadOnlyList<bool> Strong, IReadOnlyList<bool> Relic, IReadOnlyList<string> RelicName, IReadOnlyList<string> Merit, IReadOnlyList<int> Gear, IReadOnlyList<int> Skill)>
    {
        (Model.Entry.CharacterName, false, Model.Entry.JobLevels, Model.Entry.StrongJobs, Model.Entry.RelicFlags, Model.Entry.RelicNames, Model.Entry.MeritJobs, Model.Entry.GearRatings, Model.Entry.SkillRatings)
    };
    if (Model.Entry.Alt1Name is not null) { characters.Add((Model.Entry.Alt1Name, true, Model.Entry.Alt1JobLevels, Model.Entry.Alt1StrongJobs, Model.Entry.Alt1RelicFlags, Model.Entry.Alt1RelicNames, Model.Entry.Alt1MeritJobs, Model.Entry.Alt1GearRatings, Model.Entry.Alt1SkillRatings)); }
    if (Model.Entry.Alt2Name is not null) { characters.Add((Model.Entry.Alt2Name, true, Model.Entry.Alt2JobLevels, Model.Entry.Alt2StrongJobs, Model.Entry.Alt2RelicFlags, Model.Entry.Alt2RelicNames, Model.Entry.Alt2MeritJobs, Model.Entry.Alt2GearRatings, Model.Entry.Alt2SkillRatings)); }
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">@Model.Entry.CharacterName</h1>
        <div class="page-sub">
            @if (!string.IsNullOrWhiteSpace(Model.LinkshellName))
            {
                <span>@Model.LinkshellName</span>
                <span class="dot"> · </span>
            }
            <span>@(Model.Entry.Rank ?? "Member")</span>
        </div>
    </div>
    <div class="page-actions">
        <a class="btn ghost" asp-action="Index" asp-route-selectedLinkshellId="@Model.LinkshellId">Back to team</a>
    </div>
</div>

<div class="card jr-card fade d2" style="max-width:720px">
    <div class="jr-card-head">
        <div class="jr-av">@InitialsFor(Model.Entry.CharacterName)</div>
        <div class="jr-id">
            <div class="jr-name">@Model.Entry.CharacterName</div>
            <div class="jr-rank">@(Model.Entry.Rank ?? "Member")</div>
        </div>
    </div>

    <div style="font-weight:500;color:var(--fg);font-size:13px;margin-top:4px">Jobs</div>
    @foreach (var ch in characters)
    {
        var leveled = ch.Levels
            .Select((lvl, i) => new
            {
                Name = Model.JobCatalog[i],
                Level = lvl,
                Strong = i < ch.Strong.Count && ch.Strong[i],
                Relic = i < ch.Relic.Count && ch.Relic[i],
                RelicName = i < ch.RelicName.Count ? ch.RelicName[i] : "",
                Merit = i < ch.Merit.Count ? ch.Merit[i] : "",
                Gear = i < ch.Gear.Count ? ch.Gear[i] : 0,
                Skill = i < ch.Skill.Count ? ch.Skill[i] : 0
            })
            .Where(x => x.Level > 0)
            .OrderByDescending(x => x.Level)
            .ToList();

        <div class="jr-char">
            @if (ch.IsAlt)
            {
                <div class="jr-char-label">@ch.Label <span class="jr-alt-tag">alt</span></div>
            }
            @if (leveled.Count == 0)
            {
                <div class="jr-empty">No jobs entered</div>
            }
            else
            {
                <div class="jr-pills">
                    @foreach (var job in leveled)
                    {
                        var tipParts = new List<string>();
                        if (job.Relic) { tipParts.Add(string.IsNullOrWhiteSpace(job.RelicName) ? "Relic weapon" : "Relic: " + job.RelicName); }
                        if (job.Strong && !string.IsNullOrWhiteSpace(job.Merit)) { tipParts.Add("Merits: " + job.Merit); }
                        else if (job.Strong) { tipParts.Add("Merited"); }
                        var tip = tipParts.Count > 0 ? string.Join(" · ", tipParts) : null;
                        <span class="jr-pill @(job.Strong ? "jr-pill--strong" : "") @(job.Relic ? "relic-flame" : "")" title="@tip"><span class="jr-pill-job">@job.Name</span><span class="jr-pill-lvl">@job.Level</span>@if (job.Strong) {<span class="jr-pill-strong">★</span>}@if (job.Gear > 0 || job.Skill > 0)
                        {
                            <span class="jr-pill-rate" title="Self-rated — Gear @job.Gear/5 · Skill @job.Skill/5"><span class="jr-rate"><span class="jr-rate-k">G</span><span class="jr-stars">@for (var s = 1; s <= 5; s++){<span class="@(s <= job.Gear ? "on" : "")">★</span>}</span></span><span class="jr-rate"><span class="jr-rate-k">S</span><span class="jr-stars">@for (var s = 1; s <= 5; s++){<span class="@(s <= job.Skill ? "on" : "")">★</span>}</span></span></span>
                        }</span>
                    }
                </div>
            }
        </div>
    }
</div>

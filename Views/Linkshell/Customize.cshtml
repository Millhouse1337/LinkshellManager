@model LinkshellCustomizeViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Customize Linkshell";
    ViewData["BodyClass"] = "lsm-page";
    var savedMessage = TempData["CustomizeSaved"] as string;
    var errorMessage = TempData["CustomizeError"] as string;
    var antiforgeryTokens = Antiforgery.GetAndStoreTokens(Context);
}
<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Customize Linkshell</h1>
        <div class="page-sub">
            @if (Model.ManageableLinkshells.Count > 0 && !string.IsNullOrWhiteSpace(Model.LinkshellName))
            {
                <span>@Model.LinkshellName</span>
            }
            else
            {
                <span>Settings</span>
            }
        </div>
    </div>
    <div class="page-actions">
        <a class="btn ghost" asp-controller="Linkshell" asp-action="Index">Back to linkshells</a>
    </div>
</div>
@if (Model.ManageableLinkshells.Count == 0)
{
    <div class="card fade d2">
        <div class="empty">
            <div style="padding:32px 16px;text-align:center;color:var(--fg-3)">
                You're not a Leader or Officer in any linkshell, so there's nothing here to customize yet.
            </div>
        </div>
    </div>
    return;
}
@if (!string.IsNullOrEmpty(savedMessage))
{
    <div class="alert alert-success fade d2" style="margin-bottom:16px">@savedMessage</div>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger fade d2" style="margin-bottom:16px">@errorMessage</div>
}
<!-- Dashboard banner: officer-uploaded image shown atop the dashboard on both
     the web app and the Discord Activity. Kept as the first section here (and on
     the Activity Configurations tab). Stored in the LinkshellBanner table; served
     anonymously so the <img> works inside the Discord iframe. -->
<div class="card fade d2" id="bannerCard" style="margin-bottom:16px">
    <div class="card-head">
        <div class="card-title">🖼 Dashboard Banner</div>
    </div>
    @* Full-width so the preview is the same 1200x200 strip the dashboard draws. *@
    <div style="padding:8px 16px 16px;display:flex;flex-direction:column;gap:14px;width:100%">
        <div style="font-size:12px;color:var(--fg-3)">
            Shown at the top of the dashboard (web and Discord Activity). Recommended size
            <strong>1200 × 200</strong> px — it displays full-width at 200&nbsp;px tall and is cropped to fit.
        </div>
        @if (!string.IsNullOrEmpty(Model.BannerUrl))
        {
            <img class="lsm-dash-banner" src="@Model.BannerUrl" alt="Current banner" />
        }
        <form method="post" asp-action="UploadBanner" enctype="multipart/form-data"
              style="display:flex;flex-direction:column;gap:10px">
            @Html.AntiForgeryToken()
            <input type="hidden" name="linkshellId" value="@Model.LinkshellId" />
            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                <input type="file" name="bannerFile" id="banner-file"
                       accept="image/png,image/jpeg,image/webp,image/gif"
                       style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0" />
                <label for="banner-file" class="btn sm" style="cursor:pointer">Choose image</label>
                <span id="banner-file-name" style="font-size:12px;color:var(--fg-3)">No file chosen</span>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
                <button type="submit" class="btn primary sm">Upload banner</button>
            </div>
        </form>
        @if (!string.IsNullOrEmpty(Model.BannerUrl))
        {
            <form method="post" asp-action="RemoveBanner" class="lsm-confirm-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="linkshellId" value="@Model.LinkshellId" />
                <button type="submit" class="btn ghost sm">Remove banner</button>
            </form>
        }
    </div>
</div>
<script nonce="@Html.CspNonce()">
    (function () {
        var input = document.getElementById('banner-file');
        var label = document.getElementById('banner-file-name');
        if (input && label) {
            input.addEventListener('change', function () {
                label.textContent = input.files && input.files.length ? input.files[0].name : 'No file chosen';
            });
        }
    })();
</script>
<form asp-action="Customize" method="post" class="fade d2" id="customizeForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="LinkshellId" />
    <div class="card" style="margin-bottom:16px">
        <div class="card-head">
            <div class="card-title">Loot Structure</div>
        </div>
        <div style="padding:8px 16px 16px;display:flex;flex-direction:column;gap:14px">
            <div style="display:flex;gap:32px;flex-wrap:wrap;align-items:flex-start">
                <div style="flex:1 1 300px;display:flex;flex-direction:column;gap:10px">
                    <div style="font-size:12px;color:var(--fg-3)">Choose how loot is awarded for this linkshell.</div>
                    <label style="display:flex;gap:10px;align-items:flex-start">
                        <input type="radio" asp-for="LootStructure" value="Dkp" id="loot-dkp" />
                        <span>
                            <strong>DKP Based</strong>
                            <div style="color:var(--fg-3);font-size:12px">DKP earned per event, spent on loot.</div>
                        </span>
                    </label>
                    <label style="display:flex;gap:10px;align-items:flex-start">
                        <input type="radio" asp-for="LootStructure" value="LootCouncil" id="loot-council" />
                        <span>
                            <strong>Loot Council</strong>
                            <div style="color:var(--fg-3);font-size:12px">Leader decides; DKP is not tracked.</div>
                        </span>
                    </label>
                    <label style="display:flex;gap:10px;align-items:flex-start">
                        <input type="radio" asp-for="LootStructure" value="Hybrid" id="loot-hybrid" />
                        <span>
                            <strong>Percentage Based</strong>
                            <div style="color:var(--fg-3);font-size:12px">DKP earned as usual; loot deducts a percentage of the winner's balance.</div>
                        </span>
                    </label>
                    <div id="dkp-rounding-row" style="display:flex;flex-direction:column;gap:4px;max-width:320px;margin-top:8px">
                        <label asp-for="DkpRoundingIncrement">DKP rounding increment</label>
                        <select class="form-select" asp-for="DkpRoundingIncrement">
                            <option value="Quarter">Nearest Quarter (0.25)</option>
                            <option value="Half">Nearest Half (0.5)</option>
                        </select>
                    </div>
                </div>
                <div style="flex:1 1 360px;display:flex;flex-direction:column;gap:8px;border-left:1px solid var(--border);padding-left:32px">
                    <div class="card-title" style="font-size:14px">Feature Toggles</div>
                    <div style="font-size:12px;color:var(--fg-3)">Hide sections your linkshell doesn't use.</div>
                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:6px 16px">
                        <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" class="switch" asp-for="EnableEndgame" /> Charts tab</label>
                        <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" class="switch" asp-for="EnableHnmSection" /> HNM tab</label>
                        @* Missions isn't built yet: locked off + (TBA). Restore asp-for (and the nav
                           gate in _Sidebar) when it ships. *@
                        <label style="display:flex;gap:8px;align-items:center;opacity:.55;cursor:not-allowed" title="Not developed yet — coming soon."><input type="checkbox" class="switch" disabled /> Missions tab <span style="color:var(--fg-3)">(TBA)</span></label>
                        <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" class="switch" asp-for="EnableAuctions" /> Auctions tab</label>
                        <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" class="switch" asp-for="EnableToDs" /> ToDs tab</label>
                        <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" class="switch" asp-for="EnableEvents" /> Events tab</label>
                        <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" class="switch" asp-for="EnableDkp" /> DKP tab</label>
                        <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" class="switch" asp-for="EnableItems" /> Items</label>
                        <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" class="switch" asp-for="EnableRevenue" /> Revenue</label>
                    </div>
                    <div class="card-title" style="font-size:14px;margin-top:14px">Member Activity Tracking</div>
                    <div style="font-size:12px;color:var(--fg-3)">
                        Show an Active/Inactive badge per member based on event attendance. A member goes
                        <strong>Inactive</strong> after N consecutive absences from events that count, and back to
                        <strong>Active</strong> after M consecutive credited attendances.
                    </div>
                    <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" class="switch" asp-for="EnableActivityTracking" /> Enable activity tracking</label>
                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:6px 16px">
                        <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--fg-2)">
                            Absences before Inactive
                            <input type="number" min="1" max="50" class="form-control" asp-for="InactiveAfterAbsences" />
                        </label>
                        <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--fg-2)">
                            Attendances back to Active
                            <input type="number" min="1" max="50" class="form-control" asp-for="ActiveAfterAttendances" />
                        </label>
                    </div>
                    <div style="display:flex;gap:24px;flex-wrap:wrap;margin-top:14px">
                        <div style="flex:1 1 220px;min-width:0;display:flex;flex-direction:column;gap:8px">
                            <div class="card-title" style="font-size:14px">Outside Party Signup</div>
                            <div style="font-size:12px;color:var(--fg-3)">
                                Let Discord-server members who have <strong>never launched the app</strong> sign up —
                                or <strong>Check In</strong> on an HNM camp — straight from the board, identified by their
                                Discord account. Their first click adds them to your roster as a placeholder member, so they
                                <strong>earn DKP and count toward attendance</strong> like anyone else (and aren't re-asked
                                for their name next time). Covers <strong>every event type</strong>, HNM included.
                            </div>
                            <label style="display:flex;gap:8px;align-items:center;margin-top:auto"><input type="checkbox" class="switch" asp-for="OutsidePartySignupEnabled" /> Allow outside (non-account) Discord signups</label>
                        </div>

                        <div style="flex:1 1 220px;min-width:0;display:flex;flex-direction:column;gap:8px">
                            <div class="card-title" style="font-size:14px">Full-width event boards <span style="font-size:11px;color:var(--fg-3)">(experimental)</span></div>
                            <div style="font-size:12px;color:var(--fg-3)">
                                Post sign-up boards as a <strong>full-width text grid</strong>: parties in three columns
                                with role, leader and readiness icons, spanning the whole message column. No rendered
                                image &mdash; the grid already shows every slot, so boards post faster too. Off, a rendered
                                picture <em>is</em> the board and Discord caps it at roughly a third of that width. Same
                                buttons and signup flow. Discord won't let a board switch modes once posted, so this only
                                affects boards posted <strong>after</strong> you turn it on.
                            </div>
                            <label style="display:flex;gap:8px;align-items:center;margin-top:auto"><input type="checkbox" class="switch" asp-for="UseComponentsV2Boards" /> Full-width text boards</label>
                        </div>
                    </div>
                </div>
            </div>
            <div style="display:flex;justify-content:flex-end;border-top:1px solid var(--border);padding-top:14px">
                <button class="btn primary" type="submit">Save changes</button>
            </div>
        </div>
    </div>
    <div class="card" style="margin-bottom:16px">
        <div class="card-head">
            <div class="card-title">Event Board Theme</div>
        </div>
        <div style="padding:12px 16px 16px;display:flex;flex-direction:column;gap:12px">
            <div style="font-size:12px;color:var(--fg-3)">
                Colour palette for the event signup board image posted to your Discord channel.
                Applies the next time a board is posted or refreshed.
            </div>
            <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:10px">
                @foreach (var theme in LinkshellManagerDiscordApp.Services.EventBoardThemes.All)
                {
                    var selected = string.Equals(Model.EventBoardTheme, theme.Key, StringComparison.OrdinalIgnoreCase);
                    <label style="flex:0 0 auto;min-width:160px;display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;cursor:pointer;border:1px solid @(selected ? theme.SwatchAccent : "var(--border)");background:var(--surface)">
                        <input type="radio" asp-for="EventBoardTheme" value="@theme.Key" style="margin:0" />
                        <span style="width:34px;height:34px;border-radius:8px;flex-shrink:0;background:@theme.SwatchBg;border:2px solid @theme.SwatchAccent;box-shadow:0 0 10px @theme.SwatchAccent;display:flex;align-items:center;justify-content:center">
                            <span style="width:12px;height:12px;border-radius:3px;transform:rotate(45deg);background:@theme.SwatchAccent"></span>
                        </span>
                        <strong style="font-size:13px">@theme.DisplayName</strong>
                    </label>
                }
            </div>
            <div style="display:flex;justify-content:flex-end;border-top:1px solid var(--border);padding-top:14px">
                <button class="btn primary" type="submit">Save changes</button>
            </div>
        </div>
    </div>
    @* (A "Hide ToD Mobs" card sat here — per-monster switches that kept a monster out of the
       Tracked Windows panel. The feature is no longer used, so the web config doesn't offer it;
       the stored value is left alone by the save below rather than wiped.) *@
</form>

<!-- Monster setups. Its OWN form, outside the settings form above, because it saves through its
     own action (SaveMonsterTimings -> the same MonsterTimingEditor the Activity endpoint uses).
     Nesting it would make one Save persist both, and an Enter keypress in a cell would submit
     the whole linkshell settings payload. -->
@* (A "Claim Shield is switched off server-wide" banner sat here. While the switch is off the whole
   Claim Shield COLUMN is hidden below, so the banner explained an absence — nothing on this card
   mentions Claim Shield at all any more. The Settings page owns that state and already shows it.) *@
<form method="post" asp-action="SaveMonsterTimings" class="lsm-confirm-form"
      data-confirm="Save the monster setups for @Model.LinkshellName?">
    @Html.AntiForgeryToken()
    <input type="hidden" name="linkshellId" value="@Model.LinkshellId" />
    <div class="card" style="margin-bottom:16px">
        <div class="card-head">
            <div class="card-title">Monster Setups</div>
        </div>
        <div style="padding:12px 16px;display:flex;flex-direction:column;gap:12px">
            <div style="font-size:12px;color:var(--fg-3)">
                What each monster's camp runs on: how many spawn <strong>windows</strong> it sits
                through, how far apart those windows open (<strong>cadence</strong>), and how long
                after a kill it repops (<strong>cooldown</strong>). These drive the monster list on
                the event and ToD forms, and a camp captures them when it is created — editing here
                never changes a camp that is already running.
            </div>
            <div style="font-size:12px;color:var(--fg-3)">
                Leave <strong>windows</strong> blank for a monster with no spawn-window cycle; its
                cadence is then just how often the ToD form suggests re-checking.
            </div>

            @{
                // Rendered as one GROUP PER CATEGORY, each with its own "+ Add monster", because a
                // category can now be empty: the built-in catalog is the twelve HNMs, so "Other NMs"
                // starts with no rows at all and a linkshell fills it itself. The old flat list drew
                // a heading only when a row changed category, which left an empty group invisible —
                // and its add button used to clone the LAST row, so an NM added from the bottom of
                // the page would have landed under HNMs.
                //
                // Still posts as ONE indexed collection (monsterTimings[i].Field), so this counter
                // runs across every group: the binder drops everything after the first gap.
                var monsterIndex = 0;
                var categories = Model.MonsterTimingCategories.Count > 0
                    ? Model.MonsterTimingCategories
                    : new List<string> { "Other NMs" };
            }
            <div class="monster-setup-rows">
                @for (var g = 0; g < categories.Count; g++)
                {
                    var category = categories[g];
                    var isLastCategory = g == categories.Count - 1;
                    // A row carrying an unknown or retired category folds into the LAST group rather
                    // than vanishing, so it stays visible and therefore deletable. Mirrors the
                    // Activity's monsterTimingGroups().
                    var groupRows = Model.MonsterTimings
                        .Where(candidate => categories.Any(known =>
                                string.Equals(known, candidate.Category, StringComparison.OrdinalIgnoreCase))
                            ? string.Equals(category, candidate.Category, StringComparison.OrdinalIgnoreCase)
                            : isLastCategory)
                        .ToList();
                    <section class="monster-setup-group" data-category="@category">
                        <div class="monster-setup-heading">
                            <span>@category</span>
                            <span class="monster-setup-heading-line"></span>
                            <button class="btn ghost sm monster-setup-add" type="button"
                                    data-category="@category">+ Add monster</button>
                        </div>
                        @* Column labels only when there is something to label — "Other NMs" is empty
                           until a linkshell adds its own. Rendered-but-hidden rather than omitted so
                           the script can reveal it the moment a row is added. *@
                        <div class="monster-setup-row monster-setup-row--head" hidden="@(groupRows.Count == 0)">
                            <div class="monster-setup-name">Monster</div>
                            <div class="monster-setup-windows">Windows</div>
                            <div class="monster-setup-duration">Cadence</div>
                            <div class="monster-setup-duration">Cooldown</div>
                            @if (!Model.ClaimShieldGloballyDisabled)
                            {
                                <div class="monster-setup-claim" title="Record who tagged this monster during a claim-shield lottery. Off for monsters you don't contest.">Claim Shield</div>
                            }
                            <div class="monster-setup-actions"></div>
                        </div>
                        <div class="monster-setup-group-rows">
                        @foreach (var row in groupRows)
                        {
                            var i = monsterIndex++;
                            <div class="monster-setup-row">
                                <input type="hidden" name="monsterTimings[@i].Id" value="@row.Id" />
                                <input type="hidden" name="monsterTimings[@i].Category" value="@row.Category" />
                                <div class="monster-setup-name">
                                    @if (row.IsCustom)
                                    {
                                        <input type="text" name="monsterTimings[@i].MonsterName" value="@row.MonsterName"
                                               maxlength="128" placeholder="Monster name" />
                                    }
                                    else
                                    {
                                        <input type="hidden" name="monsterTimings[@i].MonsterName" value="@row.MonsterName" />
                                        <span>@row.MonsterName</span>
                                    }
                                </div>
                                <div class="monster-setup-windows">
                                    <input type="number" name="monsterTimings[@i].Windows" value="@row.Windows"
                                           min="1" max="@Model.MonsterTimingMaxWindows" step="1" placeholder="none"
                                           title="How many spawn windows this camp sits through. Blank = no window cycle." />
                                </div>
                                <div class="monster-setup-duration">
                                    @* Placeholder 0, not an em dash: a blank cadence means this monster has
                                       no interval at all, which is a real answer for most NMs. *@
                                    <input type="number" name="monsterTimings[@i].CadenceValue" value="@row.CadenceValue"
                                           min="0" step="1" placeholder="0" />
                                    <select name="monsterTimings[@i].CadenceUnit">
                                        <option value="hours" selected="@(row.CadenceUnit == "hours")">hours</option>
                                        <option value="mins" selected="@(row.CadenceUnit != "hours")">mins</option>
                                    </select>
                                </div>
                                <div class="monster-setup-duration">
                                    @* min 0, because an added row starts blank: typing nothing says "I don't
                                       know the repop yet". MonsterTimingEditor.NormalizeCooldown fills the
                                       built-in band for that monster rather than storing a zero cooldown,
                                       which would repop it the instant it died. *@
                                    <input type="number" name="monsterTimings[@i].CooldownValue" value="@row.CooldownValue"
                                           min="0" step="1" placeholder="0" />
                                    <select name="monsterTimings[@i].CooldownUnit">
                                        <option value="hours" selected="@(row.CooldownUnit == "hours")">hours</option>
                                        <option value="mins" selected="@(row.CooldownUnit != "hours")">mins</option>
                                    </select>
                                </div>
                                @if (Model.ClaimShieldGloballyDisabled)
                                {
                                    @* Column hidden entirely while an admin has Claim Shield off server-wide —
                                       there is nothing useful to set, so it isn't shown.
        
                                       The HIDDEN FIELD still ships, and has to: this form is a full replace, so
                                       a row that posts no value at all binds false and would silently wipe the
                                       linkshell's per-monster choices the moment anyone saved the page. It
                                       carries the STORED value verbatim, so everything comes back exactly as it
                                       was when Claim Shield is re-enabled. *@
                                    <input type="hidden" name="monsterTimings[@i].ClaimShieldEnabled"
                                           value="@(row.ClaimShieldEnabled ? "true" : "false")" />
                                }
                                else
                                {
                                    <div class="monster-setup-claim">
                                        <label>
                                            @* Checkbox FIRST, hidden partner second — the order ASP.NET Core's
                                               own checkbox tag helper emits. The bool binder takes the FIRST
                                               posted value, so reversing them makes a ticked box bind false. *@
                                            <input type="checkbox" name="monsterTimings[@i].ClaimShieldEnabled" value="true"
                                                   checked="@row.ClaimShieldEnabled" />
                                            <input type="hidden" name="monsterTimings[@i].ClaimShieldEnabled" value="false" />
                                            <span>@(row.ClaimShieldEnabled ? "On" : "Off")</span>
                                        </label>
                                    </div>
                                }
                                <div class="monster-setup-actions">
                                    @if (row.IsCustom)
                                    {
                                        <button type="button" class="btn ghost sm monster-setup-remove"
                                                title="Remove this monster">Remove</button>
                                    }
                                </div>
                            </div>
                        }
                        </div>
                        <div class="monster-setup-empty" hidden="@(groupRows.Count > 0)">
                            No monsters in this group yet.
                        </div>
                    </section>
                }
            </div>

            @* The blueprint "+ Add monster" clones. A <template> is inert — nothing inside it posts —
               so the new-row shape lives here beside the real rows instead of being copied off
               whichever row happened to be last, which is how an added NM used to inherit the wrong
               group. The [0] indices and the Category are rewritten by the script below. *@
            <template id="monster-setup-template">
                <div class="monster-setup-row">
                    <input type="hidden" name="monsterTimings[0].Id" value="0" />
                    <input type="hidden" name="monsterTimings[0].Category" value="" />
                    <div class="monster-setup-name">
                        <input type="text" name="monsterTimings[0].MonsterName"
                               maxlength="128" placeholder="Monster name" />
                    </div>
                    <div class="monster-setup-windows">
                        <input type="number" name="monsterTimings[0].Windows"
                               min="1" max="@Model.MonsterTimingMaxWindows" step="1" placeholder="none"
                               title="How many spawn windows this camp sits through. Blank = no window cycle." />
                    </div>
                    <div class="monster-setup-duration">
                        <input type="number" name="monsterTimings[0].CadenceValue" min="0" step="1" placeholder="0" />
                        <select name="monsterTimings[0].CadenceUnit">
                            <option value="hours">hours</option>
                            <option value="mins" selected>mins</option>
                        </select>
                    </div>
                    <div class="monster-setup-duration">
                        <input type="number" name="monsterTimings[0].CooldownValue" min="0" step="1" placeholder="0" />
                        <select name="monsterTimings[0].CooldownUnit">
                            <option value="hours" selected>hours</option>
                            <option value="mins">mins</option>
                        </select>
                    </div>
                    @if (Model.ClaimShieldGloballyDisabled)
                    {
                        @* Same contract as a rendered row: the field still ships while the column is
                           hidden, so a full-replace save can't silently switch Claim Shield off. A
                           monster someone is adding is one they camp, so it starts on. *@
                        <input type="hidden" name="monsterTimings[0].ClaimShieldEnabled" value="true" />
                    }
                    else
                    {
                        <div class="monster-setup-claim">
                            <label>
                                <input type="checkbox" name="monsterTimings[0].ClaimShieldEnabled" value="true" checked />
                                <input type="hidden" name="monsterTimings[0].ClaimShieldEnabled" value="false" />
                                <span>On</span>
                            </label>
                        </div>
                    }
                    <div class="monster-setup-actions">
                        <button type="button" class="btn ghost sm monster-setup-remove"
                                title="Remove this monster">Remove</button>
                    </div>
                </div>
            </template>

            <div style="display:flex;justify-content:flex-end;gap:8px;border-top:1px solid var(--border);padding-top:14px">
                <button class="btn primary" type="submit">Save changes</button>
            </div>
        </div>
    </div>
</form>

<script nonce="@Html.CspNonce()">
    (function () {
        var rows = document.querySelector('.monster-setup-rows');
        var template = document.getElementById('monster-setup-template');
        if (!rows || !template) { return; }

        // Field names carry the POST index, so any add/remove has to renumber EVERY row — across all
        // groups, in document order — or the model binder silently drops everything after the first
        // gap. The index is the only thing tying a row's fields together; the group it sits in is
        // carried by its own hidden Category field.
        function reindex() {
            var list = rows.querySelectorAll('.monster-setup-row:not(.monster-setup-row--head)');
            for (var i = 0; i < list.length; i++) {
                list[i].querySelectorAll('[name]').forEach(function (el) {
                    el.setAttribute(
                        'name',
                        el.getAttribute('name').replace(/^monsterTimings\[\d+\]/, 'monsterTimings[' + i + ']'));
                });
            }
        }

        // Whether a group still has rows decides both its column labels and its "nothing here yet"
        // line. A group can legitimately be empty — "Other NMs" starts that way on every linkshell.
        function syncEmptyState(group) {
            var populated = !!group.querySelector('.monster-setup-row:not(.monster-setup-row--head)');
            var note = group.querySelector('.monster-setup-empty');
            var head = group.querySelector('.monster-setup-row--head');
            if (note) { note.hidden = populated; }
            if (head) { head.hidden = !populated; }
        }

        rows.addEventListener('click', function (evt) {
            var addBtn = evt.target.closest('.monster-setup-add');
            if (addBtn) {
                var group = addBtn.closest('.monster-setup-group');
                var body = group.querySelector('.monster-setup-group-rows');
                var row = template.content.firstElementChild.cloneNode(true);

                // The row lands in the group whose button was clicked, and says so in the field the
                // server reads — the DOM position is only how it looks.
                row.querySelector('[name$=".Category"]').value = group.dataset.category || '';

                body.appendChild(row);
                syncEmptyState(group);
                reindex();
                row.querySelector('[name$=".MonsterName"]').focus();
                return;
            }

            var removeBtn = evt.target.closest('.monster-setup-remove');
            if (!removeBtn) { return; }
            var doomed = removeBtn.closest('.monster-setup-row');
            var owner = doomed.closest('.monster-setup-group');
            doomed.remove();
            if (owner) { syncEmptyState(owner); }
            reindex();
        });
    })();
</script>

<!-- Import DKP: a migrating linkshell uploads an Excel/CSV (fit to the export
     template) to bring its existing DKP in. Matched members are updated; unknown
     names are created as unsynced placeholders that carry their DKP until that
     person first launches the app and claims it. Two steps: upload → preview →
     confirm (on the preview page). Standalone multipart form. -->
<div class="card fade d2" id="dkpImportCard" style="margin-bottom:16px">
    <div class="card-head">
        <div class="card-title">📥 Import DKP</div>
        <div class="page-actions">
            <a class="btn sm" asp-controller="Linkshell" asp-action="DownloadDkpTemplate">⬇ Download template</a>
        </div>
    </div>
    <div style="padding:8px 16px 16px;display:flex;flex-direction:column;gap:14px;max-width:560px;margin:0 auto;width:100%">
        <div style="font-size:12px;color:var(--fg-3)">
            Bringing a linkshell over from another tracker? Upload a spreadsheet of your existing
            DKP. Members already in the app are updated; names we don't recognize are created as
            unsynced members that keep their DKP until that person first opens the app and claims it.
            You'll review everything before anything changes.
        </div>
        <div style="font-size:12px;color:var(--fg-3)">
            Your sheet needs these columns: <strong>Member Name</strong>, <strong>Alt 1</strong>,
            <strong>Alt 2</strong>, <strong>Current DKP</strong>, <strong>Total DKP</strong>,
            <strong>Total DKP Spent</strong>. Download the template (top-right) to see the exact format.
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
            <a class="btn ghost sm" asp-controller="DkpSheet" asp-action="ExportExcel" asp-route-linkshellId="@Model.LinkshellId">Export current DKP</a>
        </div>
        <form method="post" asp-action="PreviewDkpImport" enctype="multipart/form-data"
              style="display:flex;flex-direction:column;gap:10px">
            @Html.AntiForgeryToken()
            <input type="hidden" name="linkshellId" value="@Model.LinkshellId" />
            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                <input type="file" name="importFile" id="dkp-import-file"
                       accept=".xlsx,.csv"
                       style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0" />
                <label for="dkp-import-file" class="btn sm" style="cursor:pointer">Choose file</label>
                <span id="dkp-import-name" style="font-size:12px;color:var(--fg-3)">No file chosen</span>
            </div>
            <!-- Hidden until a correctly-typed (.xlsx/.csv) file is chosen — see script below. -->
            <div id="dkp-preview-wrap" style="display:none">
                <button type="submit" class="btn primary sm">Preview import</button>
            </div>
        </form>
    </div>
</div>
<script nonce="@Html.CspNonce()">
    (function () {
        var input = document.getElementById('dkp-import-file');
        var label = document.getElementById('dkp-import-name');
        var previewWrap = document.getElementById('dkp-preview-wrap');
        if (!input || !label) { return; }
        // Only reveal "Preview import" once a correctly-typed file is selected.
        var allowed = /\.(xlsx|csv)$/i;
        input.addEventListener('change', function () {
            var hasFile = input.files && input.files.length;
            if (!hasFile) {
                label.textContent = 'No file chosen';
                label.style.color = 'var(--fg-3)';
                if (previewWrap) { previewWrap.style.display = 'none'; }
                return;
            }
            var name = input.files[0].name;
            if (allowed.test(name)) {
                label.textContent = name;
                label.style.color = 'var(--fg-3)';
                if (previewWrap) { previewWrap.style.display = ''; }
            } else {
                label.textContent = name + ' — choose a .xlsx or .csv file';
                label.style.color = 'var(--danger)';
                if (previewWrap) { previewWrap.style.display = 'none'; }
            }
        });
    })();
</script>
<!-- Discord Server: associate the linkshell with a server (roster/invites/
     channels) and, separately, optionally lock viewing access to it. Standalone
     card with its own POST forms, not tied to the main customize save. -->
<div class="card fade d2" id="discordLockCard" style="margin-bottom:16px">
    <div class="card-head">
        <div class="card-title">Discord Server</div>
    </div>
    @* Three side-by-side steps: add the bot, pick the server, then (optionally) lock to it.
       auto-fit means they stack again on a narrow window instead of squeezing. *@
    <div style="padding:8px 16px 16px;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:18px;align-items:start;width:100%">
        <!-- Set up the bot -->
        <div style="display:flex;flex-direction:column;gap:8px">
            <div style="font-weight:500;color:var(--fg)">Set up the bot</div>
            <div style="font-size:12px;color:var(--fg-3)">
                The LSM bot allows linkshell info to be posted in your Discord server's channels.
            </div>
            <ol style="margin:0;padding-left:18px;display:flex;flex-direction:column;gap:8px;font-size:12px;color:var(--fg-3);line-height:1.5">
                <li><strong>Add the bot to your server</strong> — click the button, choose your server, authorize (you must own the server or have the <em>Manage Server</em> Discord permission).</li>
                <li><strong>Give your bot the following permissions</strong> — <strong>Send Messages</strong>, <strong>Embed Links</strong>, and <strong>Attach Files</strong>.</li>
            </ol>
            <div style="margin-top:4px">
                <a class="btn primary" href="https://discord.com/oauth2/authorize?client_id=1320463503848636568" target="_blank" rel="noopener noreferrer">Add the LSM bot to Discord ↗</a>
            </div>
        </div>
        <!-- Server -->
        <div style="display:flex;flex-direction:column;gap:10px">
        <div style="font-weight:500;color:var(--fg)">Server</div>
        <div style="font-size:12px;color:var(--fg-3);margin-top:-4px">
            Set your server here, then run <strong>/lsm</strong> in Discord to drop a "Join" button for members to launch the app.
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.DiscordGuildId))
        {
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                <span class="tag success">Server set</span>
                <span style="font-size:13px;color:var(--fg-2)">
                    <strong>@(string.IsNullOrWhiteSpace(Model.DiscordGuildName) ? Model.DiscordGuildId : Model.DiscordGuildName)</strong>
                </span>
                <form method="post" asp-action="ClearGuild" class="lsm-confirm-form" style="display:inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="linkshellId" value="@Model.LinkshellId" />
                    <button class="btn ghost sm" type="submit" onclick="return confirm('Clear the Discord server? This also turns off the access lock.');">Clear server</button>
                </form>
            </div>
        }
        else
        {
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                <span class="tag">No server set</span>
                <span style="font-size:13px;color:var(--fg-3)">Not associated with a Discord server.</span>
            </div>
        }
        <form method="post" asp-action="SetGuild" class="lsm-confirm-form"
              style="display:flex;flex-direction:column;gap:8px;border-top:1px solid var(--border);padding-top:12px">
            @Html.AntiForgeryToken()
            <input type="hidden" name="linkshellId" value="@Model.LinkshellId" />
            @if (Model.EligibleGuilds.Count > 0)
            {
                <div class="field">
                    <label for="setGuildSelect">Server</label>
                    <select class="form-select" id="setGuildSelect" name="guildId" style="width:100%">
                        @foreach (var guild in Model.EligibleGuilds)
                        {
                            <option value="@guild.Id" selected="@(guild.Id == Model.DiscordGuildId)">@guild.Name</option>
                        }
                    </select>
                </div>
                <div style="font-size:12px;color:var(--fg-3)">Servers where you and the LSM bot are both members.</div>
            }
            else
            {
                <div class="field">
                    <label for="setGuildInput">Discord server ID</label>
                    <input class="input" id="setGuildInput" type="text" name="guildId"
                           inputmode="numeric" pattern="[0-9]*" maxlength="20" autocomplete="off"
                           placeholder="e.g. 123456789012345678" />
                </div>
                <div style="font-size:12px;color:var(--fg-3)">
                    No servers found automatically. Make sure the LSM bot is in your server, then enter its
                    numeric ID (in Discord, with Developer Mode on, right-click the server &rarr; Copy Server ID).
                </div>
            }
            <div style="display:flex;justify-content:flex-end">
                <button class="btn primary" type="submit">
                    @(string.IsNullOrWhiteSpace(Model.DiscordGuildId) ? "Set server" : "Change server")
                </button>
            </div>
        </form>
        </div>

        <!-- Lock access -->
        <div style="display:flex;flex-direction:column;gap:6px">
            <div style="font-weight:500;color:var(--fg)">Lock access to this server</div>
            <div style="font-size:12px;color:var(--fg-3)">
                Optional. When ON, members can only open this linkshell from the set Discord server.
                Leave OFF to let members view it from anywhere (the default).
            </div>
            @if (string.IsNullOrWhiteSpace(Model.DiscordGuildId))
            {
                <span class="tag" style="margin-top:4px;width:fit-content">Set a server first to enable the lock.</span>
            }
            else
            {
                <form method="post" asp-action="SetGuildLock" class="lsm-confirm-form" style="margin-top:4px;display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="linkshellId" value="@Model.LinkshellId" />
                    <input type="hidden" name="locked" value="@((!Model.GuildLocked).ToString().ToLowerInvariant())" />
                    @if (Model.GuildLocked)
                    {
                        <span class="tag success">Locked</span>
                        <button class="btn warn sm" type="submit">Unlock (allow any server)</button>
                    }
                    else
                    {
                        <span class="tag">Not locked</span>
                        <button class="btn primary sm" type="submit">Lock to this server</button>
                    }
                </form>
            }
        </div>
    </div>
</div>
<!-- Post-event discussion mirror: the bot reposts each new event-history comment
     to this channel so the discussion shows up in Discord too. -->
<div class="card" style="margin-bottom:16px">
    <div class="card-head"><div class="card-title">💬 After-event discussion channel</div></div>
    <div style="padding:8px 16px 14px">
        <p style="margin-top:0;font-size:13px;color:var(--fg-3)">
            Optional. New comments on a completed event are mirrored to this channel. Leave blank to keep discussion in-app only.
        </p>
        <form asp-action="SetDiscussionChannel" method="post" style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap">
            <input type="hidden" name="linkshellId" value="@Model.LinkshellId" />
            <label class="field" style="flex:1 1 240px">
                <span>Discussion channel</span>
                @if (Model.AvailableChannels.Count > 0)
                {
                    <select class="form-select" name="discussionChannelId">
                        <option value="">— none (in-app only) —</option>
                        @foreach (var channel in Model.AvailableChannels)
                        {
                            <option value="@channel.Id" selected="@(channel.Id == Model.DiscussionChannelId)">#@channel.Name</option>
                        }
                    </select>
                }
                else
                {
                    <input class="input" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="20"
                           placeholder="Channel ID" name="discussionChannelId" value="@Model.DiscussionChannelId" autocomplete="off" />
                }
            </label>
            <button class="btn primary sm" type="submit" style="margin-bottom:2px">Save</button>
        </form>
    </div>
</div>
<!-- Discord channel routes: the bot posts each kind of content to the channel(s)
     you assign here. Combine several post types into one channel or split them. -->
@{
    var availableChannels = Model.AvailableChannels;
    var eventTypes = LinkshellManagerDiscordApp.Models.EventTypeVocabulary.All;
    // The linkshell's own monster catalog (built-ins + custom), same list the Activity's
    // per-route HNM narrowing offers.
    var routeMonsters = Model.MonsterTimings
        .Select(timing => timing.MonsterName)
        .Where(name => !string.IsNullOrWhiteSpace(name))
        .Select(name => name!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    async Task RouteRow(int i, LinkshellManagerDiscordApp.ViewModels.ChannelRouteInput r, bool isTemplate)
    {
        // A route that is already persisted opens collapsed to its channel name, exactly as
        // it does on the Activity's Configurations tab; a freshly added one starts open.
        var saved = !isTemplate && r.Id != 0;
        var showEvents = !isTemplate && r.PostEvents;
        var showMonsters = showEvents && r.EventTypeFilter.Contains("HNM");
        var channelName = availableChannels.FirstOrDefault(c => c.Id == r.ChannelId)?.Name;
        var channelLabel = !string.IsNullOrWhiteSpace(channelName) ? "#" + channelName
            : !string.IsNullOrWhiteSpace(r.ChannelId) ? r.ChannelId
            : "New route";
        <div class="route-row@(saved ? " is-saved is-collapsed" : "")">
            <input type="hidden" data-field="Id" name="channelRoutes[@i].Id" value="@r.Id" />
            <input type="hidden" data-field="Name" name="channelRoutes[@i].Name" value="@r.Name" />

            @* Collapsed summary row: saved pill + channel + Expand. *@
            <div class="route-collapsed">
                <span class="tag success route-pill-saved">✓ Saved</span>
                <span class="tag route-pill-dirty">Unsaved</span>
                <span class="route-collapsed-name" data-route-label>@channelLabel</span>
                <button type="button" class="btn ghost sm route-expand">Expand</button>
            </div>

            <div class="route-expanded">
                <span class="tag success route-status route-pill-saved">✓ Saved</span>
                <span class="tag route-status route-pill-dirty">Unsaved</span>
                @if (saved)
                {
                    <button type="button" class="btn ghost sm route-collapse-top">Collapse</button>
                }

                <div class="route-main">
                    <div class="route-top">
                        <label class="field route-channel">
                            <span>Channel</span>
                            @if (availableChannels.Count > 0)
                            {
                                <select class="form-select" data-field="ChannelId" name="channelRoutes[@i].ChannelId">
                                    <option value="">— pick a channel —</option>
                                    @foreach (var channel in availableChannels)
                                    {
                                        <option value="@channel.Id" selected="@(!isTemplate && channel.Id == r.ChannelId)">#@channel.Name</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input class="input" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="20"
                                       placeholder="Channel ID" autocomplete="off"
                                       data-field="ChannelId" name="channelRoutes[@i].ChannelId" value="@r.ChannelId" />
                            }
                        </label>
                    </div>
                    <div class="route-group">
                        <h4>Choose What to Post</h4>
                        <div class="chip-grid post-types">
                            @foreach (var (prop, label, on) in new[]
                            {
                                ("PostEvents", "Events", r.PostEvents),
                                ("PostLoot", "Loot", r.PostLoot),
                                ("PostAuctions", "Auctions", r.PostAuctions),
                                ("PostAttendance", "Attendance", r.PostAttendance),
                                ("PostTodBoard", "ToD", r.PostTodBoard),
                                ("PostDkpSheet", "DKP", r.PostDkpSheet),
                            })
                            {
                                <label class="chip">
                                    <input type="checkbox" value="true" data-field="@prop" name="channelRoutes[@i].@prop"
                                           checked="@(!isTemplate && on)"
                                           @(prop == "PostEvents" ? "data-events-toggle" : "") />
                                    <input type="hidden" data-field="@prop" name="channelRoutes[@i].@prop" value="false" />
                                    <span>@label</span>
                                </label>
                            }
                        </div>
                    </div>
                </div>

                <div class="route-side" style="@(showEvents ? "" : "display:none")">
                    <div class="route-event-types route-group">
                        <h4>Choose what Event Type</h4>
                        <div class="chip-grid event-grid">
                            @foreach (var et in eventTypes)
                            {
                                <label class="chip">
                                    <input type="checkbox" value="@et" data-field="EventTypeFilter" name="channelRoutes[@i].EventTypeFilter"
                                           checked="@(!isTemplate && r.EventTypeFilter.Contains(et))"
                                           @(et == "HNM" ? "data-hnm-toggle" : "") />
                                    <span>@et</span>
                                </label>
                            }
                        </div>
                    </div>

                    @* Per-monster narrowing, only while this route catches HNM. Nothing ticked =
                       every HNM goes here; tick monsters to route ONLY those to this channel. *@
                    @if (routeMonsters.Count > 0)
                    {
                        <div class="route-monsters route-group" style="@(showMonsters ? "" : "display:none")">
                            <h4>Choose what HNM Monsters</h4>
                            <div class="chip-grid event-grid--wide">
                                @foreach (var monster in routeMonsters)
                                {
                                    <label class="chip">
                                        <input type="checkbox" value="@monster" data-field="HnmMonsterFilter"
                                               name="channelRoutes[@i].HnmMonsterFilter"
                                               checked="@(!isTemplate && r.HnmMonsterFilter.Contains(monster))" />
                                        <span>@monster</span>
                                    </label>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="route-remove-row">
                    <button type="button" class="btn ghost sm route-remove">Remove</button>
                </div>
            </div>
        </div>
    }
}
<!-- Chip-style route cards, matching the Discord Activity's Configurations tab: one centered
     column of bordered toggle chips, a saved route collapsed to "✓ Saved · #channel · Expand",
     and a green tint while what's on screen is what's stored. -->
<style>
    /* A single centered column: Channel → Choose What to Post → Event types → HNM monsters. */
    #discordChannelsCard .route-row {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 20px;
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 18px;
    }
    /* A persisted, unedited route gets a slight green tint so it's obvious what's saved. */
    #discordChannelsCard .route-row.is-saved {
        border-color: rgba(74, 222, 128, 0.35);
        background: rgba(74, 222, 128, 0.045);
    }
    #discordChannelsCard .route-row.is-dirty {
        border-color: var(--border);
        background: var(--surface-2);
    }
    /* Saved routes sit collapsed: just the channel name + Expand. */
    #discordChannelsCard .route-row.is-collapsed { padding: 12px 16px; gap: 0; }
    #discordChannelsCard .route-collapsed { display: none; width: 100%; align-items: center; gap: 12px; text-align: left; }
    #discordChannelsCard .route-row.is-collapsed .route-collapsed { display: flex; }
    #discordChannelsCard .route-row.is-collapsed .route-expanded { display: none; }
    #discordChannelsCard .route-collapsed-name { font-weight: 600; color: var(--fg-1); }
    #discordChannelsCard .route-collapsed .route-expand { margin-left: auto; }
    #discordChannelsCard .route-expanded {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        width: 100%;
    }
    /* Status pill top-left, Collapse top-right — mirrors the Activity's route card. */
    #discordChannelsCard .route-status { position: absolute; top: 0; left: 0; z-index: 1; white-space: nowrap; }
    #discordChannelsCard .route-collapse-top { position: absolute; top: -2px; right: 0; z-index: 1; white-space: nowrap; }
    #discordChannelsCard .route-pill-dirty { display: none; }
    #discordChannelsCard .route-row.is-dirty .route-pill-saved { display: none; }
    #discordChannelsCard .route-row.is-dirty .route-pill-dirty { display: inline-flex; }
    /* An unsaved (new) route has no status pill at all. */
    #discordChannelsCard .route-row:not(.is-saved):not(.is-dirty) .route-status { display: none; }
    #discordChannelsCard .route-main { display: flex; flex-direction: column; gap: 16px; min-width: 0; width: 100%; align-items: center; }
    #discordChannelsCard .route-top { display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap; justify-content: center; }
    #discordChannelsCard .route-channel { flex: 1 1 280px; min-width: 0; max-width: 360px; }
    #discordChannelsCard .route-remove-row { width: 100%; display: flex; justify-content: flex-end; gap: 8px; }
    #discordChannelsCard .route-remove { white-space: nowrap; }
    #discordChannelsCard .route-side {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 18px;
        min-width: 0;
        width: 100%;
        border-top: 1px solid var(--border);
        padding-top: 18px;
    }
    #discordChannelsCard .event-grid--wide { max-width: 760px; }
    #discordChannelsCard .route-group { display: flex; flex-direction: column; align-items: center; width: 100%; }
    #discordChannelsCard .route-group h4 {
        margin: 0 0 10px;
        font-size: 13px;
        font-weight: 700;
        color: var(--fg-1);
    }
    #discordChannelsCard .chip-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
    #discordChannelsCard .chip {
        display: flex;
        align-items: center;
        gap: 9px;
        min-height: 38px;
        padding: 8px 12px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 600;
        color: var(--fg-1);
        background: rgba(255, 255, 255, 0.025);
        border: 1px solid var(--border);
        cursor: pointer;
        transition: border-color 0.12s ease, background 0.12s ease, color 0.12s ease;
    }
    #discordChannelsCard .chip:hover { border-color: var(--accent); }
    #discordChannelsCard .chip span { line-height: 1.2; }
    #discordChannelsCard .chip:has(input[type="checkbox"]:checked) {

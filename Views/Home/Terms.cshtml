@{
    ViewData["Title"] = "Terms of Service";
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Terms of Service</h1>
        <div class="page-sub"><span>Effective date: May 3, 2026</span></div>
    </div>
</div>

<div class="card fade d2" style="padding:24px;max-width:860px">
    <div style="display:grid;gap:18px;color:var(--fg-3);font-size:14px;line-height:1.65">
        <section>
            <h2 style="font-size:18px;color:var(--fg);margin:0 0 8px">1. Acceptance</h2>
            <p style="margin:0">
                By using LinkshellManager, including the website, Discord Activity, and in-game attendance addon,
                you agree to these Terms of Service. If you do not agree, do not use the service.
            </p>
        </section>

        <section>
            <h2 style="font-size:18px;color:var(--fg);margin:0 0 8px">2. What LSManager Does</h2>
            <p style="margin:0">
                LinkshellManager helps Final Fantasy XI linkshells manage rosters, events, attendance, DKP,
                loot, auctions, ToDs, announcements, rules, and related linkshell activity. The service may be
                accessed through a browser, inside Discord, or through the paired in-game addon.
            </p>
        </section>

        <section>
            <h2 style="font-size:18px;color:var(--fg);margin:0 0 8px">3. Accounts and Discord</h2>
            <p style="margin:0">
                LSManager uses Discord sign-in to identify users. You are responsible for keeping your Discord
                account secure and for activity performed through your account. Linkshell leaders and officers
                are responsible for managing membership, permissions, and content inside their linkshell.
            </p>
        </section>

        <section>
            <h2 style="font-size:18px;color:var(--fg);margin:0 0 8px">4. Acceptable Use</h2>
            <p style="margin:0">
                Do not use LSManager to harass others, upload or share unlawful content, interfere with the
                service, attempt unauthorized access, abuse APIs, or impersonate another person. Access may be
                limited or removed if the service is abused or used in a way that harms other users.
            </p>
        </section>

        <section>
            <h2 style="font-size:18px;color:var(--fg);margin:0 0 8px">5. User Content and Linkshell Data</h2>
            <p style="margin:0">
                Your linkshell may create and store names, event records, attendance records, DKP entries,
                loot history, messages, rules, announcements, and related gameplay data. You retain responsibility
                for the content you enter. LSManager may store and process this data to provide the service.
            </p>
        </section>

        <section>
            <h2 style="font-size:18px;color:var(--fg);margin:0 0 8px">6. Addon Use</h2>
            <p style="margin:0">
                The in-game addon is optional and is intended to help record attendance, ToDs, events, and loot.
                You are responsible for using the addon in a way that complies with the rules of the game server
                or community where you play.
            </p>
        </section>

        <section>
            <h2 style="font-size:18px;color:var(--fg);margin:0 0 8px">7. Service Availability</h2>
            <p style="margin:0">
                LSManager is provided as-is and may change, be interrupted, or become unavailable. No guarantee
                is made that the service will always be available, error-free, or suitable for every linkshell's
                needs.
            </p>
        </section>

        <section>
            <h2 style="font-size:18px;color:var(--fg);margin:0 0 8px">8. Limitation of Liability</h2>
            <p style="margin:0">
                To the fullest extent allowed by law, LSManager is not responsible for lost data, missed events,
                DKP disputes, loot decisions, service downtime, or other damages resulting from use of the
                service.
            </p>
        </section>

        <section>
            <h2 style="font-size:18px;color:var(--fg);margin:0 0 8px">9. Changes</h2>
            <p style="margin:0">
                These terms may be updated from time to time. Continued use of LSManager after changes are posted
                means you accept the updated terms.
            </p>
        </section>

        <section>
            <h2 style="font-size:18px;color:var(--fg);margin:0 0 8px">10. Contact</h2>
            <p style="margin:0">
                For questions about these terms, contact the LSManager operator or administrator who provided
                access to your linkshell.
            </p>
        </section>
    </div>
</div>

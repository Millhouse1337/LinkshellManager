@model LinkshellCustomizeViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Customize Linkshell";
    var savedMessage = TempData["CustomizeSaved"] as string;
    var antiforgeryTokens = Antiforgery.GetAndStoreTokens(Context);
    var canManageRolesValue = Model.CanManageRoles.ToString().ToLowerInvariant();
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Customize Linkshell</h1>
        <div class="page-sub">
            @if (Model.ManageableLinkshells.Count > 0 && !string.IsNullOrWhiteSpace(Model.LinkshellName))
            {
                <span>@Model.LinkshellName</span>
            }
            else
            {
                <span>Settings</span>
            }
        </div>
    </div>
    <div class="page-actions">
        <a class="btn ghost" asp-controller="Linkshell" asp-action="Index">Back to linkshells</a>
    </div>
</div>

@if (Model.ManageableLinkshells.Count == 0)
{
    <div class="card fade d2">
        <div class="empty">
            <div style="padding:32px 16px;text-align:center;color:var(--fg-3)">
                You're not a Leader or Officer in any linkshell, so there's nothing here to customize yet.
            </div>
        </div>
    </div>
    return;
}

@if (!string.IsNullOrEmpty(savedMessage))
{
    <div class="alert alert-success fade d2" style="margin-bottom:16px">@savedMessage</div>
}

<div class="card fade d2" style="margin-bottom:16px">
    <div class="card-head">
        <div class="card-title">Linkshell</div>
    </div>
    <form method="get" asp-action="Customize" style="padding:12px 16px;display:flex;gap:8px;align-items:center;flex-wrap:wrap">
        <select class="form-select" name="id" style="min-width:240px;flex:1 1 240px">
            @foreach (var linkshell in Model.ManageableLinkshells)
            {
                if (linkshell.Id == Model.LinkshellId)
                {
                    <option value="@linkshell.Id" selected>@linkshell.LinkshellName</option>
                }
                else
                {
                    <option value="@linkshell.Id">@linkshell.LinkshellName</option>
                }
            }
        </select>
        <button class="btn primary sm" type="submit" style="white-space:nowrap">Switch Linkshell</button>
    </form>
</div>

<form asp-action="Customize" method="post" class="fade d2">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="LinkshellId" />

    <div class="card" style="margin-bottom:16px">
        <div class="card-head">
            <div class="card-title">Loot Structure</div>
        </div>
        <div style="padding:8px 16px 16px;display:flex;flex-direction:column;gap:10px">
            <div style="font-size:12px;color:var(--fg-3)">Choose how loot is awarded for this linkshell.</div>
            <label style="display:flex;gap:10px;align-items:flex-start">
                <input type="radio" asp-for="LootStructure" value="Dkp" id="loot-dkp" />
                <span>
                    <strong>DKP</strong>
                    <div style="color:var(--fg-3);font-size:12px">Time-based DKP earned per event, spent on loot.</div>
                </span>
            </label>
            <label style="display:flex;gap:10px;align-items:flex-start">
                <input type="radio" asp-for="LootStructure" value="LootCouncil" id="loot-council" />
                <span>
                    <strong>Loot Council</strong>
                    <div style="color:var(--fg-3);font-size:12px">Leader decides; DKP is not tracked.</div>
                </span>
            </label>
            <label style="display:flex;gap:10px;align-items:flex-start">
                <input type="radio" asp-for="LootStructure" value="Hybrid" id="loot-hybrid" />
                <span>
                    <strong>Percentage Based</strong>
                    <div style="color:var(--fg-3);font-size:12px">DKP earned as usual; loot deducts a percentage of the winner's balance.</div>
                </span>
            </label>

            <div id="dkp-rounding-row" style="display:flex;flex-direction:column;gap:4px;max-width:320px;margin-top:8px">
                <label asp-for="DkpRoundingIncrement">DKP rounding increment</label>
                <select class="form-select" asp-for="DkpRoundingIncrement">
                    <option value="Quarter">Nearest Quarter (0.25)</option>
                    <option value="Half">Nearest Half (0.5)</option>
                </select>
            </div>
            <div style="display:flex;justify-content:flex-end;margin-top:8px">
                <button class="btn primary" type="submit">Save changes</button>
            </div>
        </div>
    </div>

    <div class="card" style="margin-bottom:16px">
        <div class="card-head">
            <div class="card-title">Feature Toggles</div>
        </div>
        <div style="padding:8px 16px 16px;display:flex;flex-direction:column;gap:8px">
            <div style="font-size:12px;color:var(--fg-3)">Hide sections your linkshell doesn't use.</div>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:6px 16px">
                <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" asp-for="EnableEndgame" /> Endgame tab</label>
                <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" asp-for="EnableHnmSection" /> HNM tab</label>
                <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" asp-for="EnableMissions" /> Missions tab</label>
                <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" asp-for="EnableAuctions" /> Auctions tab</label>
                <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" asp-for="EnableToDs" /> ToDs tab</label>
                <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" asp-for="EnableEvents" /> Events tab</label>
                <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" asp-for="EnableDkp" /> DKP tab</label>
                <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" asp-for="EnableItems" /> Items tile on dashboard</label>
                <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" asp-for="EnableRevenue" /> Revenue tile on dashboard</label>
            </div>
            <div style="display:flex;justify-content:flex-end;margin-top:8px">
                <button class="btn primary" type="submit">Save changes</button>
            </div>
        </div>
    </div>
</form>

<div class="card fade d2 permissions-config-card" id="permissionsConfigCard" style="margin-top:16px"
     data-linkshellid="@Model.LinkshellId"
     data-can-manage-roles="@canManageRolesValue"
     data-csrf-header="@antiforgeryTokens.HeaderName"
     data-csrf-token="@antiforgeryTokens.RequestToken">
    <div class="card-head">
        <div class="card-title">Permissions</div>
        <div class="page-actions">
            <span id="permissionsStatus" class="permissions-status">Loading roles...</span>
            @if (Model.CanManageRoles)
            {
                <button type="button" class="btn primary sm" id="permissionsNewRoleBtn" style="white-space:nowrap">+ New Role</button>
            }
        </div>
    </div>
    <div id="permissionsError" class="alert alert-danger permissions-error" style="display:none"></div>
    <div class="permissions-table-wrap" id="permissionsTableWrap">
        <div class="empty">Loading roles...</div>
    </div>

    @if (Model.CanManageRoles)
    {
        <form id="roleEditForm" class="role-edit-form" style="display:none">
            <div class="role-edit-form__header">
                <strong id="roleEditTitle">Edit role</strong>
                <button type="button" class="btn ghost sm" id="roleEditCancelBtn">Cancel</button>
            </div>
            <label class="field">
                <span>Role name</span>
                <input type="text" class="form-control" id="roleEditName" maxlength="64" required />
            </label>
            <div class="role-edit-form__permissions" id="rolePermissionFields"></div>
            <div class="role-edit-form__actions">
                <button type="submit" class="btn primary" id="roleEditSaveBtn">Save changes</button>
                <button type="button" class="btn ghost" id="roleEditCancelBtnBottom">Cancel</button>
            </div>
        </form>
    }
</div>

<!-- Game Addon (att) pairing card. Lives outside the customize form because tokens
     are managed via separate XHR endpoints (no full-form post). -->
<div class="card fade d2" id="addonTokenCard" style="margin-top:16px"
     data-linkshellid="@Model.LinkshellId"
     data-csrf-header="@antiforgeryTokens.HeaderName"
     data-csrf-token="@antiforgeryTokens.RequestToken">
    <div class="card-head">
        <div>
            <div class="card-title">Game Addon (att)</div>
            <div style="color:var(--fg-3);font-size:12px;margin-top:2px">
                Generate a one-time pairing code, then in FFXI type
                <code style="background:var(--bg-2);padding:1px 6px;border-radius:4px">/att link &lt;code&gt;</code>
                to connect the addon to this linkshell.
            </div>
        </div>
        <div class="page-actions">
            <button type="button" class="btn primary sm" id="addonGenerateBtn">+ Generate pairing code</button>
        </div>
    </div>
    <div id="addonTokensWrapper" style="padding:0 4px 4px">
        <div id="addonTokensEmpty" class="empty" style="display:none">No active addon tokens. Generate one to get started.</div>
        <table class="table themed" id="addonTokensTable" style="display:none">
            <thead>
                <tr>
                    <th>Token</th>
                    <th>Label</th>
                    <th>Created</th>
                    <th>Last used</th>
                    <th style="text-align:right">Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<div class="mt-modal" id="addonPairModal" role="dialog" aria-modal="true">
    <div class="mt-modal__backdrop" data-mt-close="1"></div>
    <div class="mt-modal__dialog">
        <div class="mt-modal__content">
            <div class="mt-modal__header">
                <h5 class="mt-modal__title">Pairing code</h5>
                <button type="button" class="mt-modal__close" data-mt-close="1" aria-label="Close">&times;</button>
            </div>
            <div class="mt-modal__body">
                <div class="field" style="margin-bottom:14px">
                    <label for="addonPairLabel">Label (optional)</label>
                    <input type="text" id="addonPairLabel" class="form-control" placeholder="e.g. Nils — desktop" maxlength="128" />
                </div>
                <div id="addonPairCodeWrapper" style="display:none">
                    <div style="text-align:center;margin:12px 0">
                        <div style="font-size:32px;letter-spacing:6px;font-family:monospace;font-weight:700" id="addonPairCode"></div>
                        <div style="color:var(--fg-3);font-size:12px;margin-top:8px">
                            Expires in <span id="addonPairCountdown">10:00</span>. In FFXI: <code>/att link &lt;code&gt;</code>
                        </div>
                    </div>
                </div>
                <div id="addonPairError" style="color:#e05a5a;font-size:13px;margin-top:8px;display:none"></div>
            </div>
            <div class="mt-modal__footer">
                <button type="button" class="btn ghost" data-mt-close="1">Close</button>
                <button type="button" class="btn primary" id="addonPairCreateBtn">Generate</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script nonce="@Html.CspNonce()">
        (function () {
            // Hide the DKP rounding row when the loot structure is Loot Council,
            // matching the Activity's behavior (rounding only applies to DKP-based modes).
            var dkpRow = document.getElementById('dkp-rounding-row');
            var radios = document.querySelectorAll('input[type=radio][name="LootStructure"]');
            function update() {
                var selected = document.querySelector('input[type=radio][name="LootStructure"]:checked');
                var value = selected ? selected.value : '';
                dkpRow.style.display = (value === 'Dkp' || value === 'Hybrid') ? '' : 'none';
            }
            radios.forEach(function (r) { r.addEventListener('change', update); });
            update();
        })();
    </script>

    <script nonce="@Html.CspNonce()">
        (function () {
            var card = document.getElementById('permissionsConfigCard');
            if (!card) return;

            var linkshellId = parseInt(card.dataset.linkshellid, 10);
            var canManageRoles = card.dataset.canManageRoles === 'true';
            var antiforgeryHeader = card.dataset.csrfHeader || '';
            var antiforgeryToken = card.dataset.csrfToken || '';
            var tableWrap = document.getElementById('permissionsTableWrap');
            var statusEl = document.getElementById('permissionsStatus');
            var errorEl = document.getElementById('permissionsError');
            var newRoleBtn = document.getElementById('permissionsNewRoleBtn');
            var form = document.getElementById('roleEditForm');
            var formTitle = document.getElementById('roleEditTitle');
            var nameInput = document.getElementById('roleEditName');
            var fieldsWrap = document.getElementById('rolePermissionFields');
            var saveBtn = document.getElementById('roleEditSaveBtn');
            var roles = [];
            var editingRoleId = null;

            var permissions = [
                { key: 'canManageRoles', label: 'Manage roles & permissions' },
                { key: 'canManageMembers', label: 'Manage members (invite, rank, status)' },
                { key: 'canManageEvents', label: 'Manage events (create, edit, start, end, cancel)' },
                { key: 'canModerateLiveEvent', label: 'Moderate live events (verify attendance, break room)' },
                { key: 'canAddLoot', label: 'Add event loot entries' },
                { key: 'canManageInventory', label: 'Manage inventory (items)' },
                { key: 'canManageTreasury', label: 'Manage treasury (revenue)' },
                { key: 'canManageRules', label: 'Manage rules' },
                { key: 'canManageAnnouncements', label: 'Manage announcements' },
                { key: 'canManageTods', label: 'Manage ToDs' },
                { key: 'canAuditDkp', label: 'Audit DKP' },
                { key: 'canManageAuctions', label: 'Manage auctions' },
                { key: 'canCustomizeLinkshell', label: 'Customize linkshell settings' }
            ];

            var escapeHtml = window.escapeHtml || function (value) {
                return String(value == null ? '' : value).replace(/[&<>"']/g, function (c) {
                    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
                });
            };

            function withCsrf(headers) {
                headers = headers || {};
                if (antiforgeryHeader && antiforgeryToken) {
                    headers[antiforgeryHeader] = antiforgeryToken;
                }
                return headers;
            }

            function setBusy(isBusy) {
                if (newRoleBtn) newRoleBtn.disabled = isBusy;
                if (saveBtn) saveBtn.disabled = isBusy;
                card.querySelectorAll('[data-role-action]').forEach(function (button) {
                    button.disabled = isBusy;
                });
                if (statusEl) statusEl.textContent = isBusy ? 'Saving...' : '';
            }

            function setError(message) {
                errorEl.textContent = message || '';
                errorEl.style.display = message ? 'block' : 'none';
            }

            function readError(response, fallback) {
                return response.text().then(function (text) {
                    if (!text) return fallback;
                    try {
                        var payload = JSON.parse(text);
                        return payload && payload.error ? payload.error : fallback;
                    } catch (e) {
                        return text;
                    }
                });
            }

            function renderTable() {
                if (!roles.length) {
                    tableWrap.innerHTML = '<div class="empty">No roles found.</div>';
                    return;
                }

                var head = '<tr><th>Permission</th>' + roles.map(function (role) {
                    var actions = '';
                    if (canManageRoles) {
                        actions =
                            '<div class="permissions-matrix__role-actions">' +
                            '<button type="button" class="btn ghost sm" data-role-action="edit" data-role-id="' + role.id + '">Edit</button>' +
                            (role.isSystem ? '' : '<button type="button" class="btn ghost sm" data-role-action="delete" data-role-id="' + role.id + '">Delete</button>') +
                            '</div>';
                    }
                    return '<th><div class="permissions-matrix__role">' +
                        '<strong>' + escapeHtml(role.name) + '</strong>' +
                        (role.isSystem ? '<span class="tag">System</span>' : '') +
                        actions +
                        '</div></th>';
                }).join('') + '</tr>';

                var body = permissions.map(function (permission) {
                    return '<tr><td>' + escapeHtml(permission.label) + '</td>' +
                        roles.map(function (role) {
                            return '<td class="permissions-matrix__cell">' +
                                (role[permission.key] ? '<span class="perm-yes">✓</span>' : '<span class="perm-no">-</span>') +
                                '</td>';
                        }).join('') +
                        '</tr>';
                }).join('');

                tableWrap.innerHTML =
                    '<table class="table themed permissions-matrix">' +
                    '<thead>' + head + '</thead>' +
                    '<tbody>' + body + '</tbody>' +
                    '</table>';
            }

            function renderPermissionFields() {
                if (!fieldsWrap) return;
                fieldsWrap.innerHTML = permissions.map(function (permission) {
                    return '<label class="role-edit-form__perm">' +
                        '<input type="checkbox" data-role-permission="' + permission.key + '" />' +
                        '<span>' + escapeHtml(permission.label) + '</span>' +
                        '</label>';
                }).join('');
            }

            function openForm(role) {
                if (!form) return;
                editingRoleId = role ? role.id : null;
                formTitle.textContent = role ? 'Edit role' : 'New role';
                nameInput.value = role ? role.name : '';
                nameInput.disabled = !!(role && role.isSystem);
                fieldsWrap.querySelectorAll('[data-role-permission]').forEach(function (input) {
                    var key = input.dataset.rolePermission;
                    input.checked = role ? role[key] === true : false;
                });
                form.style.display = '';
                if (newRoleBtn) newRoleBtn.style.display = 'none';
                nameInput.focus();
            }

            function closeForm() {
                editingRoleId = null;
                if (form) form.style.display = 'none';
                if (newRoleBtn) newRoleBtn.style.display = '';
            }

            function buildPayload() {
                var payload = { name: nameInput.value.trim() || null };
                fieldsWrap.querySelectorAll('[data-role-permission]').forEach(function (input) {
                    payload[input.dataset.rolePermission] = input.checked;
                });
                return payload;
            }

            function loadRoles() {
                setError('');
                if (statusEl) statusEl.textContent = 'Loading roles...';
                return fetch('/api/activity/linkshells/' + linkshellId + '/roles', {
                    cache: 'no-store',
                    credentials: 'same-origin'
                }).then(function (response) {
                    if (!response.ok) {
                        return readError(response, 'Loading roles failed.').then(function (message) {
                            throw new Error(message);
                        });
                    }
                    return response.json();
                }).then(function (data) {
                    roles = data.roles || [];
                    renderTable();
                    if (statusEl) statusEl.textContent = '';
                }).catch(function (error) {
                    setError(error.message || 'Loading roles failed.');
                    tableWrap.innerHTML = '<div class="empty">Roles could not be loaded.</div>';
                    if (statusEl) statusEl.textContent = '';
                });
            }

            function saveRole() {
                var payload = buildPayload();
                if (!payload.name) {
                    setError('A role name is required.');
                    nameInput.focus();
                    return;
                }

                var path = editingRoleId == null
                    ? '/api/activity/linkshells/' + linkshellId + '/roles'
                    : '/api/activity/linkshells/' + linkshellId + '/roles/' + editingRoleId + '/update';

                setBusy(true);
                setError('');
                fetch(path, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: withCsrf({ 'Content-Type': 'application/json' }),
                    body: JSON.stringify(payload)
                }).then(function (response) {
                    if (!response.ok) {
                        return readError(response, 'Saving the role failed.').then(function (message) {
                            throw new Error(message);
                        });
                    }
                    closeForm();
                    return loadRoles();
                }).catch(function (error) {
                    setError(error.message || 'Saving the role failed.');
                }).finally(function () {
                    setBusy(false);
                });
            }

            function deleteRole(role) {
                if (!role || role.isSystem) return;
                if (!window.confirm('Delete the "' + role.name + '" role?')) return;

                setBusy(true);
                setError('');
                fetch('/api/activity/linkshells/' + linkshellId + '/roles/' + role.id + '/delete', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: withCsrf()
                }).then(function (response) {
                    if (!response.ok) {
                        return readError(response, 'Deleting the role failed.').then(function (message) {
                            throw new Error(message);
                        });
                    }
                    closeForm();
                    return loadRoles();
                }).catch(function (error) {
                    setError(error.message || 'Deleting the role failed.');
                }).finally(function () {
                    setBusy(false);
                });
            }

            if (newRoleBtn) {
                newRoleBtn.addEventListener('click', function () { openForm(null); });
            }
            if (form) {
                renderPermissionFields();
                form.addEventListener('submit', function (event) {
                    event.preventDefault();
                    saveRole();
                });
                document.getElementById('roleEditCancelBtn').addEventListener('click', closeForm);
                document.getElementById('roleEditCancelBtnBottom').addEventListener('click', closeForm);
            }
            card.addEventListener('click', function (event) {
                var button = event.target.closest('[data-role-action]');
                if (!button) return;
                var roleId = parseInt(button.dataset.roleId, 10);
                var role = roles.find(function (item) { return item.id === roleId; });
                if (!role) return;
                if (button.dataset.roleAction === 'edit') openForm(role);
                if (button.dataset.roleAction === 'delete') deleteRole(role);
            });

            loadRoles();
        })();
    </script>

    <script nonce="@Html.CspNonce()">
        // Addon-pairing card UX. Self-contained so this view doesn't depend on
        // manage-team.js (which has been retired alongside the old card location).
        (function () {
            var addonCard = document.getElementById('addonTokenCard');
            if (!addonCard) return;

            // Read CSRF header/token from data-* attributes so the token never
            // gets interpolated as a JS string literal — the runtime parses it
            // as plain text from the DOM, which keeps it out of the script body
            // and is safe under the strict CSP nonce policy.
            var antiforgeryHeader = addonCard.dataset.csrfHeader || '';
            var antiforgeryToken = addonCard.dataset.csrfToken || '';
            function withCsrf(headers) {
                headers = headers || {};
                if (antiforgeryHeader && antiforgeryToken) {
                    headers[antiforgeryHeader] = antiforgeryToken;
                }
                return headers;
            }

            function openModal(id) {
                var el = document.getElementById(id);
                if (el) { el.classList.add('mt-modal--open'); document.body.style.overflow = 'hidden'; }
            }
            function closeModal(id) {
                var el = document.getElementById(id);
                if (el) { el.classList.remove('mt-modal--open'); document.body.style.overflow = ''; }
            }
            document.querySelectorAll('[data-mt-close]').forEach(function (el) {
                el.addEventListener('click', function () {
                    var modal = el.closest('.mt-modal');
                    if (modal) closeModal(modal.id);
                });
            });

            var addonLinkshellId = parseInt(addonCard.dataset.linkshellid, 10);
            var addonGenerateBtn = document.getElementById('addonGenerateBtn');
            var addonPairCreateBtn = document.getElementById('addonPairCreateBtn');
            var addonPairCodeWrapper = document.getElementById('addonPairCodeWrapper');
            var addonPairCode = document.getElementById('addonPairCode');
            var addonPairCountdown = document.getElementById('addonPairCountdown');
            var addonPairError = document.getElementById('addonPairError');
            var addonTokensTable = document.getElementById('addonTokensTable');
            var addonTokensEmpty = document.getElementById('addonTokensEmpty');
            var countdownTimer = null;

            var escapeHtml = window.escapeHtml;

            function setAddonPairError(msg) {
                addonPairError.textContent = msg || '';
                addonPairError.style.display = msg ? 'block' : 'none';
            }

            function renderTokens(tokens) {
                var tbody = addonTokensTable.querySelector('tbody');
                tbody.innerHTML = '';
                if (!tokens || tokens.length === 0) {
                    addonTokensTable.style.display = 'none';
                    addonTokensEmpty.style.display = 'block';
                    return;
                }
                addonTokensEmpty.style.display = 'none';
                addonTokensTable.style.display = '';
                tokens.forEach(function (t) {
                    var tr = document.createElement('tr');
                    var lastUsed = t.lastUsedAt ? new Date(t.lastUsedAt).toLocaleString() : '—';
                    var created = new Date(t.createdAt).toLocaleString();
                    tr.innerHTML =
                        '<td><code>' + escapeHtml(t.prefix) + '…</code></td>' +
                        '<td>' + escapeHtml(t.label || '—') + '</td>' +
                        '<td style="font-size:12px;color:var(--fg-3)">' + escapeHtml(created) + '</td>' +
                        '<td style="font-size:12px;color:var(--fg-3)">' + escapeHtml(lastUsed) + '</td>' +
                        '<td style="text-align:right"><button type="button" class="btn warn sm" data-revoke="' + t.id + '">Revoke</button></td>';
                    tbody.appendChild(tr);
                });
                tbody.querySelectorAll('button[data-revoke]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        var id = parseInt(btn.dataset.revoke, 10);
                        if (!id || !window.confirm('Revoke this addon token? The addon will lose access immediately.')) return;
                        btn.disabled = true;
                        fetch('/api/addon/management/tokens/' + id + '/revoke?linkshellId=' + addonLinkshellId, {
                            method: 'POST',
                            credentials: 'same-origin',
                            headers: withCsrf()
                        }).then(function (res) {
                            if (!res.ok) { btn.disabled = false; return; }
                            loadTokens();
                        }).catch(function () { btn.disabled = false; });
                    });
                });
            }

            function loadTokens() {
                fetch('/api/addon/management/tokens?linkshellId=' + addonLinkshellId, {
                    credentials: 'same-origin'
                }).then(function (res) {
                    if (!res.ok) return null;
                    return res.json();
                }).then(function (data) {
                    if (!data) return;
                    renderTokens(data.tokens || []);
                });
            }

            function startCountdown(totalSeconds) {
                if (countdownTimer) clearInterval(countdownTimer);
                var remaining = totalSeconds;
                function tick() {
                    if (remaining <= 0) {
                        addonPairCountdown.textContent = 'expired';
                        clearInterval(countdownTimer);
                        return;
                    }
                    var m = Math.floor(remaining / 60);
                    var s = remaining % 60;
                    addonPairCountdown.textContent = m + ':' + (s < 10 ? '0' : '') + s;
                    remaining--;
                }
                tick();
                countdownTimer = setInterval(tick, 1000);
            }

            addonGenerateBtn.addEventListener('click', function () {
                setAddonPairError('');
                addonPairCodeWrapper.style.display = 'none';
                addonPairCode.textContent = '';
                document.getElementById('addonPairLabel').value = '';
                openModal('addonPairModal');
            });

            addonPairCreateBtn.addEventListener('click', function () {
                setAddonPairError('');
                addonPairCreateBtn.disabled = true;
                var label = document.getElementById('addonPairLabel').value.trim();
                fetch('/api/addon/management/pairing-code', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: withCsrf({ 'Content-Type': 'application/json' }),
                    body: JSON.stringify({ linkshellId: addonLinkshellId, label: label || null })
                }).then(function (res) {
                    if (!res.ok) {
                        return res.text().then(function (txt) {
                            var msg = 'Could not generate pairing code.';
                            try { var j = JSON.parse(txt); if (j && j.error) msg = j.error; } catch (e) {}
                            setAddonPairError(msg);
                            return null;
                        });
                    }
                    return res.json();
                }).then(function (data) {
                    if (!data) return;
                    addonPairCode.textContent = data.code;
                    addonPairCodeWrapper.style.display = 'block';
                    startCountdown((data.expiresInMinutes || 10) * 60);
                }).catch(function () {
                    setAddonPairError('Network error generating pairing code.');
                }).finally(function () {
                    addonPairCreateBtn.disabled = false;
                });
            });

            document.getElementById('addonPairModal').addEventListener('click', function (e) {
                if (e.target.dataset && e.target.dataset.mtClose === '1') {
                    if (countdownTimer) clearInterval(countdownTimer);
                    loadTokens();
                }
            });

            loadTokens();
        })();
    </script>
}

                <a class="nav-sub-item @IsSubActive("Linkshell", "Permissions")" asp-controller="Linkshell" asp-action="Permissions">Permissions</a>
                <a class="nav-sub-item @IsSubActive("Linkshell", "GameAddon")" asp-controller="Linkshell" asp-action="GameAddon">Game Addon</a>

@using LinkshellManagerDiscordApp.Models
@using LinkshellManagerDiscordApp.Services
@model LinkshellManagerDiscordApp.ViewModels.FixTreasuryEntryViewModel
@{
    ViewData["Title"] = $"Fix entry {TreasuryLabels.EntryReference(Model.EntryNumber)}";
    ViewData["BodyClass"] = "lsm-page";
    var groups = new[]
    {
        (Key: TreasuryTransactionKinds.GroupCommon, Label: "Everyday"),
        (Key: TreasuryTransactionKinds.GroupOwed, Label: "Gil promised but not moved yet"),
        (Key: TreasuryTransactionKinds.GroupSetup, Label: "Setup"),
    };
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">@ViewData["Title"]</h1>
        <div class="page-sub">
            <span>Enter what it should have said. The original entry stays in the list with an opposite
                  entry beside it, so nothing disappears.</span>
        </div>
    </div>
</div>

<div class="card fade d2" style="padding:20px">
    <form asp-action="Fix" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-grid" style="grid-template-columns:repeat(3,minmax(0,1fr));column-gap:24px;align-items:end">
            <div class="field" style="grid-column:1/-1">
                <label asp-for="TransactionKind"></label>
                <select asp-for="TransactionKind" class="form-select" id="TransactionKind" required>
                    @foreach (var group in groups)
                    {
                        var options = Model.Options.Where(option => option.Group == group.Key).ToList();
                        if (options.Count == 0) { continue; }
                        <optgroup label="@group.Label">
                            @foreach (var option in options)
                            {
                                <option value="@option.Key" data-help="@option.Help" data-preview="@option.PreviewTemplate"
                                        data-member="@(option.ShowsMember ? "1" : "0")"
                                        data-split="@(option.IsSplittable ? "1" : "0")"
                                        data-settles="@(option.SettlesMemberDebt ? "1" : "0")">@option.Label</option>
                            }
                        </optgroup>
                    }
                </select>
                <div id="kindHelp" style="font-size:12px;color:var(--fg-3);margin-top:4px"></div>
            </div>

            <div class="field">
                <label asp-for="Amount"></label>
                <input asp-for="Amount" class="form-control" type="text" inputmode="numeric" data-thousands
                       autocomplete="off" id="Amount" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="TransactionDate"></label>
                <input asp-for="TransactionDate" class="form-control" type="datetime-local"
                       value="@Model.TransactionDate.ToString("yyyy-MM-ddTHH:mm")" />
            </div>

            <div class="field" id="memberField">
                <label asp-for="Member"></label>
                <input asp-for="Member" class="form-control" maxlength="256" autocomplete="off"
                       list="memberOptions" placeholder="Search members…" />
                <datalist id="memberOptions">
                    @foreach (var option in Model.Roster)
                    {
                        <option value="@option.CharacterName" data-owed="@option.Owed"></option>
                    }
                </datalist>
                <div id="memberOwed" style="font-size:12px;color:var(--fg-3);margin-top:4px"></div>
                <span asp-validation-for="Member" class="text-danger"></span>
            </div>

            @* A fix rebuilds the entry from this form, so a split has to be re-stated in full — the
               original's members come back pre-picked. *@
            <partial name="_TreasuryRecipients" model="Model" />

            <div class="field" style="grid-column:1/-1">
                <label asp-for="Memo"></label>
                <textarea asp-for="Memo" class="form-control" rows="2" maxlength="1024"></textarea>
            </div>

            @* Required: an entry that says an earlier one was wrong has to say why. A database CHECK
               enforces the same thing, so this cannot be bypassed by posting round the form. *@
            <div class="field" style="grid-column:1/-1">
                <label asp-for="Reason"></label>
                <input asp-for="Reason" class="form-control" maxlength="512"
                       placeholder="Typed an extra zero" />
                <span asp-validation-for="Reason" class="text-danger"></span>
            </div>
        </div>

        <div id="preview" style="margin-top:16px;padding:10px 12px;border:1px solid var(--border);
                                border-radius:6px;font-size:13px;color:var(--fg-2)"></div>

        <div style="display:flex;gap:8px;margin-top:20px;padding-top:16px;border-top:1px solid var(--border)">
            <button type="submit" class="btn primary">@TreasuryLabels.FixAction</button>
            <a class="btn ghost" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @* Shared with Record.cshtml, which renders the same fields. *@
    <script src="~/js/treasury-record.js" asp-append-version="true" defer></script>
}

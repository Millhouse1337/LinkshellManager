@model LinkshellManagerDiscordApp.ViewModels.RuleViewModel
@{
    ViewData["Title"] = "Create rule";
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Create rule</h1>
        <div class="page-sub"><span>Publish a rule for your linkshell</span></div>
    </div>
</div>

<div class="card fade d2" style="padding:20px">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="LinkshellId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-grid">
            <div class="field" style="grid-column:1/-1">
                <label asp-for="RuleTitle"></label>
                <input asp-for="RuleTitle" class="form-control" maxlength="256" />
                <span asp-validation-for="RuleTitle" class="text-danger"></span>
            </div>

            <div class="field" style="grid-column:1/-1">
                <label asp-for="RuleDetails"></label>
                <textarea asp-for="RuleDetails" class="form-control" rows="5" maxlength="4000"></textarea>
                <span asp-validation-for="RuleDetails" class="text-danger"></span>
            </div>
        </div>

        <div style="display:flex;gap:8px;margin-top:20px;padding-top:16px;border-top:1px solid var(--border)">
            <button type="submit" class="btn primary">Save rule</button>
        </div>
    </form>
</div>

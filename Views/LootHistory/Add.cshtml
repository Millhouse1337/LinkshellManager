@model LinkshellManagerDiscordApp.ViewModels.LootAddViewModel
@{
    ViewData["Title"] = "Add Loot";
    var lootStructure = (Model.LinkshellLootStructure ?? "Dkp").ToLowerInvariant();
    var isHybrid = lootStructure == "hybrid";
    var isLootCouncil = lootStructure == "lootcouncil";
    var dkpLabel = isHybrid ? "Deduction %" : "DKP spent";
    var dkpHint = isHybrid
        ? "Hybrid linkshell — value is the percent of the winner's current balance to deduct (0–100)."
        : isLootCouncil
            ? "Loot Council linkshell — recorded for history only; no DKP is deducted."
            : "Flat DKP deducted from the winner's balance and posted to the ManualPoints sheet.";
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Add loot</h1>
        <div class="page-sub">
            <span>Manual loot entry</span>
            @if (!string.IsNullOrWhiteSpace(Model.LinkshellName))
            {
                <span class="dot"> &middot; </span>
                <span>@Model.LinkshellName</span>
            }
        </div>
    </div>
    <div class="page-actions">
        <a class="btn ghost" asp-action="Index">Back to history</a>
    </div>
</div>

<div class="card fade d2" style="padding:24px;max-width:760px;margin:0 auto">
    <form asp-action="Add" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="LinkshellId" />
        <input type="hidden" asp-for="LinkshellLootStructure" />

        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:12px"></div>

        <div class="form-grid">
            <div class="field">
                <label asp-for="Context">Event</label>
                @if (string.Equals(Model.LinkshellType, LinkshellManagerDiscordApp.Models.LinkshellTypes.SkySeaDynamis, StringComparison.OrdinalIgnoreCase))
                {
                    @* Sky/Sea/Dynamis linkshell: curated event dropdown. Picking
                       "Other" reveals a free-text box (CustomContext) that the
                       controller folds into Context on save. *@
                    var eventOptions = new[] { "Sky", "Sea", "Dynamis", "Limbus", "HENM", "KSNM", "BCNM", "Other" };
                    var isKnownEvent = eventOptions.Any(o => string.Equals(o, Model.Context, StringComparison.OrdinalIgnoreCase));
                    var pickValue = string.IsNullOrEmpty(Model.Context) ? string.Empty : (isKnownEvent ? Model.Context! : "Other");
                    var customValue = (!isKnownEvent && !string.IsNullOrEmpty(Model.Context)) ? Model.Context : Model.CustomContext;
                    <select name="Context" id="Context" class="form-select">
                        <option value="">Select event…</option>
                        @foreach (var opt in eventOptions)
                        {
                            <option value="@opt" selected="@(string.Equals(opt, pickValue, StringComparison.OrdinalIgnoreCase))">@opt</option>
                        }
                    </select>
                    <input name="CustomContext" id="loot-event-custom" class="form-control" maxlength="256"
                           value="@customValue" autocomplete="off" placeholder="Name the source (e.g. Limbus)"
                           style="margin-top:6px;@(pickValue == "Other" ? string.Empty : "display:none")" />
                    <span asp-validation-for="Context" class="text-danger"></span>
                    <span class="muted" style="font-size:11px">Pick the event, or choose "Other" to name a custom source.</span>
                }
                else
                {
                    @* HNM / Both: free-text filter over the known monster list. *@
                    <input asp-for="Context" class="form-control"
                           list="loot-source-options" autocomplete="off" maxlength="256"
                           placeholder="Type to filter known monsters, or enter your own…" />
                    <datalist id="loot-source-options">
                        @foreach (var monster in TodManagerViewModel.SupportedMonsters)
                        {
                            <option value="@monster"></option>
                        }
                    </datalist>
                    <span asp-validation-for="Context" class="text-danger"></span>
                    <span class="muted" style="font-size:11px">Start typing to filter, or enter a custom source (e.g. "Sky"). Shown as the loot's Context in history.</span>
                }
            </div>

            <div class="field">
                <label asp-for="ItemName">Item name</label>
                <input asp-for="ItemName" class="form-control" maxlength="256" />
                <span asp-validation-for="ItemName" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="ItemWinner">Winner</label>
                @if (Model.RosterCharacterNames.Any())
                {
                    <input asp-for="ItemWinner" class="form-control" maxlength="256"
                           list="loot-winner-options" autocomplete="off"
                           placeholder="Type to filter, then pick a name…" />
                    <datalist id="loot-winner-options">
                        @foreach (var name in Model.RosterCharacterNames)
                        {
                            <option value="@name"></option>
                        }
                    </datalist>
                    <span class="muted" style="font-size:11px">Start typing to filter the roster.</span>
                }
                else
                {
                    <input asp-for="ItemWinner" class="form-control" maxlength="256" />
                }
                <span asp-validation-for="ItemWinner" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="WinningDkpSpent">@dkpLabel</label>
                <div style="display:flex;gap:8px;align-items:center">
                    <input asp-for="WinningDkpSpent" class="form-control" type="number" min="0" style="flex:1;min-width:0" />
                    <label style="display:flex;gap:6px;align-items:center;font-size:12px;color:var(--text-muted);white-space:nowrap;margin:0">
                        <input type="checkbox" id="loot-no-dkp" @(Model.WinningDkpSpent == 0 ? "checked" : null) />
                        No DKP
                    </label>
                </div>
                <span asp-validation-for="WinningDkpSpent" class="text-danger"></span>
                <span class="muted" style="font-size:11px">@dkpHint</span>
            </div>

            @* Manual/ToD loot has a monster, not an event type, so its pool can't be derived. Defaults
               to whichever pool HNM maps to. Hidden entirely on a single-pool linkshell. *@
            @if (Model.HasMultiplePools && !isLootCouncil)
            {
                <div class="field">
                    <label asp-for="DkpPoolId">DKP pool</label>
                    <select asp-for="DkpPoolId" class="form-control">
                        @foreach (var pool in Model.DkpPools)
                        {
                            <option value="@pool.Id" selected="@(Model.DkpPoolId == pool.Id)">@pool.Name</option>
                        }
                    </select>
                    <span class="muted" style="font-size:11px">Which pool this DKP comes out of. Refunds go back to the same one.</span>
                </div>
            }
        </div>

        <div style="margin-top:16px;display:flex;gap:8px">
            <button type="submit" class="btn primary">Add loot</button>
            <a class="btn ghost" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

<script nonce="@Html.CspNonce()">
    (function () {
        // Sky/Sea/Dynamis dropdown: reveal the custom-name box only on "Other".
        var sel = document.getElementById('Context');
        var custom = document.getElementById('loot-event-custom');
        if (sel && custom && sel.tagName === 'SELECT') {
            var syncOther = function () { custom.style.display = (sel.value === 'Other') ? '' : 'none'; };
            sel.addEventListener('change', syncOther);
            syncOther();
        }

        // "No DKP": zero + lock the DKP spent field so the loot records 0 cost.
        var noDkp = document.getElementById('loot-no-dkp');
        var dkp = document.getElementById('WinningDkpSpent');
        if (noDkp && dkp) {
            var applyNoDkp = function () {
                if (noDkp.checked) {
                    dkp.value = '0';
                    dkp.readOnly = true;
                    dkp.style.opacity = '0.55';
                } else {
                    dkp.readOnly = false;
                    dkp.style.opacity = '';
                    if (dkp.value === '0') dkp.value = '';
                }
            };
            noDkp.addEventListener('change', applyNoDkp);
            applyNoDkp();
        }
    })();
</script>

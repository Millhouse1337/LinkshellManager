<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-LinkshellManagerDiscordApp-097d4206-0f91-471a-b0bb-fb7302e26d5f</UserSecretsId>
    <!-- Keep the old committed EF-tools build output and any local publish
         artifacts out of every default item glob so `dotnet publish` never
         ships stale binaries. (bin-ef/ is also gitignored.) -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin-ef\**;artifacts\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- The ToD duration parser and the monster-timing seed live on internal statics (they are
         helpers on a controller / provisioner, not public API), and both are exactly the kind of
         pure logic that wants direct test coverage rather than a round trip through an endpoint. -->
    <InternalsVisibleTo Include="LinkshellManager.Tests" />
    <!-- The Postgres tests run the real races through the same internal retry helpers Post uses. -->
    <InternalsVisibleTo Include="LinkshellManager.PostgresTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="NodaTime" Version="3.3.7" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tools\\**\\*.cs" />
    <Content Remove="tools\\**" />
    <Compile Remove="DbWipe\\**\\*.cs" />
    <Content Remove="DbWipe\\**" />
    <Compile Remove="tests\\**\\*.cs" />
    <Content Remove="tests\\**" />
    <!-- Dev-machine ToD screenshots (the Uploads:Root fallback) must never ship in a deploy. -->
    <Content Remove="wwwroot\\uploads\\**" />
  </ItemGroup>

</Project>

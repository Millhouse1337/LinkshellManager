<template id="routeRowTemplate">
    @{ await RouteRow(0, new LinkshellManagerDiscordApp.ViewModels.ChannelRouteInput(), true); }
</template>

<script nonce="@Html.CspNonce()">
    (function () {
        var rows = document.getElementById('routeRows');
        var addBtn = document.getElementById('routeAdd');
        var tpl = document.getElementById('routeRowTemplate');
        if (!rows || !addBtn || !tpl) { return; }

        // Renumber every bound field so the model binder sees a contiguous
        // channelRoutes[0..n] collection after add/remove.
        function reindex() {
            var list = rows.querySelectorAll('.route-row');
            for (var i = 0; i < list.length; i++) {
                list[i].querySelectorAll('[data-field]').forEach(function (el) {
                    el.setAttribute('name', 'channelRoutes[' + i + '].' + el.getAttribute('data-field'));
                });
            }
        }

        // Show/hide a row's event-type picker with its "Event posts" checkbox.
        function bindEventsToggle(row) {
            var toggle = row.querySelector('[data-events-toggle]');
            var picker = row.querySelector('.route-event-types');
            if (!toggle || !picker) { return; }
            var sync = function () { picker.style.display = toggle.checked ? 'flex' : 'none'; };
            toggle.addEventListener('change', sync);
            sync();
        }

        rows.querySelectorAll('.route-row').forEach(bindEventsToggle);

        addBtn.addEventListener('click', function () {
            var clone = tpl.content.firstElementChild.cloneNode(true);
            rows.appendChild(clone);
            reindex();
            bindEventsToggle(clone);
        });

        rows.addEventListener('click', function (evt) {
            var btn = evt.target.closest('.route-remove');
            if (!btn) { return; }
            btn.closest('.route-row').remove();
            reindex();
        });
    })();
</script>


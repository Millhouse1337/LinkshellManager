@page
@model LinkshellManagerDiscordApp.Areas.Identity.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

<div class="auth-card">
    <div class="auth-brand">
        <span class="brand-mark">LS</span>
        <span class="brand-name">LinkshellManager</span>
    </div>

    <h1 class="auth-title">Access denied</h1>
    <p class="auth-sub">
        Your account doesn't have permission to open that page. If you think it should, ask a linkshell leader.
    </p>

    <div class="auth-actions">
        <a class="btn primary" href="/">Back to LinkshellManager</a>
    </div>
</div>

@model IEnumerable<LinkshellManagerDiscordApp.ViewModels.AnnouncementViewModel>
@{
    ViewData["Title"] = "Announcements";
    ViewData["BodyClass"] = "lsm-page";
    var canManage = (bool)(ViewBag.CanManage ?? false);
    var linkshellName = ViewBag.LinkshellName as string;
    var announcements = Model.ToList();
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Announcements</h1>
        <div class="page-sub">
            @if (!string.IsNullOrWhiteSpace(linkshellName))
            {
                <span>@linkshellName</span>
                <span class="dot"> · </span>
            }
            <span><span class="num">@announcements.Count</span> announcement@(announcements.Count == 1 ? "" : "s")</span>
        </div>
    </div>
    @if (canManage)
    {
        <div class="page-actions">
            <a class="btn primary" asp-action="Create">+ Create announcement</a>
        </div>
    }
</div>

@* Announcements are written in Discord and pasted in, so they are shown the way Discord
   shows them: a channel of messages with the details rendered as Discord markdown. *@
<div class="dc-channel fade d2">
    <div class="dc-channel-head">
        <span class="dc-channel-hash" aria-hidden="true">#</span>
        <span class="dc-channel-name">announcements</span>
        <div class="dc-channel-rule" aria-hidden="true"></div>
        <div class="dc-channel-topic">
            @if (!string.IsNullOrWhiteSpace(linkshellName))
            {
                <span>@linkshellName</span>
                <span> — </span>
            }
            <span>news and updates for the linkshell</span>
        </div>
    </div>

    @if (announcements.Count == 0)
    {
        <div class="dc-empty">
            <strong>No announcements yet</strong>
            @if (canManage)
            {
                <span>Post an announcement to share news with your linkshell.</span>
            }
            else
            {
                <span>No announcements have been posted for your linkshell.</span>
            }
        </div>
    }
    else
    {
        <div class="dc-messages">
            @for (var i = 0; i < announcements.Count; i++)
            {
                var announcement = announcements[i];
                var post = new DiscordPostViewModel
                {
                    Id = announcement.Id,
                    Title = announcement.AnnouncementTitle,
                    Details = announcement.AnnouncementDetails,
                    Category = announcement.Category,
                    Author = announcement.CreatedByCharacterName,
                    CreatedAt = announcement.CreatedAt,
                    CanManage = announcement.CanManage,
                    Index = i,
                    DeleteConfirm = "Delete this announcement?"
                };
                <partial name="_DiscordPost" model="post" />
            }
        </div>
    }
</div>

@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";

    string RosterAvClass(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "a";
        var h = 0;
        foreach (var ch in name) { h = (h * 31 + ch) & 0x7fffffff; }
        return new[] { "a", "b", "c", "d", "e" }[h % 5];
    }

    string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var ini = string.Concat(parts.Select(p => p[0])).ToUpperInvariant();
        return ini.Length > 2 ? ini[..2] : ini;
    }

    string RelativeEventTime(DateTime? when)
    {
        if (!when.HasValue) return "TBD";
        var delta = when.Value - DateTime.UtcNow;
        var abs = delta.Duration();
        var prefix = delta.TotalSeconds < 0 ? "" : "in ";
        var suffix = delta.TotalSeconds < 0 ? " ago" : "";
        if (abs.TotalMinutes < 60) return $"{prefix}{(int)abs.TotalMinutes}m{suffix}";
        if (abs.TotalHours < 24) return $"{prefix}{(int)abs.TotalHours}h{suffix}";
        if (abs.TotalDays < 14) return $"{prefix}{(int)abs.TotalDays}d{suffix}";
        return when.Value.ToString("MMM d");
    }
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <div class="page-sub">
            @if (!string.IsNullOrWhiteSpace(Model.SelectedLinkshellName))
            {
                <span>@Model.SelectedLinkshellName</span>
                <span>·</span>
            }
            <span><span class="num">@Model.TotalMembers</span> members</span>
            <span class="live-dot">Live</span>
        </div>
    </div>

</div>

@if (Model.Linkshells.Count == 0)
{
    <div class="card fade d2">
        <div class="empty">
            <div style="font-size:15px;color:var(--fg);font-weight:500;margin-bottom:6px">No linkshells yet</div>
            <div style="margin-bottom:12px">Create your first linkshell to start managing memberships and events.</div>
            <a class="btn primary" asp-controller="Linkshell" asp-action="Create">Create linkshell</a>
        </div>
    </div>
}
else
{
    <div class="stat-strip fade d2">
        <div class="stat-cell">
            <div class="stat-cell-label">Linkshell</div>
            <div class="stat-cell-value stat-cell-value--text">@(Model.SelectedLinkshellName ?? "—")</div>
        </div>
        @if (Model.EnableItems)
        {
            <div class="stat-cell">
                <div class="stat-cell-label">Items</div>
                <div class="stat-cell-value">@Model.ItemCount</div>
            </div>
        }
        @if (Model.EnableRevenue)
        {
            <div class="stat-cell">
                <div class="stat-cell-label">Revenue</div>
                <div class="stat-cell-value">@Model.RevenueTotal.ToString("N0")</div>
            </div>
        }
        <div class="stat-cell">
            <div class="stat-cell-label">Upcoming Events</div>
            <div class="stat-cell-value">@Model.UpcomingEvents</div>
        </div>
        <div class="stat-cell">
            <div class="stat-cell-label">Upcoming Auctions</div>
            <div class="stat-cell-value">@Model.UpcomingAuctionsCount</div>
        </div>
        <div class="stat-cell">
            <div class="stat-cell-label">Upcoming ToDs</div>
            <div class="stat-cell-value">@Model.UpcomingTodsCount</div>
        </div>
    </div>

    <div class="card fade d2" style="margin-top:16px;margin-bottom:16px">
        <div class="card-head">
            <div class="card-title">Rules</div>
            <a class="card-link" asp-controller="Rule" asp-action="Index">View all</a>
        </div>
        <div class="empty">No rules defined yet.</div>
    </div>

    <div class="card fade d2" style="margin-top:16px;margin-bottom:16px">
        <div class="card-head">
            <div class="card-title">Recent Announcements</div>
            <a class="card-link" asp-controller="Announcement" asp-action="Index">View all</a>
        </div>
        @if (Model.RecentAnnouncements.Count == 0)
        {
            <div class="empty">No recent announcements found.</div>
        }
        else
        {
            <div class="act-list">
                @foreach (var ann in Model.RecentAnnouncements)
                {
                    <div class="act-row">
                        <div class="act-when">@ann.RelativeTime</div>
                        <div class="act-dot claim"></div>
                        <div class="act-text">
                            <strong>@ann.Title</strong>
                            @if (!string.IsNullOrWhiteSpace(ann.Details))
                            {
                                <span> · @ann.Details</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(ann.Author))
                            {
                                <span class="roster-name-sub"> — @ann.Author</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="grid">
        <div class="col">
            <div class="card fade d3">
                <div class="card-head">
                    <div class="card-title">Upcoming Events</div>
                    <a class="card-link" asp-controller="Event" asp-action="Create">+ Create event</a>
                </div>
                @if (Model.Events.Count == 0)
                {
                    <div class="empty">No active events for this linkshell.</div>
                }
                else
                {
                    <div class="list">
                        @foreach (var evt in Model.Events)
                        {
                            var href = evt.CommencementStartTime.HasValue
                                ? Url.Action("Start", "Event", new { eventId = evt.Id })
                                : Url.Action("Edit", "Event", new { id = evt.Id });
                            var isLive = evt.CommencementStartTime.HasValue;
                            <a class="row plain" href="@href">
                                <div class="row-main">
                                    <div class="row-title">
                                        @(evt.EventName ?? "Untitled event")
                                        @if (!string.IsNullOrWhiteSpace(evt.EventType))
                                        {
                                            <span class="tag">@evt.EventType</span>
                                        }
                                        @if (isLive)
                                        {
                                            <span class="tag success">Live</span>
                                        }
                                    </div>
                                    <div class="row-meta">
                                        @if (!string.IsNullOrWhiteSpace(evt.EventLocation))
                                        {
                                            <span>@evt.EventLocation</span>
                                            <span class="dot">·</span>
                                        }
                                        <span>@(evt.StartTime?.ToString("ddd MMM d, HH:mm") ?? "Start TBD")</span>
                                    </div>
                                </div>
                                <div class="row-time @(isLive ? "warn" : "")">
                                    <span class="num">@(evt.StartTime?.ToString("HH:mm") ?? "—")</span>
                                    <div class="row-time-sub">@RelativeEventTime(evt.StartTime)</div>
                                </div>
                                <div class="row-cta">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M9 6l6 6-6 6"/></svg>
                                </div>
                            </a>
                        }
                    </div>
                }
            </div>

            <div class="card fade d4">
                <div class="card-head">
                    <div class="card-title">Recent activity</div>
                    <a class="card-link" asp-controller="EventHistory" asp-action="Index">Full log</a>
                </div>
                @if (Model.RecentActivity.Count == 0)
                {
                    <div class="empty">No activity yet.</div>
                }
                else
                {
                    <div class="act-list">
                        @foreach (var item in Model.RecentActivity)
                        {
                            <div class="act-row">
                                <div class="act-when">@item.RelativeTime</div>
                                <div class="act-dot @item.DotClass"></div>
                                <div class="act-text">
                                    <strong>@item.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                                    {
                                        <span> · @item.Subtitle</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="card fade d5">
                <div class="card-head">
                    <div class="card-title">Linkshell roster</div>
                    <a class="card-link" asp-controller="ManageTeam" asp-action="Index">Manage team</a>
                </div>
                @if (Model.Members.Count == 0)
                {
                    <div class="empty">No members found for this linkshell yet.</div>
                }
                else
                {
                    <div style="display:flex;align-items:center;gap:8px;padding:8px 16px;border-bottom:1px solid var(--border)">
                        <input id="dashRosterSearch" type="text" class="input"
                               placeholder="Filter roster (character, rank, status…)…"
                               style="flex:1;min-width:180px" maxlength="64" autocomplete="off" />
                        <span id="dashRosterCount" style="font-size:12px;color:var(--fg-3);white-space:nowrap"></span>
                    </div>

                    <div id="dashRosterList">
                        <div class="roster-head">
                            <div></div>
                            <div>Character</div>
                            <div>Rank</div>
                            <div style="text-align:right">DKP</div>
                            <div>Status</div>
                        </div>
                        @* Render the FULL roster (no Server-side Take). The client-side
                           JS below paginates at 5 per page and applies the live search
                           filter, matching the Linkshell Details page's pattern. *@
                        @foreach (var m in Model.Members)
                        {
                            var name = m.CharacterName ?? m.AppUser?.UserName ?? "Unknown";
                            var rank = m.Rank ?? "Member";
                            var status = m.Status ?? "Active";
                            var statusClass = status.Equals("Active", StringComparison.OrdinalIgnoreCase)
                                ? "success"
                                : status.Equals("Pending", StringComparison.OrdinalIgnoreCase)
                                    ? "warning"
                                    : "";
                            // Pre-baked lowercased haystack the JS filter matches
                            // against. Keeps filtering O(1) per row at search time.
                            var searchKey = (name + " " + rank + " " + status).ToLowerInvariant();
                            <div class="roster-row" data-search="@searchKey">
                                <div class="roster-av @RosterAvClass(name)">@Initials(name)</div>
                                <div>
                                    <div class="roster-name">@name</div>
                                </div>
                                <div class="roster-rank">@rank</div>
                                <div class="roster-dkp">@((m.LinkshellDkp ?? 0).ToString("0.##"))</div>
                                <div><span class="tag @statusClass">@status</span></div>
                            </div>
                        }
                    </div>

                    <div style="display:flex;align-items:center;gap:8px;padding:10px 16px;border-top:1px solid var(--border)">
                        <button type="button" class="btn sm" id="dashRosterPrev" disabled>← Prev</button>
                        <span id="dashRosterPageLabel" style="font-size:12px;color:var(--fg-3);min-width:90px;text-align:center">Page 1 / 1</span>
                        <button type="button" class="btn sm" id="dashRosterNext" disabled>Next →</button>
                    </div>

                    <script nonce="@Html.CspNonce()">
                        (function () {
                            var PAGE_SIZE = 5;
                            var list      = document.getElementById('dashRosterList');
                            var search    = document.getElementById('dashRosterSearch');
                            var prevBtn   = document.getElementById('dashRosterPrev');
                            var nextBtn   = document.getElementById('dashRosterNext');
                            var pageLabel = document.getElementById('dashRosterPageLabel');
                            var countEl   = document.getElementById('dashRosterCount');
                            if (!list) { return; }

                            var rows = Array.prototype.slice.call(list.querySelectorAll('.roster-row'));
                            var state = { page: 1, filtered: rows };

                            function render() {
                                var totalPages = Math.max(1, Math.ceil(state.filtered.length / PAGE_SIZE));
                                if (state.page > totalPages) { state.page = totalPages; }
                                var start = (state.page - 1) * PAGE_SIZE;
                                var end   = start + PAGE_SIZE;
                                for (var i = 0; i < rows.length; i++) { rows[i].style.display = 'none'; }
                                var slice = state.filtered.slice(start, end);
                                for (var j = 0; j < slice.length; j++) { slice[j].style.display = ''; }
                                if (pageLabel) { pageLabel.textContent = 'Page ' + state.page + ' / ' + totalPages; }
                                if (countEl) {
                                    countEl.textContent = (state.filtered.length === rows.length)
                                        ? (rows.length + ' members')
                                        : (state.filtered.length + ' of ' + rows.length + ' members');
                                }
                                if (prevBtn) { prevBtn.disabled = (state.page <= 1); }
                                if (nextBtn) { nextBtn.disabled = (state.page >= totalPages); }
                            }

                            function applyFilter() {
                                var q = (search ? search.value : '').trim().toLowerCase();
                                if (q === '') {
                                    state.filtered = rows;
                                } else {
                                    state.filtered = rows.filter(function (r) {
                                        return (r.getAttribute('data-search') || '').indexOf(q) >= 0;
                                    });
                                }
                                state.page = 1;
                                render();
                            }

                            if (search) { search.addEventListener('input', applyFilter); }
                            if (prevBtn) {
                                prevBtn.addEventListener('click', function () {
                                    if (state.page > 1) { state.page--; render(); }
                                });
                            }
                            if (nextBtn) {
                                nextBtn.addEventListener('click', function () {
                                    var total = Math.max(1, Math.ceil(state.filtered.length / PAGE_SIZE));
                                    if (state.page < total) { state.page++; render(); }
                                });
                            }

                            applyFilter();
                        })();
                    </script>
                }
            </div>
        </div>

        <div class="col">
            <div class="card fade d3">
                <div class="card-head">
                    <div class="card-title">ToD Tracker</div>
                    <a class="card-link" asp-controller="ToD" asp-action="Index">All HNMs</a>
                </div>
                @if (Model.TodTracker.Count == 0)
                {
                    <div class="empty">No tracked windows yet. Log a ToD to start tracking.</div>
                }
                else
                {
                    <div class="tod-tracker-list">
                        @foreach (var entry in Model.TodTracker)
                        {
                            <div class="tod-tracker-row">
                                <div class="tod-tracker-av @entry.StatusTagClass"></div>
                                <div class="tod-tracker-main">
                                    <div class="tod-tracker-head">
                                        <span class="tod-tracker-name">@entry.MonsterName</span>
                                        <span class="tag @entry.StatusTagClass">@entry.StatusLabel</span>
                                    </div>
                                    <div class="tod-tracker-bar">
                                        <div class="tod-tracker-bar-fill @entry.StatusTagClass" style="width:@(entry.ProgressPercent.ToString("0.##"))%"></div>
                                    </div>
                                </div>
                                <div class="tod-tracker-time">
                                    <div class="num">@entry.TimeLabel</div>
                                    <div class="tod-tracker-sub">@entry.TimeSubLabel</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="card fade d4">
                <div class="card-head">
                    <div class="card-title">HNM Claims (last @Model.HnmClaimsWindowDays days)</div>
                </div>
                @if (Model.HnmClaims.Count == 0)
                {
                    <div class="empty">No claims in the last @Model.HnmClaimsWindowDays days.</div>
                }
                else
                {
                    <div class="donut-wrap">
                        <svg class="donut" viewBox="0 0 42 42">
                            <circle class="donut-track" cx="21" cy="21" r="15.9155" fill="none" stroke-width="4"></circle>
                            @{
                                double offset = 25;
                            }
                            @foreach (var claim in Model.HnmClaims)
                            {
                                var dash = claim.Percent;
                                var gap = 100 - dash;
                                <circle class="donut-seg donut-seg-@claim.ColorClass" cx="21" cy="21" r="15.9155" fill="none" stroke-width="4"
                                        stroke-dasharray="@(dash.ToString("0.##")) @(gap.ToString("0.##"))"
                                        stroke-dashoffset="@(offset.ToString("0.##"))"></circle>
                                offset = (offset - dash + 100) % 100;
                            }
                            <text x="21" y="20" text-anchor="middle" class="donut-value">@Model.HnmClaimsTotal</text>
                            <text x="21" y="25" text-anchor="middle" class="donut-label">CLAIMS</text>
                        </svg>
                        <div class="donut-legend">
                            @foreach (var claim in Model.HnmClaims)
                            {
                                <div class="donut-legend-row">
                                    <span class="donut-swatch donut-seg-@claim.ColorClass"></span>
                                    <span class="donut-legend-name">@claim.MonsterName</span>
                                    <span class="donut-legend-stats"><span class="num">@claim.Count</span> · @(claim.Percent.ToString("0.#"))%</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="card fade d5">
                <div class="card-head">
                    <div class="card-title">News &amp; updates</div>
                    <a class="card-link" asp-controller="DkpHistory" asp-action="Index">Full log</a>
                </div>
                @if (Model.NewsUpdates.Count == 0)
                {
                    <div class="empty">No loot recorded yet.</div>
                }
                else
                {
                    <div class="news-list">
                        @foreach (var news in Model.NewsUpdates)
                        {
                            <div class="news-row">
                                <div class="news-icon donut-seg-@news.ColorClass"></div>
                                <div class="news-main">
                                    <div class="news-title">@news.Title</div>
                                    @if (!string.IsNullOrWhiteSpace(news.Subtitle))
                                    {
                                        <div class="news-sub">@news.Subtitle</div>
                                    }
                                </div>
                                <div class="news-meta">
                                    @if (news.Dkp.HasValue)
                                    {
                                        <div><span class="num">@news.Dkp.Value.ToString("N0")</span> dkp</div>
                                    }
                                    <div class="news-time">@news.RelativeTime</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@section Scripts {
    <script nonce="@Html.CspNonce()">
        // Entry "which linkshell" modal + a promise-based confirm gate reused by
        // every save action on this page (window.lsmConfirmChange). Defined first
        // so the permissions/addon scripts below can call it.
        (function () {
            var CUR_ID = @Model.LinkshellId;

            function openModal(id) { var el = document.getElementById(id); if (el) el.classList.add('mt-modal--open'); }
            function closeModal(id) { var el = document.getElementById(id); if (el) el.classList.remove('mt-modal--open'); }

            var pendingResolve = null;
            window.lsmConfirmChange = function () {
                return new Promise(function (resolve) {
                    pendingResolve = resolve;
                    openModal('customizeConfirmModal');
                });
            };
            function settle(result) {
                closeModal('customizeConfirmModal');
                var r = pendingResolve; pendingResolve = null;
                if (r) r(result);
            }
            var yes = document.getElementById('customizeConfirmYes');
            var no = document.getElementById('customizeConfirmNo');
            if (yes) yes.addEventListener('click', function () { settle(true); });
            if (no) no.addEventListener('click', function () { settle(false); });

            // Suppress the entry modal on self-caused reloads (save / switch);
            // only a fresh arrival should be greeted.
            var SKIP_ENTRY = @(skipEntryModal ? "true" : "false");
            // Drop the one-shot ?switched flag so a later manual reload behaves
            // normally (and the URL stays clean).
            if (window.history && window.history.replaceState) {
                try {
                    var cleanUrl = new URL(window.location.href);
                    if (cleanUrl.searchParams.has('switched')) {
                        cleanUrl.searchParams.delete('switched');
                        window.history.replaceState({}, '', cleanUrl.toString());
                    }
                } catch (e) { /* no-op */ }
            }

            // Entry modal — establishes/confirms the target linkshell on open.
            var entrySelect = document.getElementById('customizeTargetSelect');
            var entryContinue = document.getElementById('customizeTargetContinue');
            if (entrySelect && entryContinue) {
                if (!SKIP_ENTRY) { openModal('customizeTargetModal'); }
                entryContinue.addEventListener('click', function () {
                    var chosen = parseInt(entrySelect.value, 10);
                    if (chosen && chosen !== CUR_ID) {
                        window.location.href = '?id=' + chosen + '&switched=1';
                    } else {
                        closeModal('customizeTargetModal');
                    }
                });
            }

            // Gate the main customize form (loot structure, linkshell type,
            // feature toggles, hide ToD mobs, Discord webhooks) behind confirm.
            var form = document.getElementById('customizeForm');
            if (form) {
                var confirmed = false;
                form.addEventListener('submit', function (e) {
                    if (confirmed) return;
                    e.preventDefault();
                    window.lsmConfirmChange().then(function (ok) {
                        if (ok) { confirmed = true; form.submit(); }
                    });
                });
            }

            // Gate the standalone server-lock / unlock forms (and any future
            // .lsm-confirm-form) through the same "Are you sure?" modal.
            document.querySelectorAll('form.lsm-confirm-form').forEach(function (cf) {
                var ok = false;
                cf.addEventListener('submit', function (e) {
                    if (ok) return;
                    e.preventDefault();
                    window.lsmConfirmChange().then(function (yes) {
                        if (yes) { ok = true; cf.submit(); }
                    });
                });
            });
        })();
    </script>

    <script nonce="@Html.CspNonce()">
        (function () {
            // Hide the DKP rounding row when the loot structure is Loot Council,
            // matching the Activity's behavior (rounding only applies to DKP-based modes).
            var dkpRow = document.getElementById('dkp-rounding-row');
            var radios = document.querySelectorAll('input[type=radio][name="LootStructure"]');
            function update() {
                var selected = document.querySelector('input[type=radio][name="LootStructure"]:checked');
                var value = selected ? selected.value : '';
                dkpRow.style.display = (value === 'Dkp' || value === 'Hybrid') ? '' : 'none';
            }
            radios.forEach(function (r) { r.addEventListener('change', update); });
            update();
        })();
    </script>

    <script nonce="@Html.CspNonce()">
        (function () {
            var card = document.getElementById('permissionsConfigCard');
            if (!card) return;

            var linkshellId = parseInt(card.dataset.linkshellid, 10);
            var canManageRoles = card.dataset.canManageRoles === 'true';
            var antiforgeryHeader = card.dataset.csrfHeader || '';
            var antiforgeryToken = card.dataset.csrfToken || '';
            var tableWrap = document.getElementById('permissionsTableWrap');
            var statusEl = document.getElementById('permissionsStatus');
            var errorEl = document.getElementById('permissionsError');
            var newRoleBtn = document.getElementById('permissionsNewRoleBtn');
            var form = document.getElementById('roleEditForm');
            var formTitle = document.getElementById('roleEditTitle');
            var nameInput = document.getElementById('roleEditName');
            var fieldsWrap = document.getElementById('rolePermissionFields');
            var saveBtn = document.getElementById('roleEditSaveBtn');
            var roles = [];
            var editingRoleId = null;

            var permissions = [
                { key: 'canManageRoles', label: 'Manage roles & permissions' },
                { key: 'canManageMembers', label: 'Manage members (invite, rank, status)' },
                { key: 'canManageEvents', label: 'Manage events (create, edit, start, end, cancel)' },
                { key: 'canModerateLiveEvent', label: 'Moderate live events (verify attendance, break room)' },
                { key: 'canAddLoot', label: 'Add event loot entries' },
                { key: 'canManageInventory', label: 'Manage inventory (items)' },
                { key: 'canManageTreasury', label: 'Manage treasury (revenue)' },
                { key: 'canManageRules', label: 'Manage rules' },
                { key: 'canManageAnnouncements', label: 'Manage announcements' },
                { key: 'canManageTods', label: 'Manage ToDs' },
                { key: 'canAuditDkp', label: 'Audit DKP' },
                { key: 'canManageAuctions', label: 'Manage auctions' },
                { key: 'canLockAuctions', label: 'Lock auctions (bid freeze)' },
                { key: 'canCustomizeLinkshell', label: 'Customize linkshell settings' }
            ];

            var escapeHtml = window.escapeHtml || function (value) {
                return String(value == null ? '' : value).replace(/[&<>"']/g, function (c) {
                    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
                });
            };

            function withCsrf(headers) {
                headers = headers || {};
                if (antiforgeryHeader && antiforgeryToken) {
                    headers[antiforgeryHeader] = antiforgeryToken;
                }
                return headers;
            }

            function setBusy(isBusy) {
                if (newRoleBtn) newRoleBtn.disabled = isBusy;
                if (saveBtn) saveBtn.disabled = isBusy;
                card.querySelectorAll('[data-role-action]').forEach(function (button) {
                    button.disabled = isBusy;
                });
                if (statusEl) statusEl.textContent = isBusy ? 'Saving...' : '';
            }

            function setError(message) {
                errorEl.textContent = message || '';
                errorEl.style.display = message ? 'block' : 'none';
            }

            function readError(response, fallback) {
                return response.text().then(function (text) {
                    if (!text) return fallback;
                    try {
                        var payload = JSON.parse(text);
                        return payload && payload.error ? payload.error : fallback;
                    } catch (e) {
                        return text;
                    }
                });
            }

            function renderTable() {
                if (!roles.length) {
                    tableWrap.innerHTML = '<div class="empty">No roles found.</div>';
                    return;
                }

                var head = '<tr><th>Permission</th>' + roles.map(function (role) {
                    var actions = '';
                    if (canManageRoles) {
                        actions =
                            '<div class="permissions-matrix__role-actions">' +
                            '<button type="button" class="btn ghost sm" data-role-action="edit" data-role-id="' + role.id + '">Edit</button>' +
                            (role.isSystem ? '' : '<button type="button" class="btn ghost sm" data-role-action="delete" data-role-id="' + role.id + '">Delete</button>') +
                            '</div>';
                    }
                    return '<th><div class="permissions-matrix__role">' +
                        '<strong>' + escapeHtml(role.name) + '</strong>' +
                        (role.isSystem ? '<span class="tag">System</span>' : '') +
                        actions +
                        '</div></th>';
                }).join('') + '</tr>';

                var body = permissions.map(function (permission) {
                    return '<tr><td>' + escapeHtml(permission.label) + '</td>' +
                        roles.map(function (role) {
                            return '<td class="permissions-matrix__cell">' +
                                (role[permission.key] ? '<span class="perm-yes">✓</span>' : '<span class="perm-no">-</span>') +
                                '</td>';
                        }).join('') +
                        '</tr>';
                }).join('');

                tableWrap.innerHTML =
                    '<table class="table themed permissions-matrix">' +
                    '<thead>' + head + '</thead>' +
                    '<tbody>' + body + '</tbody>' +
                    '</table>';
            }

            function renderPermissionFields() {
                if (!fieldsWrap) return;
                fieldsWrap.innerHTML = permissions.map(function (permission) {
                    return '<label class="role-edit-form__perm">' +
                        '<input type="checkbox" data-role-permission="' + permission.key + '" />' +
                        '<span>' + escapeHtml(permission.label) + '</span>' +
                        '</label>';
                }).join('');
            }

            function openForm(role) {
                if (!form) return;
                editingRoleId = role ? role.id : null;
                formTitle.textContent = role ? 'Edit role' : 'New role';
                nameInput.value = role ? role.name : '';
                nameInput.disabled = !!(role && role.isSystem);
                fieldsWrap.querySelectorAll('[data-role-permission]').forEach(function (input) {
                    var key = input.dataset.rolePermission;
                    input.checked = role ? role[key] === true : false;
                });
                form.style.display = '';
                if (newRoleBtn) newRoleBtn.style.display = 'none';
                nameInput.focus();
            }

            function closeForm() {
                editingRoleId = null;
                if (form) form.style.display = 'none';
                if (newRoleBtn) newRoleBtn.style.display = '';
            }

            function buildPayload() {
                var payload = { name: nameInput.value.trim() || null };
                fieldsWrap.querySelectorAll('[data-role-permission]').forEach(function (input) {
                    payload[input.dataset.rolePermission] = input.checked;
                });
                return payload;
            }

            function loadRoles() {
                setError('');
                if (statusEl) statusEl.textContent = 'Loading roles...';
                return fetch('/api/activity/linkshells/' + linkshellId + '/roles', {
                    cache: 'no-store',
                    credentials: 'same-origin'
                }).then(function (response) {
                    if (!response.ok) {
                        return readError(response, 'Loading roles failed.').then(function (message) {
                            throw new Error(message);
                        });
                    }
                    return response.json();
                }).then(function (data) {
                    roles = data.roles || [];
                    renderTable();
                    if (statusEl) statusEl.textContent = '';
                }).catch(function (error) {
                    setError(error.message || 'Loading roles failed.');
                    tableWrap.innerHTML = '<div class="empty">Roles could not be loaded.</div>';
                    if (statusEl) statusEl.textContent = '';
                });
            }

            function saveRole() {
                var payload = buildPayload();
                if (!payload.name) {
                    setError('A role name is required.');
                    nameInput.focus();
                    return;
                }
                if (window.lsmConfirmChange && !saveRole._confirmed) {
                    window.lsmConfirmChange().then(function (ok) {
                        if (!ok) return;
                        saveRole._confirmed = true;
                        try { saveRole(); } finally { saveRole._confirmed = false; }
                    });
                    return;
                }

                var path = editingRoleId == null
                    ? '/api/activity/linkshells/' + linkshellId + '/roles'
                    : '/api/activity/linkshells/' + linkshellId + '/roles/' + editingRoleId + '/update';

                setBusy(true);
                setError('');
                fetch(path, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: withCsrf({ 'Content-Type': 'application/json' }),
                    body: JSON.stringify(payload)
                }).then(function (response) {
                    if (!response.ok) {
                        return readError(response, 'Saving the role failed.').then(function (message) {
                            throw new Error(message);
                        });
                    }
                    closeForm();
                    return loadRoles();
                }).catch(function (error) {
                    setError(error.message || 'Saving the role failed.');
                }).finally(function () {
                    setBusy(false);
                });
            }

            function deleteRole(role) {
                if (!role || role.isSystem) return;
                if (window.lsmConfirmChange && !deleteRole._confirmed) {
                    window.lsmConfirmChange().then(function (ok) {
                        if (!ok) return;
                        deleteRole._confirmed = true;
                        try { deleteRole(role); } finally { deleteRole._confirmed = false; }
                    });
                    return;
                }

                setBusy(true);
                setError('');
                fetch('/api/activity/linkshells/' + linkshellId + '/roles/' + role.id + '/delete', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: withCsrf()
                }).then(function (response) {
                    if (!response.ok) {
                        return readError(response, 'Deleting the role failed.').then(function (message) {
                            throw new Error(message);
                        });
                    }
                    closeForm();
                    return loadRoles();
                }).catch(function (error) {
                    setError(error.message || 'Deleting the role failed.');
                }).finally(function () {
                    setBusy(false);
                });
            }

            if (newRoleBtn) {
                newRoleBtn.addEventListener('click', function () { openForm(null); });
            }
            if (form) {
                renderPermissionFields();
                form.addEventListener('submit', function (event) {
                    event.preventDefault();
                    saveRole();
                });
                document.getElementById('roleEditCancelBtn').addEventListener('click', closeForm);
                document.getElementById('roleEditCancelBtnBottom').addEventListener('click', closeForm);
            }
            card.addEventListener('click', function (event) {
                var button = event.target.closest('[data-role-action]');
                if (!button) return;
                var roleId = parseInt(button.dataset.roleId, 10);
                var role = roles.find(function (item) { return item.id === roleId; });
                if (!role) return;
                if (button.dataset.roleAction === 'edit') openForm(role);
                if (button.dataset.roleAction === 'delete') deleteRole(role);
            });

            loadRoles();
        })();
    </script>

    <script nonce="@Html.CspNonce()">
        // Addon-pairing card UX. Self-contained so this view doesn't depend on
        // manage-team.js (which has been retired alongside the old card location).
        (function () {
            var addonCard = document.getElementById('addonTokenCard');
            if (!addonCard) return;

            // Read CSRF header/token from data-* attributes so the token never
            // gets interpolated as a JS string literal — the runtime parses it
            // as plain text from the DOM, which keeps it out of the script body
            // and is safe under the strict CSP nonce policy.
            var antiforgeryHeader = addonCard.dataset.csrfHeader || '';
            var antiforgeryToken = addonCard.dataset.csrfToken || '';
            function withCsrf(headers) {
                headers = headers || {};
                if (antiforgeryHeader && antiforgeryToken) {
                    headers[antiforgeryHeader] = antiforgeryToken;
                }
                return headers;
            }

            function openModal(id) {
                var el = document.getElementById(id);
                if (el) { el.classList.add('mt-modal--open'); document.body.style.overflow = 'hidden'; }
            }
            function closeModal(id) {
                var el = document.getElementById(id);
                if (el) { el.classList.remove('mt-modal--open'); document.body.style.overflow = ''; }
            }
            document.querySelectorAll('[data-mt-close]').forEach(function (el) {
                el.addEventListener('click', function () {
                    var modal = el.closest('.mt-modal');
                    if (modal) closeModal(modal.id);
                });
            });

            var addonLinkshellId = parseInt(addonCard.dataset.linkshellid, 10);
            var addonGenerateBtn = document.getElementById('addonGenerateBtn');
            var addonPairCreateBtn = document.getElementById('addonPairCreateBtn');
            var addonPairCodeWrapper = document.getElementById('addonPairCodeWrapper');
            var addonPairCode = document.getElementById('addonPairCode');
            var addonPairCountdown = document.getElementById('addonPairCountdown');
            var addonPairError = document.getElementById('addonPairError');
            var addonPairStatusTag = document.getElementById('addonPairStatusTag');
            var addonPairStatusText = document.getElementById('addonPairStatusText');
            var addonPairCmd1 = document.getElementById('addonPairCmd1');
            var addonPairLsName = document.getElementById('addonPairLsName');
            var addonTokensTable = document.getElementById('addonTokensTable');
            var addonTokensEmpty = document.getElementById('addonTokensEmpty');
            var countdownTimer = null;
            var pairStatusTimer = null;

            // Restores the modal to its pre-generate state: Generate button
            // visible, code/instructions hidden, both timers stopped. Called
            // on open (fresh start) and on close (so the next open is clean).
            function resetPairModalUi() {
                if (countdownTimer) { clearInterval(countdownTimer); countdownTimer = null; }
                if (pairStatusTimer) { clearInterval(pairStatusTimer); pairStatusTimer = null; }
                addonPairCodeWrapper.style.display = 'none';
                addonPairCode.textContent = '';
                addonPairCreateBtn.style.display = '';
                addonPairCreateBtn.disabled = false;
                if (addonPairStatusTag) {
                    addonPairStatusTag.className = 'tag warning';
                }
                if (addonPairStatusText) addonPairStatusText.textContent = 'Unpaired';
            }

            var escapeHtml = window.escapeHtml;

            function setAddonPairError(msg) {
                addonPairError.textContent = msg || '';
                addonPairError.style.display = msg ? 'block' : 'none';
            }

            function renderTokens(tokens) {
                var tbody = addonTokensTable.querySelector('tbody');
                tbody.innerHTML = '';
                if (!tokens || tokens.length === 0) {
                    addonTokensTable.style.display = 'none';
                    addonTokensEmpty.style.display = 'block';
                    return;
                }
                addonTokensEmpty.style.display = 'none';
                addonTokensTable.style.display = '';
                tokens.forEach(function (t) {
                    var tr = document.createElement('tr');
                    var lastUsed = t.lastUsedAt ? new Date(t.lastUsedAt).toLocaleString() : '—';
                    var created = new Date(t.createdAt).toLocaleString();
                    tr.innerHTML =
                        '<td><code>' + escapeHtml(t.prefix) + '…</code></td>' +
                        '<td style="font-size:12px;color:var(--fg-3)">' + escapeHtml(created) + '</td>' +
                        '<td style="font-size:12px;color:var(--fg-3)">' + escapeHtml(lastUsed) + '</td>' +
                        '<td style="text-align:right"><button type="button" class="btn warn sm" data-revoke="' + t.id + '">Revoke</button></td>';
                    tbody.appendChild(tr);
                });
                tbody.querySelectorAll('button[data-revoke]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        var id = parseInt(btn.dataset.revoke, 10);
                        if (!id) return;
                        var doRevoke = function () {
                            btn.disabled = true;
                            fetch('/api/addon/management/tokens/' + id + '/revoke?linkshellId=' + addonLinkshellId, {
                                method: 'POST',
                                credentials: 'same-origin',
                                headers: withCsrf()
                            }).then(function (res) {
                                if (!res.ok) { btn.disabled = false; return; }
                                loadTokens();
                            }).catch(function () { btn.disabled = false; });
                        };
                        if (window.lsmConfirmChange) {
                            window.lsmConfirmChange().then(function (ok) { if (ok) doRevoke(); });
                        } else {
                            doRevoke();
                        }
                    });
                });
            }

            function loadTokens() {
                fetch('/api/addon/management/tokens?linkshellId=' + addonLinkshellId, {
                    credentials: 'same-origin'
                }).then(function (res) {
                    if (!res.ok) return null;
                    return res.json();
                }).then(function (data) {
                    if (!data) return;
                    renderTokens(data.tokens || []);
                });
            }

            function startCountdown(totalSeconds) {
                if (countdownTimer) clearInterval(countdownTimer);
                var remaining = totalSeconds;
                function tick() {
                    if (remaining <= 0) {
                        addonPairCountdown.textContent = 'expired';
                        if (countdownTimer) { clearInterval(countdownTimer); countdownTimer = null; }
                        // An expired code can't be redeemed; stop polling and
                        // flag the chip so the state is unambiguous.
                        if (pairStatusTimer) { clearInterval(pairStatusTimer); pairStatusTimer = null; }
                        if (addonPairStatusTag) addonPairStatusTag.className = 'tag danger';
                        if (addonPairStatusText) addonPairStatusText.textContent = 'Expired';
                        return;
                    }
                    var m = Math.floor(remaining / 60);
                    var s = remaining % 60;
                    addonPairCountdown.textContent = m + ':' + (s < 10 ? '0' : '') + s;
                    remaining--;
                }
                tick();
                countdownTimer = setInterval(tick, 1000);
            }

            addonGenerateBtn.addEventListener('click', function () {
                setAddonPairError('');
                // Fresh state every open: Generate button back, code +
                // instructions hidden, any prior poll/countdown stopped.
                resetPairModalUi();
                // Re-enable the linkshell picker the previous generation may
                // have locked.
                var lsSelect = document.getElementById('addonPairLinkshell');
                if (lsSelect) {
                    lsSelect.disabled = false;
                    // Reset to the current page's linkshell each time the
                    // modal opens; user can change it before generating.
                    lsSelect.value = String(addonLinkshellId);
                }
                openModal('addonPairModal');
            });

            addonPairCreateBtn.addEventListener('click', function () {
                setAddonPairError('');
                addonPairCreateBtn.disabled = true;
                // The picker lets leaders generate codes for any linkshell
                // they manage without leaving this page; fall back to the page
                // LS if the dropdown was somehow cleared.
                var lsSelect = document.getElementById('addonPairLinkshell');
                var lsId = lsSelect && lsSelect.value ? parseInt(lsSelect.value, 10) : addonLinkshellId;
                if (!lsId) {
                    setAddonPairError('Pick a linkshell to generate a code for.');
                    addonPairCreateBtn.disabled = false;
                    return;
                }
                fetch('/api/addon/management/pairing-code', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: withCsrf({ 'Content-Type': 'application/json' }),
                    body: JSON.stringify({ linkshellId: lsId })
                }).then(function (res) {
                    if (!res.ok) {
                        return res.text().then(function (txt) {
                            var msg = 'Could not generate pairing code.';
                            try { var j = JSON.parse(txt); if (j && j.error) msg = j.error; } catch (e) {}
                            setAddonPairError(msg);
                            return null;
                        });
                    }
                    return res.json();
                }).then(function (data) {
                    if (!data) return;
                    addonPairCode.textContent = data.code;

                    // Resolve the chosen linkshell's display name from the
                    // (now-locked) dropdown for the instruction text.
                    var lsName = 'this linkshell';
                    if (lsSelect && lsSelect.options && lsSelect.selectedIndex >= 0) {
                        lsName = lsSelect.options[lsSelect.selectedIndex].text || lsName;
                    }
                    if (addonPairLsName) addonPairLsName.textContent = lsName;
                    if (addonPairCmd1) addonPairCmd1.textContent = '/lsm link ' + data.code;
                    if (addonPairStatusTag) addonPairStatusTag.className = 'tag warning';
                    if (addonPairStatusText) addonPairStatusText.textContent = 'Unpaired';

                    addonPairCodeWrapper.style.display = 'block';
                    // The code is issued — replace the Generate button with
                    // the live "waiting to be linked" state. It comes back
                    // via resetPairModalUi() on next open / close.
                    addonPairCreateBtn.style.display = 'none';
                    // Lock the linkshell selection once a code is issued so the
                    // displayed code can't drift from the LS saved on the token.
                    var lockedLs = document.getElementById('addonPairLinkshell');
                    if (lockedLs) lockedLs.disabled = true;
                    startCountdown((data.expiresInMinutes || 10) * 60);
                    startStatusPoll(lsId, data.code);
                }).catch(function () {
                    setAddonPairError('Network error generating pairing code.');
                }).finally(function () {
                    // Only re-enable when still showing Generate; once a code
                    // is issued the button is hidden and shouldn't flip back.
                    if (addonPairCreateBtn.style.display !== 'none') {
                        addonPairCreateBtn.disabled = false;
                    }
                });
            });

            // Polls the status endpoint while a code is displayed. When the
            // addon redeems it in-game (consumed) we flip the chip to "Paired",
            // refresh the token list, and auto-close the modal. On expiry we
            // stop polling (the countdown already shows "expired").
            function startStatusPoll(lsId, code) {
                if (pairStatusTimer) clearInterval(pairStatusTimer);
                pairStatusTimer = setInterval(function () {
                    fetch('/api/addon/management/pairing-code/status?linkshellId=' + lsId
                            + '&code=' + encodeURIComponent(code), {
                        credentials: 'same-origin'
                    }).then(function (res) {
                        return res.ok ? res.json() : null;
                    }).then(function (s) {
                        if (!s) return;
                        if (s.consumed) {
                            clearInterval(pairStatusTimer); pairStatusTimer = null;
                            if (countdownTimer) { clearInterval(countdownTimer); countdownTimer = null; }
                            if (addonPairStatusTag) addonPairStatusTag.className = 'tag success';
                            if (addonPairStatusText) addonPairStatusText.textContent = 'Paired';
                            loadTokens();
                            setTimeout(function () { closeModal('addonPairModal'); }, 3000);
                        } else if (s.expired || s.found === false) {
                            clearInterval(pairStatusTimer); pairStatusTimer = null;
                        }
                    }).catch(function () { /* transient; keep polling */ });
                }, 2000);
            }

            document.getElementById('addonPairModal').addEventListener('click', function (e) {
                if (e.target.dataset && e.target.dataset.mtClose === '1') {
                    resetPairModalUi();
                    loadTokens();
                }
            });

            loadTokens();
        })();
    </script>
}

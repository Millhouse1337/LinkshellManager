@model EventViewModel
@{
    ViewData["Title"] = "Create event";
    ViewData["BodyClass"] = "lsm-page";
}

@* The form's own header carries the title and the linkshell chip (it is laid out as the
   Discord Activity's create-event modal), so this page adds no page-head of its own. *@
<form asp-action="Create" method="post" class="cem cem--page fade d1">
    @await Html.PartialAsync("_EventForm", Model)
</form>

@* Inline "Create New Party Setup" modal — rendered OUTSIDE the event form so its
   editor <form> isn't nested. Opened by the "+ New setup" button. *@
@if (Model.PartySetupEditor is not null)
{
    @await Html.PartialAsync("~/Views/Event/_PartySetupCreateModal.cshtml", Model.PartySetupEditor)
}

@section Scripts {
    @if (Model.PartySetupEditor is not null)
    {
        @await Html.PartialAsync("~/Views/PartySetup/_EditorScripts.cshtml")
    }
    <script src="~/js/markdown-toolbar.js" asp-append-version="true"></script>
}

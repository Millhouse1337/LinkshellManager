@model LinkshellManagerDiscordApp.ViewModels.LinkshellAppDkpSheetViewModel
@{
    ViewData["Title"] = "App DKP Sheet";
}

<style>
    /* Visible vertical separators between every column (header row, the
       pinned TOTAL row, and all data rows). Last column has no trailing
       line so it doesn't double up with the table edge. */
    .app-sheet-table th,
    .app-sheet-table td {
        border-right: 1px solid rgba(255, 255, 255, 0.15);
    }
    .app-sheet-table th:last-child,
    .app-sheet-table td:last-child {
        border-right: 0;
    }
    /* The summary row sits first in the table body so its columns line up
       exactly with the header labels and the numbers below, and stays
       pinned just under the header while the data scrolls. Its `top`
       offset = the rendered header height, set in JS (the header is a
       96px diagonal band plus the letter-header row). */
    .app-sheet-total-row td {
        font-weight: 700;
        border-top: 2px solid #24d11c;
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        position: sticky;
        z-index: 2;
    }
    .app-sheet-total-row td:first-child {
        z-index: 3;
    }

    /* The diagonal banner row draws its own tile edges, so suppress the
       generic per-column separators that would otherwise cut vertical
       lines across it. */
    .app-sheet-table tr.app-sheet-diag-row th {
        border-right: 0;
    }

    /* Toolbar polish: clean focus ring on the modern inputs, no native
       number spinner, and a clearly-dimmed disabled state on the pager
       buttons so Prev/Next read as inactive at the ends. */
    #appSheetSearch:focus,
    #appSheetPageInput:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 3px var(--accent-weak, rgba(99, 102, 241, 0.25));
    }
    #appSheetPageInput::-webkit-outer-spin-button,
    #appSheetPageInput::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    #appSheetPageInput {
        -moz-appearance: textfield;
    }
    .app-sheet-pager:disabled {
        opacity: 0.45;
        cursor: default;
    }
</style>

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">App DKP Sheet</h1>
        <div class="page-sub">
            <span>Google Sheet data rendered in-app</span>
            @if (!string.IsNullOrWhiteSpace(Model.LinkshellName))
            {
                <span class="dot"> &middot; </span>
                <span>@Model.LinkshellName</span>
            }
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger fade d2">@Model.ErrorMessage</div>
}

@if (!Model.IsConfigured)
{
    <div class="card fade d2">
        <div class="card-head">
            <div class="card-title">Sheet not configured</div>
        </div>
        <div class="empty" style="padding:16px">
            Your linkshell hasn't connected a Google Sheet yet. A Leader or Officer can set it up under
            <strong>Configurations &rarr; Google Sheet Integration</strong>.
        </div>
    </div>
}
else if (Model.Tabs.Count == 0)
{
    <div class="card fade d2">
        <div class="card-head">
            <div class="card-title">No sheet tabs found</div>
        </div>
        <div class="empty" style="padding:16px">
            The configured spreadsheet did not return any tabs.
            @if (!string.IsNullOrWhiteSpace(Model.OpenInSheetsUrl))
            {
                <a href="@Model.OpenInSheetsUrl" target="_blank" rel="noopener">Open in Google Sheets &#8599;</a>
            }
        </div>
    </div>
}
else
{
    <div class="card fade d2">
        <div class="card-head">
            <div class="card-title">Sheet tabs <span class="tag">@Model.Tabs.Count</span></div>
            @if (!string.IsNullOrWhiteSpace(Model.OpenInSheetsUrl))
            {
                <a class="btn ghost sm" href="@Model.OpenInSheetsUrl" target="_blank" rel="noopener">Open in Google Sheets &#8599;</a>
            }
        </div>

        <div style="display:flex;gap:6px;overflow-x:auto;padding:10px 16px;border-bottom:1px solid var(--border,#222)">
            @for (var i = 0; i < Model.Tabs.Count; i++)
            {
                var tab = Model.Tabs[i];
                <button type="button"
                        class="btn sm app-sheet-tab-button @(i == 0 ? "primary" : "ghost")"
                        data-tab-index="@i">
                    @tab.Name <span class="tag">@tab.Rows.Count</span>
                </button>
            }
        </div>

        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:10px 16px;border-bottom:1px solid var(--border,#222)">
            <input type="text" id="appSheetSearch" class="input" placeholder="Filter current tab..." style="flex:1;min-width:220px;max-width:380px" />
            <span id="appSheetVisibleCount" style="font-size:12px;color:var(--fg-3,#888)"></span>
            <span style="flex:1"></span>
            <button type="button" class="btn sm app-sheet-pager" id="appSheetPrev" disabled>&larr; Prev</button>
            <span id="appSheetPageLabel" style="font-size:12px;color:var(--fg-3,#aaa);min-width:90px;text-align:center">Page 1 / 1</span>
            <label style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--fg-3,#aaa)">
                Page
                <input type="number" id="appSheetPageInput" class="input" min="1" value="1" style="width:64px;text-align:center" />
            </label>
            <button type="button" class="btn sm" id="appSheetGo">Go</button>
            <button type="button" class="btn sm app-sheet-pager" id="appSheetNext" disabled>Next &rarr;</button>
        </div>

        @for (var t = 0; t < Model.Tabs.Count; t++)
        {
            var tab = Model.Tabs[t];
            var isMainTab = string.Equals(tab.Name, "Main", StringComparison.OrdinalIgnoreCase);
            var mainHeaderRow = isMainTab ? tab.Rows.FirstOrDefault(r => r.RowNumber == 6) : null;
            var mainTotalRow = isMainTab ? tab.Rows.FirstOrDefault(r => r.RowNumber == 7) : null;
            var mainHeaderStart = 1;
            var mainHeaderEnd = Math.Min(11, tab.ColumnCount);
            // One uniform column width for the whole sheet. The diagonal
            // header tiles are real cells in the SAME <table> as the data,
            // so they sit in these exact columns -- the browser's table
            // layout aligns them automatically. Nothing to tune per column;
            // every data column is colWidth, the narrow A column is 38, the
            // # gutter is 58.
            var colWidth  = 110;  // every data/header column (px)
            Func<int, int> bodyColWidth = c => c == 0 ? 38 : colWidth;
            var hasDiagRow = isMainTab && mainHeaderRow is not null;
            <div class="app-sheet-panel" data-tab-index="@t" style="@(t == 0 ? "" : "display:none")">
                @if (tab.ColumnCount == 0)
                {
                    <div class="empty" style="padding:16px">This tab is empty.</div>
                }
                else
                {
                    @if (hasDiagRow)
                    {
                        // Banner band only. The diagonal column labels used to
                        // live here in a separate CSS grid that never matched
                        // the table's columns; they are now the first <thead>
                        // row of the data table itself, so the browser's own
                        // column layout aligns them exactly (no width math).
                        <div class="main-sheet-hero" style="min-width:1120px;background:#b9b9b9;color:#fff">
                            <div style="display:flex;align-items:stretch">
                                <div style="width:96px"></div>
                                <div style="flex:1;height:104px;display:flex;align-items:center;padding:18px 0 20px 33px">
                                    <img src="~/images/onlyfrensbanner.png" asp-append-version="true" alt="OnlyFrens" style="width:319px;height:101px;object-fit:contain;display:block" />
                                </div>
                            </div>
                        </div>
                    }
                    <div style="overflow:auto;max-height:72vh;padding-bottom:8px">
                        <table class="app-sheet-table" data-tab-index="@t" style="width:100%;border-collapse:collapse;font-size:13px;min-width:max-content">
                            <thead>
                                @if (hasDiagRow)
                                {
                                    // Diagonal column-label band -- now a real table
                                    // row, so it shares the EXACT same columns as the
                                    // data below (browser table layout aligns them;
                                    // no width math). Sticky at top:0; the letter-
                                    // header row sticks just beneath it (top:96px).
                                    <tr class="app-sheet-diag-row">
                                        <th style="padding:0;position:sticky;left:0;top:0;background:#b9b9b9;z-index:5;width:58px;height:96px"></th>
                                        @for (var c = 0; c < tab.Headers.Count; c++)
                                        {
                                            var dWidth = bodyColWidth(c);
                                            var inBand = c >= mainHeaderStart && c <= mainHeaderEnd;
                                            var dLabel = inBand
                                                ? (c < mainHeaderRow!.Cells.Count ? mainHeaderRow.Cells[c] : tab.Headers.ElementAtOrDefault(c) ?? string.Empty)
                                                : string.Empty;
                                            var dIsMember = c == mainHeaderStart;
                                            var dIsExpense = dLabel.Contains("Expense", StringComparison.OrdinalIgnoreCase);
                                            var dIsGrey = dIsMember || (c >= 3 && c <= 5);
                                            var dBg = dIsGrey ? "#333" : dIsExpense ? "#4a1d1b" : c <= 4 ? "#173f10" : "#21484c";
                                            <th style="padding:0;position:sticky;top:0;background:#b9b9b9;z-index:4;width:@(dWidth)px;min-width:@(dWidth)px;max-width:@(dWidth)px;height:96px">
                                                @if (inBand)
                                                {
                                                    <div style="height:96px;background:@dBg;border-right:1px solid rgba(255,255,255,.65);clip-path:polygon(34px 0,100% 0,calc(100% - 34px) 100%,0 100%);position:relative">
                                                        <span style="display:block;position:absolute;left:50%;top:50%;transform:translate(-50%,-50%) rotate(-45deg);font-family:Georgia,serif;font-weight:700;font-size:14px;text-align:center;white-space:normal;max-width:100px;color:#fff">@dLabel</span>
                                                    </div>
                                                }
                                            </th>
                                        }
                                    </tr>
                                }
                                <tr>
                                    <th style="text-align:right;padding:8px 10px;position:sticky;left:0;top:@(hasDiagRow ? "96px" : "0");background:var(--surface,#111);z-index:3;color:var(--fg-muted,#888);width:58px">#</th>
                                    @for (var c = 0; c < tab.Headers.Count; c++)
                                    {
                                        var columnWidth = bodyColWidth(c);
                                        var columnPadding = c == 0 ? "8px 6px" : "8px 12px";
                                        <th class="app-sheet-sortable"
                                            data-sort-col="@c"
                                            style="text-align:center;padding:@columnPadding;position:sticky;top:@(hasDiagRow ? "96px" : "0");background:var(--surface,#111);z-index:2;cursor:pointer;user-select:none;width:@(columnWidth)px;min-width:@(columnWidth)px;max-width:@(columnWidth)px">
                                            @tab.Headers[c] <span class="sort-indicator" aria-hidden="true">&#9662;</span>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (isMainTab && mainTotalRow is not null)
                                {
                                    // Pinned summary: rendered as the first table row (not in
                                    // the hero) so its columns share the exact same widths as
                                    // the header cells and the data numbers below. Not an
                                    // .app-sheet-row, so the filter/pagination JS leaves it
                                    // visible on every page.
                                    <tr class="app-sheet-total-row">
                                        <td style="text-align:right;padding:7px 10px;position:sticky;left:0;background:var(--surface,#111);color:var(--fg-muted,#888);z-index:1"></td>
                                        @for (var c = 0; c < tab.ColumnCount; c++)
                                        {
                                            var inBand = c >= mainHeaderStart && c <= mainHeaderEnd;
                                            var totalValue = c == mainHeaderStart
                                                ? "TOTAL"
                                                : (c < mainTotalRow.Cells.Count ? mainTotalRow.Cells[c] : string.Empty);
                                            var headerLabel = c < mainHeaderRow?.Cells.Count ? mainHeaderRow!.Cells[c] : string.Empty;
                                            var isExpense = headerLabel.Contains("Expense", StringComparison.OrdinalIgnoreCase);
                                            var isGrey = c == mainHeaderStart || (c >= 3 && c <= 5);
                                            var bg = !inBand ? "#111" :
                                                isGrey ? "#333" :
                                                isExpense ? "#4a1d1b" :
                                                c <= 4 ? "#173f10" :
                                                "#21484c";
                                            var columnWidth = bodyColWidth(c);
                                            var columnPadding = c == 0 ? "7px 6px" : "7px 12px";
                                            <td style="padding:@columnPadding;white-space:nowrap;text-align:center;background:@bg;width:@(columnWidth)px;min-width:@(columnWidth)px;max-width:@(columnWidth)px">@totalValue</td>
                                        }
                                    </tr>
                                }
                                @foreach (var row in tab.Rows)
                                {
                                    // Sheet rows 6 (diagonal headers) and 7 (TOTAL) are
                                    // already rendered inside the Main hero above, so skip
                                    // them here to avoid showing the same data twice.
                                    if (isMainTab && (row.RowNumber == 6 || row.RowNumber == 7))
                                    {
                                        continue;
                                    }
                                    var search = string.Join(" ", row.Cells).ToLowerInvariant();
                                    <tr class="app-sheet-row" data-search="@search" style="border-top:1px solid var(--border,#222)">
                                        <td style="text-align:right;padding:7px 10px;position:sticky;left:0;background:var(--surface,#111);color:var(--fg-muted,#888);z-index:1">@row.RowNumber</td>
                                        @for (var c = 0; c < tab.ColumnCount; c++)
                                        {
                                            var value = c < row.Cells.Count ? row.Cells[c] : string.Empty;
                                            var columnWidth = bodyColWidth(c);
                                            var columnPadding = c == 0 ? "7px 6px" : "7px 12px";
                                            <td class="app-sheet-cell" data-col="@c" style="padding:@columnPadding;white-space:nowrap;text-align:center;width:@(columnWidth)px;min-width:@(columnWidth)px;max-width:@(columnWidth)px">@value</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </div>

    <script nonce="@Html.CspNonce()">
    (function () {
        var PAGE_SIZE = 50;
        var state = { tab: 0, query: '', sortCol: null, sortDir: 'asc', page: 1 };
        var tabButtons = Array.prototype.slice.call(document.querySelectorAll('.app-sheet-tab-button'));
        var panels = Array.prototype.slice.call(document.querySelectorAll('.app-sheet-panel'));
        var search = document.getElementById('appSheetSearch');
        var prev = document.getElementById('appSheetPrev');
        var next = document.getElementById('appSheetNext');
        var pageInput = document.getElementById('appSheetPageInput');
        var pageGo = document.getElementById('appSheetGo');
        var pageLabel = document.getElementById('appSheetPageLabel');
        var visibleCount = document.getElementById('appSheetVisibleCount');
        var tabDefaultPages = {};

        tabButtons.forEach(function (btn) {
            var index = Number(btn.getAttribute('data-tab-index'));
            var name = (btn.textContent || '').trim().toLowerCase();
            tabDefaultPages[index] = name.indexOf('attinput') === 0 ? 'last' : 1;
        });

        // Cache each panel's rows in their original DOM order at startup.
        // render() calls tbody.appendChild to reorder when sorting / paging,
        // which mutates the live DOM order. If we re-queried the DOM on each
        // render we'd be reading back the post-mutation order, so paging
        // would compound the reorder (page 2 starts wherever page 1 left
        // the rows, not at index 50 of the original list).
        var panelRowsByTab = {};
        panels.forEach(function (panel) {
            var idx = Number(panel.getAttribute('data-tab-index'));
            panelRowsByTab[idx] = Array.prototype.slice.call(panel.querySelectorAll('tr.app-sheet-row'));
        });

        function currentPanel() {
            return panels.find(function (p) { return Number(p.getAttribute('data-tab-index')) === state.tab; });
        }

        function currentRows() {
            return panelRowsByTab[state.tab] || [];
        }

        function parseValue(row, col) {
            var cell = row.querySelector('td.app-sheet-cell[data-col="' + col + '"]');
            if (!cell) return '';
            var text = (cell.textContent || '').trim();
            if (text === '') return '';
            var normalized = text.replace(/,/g, '');
            var n = Number(normalized);
            if (!isNaN(n) && normalized !== '') return n;
            var d = Date.parse(text);
            if (!isNaN(d) && /[0-9]/.test(text)) return d;
            return text.toLowerCase();
        }

        function compare(a, b) {
            var aEmpty = a === '' || a === null || a === undefined;
            var bEmpty = b === '' || b === null || b === undefined;
            if (aEmpty && !bEmpty) return 1;
            if (!aEmpty && bEmpty) return -1;
            if (aEmpty && bEmpty) return 0;
            if (typeof a === 'number' && typeof b === 'number') {
                return state.sortDir === 'asc' ? a - b : b - a;
            }
            var as = String(a), bs = String(b);
            if (as < bs) return state.sortDir === 'asc' ? -1 : 1;
            if (as > bs) return state.sortDir === 'asc' ? 1 : -1;
            return 0;
        }

        function filteredRows() {
            var rows = currentRows();
            var q = state.query.trim().toLowerCase();
            var filtered = q
                ? rows.filter(function (r) { return (r.getAttribute('data-search') || '').indexOf(q) !== -1; })
                : rows.slice();
            if (state.sortCol !== null) {
                filtered.sort(function (a, b) {
                    return compare(parseValue(a, state.sortCol), parseValue(b, state.sortCol));
                });
            }
            return { all: rows, filtered: filtered };
        }

        function totalPagesForCurrentFilter() {
            return Math.max(1, Math.ceil(filteredRows().filtered.length / PAGE_SIZE));
        }

        function defaultPageForTab(tabIndex) {
            return tabDefaultPages[tabIndex] === 'last' ? totalPagesForCurrentFilter() : 1;
        }

        function goToPage(value) {
            var totalPages = totalPagesForCurrentFilter();
            var requested = Number(value);
            if (!Number.isFinite(requested)) requested = state.page;
            state.page = Math.max(1, Math.min(totalPages, Math.floor(requested)));
            render();
        }

        // The TOTAL row is sticky; its `top` must equal the rendered
        // header height (96px diagonal band + the letter-header row).
        // That can't be a fixed value -- the letter row's height depends
        // on the browser's table layout -- so measure the live <thead>.
        // Skip when its table is hidden (height 0), keeping the last
        // good value until the Main tab is visible again.
        function positionTotalRow() {
            var totalRow = document.querySelector('.app-sheet-total-row');
            if (!totalRow) return;
            var table = totalRow.closest('table');
            if (!table || !table.tHead) return;
            var headerHeight = Math.round(table.tHead.getBoundingClientRect().height);
            if (!headerHeight) return;
            Array.prototype.forEach.call(totalRow.children, function (td) {
                td.style.top = headerHeight + 'px';
            });
        }

        function render() {
            panels.forEach(function (panel) {
                panel.style.display = Number(panel.getAttribute('data-tab-index')) === state.tab ? '' : 'none';
            });
            tabButtons.forEach(function (btn) {
                var active = Number(btn.getAttribute('data-tab-index')) === state.tab;
                btn.classList.toggle('primary', active);
                btn.classList.toggle('ghost', !active);
            });

            var result = filteredRows();
            result.all.forEach(function (row) { row.style.display = 'none'; });

            var totalPages = Math.max(1, Math.ceil(result.filtered.length / PAGE_SIZE));
            if (state.page > totalPages) state.page = totalPages;
            if (state.page < 1) state.page = 1;
            var start = (state.page - 1) * PAGE_SIZE;
            var end = Math.min(result.filtered.length, start + PAGE_SIZE);
            var panel = currentPanel();
            var tbody = panel ? panel.querySelector('tbody') : null;
            for (var i = start; i < end; i++) {
                result.filtered[i].style.display = '';
                if (tbody) tbody.appendChild(result.filtered[i]);
            }

            pageLabel.textContent = 'Page ' + state.page + ' / ' + totalPages;
            pageInput.value = String(state.page);
            pageInput.max = String(totalPages);
            prev.disabled = state.page <= 1;
            next.disabled = state.page >= totalPages;
            visibleCount.textContent = result.filtered.length === result.all.length
                ? result.filtered.length + ' rows'
                : result.filtered.length + ' of ' + result.all.length + ' rows';

            document.querySelectorAll('.app-sheet-sortable .sort-indicator').forEach(function (indicator) {
                indicator.textContent = ' \u25BE';
            });
            if (panel && state.sortCol !== null) {
                var activeHeader = panel.querySelector('.app-sheet-sortable[data-sort-col="' + state.sortCol + '"] .sort-indicator');
                if (activeHeader) {
                    activeHeader.textContent = state.sortDir === 'asc' ? ' \u25B4' : ' \u25BE';
                    activeHeader = null;
                }
                if (activeHeader) activeHeader.textContent = state.sortDir === 'asc' ? ' ▲' : ' ▼';
            }

            positionTotalRow();
        }

        tabButtons.forEach(function (btn) {
            btn.addEventListener('click', function () {
                state.tab = Number(btn.getAttribute('data-tab-index'));
                state.query = '';
                state.sortCol = null;
                state.sortDir = 'asc';
                search.value = '';
                state.page = defaultPageForTab(state.tab);
                render();
            });
        });

        document.querySelectorAll('.app-sheet-sortable').forEach(function (th) {
            th.addEventListener('click', function () {
                var col = Number(th.getAttribute('data-sort-col'));
                if (state.sortCol === col) {
                    state.sortDir = state.sortDir === 'asc' ? 'desc' : 'asc';
                } else {
                    state.sortCol = col;
                    state.sortDir = 'asc';
                }
                state.page = 1;
                render();
            });
        });

        search.addEventListener('input', function () {
            state.query = search.value || '';
            state.page = defaultPageForTab(state.tab);
            render();
        });
        prev.addEventListener('click', function () {
            if (state.page > 1) {
                state.page--;
                render();
            }
        });
        next.addEventListener('click', function () {
            state.page++;
            render();
        });
        pageGo.addEventListener('click', function () {
            goToPage(pageInput.value);
        });
        pageInput.addEventListener('keydown', function (event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                goToPage(pageInput.value);
            }
        });
        window.addEventListener('resize', positionTotalRow);

        state.page = defaultPageForTab(state.tab);
        render();
    })();
    </script>
}

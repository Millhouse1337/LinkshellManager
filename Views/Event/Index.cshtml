@model EventSystemPageViewModel
@using LinkshellManagerDiscordApp.Models
@{
    ViewData["Title"] = "Events";
    ViewData["BodyClass"] = "lsm-page";

    // Viewer context for _TimedEventCard. Html.PartialAsync(name, model) shares THIS dictionary
    // with the partial, so setting them once here reaches every card in both sections.
    ViewData["CurrentCharacterName"] = Model.CurrentCharacterName;
    ViewData["CurrentAppUserId"]     = Model.CurrentAppUserId;
    ViewData["SignupCharacters"]     = Model.SignupCharacters;
    ViewData["SignUpRoleOptions"]    = Model.SignUpRoleOptions;
    ViewData["SignUpMainJobOptions"] = Model.SignUpMainJobOptions;
    ViewData["SignUpSubJobOptions"]  = Model.SignUpSubJobOptions;
    ViewData["EventIndexUrl"]        = Url.Action("Index", "Event") ?? "/Event";
}

@* Scoped styles for the inline Party Setup panel + manual signup toggle.
   Mirrors the Discord Activity "View & Sign Up" UX: click expands the
   alliance/parties/slots tree inline, with a "Sign Up Manually" affordance
   at the bottom that's hidden when the user already owns a slot.

   Lives here rather than in _TimedEventCard so it's emitted once, not once per card. *@
<style>
    .event-ps-row {
        padding: 12px 16px; border-top: 1px solid var(--border);
        display: flex; justify-content: space-between; align-items: center;
        gap: 12px; flex-wrap: wrap;
    }
    .event-ps-row__label { font-size: 12px; color: var(--fg-3); }
    .event-ps-row__label strong { color: var(--fg); margin-left: 4px; }
    .event-ps-panel { padding: 12px 16px 14px; border-top: 1px solid var(--border); background: rgba(124, 92, 255, 0.04); }
    .event-ps-panel[hidden] { display: none; }

    .event-ps-alliance-title {
        font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
        color: var(--accent); margin: 6px 0 8px;
    }
    .event-ps-alliance-lead {
        font-size: 12px; font-weight: 600; letter-spacing: 0; text-transform: none; color: var(--fg);
    }
    .event-ps-party-grid { display: flex; flex-wrap: wrap; gap: 12px; }
    .event-ps-party {
        flex: 1 1 280px; min-width: 260px;
        border: 1px solid var(--border); border-radius: var(--r-md);
        padding: 10px; background: var(--surface);
    }
    .event-ps-party__head {
        display: flex; align-items: center; gap: 8px; font-weight: 600; color: var(--fg);
        font-size: 13px; padding-bottom: 8px; border-bottom: 1px solid var(--border); margin-bottom: 8px;
    }
    .event-ps-party__count {
        margin-left: auto; padding: 2px 8px; border-radius: 999px;
        background: rgba(148, 163, 184, 0.14); font-size: 11px; color: var(--fg-3); font-weight: 600;
    }

    .event-ps-slot {
        display: flex; flex-direction: column; gap: 7px; padding: 8px 10px;
        border-radius: var(--r-sm); background: var(--bg-elev); border: 1px solid var(--border);
        margin-bottom: 6px;
    }
    .event-ps-slot--leader {
        border-color: rgba(245, 197, 24, 0.42);
        background: linear-gradient(180deg, rgba(245, 197, 24, 0.06), transparent 60%), var(--bg-elev);
    }
    .event-ps-slot__label {
        display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: var(--fg);
    }
    .event-ps-leader-tag {
        display: inline-flex; align-items: center; gap: 4px; padding: 1px 7px; border-radius: 999px;
        font-size: 10.5px; font-weight: 700; color: #1a1300;
        background: linear-gradient(180deg, #ffe27a, #f5b800);
        box-shadow: 0 0 6px rgba(245, 197, 24, 0.4);
    }
    .event-ps-leader-tag svg { width: 11px; height: 11px; fill: currentColor; }

    .event-ps-slot__controls {
        display: flex; align-items: center; gap: 6px; flex-wrap: wrap; justify-content: flex-end;
    }
    .event-ps-slot__controls select.form-select {
        flex: 1 1 90px; max-width: 130px; height: 32px; padding: 0 8px; font-size: 12.5px;
    }
    .event-ps-chip {
        display: inline-flex; align-items: center; gap: 5px; padding: 5px 10px; border-radius: 999px;
        font-size: 12px; font-weight: 600; color: #cdd9ff;
        background: rgba(124, 92, 255, 0.18); border: 1px solid rgba(124, 92, 255, 0.45);
    }
    .event-ps-chip--mine {
        background: rgba(124, 92, 255, 0.32); color: #f0ecff;
        border-color: rgba(124, 92, 255, 0.65);
        box-shadow: 0 0 12px rgba(124, 92, 255, 0.25);
    }
    .event-ps-chip .muted { opacity: 0.82; font-weight: 500; }

    .event-manual {
        margin-top: 14px; padding-top: 12px; border-top: 1px dashed var(--border);
        display: flex; flex-direction: column; gap: 10px;
    }
    .event-manual__toggle { align-self: center; }
    .event-manual__locked {
        padding: 10px 12px; text-align: center; color: var(--fg-3); font-size: 12.5px;
        border: 1px dashed var(--border); border-radius: var(--r-sm);
        background: rgba(255, 255, 255, 0.02);
    }
    .event-manual__form { padding: 4px 0; }
    .event-manual__form[hidden] { display: none; }

    .event-ps-empty { padding: 14px; color: var(--fg-3); font-size: 12.5px; }
</style>

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Event System</h1>
        <div class="page-sub">
            <span><span class="num">@(Model.LiveCount + Model.PendingCount)</span> active</span>
            @if (!string.IsNullOrWhiteSpace(Model.LinkshellName))
            {
                <span class="dot"> &middot; </span>
                <span>@Model.LinkshellName</span>
            }
        </div>
    </div>
    <div class="page-actions">
        <a class="btn primary" asp-action="Create">+ Create event</a>
    </div>
</div>

@* Every flash message for this page, surfaced once, above every section. The two WindowEvent
   ones used to live inside _AttendanceSections; that partial now renders twice, and reading
   TempData marks the entry consumed, so whichever slice ran first would have eaten them. *@
@if (TempData["StartError"] is string startError && !string.IsNullOrWhiteSpace(startError))
{
    <div class="card fade d1" style="border:1px solid var(--accent);padding:14px 16px;margin-bottom:16px">
        <div style="font-weight:600;color:var(--fg);margin-bottom:4px">Cannot start event</div>
        <div style="color:var(--fg-2);font-size:14px">@startError</div>
    </div>
}
@if (TempData["PartySetupMessage"] is string psMsg && !string.IsNullOrWhiteSpace(psMsg))
{
    <div class="card fade d1" style="border:1px solid var(--accent);padding:12px 14px;margin-bottom:12px">
        <div style="color:var(--fg);font-size:14px">@psMsg</div>
    </div>
}
@if (TempData["Error"] is string generalError && !string.IsNullOrWhiteSpace(generalError))
{
    <div class="alert alert-danger fade d1" style="margin-bottom:12px">@generalError</div>
}
@if (TempData["WindowEventError"] is string attendanceErr)
{
    <div class="alert alert-danger fade d1" style="margin-bottom:12px">@attendanceErr</div>
}
@if (TempData["WindowEventStatus"] is string attendanceStatus)
{
    <div class="alert alert-success fade d1" style="margin-bottom:12px">@attendanceStatus</div>
}

@* The three sections, in the Discord Activity's order. *@
@await Html.PartialAsync("_CurrentFieldActivity", Model)
@await Html.PartialAsync("_PendingEvents", Model)
@if (Model.Attendance is not null)
{
    @await Html.PartialAsync("_AttendanceArchive", Model)
}
@await Html.PartialAsync("_PastEvents", Model)

@* Shared roster typeahead source for every "Add a character by name…" input in the snapshot
   editors above (they reference it via list=). Emitted here, once, because _AttendanceSections
   renders twice on this page and both slices contain those editors. Managers only — they're the
   only ones who see the add form. *@
@if (Model.Attendance is { CanManage: true } attendanceForRoster && attendanceForRoster.RosterCharacterNames.Count > 0)
{
    <datalist id="we-roster-options">
        @foreach (var name in attendanceForRoster.RosterCharacterNames)
        {
            <option value="@name"></option>
        }
    </datalist>
}

@* Shared HNM board ToD modal — opened by each HNM card's "Post ToD" / "Edit ToD"
   button. Posts to PostBoardTod, which records the ToD, moves the board to the next
   repop, wipes signups, and re-posts before the pop. Mirrors the Activity's board-mode
   ToD dialog. The monster is locked to the board's monster (read-only).

   Rendered unconditionally. It used to sit inside an `@@if (Model.Any())` else-branch, which was
   fine when every event shared one list; now a defeated board waiting to re-post lives in Pending
   Events and needs this dialog on pages with no live events at all. *@
<div id="tod-modal" hidden
     style="position:fixed;inset:0;z-index:1000;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.55)">
    <div style="max-width:560px;width:calc(100% - 32px);max-height:calc(100vh - 48px);overflow:auto;background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px;box-shadow:0 20px 60px rgba(0,0,0,.5)">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
            <strong id="tod-modal-title" style="font-size:16px;color:var(--fg)">Post ToD</strong>
            <button type="button" class="btn ghost sm" id="tod-modal-close">Close</button>
        </div>
        <form asp-action="PostBoardTod" method="post">
            <input type="hidden" name="eventId" id="tod-modal-eventid" value="" />
            <input type="hidden" name="returnUrl" id="tod-modal-returnurl" value="" />
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px 14px;align-items:start">
                @* Monster is locked to the board; Day (read-only) comes from the event and
                   drives whether the HQ toggle shows. Day fills the row when absent. *@
                <div class="field" id="tod-modal-monster-field" style="grid-column:1/-1;display:flex;flex-direction:column">
                    <label>Monster</label>
                    <input class="form-control" id="tod-modal-monster" readonly
                           title="Locked to this board's monster" />
                </div>
                <div class="field" id="tod-modal-day-field" hidden style="display:none;flex-direction:column">
                    <label>Day</label>
                    <input class="form-control" id="tod-modal-day-display" readonly
                           title="Set on the event; days 1–3 show just the base monster, day 4+ shows the merge pair" />
                    <input type="hidden" name="dayNumber" id="tod-modal-day" value="" />
                </div>
                <div class="field" style="display:flex;flex-direction:column">
                    <label for="tod-modal-time">Time of death</label>
                    <input class="form-control" id="tod-modal-time" name="todTimeLocal" type="datetime-local" step="1" required />
                </div>
                <div class="field" style="display:flex;flex-direction:column">
                    <label for="tod-modal-cooldown">Cooldown</label>
                    <select class="form-select" id="tod-modal-cooldown" name="cooldown">
                        @foreach (var cd in TodManagerViewModel.SupportedCooldowns)
                        {
                            <option value="@cd">@cd</option>
                        }
                    </select>
                </div>
                <div class="field" style="display:flex;flex-direction:column">
                    <label for="tod-modal-interval">Interval</label>
                    <select class="form-select" id="tod-modal-interval" name="interval">
                        @foreach (var iv in TodManagerViewModel.SupportedIntervals)
                        {
                            <option value="@iv">@iv</option>
                        }
                    </select>
                </div>
                <div class="field" style="display:flex;flex-direction:column">
                    <label for="tod-modal-claim">Claim</label>
                    <select class="form-select" id="tod-modal-claim" name="claim">
                        <option value="true" selected>Yes</option>
                        <option value="false">No</option>
                        <option value="">Not specified</option>
                    </select>
                </div>
                @* Did we get the kill? Drives the kill bonus at finalize in both attendance
                   modes. This form used to have no such field and the controller hardcoded
                   "killed", so ending a camp here always paid the kill bonus. *@
                <div class="field" style="display:flex;flex-direction:column">
                    <label for="tod-modal-killed">Killed</label>
                    <select class="form-select" id="tod-modal-killed" name="killed">
                        <option value="true" selected>Yes</option>
                        <option value="false">No</option>
                    </select>
                </div>
                @* HQ is hidden by the modal JS on days 1–3 (no HQ variant exists then). *@
                <div class="field" id="tod-modal-hq-field" style="display:flex;flex-direction:column">
                    <label for="tod-modal-hq">HQ</label>
                    <label class="tod-toggle" style="display:inline-flex;align-items:center;gap:6px">
                        <input type="checkbox" id="tod-modal-hq" name="hq" value="true" />
                        <span>Yes</span>
                    </label>
                </div>
            </div>
            @* Re-post the sign-up board before the next pop. This is the ONLY place the lead
               is entered — the event create form just toggles recurrence on/off, because
               this is where the officer actually knows the next pop. Mirrors the Activity's
               End Camp form and the Discord modal's last field. *@
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px 14px;align-items:start;margin-top:12px">
                <div class="field" style="display:flex;flex-direction:column">
                    <label for="tod-modal-repost">Re-post board before next pop?</label>
                    <label class="tod-toggle" style="display:inline-flex;align-items:center;gap:6px">
                        <input type="checkbox" id="tod-modal-repost" name="repost" value="true" />
                        <input type="hidden" name="repost" value="false" />
                        <span>Re-post the sign-up board</span>
                    </label>
                </div>
                <div class="field" id="tod-modal-repost-lead-field" style="display:flex;flex-direction:column">
                    <label for="tod-modal-repost-lead">Hours before repop</label>
                    <input class="form-control" type="number" min="0" max="168" step="0.25"
                           id="tod-modal-repost-lead" name="repostLeadHours" placeholder="e.g. 2"
                           title="How many hours before the predicted next pop the board auto-re-posts" />
                </div>
            </div>
            <div style="margin-top:12px;padding:10px 12px;border:1px solid var(--border);border-radius:8px;background:var(--surface-2)">
                <div style="font-size:11px;color:var(--fg-3);text-transform:uppercase;letter-spacing:.04em">Calculated repop</div>
                <strong id="tod-modal-repop" style="color:var(--fg)">Pick a time of death.</strong>
            </div>
            <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:14px">
                <button type="button" class="btn ghost" id="tod-modal-cancel">Cancel</button>
                <button type="submit" class="btn primary" id="tod-modal-submit">Log ToD</button>
            </div>
        </form>
    </div>
</div>

@* Inline panel toggle: clicking a .event-ps-toggle button shows/hides the
   matching .event-ps-panel (by id stored in data-target). Same handler
   also drives the "Sign Up Manually" toggle. On page load, if the URL
   has a fragment matching a panel id (e.g. "#event-ps-panel-42"), open
   that panel — used after a PartySetup signup/withdraw round-trip.

   Unconditional for the same reason as the ToD modal above: cards now live in two sections and
   either can be empty. *@
<script nonce="@Html.CspNonce()">
    (function () {
        var STORE_KEY = 'lsmOpenEventPsPanel';

        function openPanel(id) {
            if (!id) { return null; }
            var panel = document.getElementById(id);
            if (panel && panel.classList.contains('event-ps-panel')) {
                panel.removeAttribute('hidden');
                return panel;
            }
            return null;
        }

        document.addEventListener('click', function (e) {
            var t = e.target.closest('.event-ps-toggle, .event-manual__toggle');
            if (!t) return;
            var panel = document.getElementById(t.getAttribute('data-target'));
            if (!panel) return;
            if (panel.hasAttribute('hidden')) panel.removeAttribute('hidden');
            else panel.setAttribute('hidden', '');
        });

        // Sign up / Withdraw / manual-signup forms live inside a party-setup panel.
        // Submit them via fetch and swap ONLY that panel in place — no full page
        // reload. (Falls back to a normal submit on a network error, and to a reload
        // if the panel can't be located in the response.)
        document.addEventListener('submit', async function (e) {
            var form = e.target;
            if (!form || !form.closest) return;
            var panel = form.closest('.event-ps-panel');
            if (!panel || !panel.id) return;
            var panelId = panel.id;
            // Remember the open panel so a fallback full reload re-expands it.
            try { sessionStorage.setItem(STORE_KEY, panelId); } catch (err) { /* ignore */ }
            e.preventDefault();
            var fd = new FormData(form);
            // FormData omits the clicked submit button — re-add it (e.g. asLeader=true/false).
            if (e.submitter && e.submitter.name) { fd.append(e.submitter.name, e.submitter.value); }
            var res;
            try {
                res = await fetch(form.action, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'same-origin' });
            } catch (err) { form.submit(); return; }
            var fresh = null;
            try {
                var doc = new DOMParser().parseFromString(await res.text(), 'text/html');
                fresh = doc.getElementById(panelId);
            } catch (err) { /* ignore */ }
            var current = document.getElementById(panelId);
            if (fresh && current) {
                current.replaceWith(fresh);
                fresh.removeAttribute('hidden'); // keep it expanded after the swap
                try { sessionStorage.removeItem(STORE_KEY); } catch (err) { /* ignore */ }
            } else {
                window.location.reload();
            }
        });

        // On load, re-open the panel remembered across a signup/withdraw
        // round-trip (one-shot), and/or the one named by the URL fragment.
        // A section anchor like #past-events falls through openPanel (it isn't an
        // .event-ps-panel), leaving the browser's native anchor scroll to it.
        var restored = null;
        try {
            var saved = sessionStorage.getItem(STORE_KEY);
            if (saved) {
                sessionStorage.removeItem(STORE_KEY);
                restored = openPanel(saved);
            }
        } catch (err) { /* ignore */ }

        var hash = window.location.hash;
        if (hash && hash.length > 1) {
            var fromHash = openPanel(hash.substring(1));
            if (fromHash && !restored) { restored = fromHash; }
        }

        if (restored) {
            restored.scrollIntoView({ behavior: 'auto', block: 'center' });
        }
    })();
</script>

@* asp-fragment exists for <a> but not for <form method="get">, and a fragment written into a
   form's action is dropped by the browser. The two archive search boxes carry data-anchor
   instead, and this handler rebuilds the URL with it so a search lands back on its own section. *@
<script nonce="@Html.CspNonce()">
    document.addEventListener('submit', function (e) {
        var f = e.target, anchor = f && f.getAttribute && f.getAttribute('data-anchor');
        if (!anchor) return;
        e.preventDefault();
        var qs = new URLSearchParams(new FormData(f)).toString();
        window.location.assign(f.action + (qs ? '?' + qs : '') + '#' + anchor);
    });
</script>

<script nonce="@Html.CspNonce()">
    (function () {
        var modal = document.getElementById('tod-modal');
        if (!modal) { return; }
        var titleEl = document.getElementById('tod-modal-title');
        var submitEl = document.getElementById('tod-modal-submit');
        var eventIdEl = document.getElementById('tod-modal-eventid');
        var returnUrlEl = document.getElementById('tod-modal-returnurl');
        var monsterEl = document.getElementById('tod-modal-monster');
        var timeEl = document.getElementById('tod-modal-time');
        var cooldownEl = document.getElementById('tod-modal-cooldown');
        var intervalEl = document.getElementById('tod-modal-interval');
        var repopEl = document.getElementById('tod-modal-repop');
        var monsterFieldEl = document.getElementById('tod-modal-monster-field');
        var dayFieldEl = document.getElementById('tod-modal-day-field');
        var dayDisplayEl = document.getElementById('tod-modal-day-display');
        var dayHiddenEl = document.getElementById('tod-modal-day');
        var hqFieldEl = document.getElementById('tod-modal-hq-field');
        var hqEl = document.getElementById('tod-modal-hq');
        var repostEl = document.getElementById('tod-modal-repost');
        var repostLeadEl = document.getElementById('tod-modal-repost-lead');
        var repostLeadFieldEl = document.getElementById('tod-modal-repost-lead-field');
        // Wyrms use an 84h window; the other window-cycle HNMs use 72h / 1h.
        var LONG = ['Tiamat', 'Jormungand', 'Vrtra'];

        function cooldownHours(v) {
            if (v === '5 Min') { return 5 / 60; }
            if (v === '2 Hour') { return 2; }
            if (v === '84 Hour') { return 84; }
            if (v === '72 Hour') { return 72; }
            return 22;
        }

        // The lead only means anything while re-posting is on.
        function syncRepostLead() {
            repostLeadFieldEl.style.display = repostEl.checked ? 'flex' : 'none';
        }

        function updateRepop() {
            if (!timeEl.value) { repopEl.textContent = 'Pick a time of death.'; return; }
            var d = new Date(timeEl.value);
            if (isNaN(d.getTime())) { repopEl.textContent = 'Pick a time of death.'; return; }
            var repop = new Date(d.getTime() + cooldownHours(cooldownEl.value) * 3600000);
            repopEl.textContent = repop.toLocaleString();
        }

        function openModal(btn) {
            var monster = btn.getAttribute('data-monster') || '';
            var editing = btn.getAttribute('data-editing') === 'true';
            eventIdEl.value = btn.getAttribute('data-event-id') || '';
            returnUrlEl.value = window.location.pathname + window.location.search;
            monsterEl.value = monster;
            titleEl.textContent = editing ? 'Edit ToD' : 'Post ToD';
            submitEl.textContent = editing ? 'Save ToD' : 'Log ToD';

            // Day comes from the event (read-only). When present it takes half the row,
            // so the Monster field drops from full-width to half; otherwise it fills the row.
            var dayRaw = btn.getAttribute('data-day') || '';
            var dayNum = dayRaw === '' ? null : parseInt(dayRaw, 10);
            var hasDay = dayNum !== null && !isNaN(dayNum);
            dayHiddenEl.value = hasDay ? String(dayNum) : '';
            dayDisplayEl.value = hasDay ? String(dayNum) : '';
            dayFieldEl.hidden = !hasDay;
            dayFieldEl.style.display = hasDay ? 'flex' : 'none';
            monsterFieldEl.style.gridColumn = hasDay ? 'auto' : '1/-1';

            // HQ (stronger merge-pair monster) only exists on day 4+; hide the toggle on
            // days 1–3 and never carry a stale checked state into a hidden field.
            var hqAllowed = !hasDay || dayNum >= 4;
            hqFieldEl.style.display = hqAllowed ? 'flex' : 'none';
            hqEl.checked = hqAllowed && editing && btn.getAttribute('data-hq') === 'true';

            var prefillTime = btn.getAttribute('data-tod-time') || '';
            if (editing && prefillTime) {
                // Edit ToD: open with the board's already-logged values.
                timeEl.value = prefillTime;
                cooldownEl.value = btn.getAttribute('data-cooldown') || '22 Hour';
                intervalEl.value = btn.getAttribute('data-interval') || '10 Min';
                // data-claim is 'true' / 'false' / '' (Not specified) — matches the select.
                document.getElementById('tod-modal-claim').value = btn.getAttribute('data-claim') || '';
                // data-killed is 'true' / 'false'; unrecorded ToDs fall back to 'true', the
                // same "unspecified means killed" default the controller applies.
                document.getElementById('tod-modal-killed').value =
                    btn.getAttribute('data-killed') === 'false' ? 'false' : 'true';
            } else {
                // Post ToD: blank time, defaults keyed to the monster's window length.
                var isLong = LONG.indexOf(monster) !== -1;
                timeEl.value = '';
                cooldownEl.value = isLong ? '84 Hour' : '22 Hour';
                intervalEl.value = isLong ? '1 Hour' : '10 Min';
                document.getElementById('tod-modal-claim').value = 'true';
                document.getElementById('tod-modal-killed').value = 'true';
            }

            // Re-post: open with the monster's current standing config so the officer sees
            // what's set and can change it here (the create form no longer asks for a lead).
            repostEl.checked = btn.getAttribute('data-repost') === 'true';
            repostLeadEl.value = btn.getAttribute('data-repost-lead') || '';
            syncRepostLead();

            updateRepop();
            modal.removeAttribute('hidden');
        }

        function closeModal() { modal.setAttribute('hidden', ''); }

        document.addEventListener('click', function (e) {
            var open = e.target.closest('.event-tod-open');
            if (open) { e.preventDefault(); openModal(open); return; }
            if (e.target.closest('#tod-modal-close, #tod-modal-cancel')) { closeModal(); return; }
            if (e.target === modal) { closeModal(); return; } // backdrop click
        });
        timeEl.addEventListener('input', updateRepop);
        timeEl.addEventListener('change', updateRepop);
        cooldownEl.addEventListener('change', updateRepop);
        repostEl.addEventListener('change', syncRepostLead);
    })();
</script>

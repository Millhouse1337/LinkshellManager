@model LinkshellManagerDiscordApp.ViewModels.ManageRevenueViewModel
@{
    ViewData["Title"] = "Add income";
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Add income</h1>
        <div class="page-sub"><span>Log a new revenue entry</span></div>
    </div>
</div>

<div class="card fade d2" style="padding:20px">
    <form asp-action="AddIncome" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="LinkshellId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-grid" style="grid-template-columns:repeat(4,minmax(0,1fr));column-gap:24px;align-items:end">
            <div class="field">
                <label asp-for="EntryType"></label>
                <select asp-for="EntryType" class="form-select" required>
                    <option value="">Select source</option>
                    @foreach (var source in LinkshellManagerDiscordApp.ViewModels.ManageRevenueViewModel.SourceOptions)
                    {
                        <option value="@source">@source</option>
                    }
                </select>
                <span asp-validation-for="EntryType" class="text-danger"></span>
            </div>

            <div class="field" id="categoryField">
                <label asp-for="Category" id="categoryLabel"></label>
                <input asp-for="Category" class="form-control" maxlength="128" />
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="Value"></label>
                <input asp-for="Value" class="form-control" type="text" inputmode="numeric" data-thousands autocomplete="off" />
                <span asp-validation-for="Value" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="OccurredAt"></label>
                <input asp-for="OccurredAt" class="form-control" type="datetime-local"
                       value="@Model.OccurredAt.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="OccurredAt" class="text-danger"></span>
            </div>

            <div class="field" style="grid-column:1/-1">
                <label asp-for="Details"></label>
                <textarea asp-for="Details" class="form-control" rows="3" maxlength="1024"></textarea>
                <span asp-validation-for="Details" class="text-danger"></span>
            </div>
        </div>

        <div style="display:flex;gap:8px;margin-top:20px;padding-top:16px;border-top:1px solid var(--border)">
            <button type="submit" class="btn primary">Add income</button>
        </div>
    </form>
</div>

@section Scripts {
    <script nonce="@Html.CspNonce()">
        (function () {
            var source = document.getElementById('EntryType');
            var field = document.getElementById('categoryField');
            var label = document.getElementById('categoryLabel');
            var input = document.getElementById('Category');
            if (!source || !field || !label) { return; }

            // The Category field is relabelled to fit the chosen source, and
            // dropped entirely for Donations (which carry no category).
            var LABELS = {
                'AH Sale': 'Item Name',
                'Mercenary Work': 'Description',
                'Other': 'Details'
            };

            function apply() {
                if (source.value === 'Donation') {
                    field.style.display = 'none';
                    if (input) { input.value = ''; } // don't post a stale category
                    return;
                }
                field.style.display = '';
                label.textContent = LABELS[source.value] || 'Category';
            }

            source.addEventListener('change', apply);
            apply();
        })();
    </script>
}

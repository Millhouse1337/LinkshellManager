@model LinkshellManagerDiscordApp.ViewModels.ManageItemViewModel
@{
    ViewData["Title"] = "Add item";
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Add item</h1>
        <div class="page-sub"><span>Track a new item for your linkshell</span></div>
    </div>
    <div class="page-actions">
        <a class="btn ghost" asp-action="Index">Cancel</a>
    </div>
</div>

<div class="card fade d2" style="padding:20px">
    <form asp-action="AddItem" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-grid">
            <div class="field">
                <label asp-for="LinkshellId">Linkshell</label>
                <select asp-for="LinkshellId" class="form-select" required>
                    @foreach (var linkshell in Model.Linkshells)
                    {
                        <option value="@linkshell.Id">@linkshell.LinkshellName</option>
                    }
                </select>
                <span asp-validation-for="LinkshellId" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="ItemName"></label>
                <input asp-for="ItemName" class="form-control" maxlength="256" />
                <span asp-validation-for="ItemName" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="ItemType"></label>
                <input asp-for="ItemType" class="form-control" maxlength="128" />
                <span asp-validation-for="ItemType" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="Quantity"></label>
                <input asp-for="Quantity" class="form-control" type="number" min="0" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="field" style="grid-column:1/-1">
                <label asp-for="Notes"></label>
                <textarea asp-for="Notes" class="form-control" rows="3" maxlength="1024"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
        </div>

        <div style="display:flex;gap:8px;margin-top:20px;padding-top:16px;border-top:1px solid var(--border)">
            <button type="submit" class="btn primary">Add item</button>
            <a class="btn ghost" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

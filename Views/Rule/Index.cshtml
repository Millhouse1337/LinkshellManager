@model IEnumerable<LinkshellManagerDiscordApp.ViewModels.RuleViewModel>
@{
    ViewData["Title"] = "Rules";
    ViewData["BodyClass"] = "lsm-page";
    var canManage = (bool)(ViewBag.CanManage ?? false);
    var linkshellName = ViewBag.LinkshellName as string;
    var rules = Model.ToList();
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Rules</h1>
        <div class="page-sub">
            @if (!string.IsNullOrWhiteSpace(linkshellName))
            {
                <span>@linkshellName</span>
                <span class="dot"> · </span>
            }
            <span><span class="num">@rules.Count</span> rule@(rules.Count == 1 ? "" : "s")</span>
        </div>
    </div>
    @if (canManage)
    {
        <div class="page-actions">
            <a class="btn primary" asp-action="Create">+ Create rule</a>
        </div>
    }
</div>

@* Rules are written in Discord and pasted in, so they are shown the way Discord shows
   them: a channel of messages with the details rendered as Discord markdown. *@
<div class="dc-channel fade d2">
    <div class="dc-channel-head">
        <span class="dc-channel-hash" aria-hidden="true">#</span>
        <span class="dc-channel-name">rules</span>
        <div class="dc-channel-rule" aria-hidden="true"></div>
        <div class="dc-channel-topic">
            @if (!string.IsNullOrWhiteSpace(linkshellName))
            {
                <span>@linkshellName</span>
                <span> — </span>
            }
            <span>what members are expected to follow</span>
        </div>
    </div>

    @if (rules.Count == 0)
    {
        <div class="dc-empty">
            <strong>No rules yet</strong>
            @if (canManage)
            {
                <span>Add rules so members know what's expected.</span>
            }
            else
            {
                <span>Your linkshell hasn't published any rules.</span>
            }
        </div>
    }
    else
    {
        <div class="dc-messages">
            @for (var i = 0; i < rules.Count; i++)
            {
                var rule = rules[i];
                var post = new DiscordPostViewModel
                {
                    Id = rule.Id,
                    Title = rule.RuleTitle,
                    Details = rule.RuleDetails,
                    Category = rule.Category,
                    Author = rule.CreatedByCharacterName,
                    CreatedAt = rule.CreatedAt,
                    CanManage = rule.CanManage,
                    Index = i,
                    DeleteConfirm = "Delete this rule?"
                };
                <partial name="_DiscordPost" model="post" />
            }
        </div>
    }
</div>

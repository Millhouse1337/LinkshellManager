@model LinkshellManagerDiscordApp.ViewModels.LinkshellReconciliationViewModel
@{
    ViewData["Title"] = "Reconcile Members";
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Reconcile Members with Sheet</h1>
        <div class="page-sub">
            <span>Confirm each Discord user ↔ sheet character match</span>
            @if (!string.IsNullOrWhiteSpace(Model.LinkshellName))
            {
                <span class="dot"> · </span>
                <span>@Model.LinkshellName</span>
            }
        </div>
    </div>
</div>

@if (TempData["ReconcileError"] is string err)
{
    <div class="alert alert-danger fade d2">@err</div>
}
@if (TempData["ReconcileSuccess"] is string ok)
{
    <div class="alert alert-success fade d2">@ok</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger fade d2">@Model.ErrorMessage</div>
}

@if (Model.IsSheetConfigured)
{
    <div class="card fade d2">
        <div class="card-head">
            <div class="card-title">Sheet rows <span class="tag" id="reconcileTotalTag">@Model.Rows.Count</span></div>
        </div>
        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:8px 16px;border-bottom:1px solid var(--border,#222)">
            <input type="text" id="reconcileSearch" placeholder="Search character name..." style="flex:1;min-width:220px;max-width:360px" />
            <span id="reconcileVisibleCount" style="font-size:12px;color:var(--fg-muted,#888)"></span>
            <span style="flex:1"></span>
            <button type="button" class="btn" id="reconcilePrev" disabled>&larr; Prev</button>
            <span id="reconcilePageLabel" style="font-size:12px;color:var(--fg-muted,#aaa);min-width:90px;text-align:center">Page 1 / 1</span>
            <button type="button" class="btn" id="reconcileNext" disabled>Next &rarr;</button>
        </div>
        <div style="overflow-x:auto;padding:0 0 8px 0">
            <table id="reconcileTable" style="width:100%;border-collapse:collapse;font-size:13px">
                <thead>
                    <tr>
                        <th class="sortable" data-sort-col="character" style="text-align:left;padding:8px 12px;position:sticky;left:0;background:var(--surface,#111);cursor:pointer;user-select:none">Sheet character <span class="sort-indicator"></span></th>
                        @for (var i = 1; i < Model.SheetColumnHeaders.Count; i++)
                        {
                            <th class="sortable" data-sort-col="cell-@i" style="text-align:right;padding:8px 12px;cursor:pointer;user-select:none">@Model.SheetColumnHeaders[i] <span class="sort-indicator"></span></th>
                        }
                        <th style="text-align:left;padding:8px 12px;min-width:260px">Assign to Discord user</th>
                        <th style="padding:8px 12px"></th>
                    </tr>
                </thead>
                <tbody id="reconcileTableBody">
                @foreach (var row in Model.Rows)
                {
                    var searchKey = (row.SheetCharacterName ?? string.Empty).ToLowerInvariant();
                    <tr class="reconcile-row" data-search="@searchKey" data-name="@row.SheetCharacterName" style="border-top:1px solid var(--border,#222);@(row.IsConfirmed ? "background:rgba(40,120,40,0.08)" : "")">
                        <td style="padding:8px 12px;position:sticky;left:0;background:var(--surface,#111)">
                            <strong>@row.SheetCharacterName</strong>
                            @if (row.IsConfirmed)
                            {
                                <span style="color:#4ade80;margin-left:6px" title="Linked and DKP in sync">✓</span>
                            }
                            else if (row.CurrentlyLinkedDiscordDisplay is not null)
                            {
                                <span style="color:#fbbf24;margin-left:6px" title="Suggested match — confirm to apply">●</span>
                            }
                            @if (row.PlaceholderMembershipId.HasValue && row.CurrentlyLinkedDiscordDisplay is null)
                            {
                                <div style="font-size:11px;color:var(--fg-muted,#888)">placeholder #@row.PlaceholderMembershipId</div>
                            }
                        </td>
                        @for (var i = 1; i < row.SheetCells.Count; i++)
                        {
                            <td class="reconcile-cell" data-col="cell-@i" style="padding:8px 12px;text-align:right">@row.SheetCells[i]</td>
                        }
                        <td style="padding:8px 12px">
                            <form asp-action="Confirm" asp-route-linkshellId="@Model.LinkshellId" method="post" style="display:flex;gap:6px;align-items:center">
                                <input type="hidden" name="sheetCharacterName" value="@row.SheetCharacterName" />
                                <input type="hidden" name="sheetDkp" value="@row.SheetDkp" />
                                <select name="appUserId" style="min-width:220px">
                                    <option value="">-- pick Discord user --</option>
                                    @foreach (var u in Model.AssignableUsers)
                                    {
                                        var label = u.DisplayName;
                                        var alts = new List<string?> { u.AltCharacterName1, u.AltCharacterName2 }
                                            .Where(a => !string.IsNullOrWhiteSpace(a))
                                            .ToList();
                                        if (alts.Count > 0)
                                        {
                                            label += $" (alts: {string.Join(", ", alts)})";
                                        }
                                        if (u.AppUserId == row.SuggestedAppUserId)
                                        {
                                            <option value="@u.AppUserId" selected>@label</option>
                                        }
                                        else
                                        {
                                            <option value="@u.AppUserId">@label</option>
                                        }
                                    }
                                </select>
                                <button type="submit" class="btn">@(row.IsConfirmed ? "Resync" : "Confirm")</button>
                            </form>
                        </td>
                        <td style="padding:8px 12px;text-align:right">
                            @if (row.PlaceholderMembershipId.HasValue)
                            {
                                <form asp-action="DeletePlaceholder" asp-route-linkshellId="@Model.LinkshellId" method="post" style="display:inline" onsubmit="return confirm('Delete this placeholder? Its DKP balance will be lost.');">
                                    <input type="hidden" name="membershipId" value="@row.PlaceholderMembershipId" />
                                    <button type="submit" class="btn" title="Delete placeholder row">Delete</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <script nonce="@Html.CspNonce()">
    (function () {
        var PAGE_SIZE = 25;
        var tbody = document.getElementById('reconcileTableBody');
        if (!tbody) return;
        var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr.reconcile-row'));
        var searchInput = document.getElementById('reconcileSearch');
        var prevBtn = document.getElementById('reconcilePrev');
        var nextBtn = document.getElementById('reconcileNext');
        var pageLabel = document.getElementById('reconcilePageLabel');
        var visibleCount = document.getElementById('reconcileVisibleCount');

        var state = { query: '', sortCol: null, sortDir: 'asc', page: 1 };
        var filtered = rows.slice();

        function parseSortValue(row, col) {
            if (col === 'character') {
                return (row.getAttribute('data-name') || '').toLowerCase();
            }
            var cell = row.querySelector('td.reconcile-cell[data-col="' + col + '"]');
            if (!cell) return '';
            var text = (cell.textContent || '').trim();
            if (text === '' || text === '✓') return { isEmpty: true, raw: text };
            var n = Number(text);
            if (!isNaN(n) && text !== '') return n;
            return text.toLowerCase();
        }

        function compareValues(a, b, dir) {
            var aEmpty = (a && a.isEmpty) || a === '' || a === null || a === undefined;
            var bEmpty = (b && b.isEmpty) || b === '' || b === null || b === undefined;
            // Empties always sort to the bottom regardless of direction so a
            // descending sort doesn't bury actual numbers under blanks.
            if (aEmpty && !bEmpty) return 1;
            if (!aEmpty && bEmpty) return -1;
            if (aEmpty && bEmpty) return 0;
            if (typeof a === 'number' && typeof b === 'number') {
                return dir === 'asc' ? a - b : b - a;
            }
            var as = String(a), bs = String(b);
            if (as < bs) return dir === 'asc' ? -1 : 1;
            if (as > bs) return dir === 'asc' ? 1 : -1;
            return 0;
        }

        function applyFilter() {
            var q = state.query.trim().toLowerCase();
            filtered = q === ''
                ? rows.slice()
                : rows.filter(function (r) {
                    return (r.getAttribute('data-search') || '').indexOf(q) !== -1;
                });
            state.page = 1;
        }

        function applySort() {
            if (!state.sortCol) return;
            var col = state.sortCol;
            var dir = state.sortDir;
            filtered.sort(function (a, b) {
                return compareValues(parseSortValue(a, col), parseSortValue(b, col), dir);
            });
        }

        function render() {
            // Hide every row; show only the current page's slice.
            for (var i = 0; i < rows.length; i++) {
                rows[i].style.display = 'none';
            }
            var totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
            if (state.page > totalPages) state.page = totalPages;
            if (state.page < 1) state.page = 1;
            var start = (state.page - 1) * PAGE_SIZE;
            var end = Math.min(filtered.length, start + PAGE_SIZE);

            // Reorder filtered slice in DOM so sorting takes effect; appending
            // an existing node moves it. Only the visible slice needs to move
            // — hidden rows can stay wherever they were.
            for (var j = start; j < end; j++) {
                filtered[j].style.display = '';
                tbody.appendChild(filtered[j]);
            }

            pageLabel.textContent = 'Page ' + state.page + ' / ' + totalPages;
            prevBtn.disabled = state.page <= 1;
            nextBtn.disabled = state.page >= totalPages;
            visibleCount.textContent = filtered.length === rows.length
                ? (filtered.length + ' rows')
                : (filtered.length + ' of ' + rows.length + ' rows');

            // Update sort-arrow indicators on the header cells.
            var ths = document.querySelectorAll('#reconcileTable th.sortable');
            for (var k = 0; k < ths.length; k++) {
                var ind = ths[k].querySelector('.sort-indicator');
                if (!ind) continue;
                if (ths[k].getAttribute('data-sort-col') === state.sortCol) {
                    ind.textContent = state.sortDir === 'asc' ? ' ▲' : ' ▼';
                    ind.style.opacity = '0.9';
                } else {
                    ind.textContent = '';
                }
            }
        }

        if (searchInput) {
            searchInput.addEventListener('input', function (e) {
                state.query = e.target.value || '';
                applyFilter();
                applySort();
                render();
            });
        }

        prevBtn.addEventListener('click', function () {
            if (state.page > 1) { state.page--; render(); }
        });
        nextBtn.addEventListener('click', function () {
            state.page++; render();
        });

        var ths = document.querySelectorAll('#reconcileTable th.sortable');
        for (var i = 0; i < ths.length; i++) {
            (function (th) {
                th.addEventListener('click', function () {
                    var col = th.getAttribute('data-sort-col');
                    if (state.sortCol === col) {
                        state.sortDir = (state.sortDir === 'asc') ? 'desc' : 'asc';
                    } else {
                        state.sortCol = col;
                        state.sortDir = 'asc';
                    }
                    applySort();
                    state.page = 1;
                    render();
                });
            })(ths[i]);
        }

        // Initial render: no sort yet, no filter, page 1.
        applyFilter();
        render();
    })();
    </script>

    <div class="card fade d3">
        <div class="card-head">
            <div class="card-title">Legend</div>
        </div>
        <div style="padding:12px 16px;font-size:13px;color:var(--fg-muted,#aaa)">
            <div><span style="color:#4ade80">✓</span> Linked and DKP matches the sheet — already in sync.</div>
            <div><span style="color:#fbbf24">●</span> Auto-match by character name or alt — click <strong>Confirm</strong> to apply.</div>
            <div>No icon: unmatched. Pick a Discord user from the dropdown and click <strong>Confirm</strong>.</div>
        </div>
    </div>

    @if (Model.DiscordUsersWithoutSheetRow.Count > 0)
    {
        <div class="card fade d4">
            <div class="card-head">
                <div class="card-title">Discord users not on the sheet <span class="tag">@Model.DiscordUsersWithoutSheetRow.Count</span></div>
            </div>
            <div style="padding:0 0 8px 0">
                <table style="width:100%;border-collapse:collapse;font-size:13px">
                    <thead>
                        <tr>
                            <th style="text-align:left;padding:8px 12px">Discord user</th>
                            <th style="text-align:left;padding:8px 12px">Profile character</th>
                            <th style="text-align:left;padding:8px 12px">Alts</th>
                            <th style="text-align:left;padding:8px 12px">Rank</th>
                            <th style="text-align:right;padding:8px 12px">DKP in app</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var u in Model.DiscordUsersWithoutSheetRow)
                    {
                        <tr style="border-top:1px solid var(--border,#222)">
                            <td style="padding:8px 12px"><strong>@u.DisplayName</strong></td>
                            <td style="padding:8px 12px">@u.CharacterName</td>
                            <td style="padding:8px 12px">
                                @(string.Join(", ", new[] { u.AltCharacterName1, u.AltCharacterName2 }.Where(a => !string.IsNullOrWhiteSpace(a))))
                            </td>
                            <td style="padding:8px 12px">@u.Rank</td>
                            <td style="padding:8px 12px;text-align:right">@u.LinkshellDkp.ToString("0.##")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div style="padding:8px 16px;color:var(--fg-muted,#888);font-size:12px">
                These Discord users are in your linkshell but their profile character names (or alts) don't appear in the sheet. Add them to the sheet manually in Google Sheets if needed, then refresh this page.
            </div>
        </div>
    }
}

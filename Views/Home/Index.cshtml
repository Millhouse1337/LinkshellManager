@{
    ViewData["Title"] = "LinkshellManager";
    Layout = "_Layout";
}

@* Page-scoped: the framed gold masthead below is only on this page. (@@ is a literal @ in Razor.) *@
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@@500;600;700&display=swap');

    .linkshell-banner {
        width: 100%;
        min-height: 210px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 14px;
        background: radial-gradient(circle at center,
                rgba(39, 48, 75, 0.55) 0%,
                rgba(14, 19, 31, 0.9) 45%,
                #080a0e 100%);
        box-sizing: border-box;
    }

    /* ---- Main frame ---- */
    .banner-inner {
        position: relative;
        width: 100%;
        min-height: 175px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border: 1px solid rgba(176, 126, 36, 0.65);
        background: radial-gradient(ellipse at center, rgba(46, 54, 82, 0.26), transparent 60%),
                    linear-gradient(180deg, rgba(15, 20, 31, 0.95), rgba(5, 8, 13, 0.98));
        box-shadow: inset 0 0 30px rgba(0, 0, 0, 0.9),
                    inset 0 0 4px rgba(255, 190, 65, 0.15),
                    0 8px 25px rgba(0, 0, 0, 0.65);
    }

    /* Second inner gold frame. */
    .banner-inner::before {
        content: "";
        position: absolute;
        inset: 7px;
        pointer-events: none;
        border-top: 1px solid rgba(215, 157, 54, 0.38);
        border-bottom: 1px solid rgba(215, 157, 54, 0.38);
    }

    /* Subtle centre glow. */
    .banner-inner::after {
        content: "";
        position: absolute;
        width: 520px;
        height: 180px;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        background: radial-gradient(ellipse, rgba(84, 99, 145, 0.18), transparent 68%);
        filter: blur(10px);
        pointer-events: none;
    }

    .banner-content {
        position: relative;
        z-index: 5;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 90%;
    }

    /* ---- Title ---- */
    .banner-content h1 {
        margin: 0;
        font-family: "Cinzel", Georgia, serif;
        font-size: clamp(38px, 5vw, 78px);
        font-weight: 600;
        letter-spacing: 2px;
        color: #e8b64f;
        text-align: center;
        /* Metallic gold painted through the glyphs. */
        background: linear-gradient(to bottom,
                #fff0a2 0%, #ffd66b 15%, #b97916 42%,
                #fff0a0 57%, #e8ae36 72%, #84510d 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        /* Gold edge / depth. */
        filter: drop-shadow(0 1px 0 #fff2a6)
                drop-shadow(0 2px 0 #8c520d)
                drop-shadow(0 5px 5px rgba(0, 0, 0, 0.9))
                drop-shadow(0 0 12px rgba(232, 174, 55, 0.25));
        text-shadow: 0 1px 0 rgba(255, 232, 151, 0.35),
                     0 4px 7px rgba(0, 0, 0, 0.95);
    }

    /* ---- Decorative divider ---- */
    .title-divider {
        width: min(780px, 80%);
        margin-top: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .divider-line {
        height: 1px;
        flex: 1;
        background: linear-gradient(to right, transparent, #8d5a15 15%, #e4ad3e 45%, #ffd76e 100%);
        box-shadow: 0 0 5px rgba(230, 171, 57, 0.25);
    }

    .divider-line:last-child { transform: scaleX(-1); }

    .divider-center {
        position: relative;
        width: 86px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Horizontal curved decoration. */
    .divider-center::before,
    .divider-center::after {
        content: "";
        position: absolute;
        top: 50%;
        width: 35px;
        height: 12px;
        border-top: 2px solid #d39b30;
    }

    .divider-center::before {
        left: 1px;
        border-radius: 90% 0 0 0;
        transform: rotate(8deg);
    }

    .divider-center::after {
        right: 1px;
        border-radius: 0 90% 0 0;
        transform: rotate(-8deg);
    }

    /* Glowing centre diamond. */
    .divider-diamond {
        position: relative;
        width: 12px;
        height: 12px;
        transform: rotate(45deg);
        background: linear-gradient(135deg, #fff4af, #e4a72f, #9c6210);
        box-shadow: 0 0 5px #ffe28b,
                    0 0 14px rgba(255, 196, 70, 0.9),
                    0 0 28px rgba(255, 169, 39, 0.4);
    }

    /* Vertical point. */
    .divider-diamond::after {
        content: "";
        position: absolute;
        width: 5px;
        height: 30px;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%) rotate(-45deg);
        background: linear-gradient(to bottom, transparent, #e7ad3d, transparent);
    }

    /* ---- Corner ornaments ---- */
    .corner {
        position: absolute;
        width: 60px;
        height: 60px;
        z-index: 2;
        opacity: 0.8;
    }

    .corner::before,
    .corner::after {
        content: "";
        position: absolute;
        background: linear-gradient(90deg, #70430c, #d79c30, #70430c);
    }

    .corner::before { width: 50px; height: 2px; }
    .corner::after { width: 2px; height: 50px; }

    .corner-top-left { top: 10px; left: 10px; }
    .corner-top-left::before,
    .corner-top-left::after { top: 0; left: 0; }

    .corner-top-right { top: 10px; right: 10px; transform: scaleX(-1); }
    .corner-top-right::before,
    .corner-top-right::after { top: 0; left: 0; }

    .corner-bottom-left { bottom: 10px; left: 10px; transform: scaleY(-1); }
    .corner-bottom-left::before,
    .corner-bottom-left::after { top: 0; left: 0; }

    .corner-bottom-right { bottom: 10px; right: 10px; transform: scale(-1); }
    .corner-bottom-right::before,
    .corner-bottom-right::after { top: 0; left: 0; }

    /* ---- Mobile ---- */
    @@media (max-width: 700px) {
        .linkshell-banner { min-height: 150px; padding: 8px; }
        .banner-inner { min-height: 135px; }
        .banner-content h1 { font-size: 34px; letter-spacing: 1px; }
        .title-divider { width: 75%; margin-top: 12px; }
        .corner { width: 35px; height: 35px; }
        .corner::before { width: 30px; }
        .corner::after { height: 30px; }
    }
</style>

@* align-items:flex-start, not center: this page is taller than the viewport, and centering it
   parked the wordmark a few hundred pixels down with dead space above it. Top-aligned, the name
   is the first thing on the page. min-height is kept so a short viewport still fills. *@
<div class="auth-shell" style="display:flex;align-items:flex-start;justify-content:center;min-height:calc(100vh - 40px);padding:32px 16px">
    <div style="max-width:960px;width:100%">
        @* The wordmark leads the page — set as TEXT inside a drawn frame, not as art, so it stays
           crisp at any width. The gold is painted through the glyphs (background-clip:text +
           transparent fill) with the depth carried by filter: drop-shadow() rather than a
           text-shadow, which would show through the transparent letterforms and muddy them;
           `color` is set first so a browser without background-clip:text still renders gold.

           Cinzel comes from Google Fonts (the only CDN asset the site loads — the CSP in
           Program.cs allows fonts.googleapis.com / fonts.gstatic.com for exactly this). Georgia
           and the generic serif behind it keep the classical look if it never arrives. *@
        @* Deliberately a wide gap below (not the 24px the cards use): the wordmark is the page's
           masthead, and letting the artwork crowd it made the two read as one stacked band. *@
        <div class="linkshell-banner fade d1" style="margin:0 0 64px">
            <div class="banner-inner">

                <span class="corner corner-top-left"></span>
                <span class="corner corner-top-right"></span>
                <span class="corner corner-bottom-left"></span>
                <span class="corner corner-bottom-right"></span>

                <div class="banner-content">
                    <h1>Linkshell Manager</h1>

                    <div class="title-divider">
                        <span class="divider-line"></span>

                        <span class="divider-center">
                            <span class="divider-diamond"></span>
                        </span>

                        <span class="divider-line"></span>
                    </div>
                </div>

            </div>
        </div>

        @* Decorative: the wordmark above already carries the name, so this one is alt="" rather
           than announcing "LinkshellManager" a second time to a screen reader. *@
        <div class="card fade d1" style="padding:0;margin-bottom:24px;overflow:hidden;line-height:0">
            <img src="~/images/LSM_Image.png" asp-append-version="true" alt=""
                 style="display:block;width:100%;height:auto" />
        </div>

        <div class="card fade d1" style="padding:40px;margin-bottom:24px">
            <div>
                <div>
                    <div style="font-size:11px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:var(--accent);margin-bottom:10px">LinkshellManager</div>
                    <h1 style="font-size:36px;font-weight:600;color:var(--fg);line-height:1.15;margin:0 0 14px">Website and Discord Activity, on the same app.</h1>
                    @* No max-width here on purpose — this line is meant to run the full width of the
                       card as a single line at desktop size. A measure cap put it on two. *@
                    <p style="font-size:15px;color:var(--fg-3);margin:0 0 24px">
                        Use Discord as the login for both the website and the Discord Activity, so the same
                        account and data follow you in both places.
                    </p>
                    <div style="display:flex;flex-wrap:wrap;gap:8px">
                        <a class="btn primary" asp-controller="Account" asp-action="Login">Discord Activity Experience</a>
                        <a class="btn ghost" asp-controller="Dashboard" asp-action="Index">Website Experience</a>
                        @if (ViewData["ShowLauncherDownload"] as bool? ?? false)
                        {
                            <a class="btn ghost" asp-controller="Launcher" asp-action="Download">Download Launcher</a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="grid fade d2" style="grid-template-columns:repeat(3,1fr)">
            <div class="card" style="padding:20px">
                <div style="font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--fg-3);margin-bottom:8px">Website</div>
                <h2 style="font-size:16px;font-weight:600;color:var(--fg);margin:0 0 8px">Full management surface</h2>
                <p style="font-size:13px;color:var(--fg-3);margin:0">
                    Sign in with Discord, manage linkshells, create events, review history, and configure your account.
                </p>
            </div>
            <div class="card" style="padding:20px">
                <div style="font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--fg-3);margin-bottom:8px">Discord Activity</div>
                <h2 style="font-size:16px;font-weight:600;color:var(--fg);margin:0 0 8px">Run app inside Discord</h2>
                <p style="font-size:13px;color:var(--fg-3);margin:0">
                    Launch from inside a voice channel, nothing to install and no separate login.
                </p>
            </div>
            <div class="card" style="padding:20px">
                <div style="font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--fg-3);margin-bottom:8px">Attendance addon</div>
                <h2 style="font-size:16px;font-weight:600;color:var(--fg);margin:0 0 8px">Game-side attendance capture</h2>
                <p style="font-size:13px;color:var(--fg-3);margin:0">
                    Pair the addon with your account to record attendance from in-game sessions and keep event history aligned with your linkshell.
                </p>
            </div>
        </div>
    </div>
</div>

@model SettingsViewModel
@{
    ViewData["Title"] = "Settings";
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Settings</h1>
        <div class="page-sub"><span>Server-wide controls</span></div>
    </div>
    <div class="page-actions">
        <a class="btn ghost" asp-controller="Dashboard" asp-action="Index">Back to dashboard</a>
    </div>
</div>

@* The active linkshell is switched from the sidebar, so this page carries only the
   settings that apply to the whole server. *@
@if (!Model.IsSuperAdmin)
{
    <div class="card fade d2" style="padding:20px;max-width:720px">
        <div style="color:var(--fg-3);font-size:13px">
            There are no settings to change here. Switch your active linkshell from the picker
            at the top of the sidebar.
        </div>
    </div>
}

@if (Model.IsSuperAdmin)
{
    <div class="card fade d3" style="padding:20px;max-width:720px;margin-top:16px;border:1px solid var(--accent)">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
            <h2 class="card-title" style="margin:0">Addon (server-wide)</h2>
            <span class="tag accent">Super admin</span>
        </div>
        <div style="color:var(--fg-3);font-size:13px;margin-bottom:14px">
            Global kill-switch for the in-game addon. When disabled, <strong>every</strong>
            linkshell's addon stops working — existing tokens are rejected and no new
            pairing codes can be generated or redeemed — until you turn it back on.
        </div>

        @if (TempData["AddonKillSwitchMessage"] is string killSwitchMessage)
        {
            <div class="alert alert-info" style="margin:0 0 14px">@killSwitchMessage</div>
        }

        <div style="display:flex;align-items:center;gap:12px">
            @if (Model.AddonGloballyDisabled)
            {
                <span class="tag danger">Addon is DISABLED</span>
            }
            else
            {
                <span class="tag success">Addon is enabled</span>
            }

            <form asp-action="SetAddonKillSwitch" method="post" style="margin:0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="disabled" value="@((!Model.AddonGloballyDisabled).ToString().ToLowerInvariant())" />
                @if (Model.AddonGloballyDisabled)
                {
                    <button type="submit" class="btn primary">Re-enable addon</button>
                }
                else
                {
                    <button type="submit" class="btn danger">Disable addon globally</button>
                }
            </form>
        </div>
    </div>

    <div class="card fade d3" style="padding:20px;max-width:720px;margin-top:16px;border:1px solid var(--accent)">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
            <h2 class="card-title" style="margin:0">Claim Shield (server-wide)</h2>
            <span class="tag accent">Super admin</span>
        </div>
        <div style="color:var(--fg-3);font-size:13px;margin-bottom:14px">
            Master switch for the addon's claim-shield capture — the record of who tagged an HNM
            during a lottery. Disabling stops <strong>every</strong> linkshell's addon recording
            them; the addon itself keeps working. Individual monsters are switched on and off per
            linkshell under <strong>Monster setups</strong>, and those only apply while this is on.
        </div>

        @if (TempData["ClaimShieldKillSwitchMessage"] is string claimShieldMessage)
        {
            <div class="alert alert-info" style="margin:0 0 14px">@claimShieldMessage</div>
        }

        <div style="display:flex;align-items:center;gap:12px">
            @if (Model.ClaimShieldGloballyDisabled)
            {
                <span class="tag danger">Claim Shield is DISABLED</span>
            }
            else
            {
                <span class="tag success">Claim Shield is enabled</span>
            }

            <form asp-action="SetClaimShieldKillSwitch" method="post" style="margin:0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="disabled" value="@((!Model.ClaimShieldGloballyDisabled).ToString().ToLowerInvariant())" />
                @if (Model.ClaimShieldGloballyDisabled)
                {
                    <button type="submit" class="btn primary">Re-enable Claim Shield</button>
                }
                else
                {
                    <button type="submit" class="btn danger">Disable Claim Shield globally</button>
                }
            </form>
        </div>
    </div>

    <div class="card fade d4" style="padding:20px;max-width:720px;margin-top:16px;border:1px solid var(--accent)">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
            <h2 class="card-title" style="margin:0">Admin override (all linkshells)</h2>
            <span class="tag accent">Super admin</span>
        </div>
        <div style="color:var(--fg-3);font-size:13px;margin-bottom:14px">
            Grants you <strong>every</strong> permission in every linkshell you are a member of,
            on top of the rank that linkshell gave you — your rank is never changed, and this
            never reaches a linkshell you have not joined. While it is on, an
            <span class="tag accent">🔧 ADMIN</span> tag appears beside your rank on the roster.
            Turn it off to fall back to your normal rank permissions.
        </div>

        @if (TempData["AdminOverrideMessage"] is string adminOverrideMessage)
        {
            <div class="alert alert-info" style="margin:0 0 14px">@adminOverrideMessage</div>
        }

        <div style="display:flex;align-items:center;gap:12px">
            @if (Model.AdminOverrideEnabled)
            {
                <span class="tag success">Admin override is ON</span>
            }
            else
            {
                <span class="tag">Admin override is off</span>
            }

            <form asp-action="SetAdminOverride" method="post" style="margin:0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="enabled" value="@((!Model.AdminOverrideEnabled).ToString().ToLowerInvariant())" />
                @if (Model.AdminOverrideEnabled)
                {
                    <button type="submit" class="btn danger">Turn off admin override</button>
                }
                else
                {
                    <button type="submit" class="btn primary">Turn on admin override</button>
                }
            </form>
        </div>
    </div>
}

@using LinkshellManagerDiscordApp.Services
@model LinkshellManagerDiscordApp.ViewModels.ManageFinancesViewModel
@{
    ViewData["Title"] = TreasuryLabels.Title;
    ViewData["BodyClass"] = "lsm-page";
    var error = TempData["TreasuryError"] as string;
    // What a payout run recorded. Its own banner rather than the error one: "paid 550,000 gil to 2
    // members" is a confirmation, and a confirmation printed in red reads as a problem.
    var message = TempData["TreasuryMessage"] as string;
    // Chip labels and their query values. "In" and "out" mean the direction gil actually moved, not a
    // string match on a type column — matching a string is what used to hide entries under both chips.
    var filters = new[]
    {
        (Key: (string?)null, Label: "All"),
        (Key: (string?)"in", Label: TreasuryLabels.MoneyIn),
        (Key: (string?)"out", Label: TreasuryLabels.MoneyOut),
        (Key: (string?)"fixed", Label: TreasuryLabels.FixedChip),
        (Key: (string?)"reversed", Label: TreasuryLabels.ReversedChip),
    };
}

@* Gil first: it is the number people open this page for. The eyebrow says which half of Treasury
   this is, because the Items section further down carries the same one — the two read as sections
   of one page rather than as two pages that happen to be stacked. Same shape the Discord Activity's
   Treasury tab uses. *@
<div class="page-head fade d1">
    <div>
        <div class="page-eyebrow">@TreasuryLabels.Section</div>
        <h1 class="page-title">@TreasuryLabels.Title</h1>
        <div class="page-sub">
            @if (!string.IsNullOrWhiteSpace(Model.LinkshellName))
            {
                <span>@Model.LinkshellName</span>
                <span class="dot"> · </span>
            }
            @* BasisNote is NOT repeated here: the net-worth strip inside the balance sheet now says
               it, next to the figure it qualifies, and printing the same sentence twice a screen
               apart reads as two different claims. *@
            <span><span class="num">@Model.TotalEntries.ToString("N0")</span> entr@(Model.TotalEntries == 1 ? "y" : "ies")</span>
        </div>
    </div>
    @if (Model.CanManage)
    {
        <div class="page-actions">
            <a class="btn primary" asp-action="Record">@TreasuryLabels.RecordAction</a>
        </div>
    }
</div>


@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="card fade d1" style="padding:12px 16px;color:var(--danger)">@error</div>
}

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="card fade d1" style="padding:12px 16px;color:var(--green-main)">@message</div>
}

@* Card 1: the balance sheet. What we have on the left, what we owe on the right, the period's flow
   across the top, and what all of that leaves underneath both. A balance and a movement over a
   period are different kinds of number, so they sit in different bands of the card rather than in
   one column where the first invites being read as the second.

   The card IS the sheet: .balance-sheet re-dresses .card rather than nesting a second panel inside
   it, so there is one border and one background, not two. *@
<div class="card fade d2 balance-sheet">
    @* The header is the whole of what a collapsed card shows — the title, the status chips AND the
       flow figures — so all of it lives inside the <summary> and all of it is the hit target. A
       native <details> rather than script: this page is server-rendered and has no JS of its own.

       open: expanded is the default. Collapsing is there for someone who wants the flow figures
       alone, not the state the page opens in. *@
    <details class="lsm-balance" open>
        <summary class="lsm-balance__summary">
            <div class="balance-header">
                <div class="balance-title">
                    <span class="gil-emblem" aria-hidden="true">G</span>
                    <div>
                        <h2>@TreasuryLabels.BalanceCard</h2>
                        <div class="balance-status">
                            @if (Model.Balances)
                            {
                                <span class="tag success">@TreasuryLabels.BooksBalance</span>
                            }
                            else
                            {
                                <span class="tag" style="color:var(--danger)">@TreasuryLabels.DoesNotBalance</span>
                            }
                            @if (Model.LockedThrough.HasValue)
                            {
                                <span class="tag">Locked through @Model.LockedThrough.Value.ToString("MMM d, yyyy")</span>
                            }
                        </div>
                    </div>
                    <span class="lsm-balance__chev" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
                    </span>
                </div>

                @* What moved, in and out. The card's headline, so it reads at the top in both states. *@
                <div class="summary-cards">
                    <div class="summary-card income">
                        <span class="summary-label">@TreasuryLabels.MoneyIn</span>
                        <strong class="num">@Model.MoneyIn.ToString("N0")</strong>
                    </div>
                    <div class="summary-card expense">
                        <span class="summary-label">@TreasuryLabels.MoneyOut</span>
                        <strong class="num">@Model.MoneyOut.ToString("N0")</strong>
                    </div>
                    <div class="summary-card change">
                        <span class="summary-label">@TreasuryLabels.NetChange</span>
                        <strong class="num">@Model.NetChange.ToString("N0")</strong>
                    </div>
                </div>
            </div>
        </summary>

        @* Have on the left, owe on the right — the two sides read against each other rather than as
           one long column where the second heading is below the fold.

           Every line shows, including zeros: a subtotal over conditionally-hidden components does not
           add up on screen, and a liability that disappears at zero reads as "there is no such thing"
           rather than "there is none right now". *@
        <div class="balance-grid">
            <section class="balance-panel">
                <div class="panel-heading">
                    <span class="panel-icon" aria-hidden="true">▣</span>
                    <h3>@TreasuryLabels.WhatWeHave</h3>
                </div>

                @* The exact shape of the panel opposite: the figure, the names behind it, and the
                   tick-and-record panel that settles them. Gil on hand is NOT here — it is not owed
                   by anybody, it has no names behind it, and it lives on the bottom line with the
                   arithmetic it feeds. *@
                <div class="owe-summary">
                    <span>@TreasuryLabels.OwedToUs</span>
                    <strong class="num">@Model.OwedToUs.ToString("N0")</strong>
                </div>

                @if (Model.OwedToUsBy.Count > 0)
                {
                    @* Who owes it, and the tick-and-record panel that clears it. The mirror of the
                       panel on the other side, from the same partial: clearing an owed-to-us debt is
                       a tick, never a typed entry, which is why the Record form offers no option for
                       it at all. *@
                    <partial name="_SettlePanel" model="Model.CollectPanel" />
                }

                <div class="panel-total">
                    <span>@TreasuryLabels.TotalOwedToUs</span>
                    <strong class="num">@Model.OwedToUs.ToString("N0")</strong>
                </div>
            </section>

            <section class="balance-panel">
                <div class="panel-heading">
                    <span class="panel-icon" aria-hidden="true">⚖</span>
                    <h3>@TreasuryLabels.WhatWeOweSection</h3>
                </div>

                <div class="owe-summary">
                    <span>@TreasuryLabels.OwedToMembers</span>
                    <strong class="num">@Model.WeOwe.ToString("N0")</strong>
                </div>

                @if (Model.OwedToMembers.Count > 0)
                {
                    @* Names AND the tick-to-pay panel. Its own partial because it grew a form, and a
                       form has no business being spelled out inside a column of figures — and
                       because the other half of the sheet now renders the same one. *@
                    <partial name="_SettlePanel" model="Model.PayPanel" />
                }

                <div class="panel-total">
                    <span>@TreasuryLabels.TotalLiabilities</span>
                    <strong class="num">@Model.WeOwe.ToString("N0")</strong>
                </div>
            </section>
        </div>

        @* The bottom line of the sheet, so it belongs to the sheet: inside the disclosure with the
           two columns that produce it, not stranded under a collapsed card.

           Gil on hand sits here rather than in the panel above, because it is the one figure the two
           panels do NOT explain: they are lists of names, and gil on hand is owed by nobody. Here it
           is beside the two columns it is added to and subtracted from, which is the only place the
           bottom line's arithmetic can be read off the screen —
           gil on hand + total owed to us − total liabilities = what we're worth. *@
        <div class="net-worth-panel">
            <div class="net-worth-info">
                <span class="net-worth-icon" aria-hidden="true">⚖</span>
                <div>
                    <h3>@TreasuryLabels.NetWorth</h3>
                    <p>@TreasuryLabels.BasisNote</p>
                </div>
            </div>
            @* Gil on hand is the only figure on this sheet with somewhere to go, so it is the only
               one that is a BUTTON. The two panels above are already lists of names; this was the
               figure with nothing behind it, and a linkshell's gil is not in a vault — it is spread
               across members' mules, and "who actually has it" was answered from memory or from
               Discord scrollback.

               A <details> rather than script: the sheet around it is already one, the page works
               without JavaScript, and the chevron rotates on [open] in CSS. The whole affordance is
               the chevron plus the hint under it — a figure that is also a button looks exactly like
               a figure that is not, and nobody clicks a number on a balance sheet on the off-chance. *@
            <details class="net-worth-holders">
                <summary class="net-worth-cash net-worth-cash--open">
                    <span class="row-icon gold" aria-hidden="true">G</span>
                    <span class="net-worth-cash__label">@TreasuryLabels.CashOnHand</span>
                    <strong class="num">@Model.CashOnHand.ToString("N0")</strong>
                    <span class="net-worth-chev" aria-hidden="true">▾</span>
                </summary>
                <div class="holders-panel">
                    <div class="holders-panel__head">
                        <span>@TreasuryLabels.GilHoldersTitle</span>
                        <span class="holders-panel__total num">@Model.CashOnHand.ToString("N0")</span>
                    </div>
                    @if (Model.GilHolders.Count > 0)
                    {
                        <ul class="holders-list">
                            @foreach (var holder in Model.GilHolders)
                            {
                                <li class="holders-row @(holder.IsUnnamed ? "is-unnamed" : "")">
                                    <span class="holders-row__name">@holder.CharacterName</span>
                                    @* The share of the biggest row, so a line reads as "most of it"
                                       or "a sliver" without anyone dividing two seven-digit numbers
                                       in their head. *@
                                    <span class="holders-row__bar" aria-hidden="true">
                                        <span class="holders-row__fill" style="width:@holder.SharePercent%"></span>
                                    </span>
                                    <span class="holders-row__amount num">@holder.Amount.ToString("N0")</span>
                                </li>
                            }
                        </ul>
                        <p class="holders-panel__note">
                            Recorded on each transaction as the gil moves — these add up to gil on hand.
                        </p>
                    }
                    else
                    {
                        <p class="holders-panel__note">@TreasuryLabels.GilHoldersEmpty</p>
                    }
                </div>
            </details>
            @* The answer, styled as the twin of gil on hand beside it: they are the two figures the
               bottom line is made of and they read together. Only the medallion tells them apart. *@
            <div class="net-worth-value">
                <span class="row-icon crystal" aria-hidden="true">◆</span>
                <span class="net-worth-value__label">@TreasuryLabels.NetWorthFigure</span>
                <strong class="num">@Model.NetWorth.ToString("N0")</strong>
            </div>
            @* Under the chip it points at, not under the heading on the far side of the band. It is
               what makes the figure look clickable at all. *@
            <p class="net-worth-hint">@TreasuryLabels.GilHoldersHint</p>
        </div>
    </details>
</div>

@* Treasury > Items. Rendered by a component rather than spelled out here, because items answer to
   their own permission rule and their own table — see TreasuryItemsViewComponent. It lands between
   the balance sheet and the transactions list: selling an item is what moves the figures above it,
   and the list below runs long enough to bury anything placed under it. *@
<div id="items">
    @await Component.InvokeAsync("TreasuryItems", new { view = Model.ItemView })
</div>

@* margin-top so this card does not sit flush against the section above — .card carries no margin of
   its own, so stacked cards need the gap stated here. *@
<div class="card fade d4" style="margin-top:16px">
    <div class="card-head">
        <div class="card-title">@TreasuryLabels.TransactionsCard</div>
    </div>

    <form asp-action="Index" method="get"
          style="display:flex;gap:8px;flex-wrap:wrap;padding:12px 16px;border-bottom:1px solid var(--border)">
        <input type="search" name="search" value="@Model.Search" class="form-control" style="max-width:280px"
               placeholder="Search entry #, note, category, member…" />
        <input type="hidden" name="filter" value="@Model.Filter" />
        <button type="submit" class="btn ghost sm">Search</button>
        <span style="flex:1"></span>
        @foreach (var chip in filters)
        {
            var active = string.Equals(Model.Filter ?? "", chip.Key ?? "", StringComparison.OrdinalIgnoreCase);
            <a class="btn sm @(active ? "primary" : "ghost")"
               asp-action="Index" asp-route-filter="@chip.Key" asp-route-search="@Model.Search">@chip.Label</a>
        }
    </form>

    @if (Model.Entries.Count == 0)
    {
        <div class="empty">
            <div style="font-size:15px;color:var(--fg);font-weight:500;margin-bottom:6px">
                @(Model.TotalEntries == 0 ? "Nothing recorded yet" : TreasuryLabels.EmptySearch)
            </div>
            @if (Model.TotalEntries == 0 && Model.CanManage)
            {
                <div style="margin-bottom:12px">@TreasuryLabels.EmptyState</div>
                <a class="btn primary" asp-action="Record">@TreasuryLabels.RecordAction</a>
            }
        </div>
    }
    else
    {
        <table class="table themed">
            <thead>
                <tr>
                    <th>@TreasuryLabels.Date</th>
                    <th>@TreasuryLabels.EntryNumberField</th>
                    <th>@TreasuryLabels.WhatHappened</th>
                    <th>@TreasuryLabels.ReasonField</th>
                    <th>@TreasuryLabels.Member</th>
                    <th>@TreasuryLabels.EnteredBy</th>
                    <th style="text-align:right">@TreasuryLabels.Amount</th>
                    @if (Model.CanManage)
                    {
                        <th style="text-align:right">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.Entries)
                {
                    <tr>
                        <td style="font-size:12px;color:var(--fg-3)">@entry.TransactionDate.ToString("MMM d, yyyy")</td>
                        <td class="num" style="font-size:12px;color:var(--fg-3)">@TreasuryLabels.EntryReference(entry.EntryNumber)</td>
                        <td>
                            <span>@entry.WhatHappened</span>
                            @if (entry.IsDraft)
                            {
                                <span class="tag">@TreasuryLabels.DraftChip</span>
                            }
                            @* Fixed beats Reversed: both are true of an entry someone corrected, and
                               "Reversed" alone reads as "called off" when the numbers were merely
                               wrong. The chips split the same way, so the word here and the chip
                               that finds it always agree. *@
                            @if (entry.IsFixed)
                            {
                                <span class="tag warning">@TreasuryLabels.FixedChip</span>
                            }
                            else if (entry.IsReversed)
                            {
                                <span class="tag warning">@TreasuryLabels.ReversedChip</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(entry.ReversesEntryNumber))
                            {
                                var replaced = entry.Kind == JournalEntryKinds.Correction;
                                <span class="tag">
                                    @(replaced ? "Fixes" : "Reverses") @TreasuryLabels.EntryReference(entry.ReversesEntryNumber)
                                </span>
                            }
                            @* The two halves, for the one officer who wants to see them. Collapsed by
                               default: nobody logging a Kirin's Osode sale needs to know. *@
                            <details style="margin-top:4px">
                                <summary style="font-size:11px;color:var(--fg-4);cursor:pointer">@(entry.Recipients.Count > 1 ? TreasuryLabels.ShowSplitDetails : TreasuryLabels.ShowDetails)</summary>
                                <div style="font-size:11px;color:var(--fg-3);margin-top:4px">
                                    @foreach (var half in entry.Halves)
                                    {
                                        <div>
                                            @half.CategoryName
                                            @* A split writes one line per member on the SAME category,
                                               so the name is the only thing telling them apart. *@
                                            @if (!string.IsNullOrWhiteSpace(half.Member))
                                            {
                                                <span class="lsm-half__member">@half.Member</span>
                                            }
                                            <span class="num">@(half.Amount >= 0 ? "+" : "")@half.Amount.ToString("N0")</span>
                                            <span style="color:var(--fg-4)">(@half.ClassLabel)</span>
                                        </div>
                                    }
                                </div>
                            </details>
                        </td>
                        <td style="color:var(--fg-3)">
                            @(entry.Memo ?? "")
                            @if (!string.IsNullOrWhiteSpace(entry.CorrectionReason))
                            {
                                <div style="font-size:11px;color:var(--fg-4)">@entry.CorrectionReason</div>
                            }
                        </td>
                        @* A split names everyone who got a share, kept to a line. *@
                        <td style="font-size:12px;color:var(--fg-3)"
                            title="@(entry.Recipients.Count > 1 ? string.Join(", ", entry.Recipients) : null)">
                            @if (entry.Recipients.Count > 3)
                            {
                                @($"{string.Join(", ", entry.Recipients.Take(3))} +{entry.Recipients.Count - 3} more")
                            }
                            else if (entry.Recipients.Count > 1)
                            {
                                @string.Join(", ", entry.Recipients)
                            }
                            else
                            {
                                @(entry.Member ?? "")
                            }
                            @* Whose mule the gil landed on, under the member it concerns. On a Gil Out
                               to a member the two ARE different people — the gil leaves the
                               treasurer's mule and arrives at theirs — so they cannot share a line. *@
                            @if (!string.IsNullOrWhiteSpace(entry.Holder))
                            {
                                <div style="font-size:11px;color:var(--fg-3)">
                                    @(entry.CashDelta < 0 ? "from" : "held by") @entry.Holder
                                </div>
                            }
                        </td>
                        <td style="font-size:12px;color:var(--fg-3)">@(entry.EnteredBy ?? "")</td>
                        @* A minus sign, not parentheses: a hobbyist reads "(5,820,000)" as a footnote
                           marker, not as gil leaving. *@
                        <td class="num" style="text-align:right;font-weight:500">
                            @if (entry.CashDelta == 0)
                            {
                                <span style="color:var(--fg-4)">@entry.Amount.ToString("N0")</span>
                            }
                            else
                            {
                                <span style="color:@(entry.CashDelta < 0 ? "var(--warning)" : "var(--success)")">
                                    @entry.CashDelta.ToString("N0")
                                </span>
                            }
                        </td>
                        @if (Model.CanManage)
                        {
                            <td style="text-align:right">
                                <div style="display:inline-flex;gap:6px;flex-wrap:wrap">
                                    @if (entry.IsDraft)
                                    {
                                        <a class="btn ghost sm" asp-action="EditDraft" asp-route-id="@entry.Id">@TreasuryLabels.EditDraftAction</a>
                                        <form asp-action="Confirm" asp-route-id="@entry.Id" method="post" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn ghost sm">@TreasuryLabels.ConfirmAction</button>
                                        </form>
                                        <form asp-action="Discard" asp-route-id="@entry.Id" method="post" style="display:inline"
                                              data-confirm="@TreasuryLabels.DiscardConfirm">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn ghost sm" style="color:var(--danger)">@TreasuryLabels.DiscardDraftAction</button>
                                        </form>
                                    }
                                    else if (!entry.IsReversed)
                                    {
                                        <a class="btn ghost sm" asp-action="Fix" asp-route-id="@entry.Id">@TreasuryLabels.FixAction</a>
                                        <form asp-action="Reverse" asp-route-id="@entry.Id" method="post" style="display:inline"
                                              data-confirm="@TreasuryLabels.ReverseConfirm">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn ghost sm" style="color:var(--danger)">@TreasuryLabels.ReverseAction</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.PageCount > 1)
        {
            <div style="display:flex;gap:8px;align-items:center;justify-content:center;padding:12px">
                @if (Model.Page > 0)
                {
                    <a class="btn ghost sm" asp-action="Index" asp-route-page="@(Model.Page - 1)"
                       asp-route-search="@Model.Search" asp-route-filter="@Model.Filter">‹ Prev</a>
                }
                <span style="font-size:12px;color:var(--fg-3)">Page @(Model.Page + 1) of @Model.PageCount</span>
                @if (Model.Page < Model.PageCount - 1)
                {
                    <a class="btn ghost sm" asp-action="Index" asp-route-page="@(Model.Page + 1)"
                       asp-route-search="@Model.Search" asp-route-filter="@Model.Filter">Next ›</a>
                }
            </div>
        }
    }
</div>

@section Scripts {
    <script nonce="@Html.CspNonce()">
        // Confirm text lives on the form as data-confirm so the wording stays in TreasuryLabels rather
        // than being duplicated inline per button.
        document.querySelectorAll('form[data-confirm]').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!window.confirm(form.getAttribute('data-confirm'))) { event.preventDefault(); }
            });
        });


        // The running total under each tick-and-record panel. BOTH halves of the sheet have one now —
        // paying members off on the right, recording gil arriving on the left — so this wires up
        // every .lsm-settle form rather than the first one it finds.
        //
        // Progressive: with no script the ticks and the button still post and the server still
        // settles exactly the ticked rows. This only says what is about to happen before it happens,
        // which is the whole reason ticking does not settle on the spot.
        document.querySelectorAll('form.lsm-settle').forEach(function (form) {
            var ticks = form.querySelectorAll('.lsm-settle__tick');
            var hint = form.querySelector('.lsm-settle__hint');
            var submit = form.querySelector('button[type="submit"]');
            var restingHint = hint ? hint.textContent : '';

            // Empty on the collecting panel: gil arriving cannot overdraw anything, so there is no
            // shortfall to warn about and no figure to measure one against.
            var cashAttr = form.getAttribute('data-cash');
            var checksShortfall = cashAttr !== null && cashAttr !== '';
            var cashOnHand = Number(cashAttr || 0);

            function update() {
                var picked = 0;
                var total = 0;
                ticks.forEach(function (tick) {
                    if (!tick.checked) { return; }
                    picked += 1;
                    total += Number(tick.getAttribute('data-amount') || 0);
                });

                if (submit) { submit.disabled = picked === 0; }
                if (!hint) { return; }

                if (picked === 0) {
                    hint.textContent = restingHint;
                    hint.classList.remove('is-short');
                    return;
                }

                var sentence = picked + (picked === 1 ? ' name · ' : ' names · ')
                    + total.toLocaleString() + ' gil';
                // Said, not blocked: the Record form has never refused a payout for want of gil on
                // hand, and a rule only one surface enforced would be worse than no rule.
                var short = checksShortfall && total > cashOnHand;
                hint.textContent = short
                    ? sentence + ' — ' + form.getAttribute('data-shortfall')
                    : sentence;
                hint.classList.toggle('is-short', short);
            }

            ticks.forEach(function (tick) { tick.addEventListener('change', update); });
            update();
        });
    </script>
}

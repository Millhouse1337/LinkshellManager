@using Microsoft.AspNetCore.Identity
@using LinkshellManagerDiscordApp.Data
@using Microsoft.EntityFrameworkCore
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject ApplicationDbContext DbContext
@inject LinkshellManagerDiscordApp.Services.AdminOverrideService AdminOverride
@inject LinkshellManagerDiscordApp.Services.GlobalSettingsService GlobalSettings

@{
    var isSignedIn = SignInManager.IsSignedIn(User);
    AppUser? currentUser = isSignedIn ? await UserManager.GetUserAsync(User) : null;
    if (isSignedIn && currentUser is null)
    {
        // Auth cookie present but the backing user can no longer be resolved (deleted or stale claim).
        // Bounce to login rather than rendering an unstyled, navless shell.
        Context.Response.Redirect("/Identity/Account/Login?expired=1");
        return;
    }
    var pageTitle = ViewData["Title"]?.ToString() ?? "Dashboard";
    var profileImage = currentUser?.ProfileImage is { Length: > 0 }
        ? $"data:image/png;base64,{Convert.ToBase64String(currentUser.ProfileImage)}"
        : null;

    string? activeLinkshellName = null;
    string? activeLinkshellInitials = null;
    string? activeRole = null;
    LinkshellManagerDiscordApp.Models.LinkshellRole? activePermissions = null;
    // True when the app-wide admin override is on AND this account carries it. Account-
    // level, not per-linkshell: it applies to EVERY linkshell the user is a member of,
    // so the sidebar's switcher (which lists only memberships) badges every row. What it
    // must NOT do is unlock a linkshell they have not joined — that stays gated on the
    // membership lookup below. See AdminOverrideService.
    bool isAppAdmin = currentUser is not null
        && await AdminOverride.IsActiveForAsync(currentUser, Context.RequestAborted);
    // The same override, narrowed to the ACTIVE linkshell (set only once membership
    // there is confirmed below), for the current-role line.
    bool isAppAdminHere = false;
    // Feature toggles that gate sidebar groups. Default true so a user with no
    // active linkshell still sees the nav (matches the sidebar's fail-open).
    bool activeEnableMissions = true;
    bool activeEnableEndgame = true;
    if (currentUser is not null && currentUser.PrimaryLinkshellId.HasValue)
    {
        var activeLinkshellId = currentUser.PrimaryLinkshellId.Value;
        var ls = await DbContext.Linkshells
            .AsNoTracking()
            .FirstOrDefaultAsync(l => l.Id == activeLinkshellId);
        if (ls is not null)
        {
            activeLinkshellName = ls.LinkshellName;
            activeEnableMissions = ls.EnableMissions;
            activeEnableEndgame = ls.EnableEndgame;
            activeLinkshellInitials = string.Concat(
                (ls.LinkshellName ?? "LS")
                    .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                    .Select(w => w[0]))
                .ToUpperInvariant();
            if (activeLinkshellInitials.Length > 2)
            {
                activeLinkshellInitials = activeLinkshellInitials[..2];
            }

            var membership = await DbContext.AppUserLinkshells
                .AsNoTracking()
                .FirstOrDefaultAsync(link =>
                    link.AppUserId == currentUser.Id &&
                    link.LinkshellId == activeLinkshellId);
            activeRole = membership?.Rank;

            // Resolve the LinkshellRole row whose Name matches the user's rank
            // so the sidenav can hide entries the user lacks permission to use.
            // Falls back to "Member" when the rank string doesn't resolve, which
            // matches the controllers' GetEffectiveRoleAsync behavior.
            var rankName = string.IsNullOrWhiteSpace(activeRole) ? "Member" : activeRole.Trim();
            activePermissions = await DbContext.LinkshellRoles
                .AsNoTracking()
                .FirstOrDefaultAsync(r => r.LinkshellId == activeLinkshellId && r.Name == rankName);
            if (activePermissions is null)
            {
                activePermissions = await DbContext.LinkshellRoles
                    .AsNoTracking()
                    .FirstOrDefaultAsync(r => r.LinkshellId == activeLinkshellId && r.Name == "Member");
            }

            // App-wide admin override: swap in a synthetic all-true role so the whole
            // sidebar unlocks. Gated on `membership is not null` so an admin viewing a
            // linkshell they have not joined gets no elevation. See AdminOverrideService.
            if (isAppAdmin && membership is not null)
            {
                activePermissions = LinkshellManagerDiscordApp.Services.LinkshellRoleDefaults
                    .BuildFullAccessRole(activeLinkshellId);
                isAppAdminHere = true;
            }
        }
    }

    // Two flags, because they answer different questions: "…Here" is the ACTIVE
    // linkshell (badge next to the current role line — false if the primary linkshell
    // points somewhere the user is no longer a member of), while "IsAppAdmin" is the
    // account (badge on every row of the switcher, which lists only memberships).
    ViewData["IsAppAdminHere"] = isAppAdminHere;
    ViewData["IsAppAdmin"] = isAppAdmin;

    // All of the signed-in user's memberships, for the sidebar linkshell
    // switcher (name + rank per linkshell).
    var userLinkshells = currentUser is not null
        ? await DbContext.AppUserLinkshells
            .AsNoTracking()
            .Include(link => link.Linkshell)
            .Where(link => link.AppUserId == currentUser.Id && link.Linkshell != null)
            .OrderBy(link => link.Linkshell!.LinkshellName)
            .ToListAsync()
        : new List<LinkshellManagerDiscordApp.Models.AppUserLinkshell>();

    ViewData["UserLinkshells"] = userLinkshells;
    ViewData["ActiveLinkshellId"] = currentUser?.PrimaryLinkshellId;
    ViewData["ActiveEnableMissions"] = activeEnableMissions;
    ViewData["ActiveEnableEndgame"] = activeEnableEndgame;
    ViewData["ActiveLinkshellName"] = activeLinkshellName;
    ViewData["ActiveLinkshellInitials"] = activeLinkshellInitials;
    ViewData["ActiveRole"] = activeRole;
    ViewData["ActivePermissions"] = activePermissions;
    // Read here rather than per-view so the sidebar link and the home page agree. Cheap:
    // GlobalSettingsService caches for 30s. Home/Index sets its own copy because a view
    // body runs before its layout, so it cannot see anything this block writes.
    ViewData["ShowLauncherDownload"] = await GlobalSettings.IsLauncherDownloadEnabledAsync(Context.RequestAborted);

    var displayName = currentUser?.CharacterName ?? currentUser?.UserName ?? "User";
    var avatarInitials = string.Concat(
            (displayName ?? "U")
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Select(w => w[0]))
            .ToUpperInvariant();
    if (string.IsNullOrEmpty(avatarInitials)) { avatarInitials = "U"; }
    if (avatarInitials.Length > 2) { avatarInitials = avatarInitials[..2]; }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle · LinkshellManager</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/lsm-theme.css" asp-append-version="true" />
    @* Create/Edit event form — a port of the Discord Activity's create-event modal.
       Namespaced under .cem / .mdta, so it applies only where those classes are used. *@
    <link rel="stylesheet" href="~/css/event-form.css" asp-append-version="true" />
</head>
<body>
    @if (isSignedIn && currentUser is not null)
    {
        <div class="app">
            <partial name="_Sidebar" />

            <div class="main">
                <div class="topbar">
                    <div class="crumbs">
                        @if (!string.IsNullOrWhiteSpace(activeLinkshellName))
                        {
                            <span>@activeLinkshellName</span>
                            <span class="sep">/</span>
                        }
                        <span class="here">@pageTitle</span>
                    </div>

                    <div class="topbar-clock" id="topbar-clock" aria-live="off"
                         data-clock-tz="@(currentUser?.TimeZone ?? string.Empty)">
                        <span class="topbar-clock__time" data-clock-time>--:--</span>
                        <span class="topbar-clock__zone" data-clock-zone></span>
                    </div>

                    <div class="topbar-actions">
                        <a class="avatar-btn" asp-controller="Account" asp-action="Profile" title="Profile">
                            @if (profileImage is not null)
                            {
                                <img class="avatar-img" src="@profileImage" alt="" />
                            }
                            else
                            {
                                <span class="avatar">@avatarInitials</span>
                            }
                            <span class="avatar-name">@displayName</span>
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                            <button type="submit" class="icon-btn" title="Sign out" aria-label="Sign out">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M15 4h4a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-4"/><path d="M10 17l-5-5 5-5"/><path d="M5 12h11"/></svg>
                            </button>
                        </form>
                    </div>
                </div>

                @* The lsm-theme is default-on for every page; a view opts OUT
                   by setting ViewData["BodyClass"] = "" (used by the few pages
                   with their own full-bleed bespoke styling). *@
                <div class="content @(ViewData["BodyClass"] as string ?? "lsm-page")">
                    @* "Claim your DKP" banner — populated by dkp-claim.js when an
                       imported placeholder matches this user's character name. *@
                    <div id="dkp-claim-mount"></div>
                    @RenderBody()
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="auth-shell">
            @RenderBody()
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/sidebar.js" asp-append-version="true"></script>
    @if (isSignedIn)
    {
        <script src="~/js/dkp-claim.js" asp-append-version="true"></script>
    }
    <partial name="_ValidationScriptsPartial" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

            Party Setups
            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M9 6l6 6-6 6"/></svg>
        </button>
        <div id="nav-party-setups" class="nav-sub">
            <a class="nav-sub-item @IsSubActive("PartySetup", "Index")" asp-controller="PartySetup" asp-action="Index">View Party Setups</a>
            @if (Allow(p => p.CanManageParties))
            {
                <a class="nav-sub-item create @IsSubActive("PartySetup", "Create")" asp-controller="PartySetup" asp-action="Create">Create Party Setup</a>
            }
        </div>

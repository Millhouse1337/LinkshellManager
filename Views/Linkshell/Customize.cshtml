<div class="card fade d2" id="discordChannelsCard" style="margin-bottom:16px">
    <div class="card-head">
        <div class="card-title">Discord channel routes</div>
    </div>
    <div style="padding:8px 16px 16px;display:flex;flex-direction:column;gap:12px;max-width:920px;margin:0 auto;width:100%">
        <div style="font-size:12px;color:var(--fg-3)">
            Select a channel for the bot to post to.
        </div>
        @if (string.IsNullOrWhiteSpace(Model.DiscordChannelGuildId))
        {
            <div style="font-size:12px;color:var(--fg-3)">
                Tip: set this linkshell's Discord server (above) so the bot can list your channels in a
                dropdown. You can still paste channel IDs manually.
            </div>
        }
        else if (Model.AvailableChannels.Count == 0)
        {
            <div style="font-size:12px;color:var(--fg-3)">
                Couldn't list channels automatically (make sure the LSM bot is in your server). Paste channel
                IDs manually — in Discord, with Developer Mode on, right-click a channel &rarr; Copy Channel ID.
            </div>
        }
        <form method="post" asp-action="SaveDiscordChannels" class="lsm-confirm-form"
              style="display:flex;flex-direction:column;gap:10px">
            @Html.AntiForgeryToken()
            <input type="hidden" name="linkshellId" value="@Model.LinkshellId" />
            <div id="routeRows" style="display:flex;flex-direction:column;gap:10px">
                @for (var i = 0; i < Model.ChannelRoutes.Count; i++)
                {
                    await RouteRow(i, Model.ChannelRoutes[i], false);
                }
            </div>
            <div style="display:flex;gap:10px;align-items:center;justify-content:flex-end">
                <button type="button" class="btn ghost sm" id="routeAdd">+ Add route</button>
                <button class="btn primary" type="submit">Save channels</button>
            </div>
        </form>
    </div>
</div>
@{
    // Group-colour name → theme token (web --*-main). Keys mirror DkpPoolAccents.All; the JS
    // map in the script below must stay in sync. Unknown / legacy keys fall back to blue.
    string SwatchColor(string? key) => (key ?? "").Trim().ToLowerInvariant() switch
    {
        "green" => "var(--green-main)",
        "red" => "var(--red-main)",
        "orange" => "var(--orange-main)",
        "gold" => "var(--gold-main)",
        "purple" => "var(--purple-main)",
        "cyan" => "var(--cyan-main)",
        "gray" => "var(--fg-3)",
        _ => "var(--blue-main)",
    };
    async Task PoolRow(int index, LinkshellManagerDiscordApp.ViewModels.DkpPoolInput pool)
    {
        <div class="dkp-pool-row@(pool.IsDefault ? " is-default" : "")"
             style="display:flex;align-items:center;gap:10px;padding:8px 10px;background:var(--surface-2);border-radius:8px">
            <input type="hidden" data-field="Id" name="dkpPools[@index].Id" value="@pool.Id" />
            @if (pool.IsDefault)
            {
                @* The default group is permanent: the catch-all every unassigned event type, plus
                   adjustments and imports, land in. It can't be renamed or removed, so the name is
                   read-only text with a hidden input to carry the value on save. *@
                <input type="hidden" data-field="Name" name="dkpPools[@index].Name" value="@pool.Name" />
                <div style="flex:1;min-width:0;display:flex;align-items:center;gap:8px"
                     title="The catch-all group: every event type you don't assign, plus adjustments and imports, land here. It can't be renamed or removed.">
                    <span style="font-size:13px">@pool.Name</span>
                </div>
            }
            else
            {
                <input type="text" data-field="Name" name="dkpPools[@index].Name" value="@pool.Name"
                       maxlength="64" placeholder="Enter a Group Name" style="flex:1;min-width:0"
                       title="What to call this group. Members see this name (e.g. Endgame, Sky/Sea)." />
            }
            <div style="flex:0 0 150px;display:flex;align-items:center;gap:8px"
                 title="A colour to tell this group apart at a glance.">
                <span data-accent-swatch
                      style="width:14px;height:14px;border-radius:4px;flex:0 0 auto;border:1px solid var(--border);background:@SwatchColor(pool.Accent)"></span>
                <select data-field="Accent" name="dkpPools[@index].Accent" style="flex:1;min-width:0">
                    @foreach (var accent in LinkshellManagerDiscordApp.Models.DkpPoolAccents.All)
                    {
                        <option value="@accent" selected="@(string.Equals(pool.Accent, accent, StringComparison.OrdinalIgnoreCase))">@accent</option>
                    }
                </select>
            </div>
            @if (pool.IsDefault)
            {
                @* No Remove for the default group. Keep the column width so rows stay aligned. *@
                <button type="button" class="btn ghost sm" style="flex:0 0 auto;visibility:hidden" tabindex="-1" aria-hidden="true">Remove</button>
            }
            else
            {
                <button type="button" class="btn ghost sm dkp-pool-remove" style="flex:0 0 auto" title="Remove this group">Remove</button>
            }
        </div>
    }
}
<div class="card fade d2" id="dkpPoolsCard" style="margin-bottom:16px">
    <div class="card-head">
        <div class="card-title">DKP grouping</div>
    </div>
    <div style="padding:8px 16px 16px;display:flex;flex-direction:column;gap:14px;max-width:920px;margin:0 auto;width:100%">
        <div style="font-size:12px;color:var(--fg-3)">
            Create a DKP Group. Customize what event categories are grouped together so that DKP
            earned and DKP spent can be separated based on event type.
        </div>
        <form method="post" asp-action="SaveDkpPools" class="lsm-confirm-form"
              style="display:flex;flex-direction:column;gap:14px">
            @Html.AntiForgeryToken()
            <input type="hidden" name="linkshellId" value="@Model.LinkshellId" />
            @* The default group is the first row and can't be moved or removed, so its index is
               fixed. Post it explicitly rather than leaning on the controller's parameter default. *@
            <input type="hidden" name="dkpPoolDefaultIndex" value="@Math.Max(0, Model.DkpPools.FindIndex(p => p.IsDefault))" />
            <div style="font-size:12px;color:var(--fg-3)">
                Every event type starts in the <em>Default</em> group, so all event DKP is pooled
                together until you create another group and move event types into it.
            </div>
            <div style="font-size:12px;font-weight:600;color:var(--fg-2);margin-top:4px">Groups</div>
            @* Column headers for the group rows below — aligned to the row's flex columns. *@
            <div style="display:flex;align-items:center;gap:10px;padding:0 10px;font-size:11px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--fg-4)">
                <div style="flex:1;min-width:0">Group Name</div>
                <div style="flex:0 0 150px">Group Color</div>
                <button type="button" class="btn ghost sm" style="flex:0 0 auto;visibility:hidden" tabindex="-1" aria-hidden="true">Remove</button>
            </div>
            <div id="dkpPoolRows" style="display:flex;flex-direction:column;gap:8px">
                @for (var i = 0; i < Model.DkpPools.Count; i++)
                {
                    await PoolRow(i, Model.DkpPools[i]);
                }
            </div>
            <div style="display:flex;gap:10px;align-items:center;justify-content:flex-end">
                <button type="button" class="btn ghost sm" id="dkpPoolAdd">+ Add New Group</button>
            </div>
            <div style="font-size:12px;font-weight:600;color:var(--fg-2);margin-top:4px">Event types</div>
            <div style="font-size:12px;color:var(--fg-3)">
                Anything left on <em>Default</em> earns into the Default group. That includes event
                types you haven't run yet, and any custom name typed into the event form's "Other"
                field.
            </div>
            <div style="display:flex;flex-direction:column;gap:6px">
                @for (var i = 0; i < Model.DkpPoolAssignments.Count; i++)
                {
                    var assignment = Model.DkpPoolAssignments[i];
                    <div class="dkp-assign-row"
                         style="display:flex;align-items:center;gap:10px;padding:6px 10px;background:var(--surface-2);border-radius:8px">
                        <input type="hidden" name="dkpPoolAssignments[@i].EventType" value="@assignment.EventType" />
                        <div style="flex:1;min-width:0;display:flex;align-items:center;gap:8px">
                            <span style="font-size:13px">@assignment.EventType</span>
                            @if (assignment.IsCustom)
                            {
                                <span class="tag" style="font-size:10px;font-weight:400">custom</span>
                            }
                            @if (assignment.EarnedTotal > 0)
                            {
                                <span style="font-size:11px;color:var(--fg-4)">@assignment.EarnedTotal.ToString("0.##") DKP earned</span>
                            }
                        </div>
                        <select name="dkpPoolAssignments[@i].PoolIndex" data-pool-select style="min-width:170px"
                                title="Which group this event type earns into — and pays its loot out of. Leave on Default to use the default group.">
                            <option value="-1" selected="@(assignment.PoolIndex < 0)">Default</option>
                            @for (var p = 0; p < Model.DkpPools.Count; p++)
                            {
                                @* The default group is the "Default" (-1) option above — never a numbered one. *@
                                @if (!Model.DkpPools[p].IsDefault)
                                {
                                    <option value="@p" selected="@(assignment.PoolIndex == p)">@Model.DkpPools[p].Name</option>
                                }
                            }
                        </select>
                    </div>
                }
            </div>
            <div style="display:flex;gap:10px;align-items:center;justify-content:flex-end">
                <button class="btn primary" type="submit">Save DKP grouping</button>
            </div>
        </form>
    </div>
</div>
<template id="dkpPoolRowTemplate">
    @{ await PoolRow(0, new LinkshellManagerDiscordApp.ViewModels.DkpPoolInput { Accent = LinkshellManagerDiscordApp.Models.DkpPoolAccents.Default }); }
</template>
<script nonce="@Html.CspNonce()">
    (function () {
        var rows = document.getElementById('dkpPoolRows');
        var addBtn = document.getElementById('dkpPoolAdd');
        var tpl = document.getElementById('dkpPoolRowTemplate');
        var card = document.getElementById('dkpPoolsCard');
        if (!rows || !addBtn || !tpl || !card) { return; }
        // Renumber every row's field names to its live DOM position. The default group is always
        // the first row and never moves (it can't be removed and new rows append after it), so its
        // index — and the dkpPoolDefaultIndex the controller reads — stays 0.
        function reindex() {
            var list = rows.querySelectorAll('.dkp-pool-row');
            for (var i = 0; i < list.length; i++) {
                list[i].querySelectorAll('[data-field]').forEach(function (el) {
                    el.setAttribute('name', 'dkpPools[' + i + '].' + el.getAttribute('data-field'));
                });
            }
            syncPoolOptions();
            syncSwatches();
        }
        // Colour name → theme token. Must mirror SwatchColor() in the Razor helper above.
        var SWATCH = {
            green: 'var(--green-main)', red: 'var(--red-main)', orange: 'var(--orange-main)',
            gold: 'var(--gold-main)', purple: 'var(--purple-main)', cyan: 'var(--cyan-main)',
            gray: 'var(--fg-3)'
        };
        function syncSwatches() {
            rows.querySelectorAll('.dkp-pool-row').forEach(function (row) {
                var sel = row.querySelector('[data-field="Accent"]');
                var swatch = row.querySelector('[data-accent-swatch]');
                if (sel && swatch) {
                    swatch.style.background = SWATCH[(sel.value || '').toLowerCase()] || 'var(--blue-main)';
                }
            });
        }
        // Rebuild every event type's <select> from the live pool rows, preserving the current
        // choice by index. A <select> per event type is what makes double-assignment impossible.
        // The default group is represented by the "Default" (-1) option, so it's skipped here
        // rather than listed as its own numbered option.
        function syncPoolOptions() {
            var pools = [];
            rows.querySelectorAll('.dkp-pool-row').forEach(function (row, i) {
                if (row.classList.contains('is-default')) { return; }
                var input = row.querySelector('[data-field="Name"]');
                pools.push({ index: i, name: (input && input.value.trim()) || 'Unnamed group' });
            });
            card.querySelectorAll('[data-pool-select]').forEach(function (select) {
                var previous = select.value;
                select.innerHTML = '';
                var none = document.createElement('option');
                none.value = '-1';
                none.textContent = 'Default';
                select.appendChild(none);
                pools.forEach(function (pool) {
                    var opt = document.createElement('option');
                    opt.value = String(pool.index);
                    opt.textContent = pool.name;
                    select.appendChild(opt);
                });
                // A pool that was removed leaves its event types on Default rather than silently
                // re-pointing them at whatever pool happens to now hold that index.
                var stillExists = pools.some(function (pool) { return String(pool.index) === previous; });
                select.value = stillExists ? previous : '-1';
            });
        }
        addBtn.addEventListener('click', function () {
            rows.appendChild(tpl.content.firstElementChild.cloneNode(true));
            reindex();
        });
        rows.addEventListener('click', function (evt) {
            if (!evt.target.closest('.dkp-pool-remove')) { return; }
            if (rows.querySelectorAll('.dkp-pool-row').length <= 1) { return; }
            evt.target.closest('.dkp-pool-row').remove();
            reindex();
        });
        rows.addEventListener('input', function (evt) {
            if (evt.target.getAttribute('data-field') === 'Name') { syncPoolOptions(); }
        });
        rows.addEventListener('change', function (evt) {
            if (evt.target.getAttribute('data-field') === 'Accent') { syncSwatches(); }
        });
        reindex();
    })();
</script>
<template id="routeRowTemplate">
    @{ await RouteRow(0, new LinkshellManagerDiscordApp.ViewModels.ChannelRouteInput(), true); }
</template>
<script nonce="@Html.CspNonce()">
    (function () {
        var rows = document.getElementById('routeRows');
        var addBtn = document.getElementById('routeAdd');
        var tpl = document.getElementById('routeRowTemplate');
        if (!rows || !addBtn || !tpl) { return; }
        // Renumber every bound field so the model binder sees a contiguous
        // channelRoutes[0..n] collection after add/remove.
        function reindex() {
            var list = rows.querySelectorAll('.route-row');
            for (var i = 0; i < list.length; i++) {
                list[i].querySelectorAll('[data-field]').forEach(function (el) {
                    el.setAttribute('name', 'channelRoutes[' + i + '].' + el.getAttribute('data-field'));
                });
            }
        }
        // Show/hide a row's event-type picker with its "Events" chip, and the per-monster
        // HNM picker with the HNM chip inside it — same nesting the Activity uses.
        function bindRow(row) {
            var eventsToggle = row.querySelector('[data-events-toggle]');
            var side = row.querySelector('.route-side');
            var hnmToggle = row.querySelector('[data-hnm-toggle]');
            var monsters = row.querySelector('.route-monsters');
            var sync = function () {
                var events = !!(eventsToggle && eventsToggle.checked);
                if (side) { side.style.display = events ? 'flex' : 'none'; }
                if (monsters) {
                    monsters.style.display = events && hnmToggle && hnmToggle.checked ? 'flex' : 'none';
                }
            };
            if (eventsToggle) { eventsToggle.addEventListener('change', sync); }
            if (hnmToggle) { hnmToggle.addEventListener('change', sync); }
            sync();

            // Keep the collapsed summary showing the channel this route posts to.
            var label = row.querySelector('[data-route-label]');
            var channel = row.querySelector('[data-field="ChannelId"]');
            if (label && channel) {
                channel.addEventListener('change', function () {
                    var text = channel.tagName === 'SELECT'
                        ? (channel.selectedOptions[0] ? channel.selectedOptions[0].textContent.trim() : '')
                        : channel.value.trim();
                    label.textContent = text && text.indexOf('—') !== 0 ? text : 'New route';
                });
            }

            // Any edit drops the green "saved" state, so the pill never claims a change is stored.
            row.addEventListener('change', function () {
                if (row.classList.contains('is-saved')) {
                    row.classList.remove('is-saved');
                    row.classList.add('is-dirty');
                }
            });
        }
        rows.querySelectorAll('.route-row').forEach(bindRow);
        addBtn.addEventListener('click', function () {
            var clone = tpl.content.firstElementChild.cloneNode(true);
            rows.appendChild(clone);
            reindex();
            bindRow(clone);
        });
        rows.addEventListener('click', function (evt) {
            var expand = evt.target.closest('.route-expand');
            if (expand) {
                expand.closest('.route-row').classList.remove('is-collapsed');
                return;
            }
            var collapse = evt.target.closest('.route-collapse-top');
            if (collapse) {
                collapse.closest('.route-row').classList.add('is-collapsed');
                return;
            }
            var btn = evt.target.closest('.route-remove');
            if (!btn) { return; }
            btn.closest('.route-row').remove();
            reindex();
        });
    })();
</script>
<!-- Confirm modal: reused by every save action on this page. -->
<div class="mt-modal" id="customizeConfirmModal" role="dialog" aria-modal="true">
    <div class="mt-modal__backdrop"></div>
    <div class="mt-modal__dialog">
        <div class="mt-modal__content">
            <div class="mt-modal__header">
                <h5 class="mt-modal__title">Confirm changes</h5>
            </div>
            <div class="mt-modal__body">
                <p style="margin:0;font-size:14px;color:var(--fg-1)">
                    You are about to make changes to
                    <strong id="customizeConfirmName">@Model.LinkshellName</strong>. Are you sure?
                </p>
            </div>
            <div class="mt-modal__footer">
                <button type="button" class="btn ghost" id="customizeConfirmNo">No</button>
                <button type="button" class="btn primary" id="customizeConfirmYes">Yes</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script nonce="@Html.CspNonce()">
        // Entry "which linkshell" modal + a promise-based confirm gate reused by
        // every save action on this page (window.lsmConfirmChange). Defined first
        // so the permissions/addon scripts below can call it.
        (function () {
            function openModal(id) { var el = document.getElementById(id); if (el) el.classList.add('mt-modal--open'); }
            function closeModal(id) { var el = document.getElementById(id); if (el) el.classList.remove('mt-modal--open'); }
            var pendingResolve = null;
            window.lsmConfirmChange = function () {
                return new Promise(function (resolve) {
                    pendingResolve = resolve;
                    openModal('customizeConfirmModal');
                });
            };
            function settle(result) {
                closeModal('customizeConfirmModal');
                var r = pendingResolve; pendingResolve = null;
                if (r) r(result);
            }
            var yes = document.getElementById('customizeConfirmYes');
            var no = document.getElementById('customizeConfirmNo');
            if (yes) yes.addEventListener('click', function () { settle(true); });
            if (no) no.addEventListener('click', function () { settle(false); });
            // Drop the one-shot ?switched flag (set by the inline linkshell switcher)
            // so a later manual reload behaves normally and the URL stays clean.
            if (window.history && window.history.replaceState) {
                try {
                    var cleanUrl = new URL(window.location.href);
                    if (cleanUrl.searchParams.has('switched')) {
                        cleanUrl.searchParams.delete('switched');
                        window.history.replaceState({}, '', cleanUrl.toString());
                    }
                } catch (e) { /* no-op */ }
            }
            // Gate the main customize form (loot structure, linkshell type,
            // feature toggles, hide ToD mobs, Discord webhooks) behind confirm.
            var form = document.getElementById('customizeForm');
            if (form) {
                var confirmed = false;
                form.addEventListener('submit', function (e) {
                    if (confirmed) return;
                    e.preventDefault();
                    window.lsmConfirmChange().then(function (ok) {
                        if (ok) { confirmed = true; form.submit(); }
                    });
                });
            }
            // Gate the standalone server-lock / unlock forms (and any future
            // .lsm-confirm-form) through the same "Are you sure?" modal.
            document.querySelectorAll('form.lsm-confirm-form').forEach(function (cf) {
                var ok = false;
                cf.addEventListener('submit', function (e) {
                    if (ok) return;
                    e.preventDefault();
                    window.lsmConfirmChange().then(function (yes) {
                        if (yes) { ok = true; cf.submit(); }
                    });
                });
            });
        })();
    </script>
    <script nonce="@Html.CspNonce()">
        (function () {
            // Hide the DKP rounding row when the loot structure is Loot Council,
            // matching the Activity's behavior (rounding only applies to DKP-based modes).
            var dkpRow = document.getElementById('dkp-rounding-row');
            var radios = document.querySelectorAll('input[type=radio][name="LootStructure"]');
            function update() {
                var selected = document.querySelector('input[type=radio][name="LootStructure"]:checked');
                var value = selected ? selected.value : '';
                dkpRow.style.display = (value === 'Dkp' || value === 'Hybrid') ? '' : 'none';
            }
            radios.forEach(function (r) { r.addEventListener('change', update); });
            update();
        })();
    </script>
}

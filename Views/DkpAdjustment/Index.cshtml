@model LinkshellManagerDiscordApp.ViewModels.DkpAdjustmentViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject LinkshellManagerDiscordApp.Services.AdminOverrideService AdminOverride
@{
    ViewData["Title"] = "DKP Adjustments";
    ViewData["BodyClass"] = "lsm-page";
    var antiforgeryTokens = Antiforgery.GetAndStoreTokens(Context);
    // AppUserIds carrying the app-wide admin override (empty when it is switched off).
    var adminAppUserIds = await AdminOverride.GetActiveAdminAppUserIdsAsync(Context.RequestAborted);
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">DKP Adjustments</h1>
        <div class="page-sub">
            <span>Manually adjust member DKP balances</span>
            @if (!string.IsNullOrWhiteSpace(Model.SelectedLinkshellName))
            {
                <span class="dot"> · </span>
                <span>@Model.SelectedLinkshellName</span>
            }
        </div>
    </div>
</div>

@if (TempData["DkpAdjustmentError"] is string errorMessage)
{
    <div class="alert alert-danger fade d2">@errorMessage</div>
}
@if (TempData["DkpAdjustmentSuccess"] is string successMessage)
{
    <div class="alert alert-success fade d2">@successMessage</div>
}

@if (!Model.CanManage)
{
    <div class="card fade d2">
        <div class="empty">
            <div style="font-size:15px;color:var(--fg);font-weight:500;margin-bottom:6px">No permission</div>
            <div>Only Leaders and Officers can adjust DKP balances.</div>
        </div>
    </div>
}
else if (Model.Linkshells.Count == 0)
{
    <div class="card fade d2">
        <div class="empty">You don't manage any linkshells yet.</div>
    </div>
}
else
{
    <div class="card fade d2">
        <div class="card-head">
            <div class="card-title">Members <span class="tag">@Model.Members.Count</span></div>
        </div>
        @if (!Model.Members.Any())
        {
            <div class="empty">No members in this linkshell yet.</div>
        }
        else
        {
            <table class="table themed">
                <thead>
                    <tr>
                        <th>Character</th>
                        <th>Rank</th>
                        <th style="text-align:right">Current DKP</th>
                        <th style="text-align:right">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Model.Members)
                    {
                        <tr>
                            <td style="font-weight:500">@member.CharacterName</td>
                            <td>
                                <span class="tag">@(member.Rank ?? "Member")</span>
                                @if (adminAppUserIds.Contains(member.AppUserId ?? string.Empty))
                                {
                                    <span class="tag accent" title="App-wide admin override: full permissions in every linkshell they belong to.">🔧 ADMIN</span>
                                }
                            </td>
                            <td class="num" style="text-align:right">@member.CurrentBalance.ToString("0.##")</td>
                            <td style="text-align:right">
                                @if (!string.IsNullOrWhiteSpace(member.AppUserId))
                                {
                                    <button type="button" class="btn primary sm js-dkp-audit"
                                            data-linkshellid="@Model.SelectedLinkshellId"
                                            data-appuserid="@member.AppUserId"
                                            data-name="@member.CharacterName"
                                            data-dkp="@member.CurrentBalance.ToString("0.##")">DKP Audit</button>
                                }
                                else
                                {
                                    <button type="button" class="btn primary sm" disabled title="Member has no user account">DKP Audit</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="mt-modal" id="dkpAuditModal" role="dialog" aria-modal="true">
        <div class="mt-modal__backdrop" data-mt-close="1"></div>
        <div class="mt-modal__dialog mt-modal__dialog--lg">
            <div class="mt-modal__content">
                <div class="mt-modal__header">
                    <h5 class="mt-modal__title">Record DKP audit</h5>
                    <button type="button" class="mt-modal__close" data-mt-close="1" aria-label="Close">&times;</button>
                </div>
                <div class="mt-modal__body">
                    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:14px">
                        <label style="padding:10px 12px;border:1px solid var(--border);border-radius:8px;cursor:pointer">
                            <input type="radio" name="auditMode" value="Adjust" checked />
                            <strong style="margin-left:6px">Correct a previous entry</strong>
                            <div style="color:var(--fg-3);font-size:12px;margin-top:2px">Fix DKP awarded/charged on a past event or auction.</div>
                        </label>
                        <label style="padding:10px 12px;border:1px solid var(--border);border-radius:8px;cursor:pointer">
                            <input type="radio" name="auditMode" value="Add" />
                            <strong style="margin-left:6px">Add to a previous entry</strong>
                            <div style="color:var(--fg-3);font-size:12px;margin-top:2px">Credit a member who was missed by a snapshot.</div>
                        </label>
                        <label style="padding:10px 12px;border:1px solid var(--border);border-radius:8px;cursor:pointer">
                            <input type="radio" name="auditMode" value="Misc" />
                            <strong style="margin-left:6px">Miscellaneous adjustment</strong>
                            <div style="color:var(--fg-3);font-size:12px;margin-top:2px">Add or subtract DKP for any other reason.</div>
                        </label>
                    </div>

                    <div class="field" style="margin-bottom:12px">
                        <label for="auditMemberSelect">Member</label>
                        <select id="auditMemberSelect" class="form-select">
                            @foreach (var member in Model.Members.Where(m => !string.IsNullOrWhiteSpace(m.AppUserId)))
                            {
                                <option value="@member.AppUserId"
                                        data-name="@member.CharacterName"
                                        data-dkp="@member.CurrentBalance.ToString("0.##")">@member.CharacterName</option>
                            }
                        </select>
                        <div id="auditMemberBalance" style="color:var(--fg-3);font-size:12px"></div>
                    </div>

                    <div id="auditAdjustFields">
                        <div class="field" style="margin-bottom:12px">
                            <label for="auditEntrySelect" id="auditEntryLabel">Entry to correct</label>
                            <select id="auditEntrySelect" class="form-select">
                                <option value="">Loading entries…</option>
                            </select>
                            <div id="auditEntryHint" style="color:var(--fg-3);font-size:12px;margin-top:4px"></div>
                        </div>
                    </div>

                    <div class="field" id="auditAmountField" style="margin-bottom:12px">
                        <label for="auditAmount" id="auditAmountLabel">Corrected amount (DKP)</label>
                        <input type="number" step="0.01" id="auditAmount" class="form-control" placeholder="e.g. 45" />
                    </div>

                    @* A free-standing adjustment has no event type to follow, so the officer says which
                       wallet it lands in. Only Misc — "Correct" and "Add" inherit the pool of the entry
                       they're correcting, which is the only answer that keeps the correction with the
                       thing it corrects under a later remap. Hidden entirely on a single-pool linkshell. *@
                    @if (Model.HasMultiplePools)
                    {
                        <div class="field" id="auditPoolField" style="margin-bottom:12px;display:none">
                            <label for="auditPool">DKP pool</label>
                            <select id="auditPool" class="form-select">
                                @foreach (var pool in Model.Pools)
                                {
                                    <option value="@pool.Id" selected="@(pool.Id == Model.DefaultPoolId)">@pool.Name</option>
                                }
                            </select>
                            <div style="color:var(--fg-3);font-size:12px;margin-top:4px">
                                Which pool this adjustment is added to or taken from.
                            </div>
                        </div>
                    }

                    <div class="field" style="margin-bottom:4px">
                        <label for="auditReason">Reason</label>
                        <textarea id="auditReason" class="form-control" rows="3" placeholder="Explain why this audit is being recorded"></textarea>
                    </div>

                    <div id="auditError" style="color:#e05a5a;font-size:13px;margin-top:8px;display:none"></div>
                </div>
                <div class="mt-modal__footer">
                    <button type="button" class="btn ghost" data-mt-close="1">Cancel</button>
                    <button type="button" class="btn primary" id="auditSaveBtn">Save audit</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script nonce="@Html.CspNonce()">
        window.LSM_CSRF_HEADER = '@antiforgeryTokens.HeaderName';
        window.LSM_CSRF_TOKEN = '@antiforgeryTokens.RequestToken';
    </script>
    <script src="~/js/manage-team.js" asp-append-version="true" defer></script>
}

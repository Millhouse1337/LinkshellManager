@model LinkshellManagerDiscordApp.ViewModels.JobsRosterViewModel
@{
    ViewData["Title"] = "Jobs Roster";
    ViewData["BodyClass"] = "lsm-page";
    var message = ViewBag.Message as string;
    var selectedLinkshell = Model.Linkshells.FirstOrDefault(l => l.Id == Model.SelectedLinkshellId);

    string InitialsFor(string? name)
    {
        var initials = string.Concat((name ?? "?")
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(w => w[0])).ToUpperInvariant();
        if (string.IsNullOrEmpty(initials)) { initials = "?"; }
        return initials.Length > 2 ? initials[..2] : initials;
    }
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Jobs Roster</h1>
        <div class="page-sub">
            @if (selectedLinkshell != null)
            {
                <span>@selectedLinkshell.LinkshellName</span>
                <span class="dot"> · </span>
            }
            <span><span class="num">@Model.Entries.Count</span> member@(Model.Entries.Count == 1 ? "" : "s")</span>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="card fade d2">
        <div class="empty">
            <div style="font-size:15px;color:var(--fg);font-weight:500;margin-bottom:6px">@message</div>
        </div>
    </div>
}
else
{
    @* Linkshell switching lives in the side nav / Customize Linkshell — the
       per-page switch card was removed to keep one switch entry point. *@

    <div class="card fade d2" style="padding:14px 16px;margin-bottom:16px">
        <div class="page-sub" style="margin:0">
            Job levels each member entered on their Profile. Only leveled jobs (1–@LinkshellManagerDiscordApp.Utils.ProfileJobLevels.MaxLevel) are shown.
        </div>
    </div>

    @if (Model.Entries.Count == 0)
    {
        <div class="card fade d3">
            <div class="empty">
                <div style="font-size:15px;color:var(--fg);font-weight:500">No app-linked members yet.</div>
            </div>
        </div>
    }
    else
    {
        <div class="jr-grid fade d3">
            @foreach (var entry in Model.Entries)
            {
                var characters = new List<(string Label, bool IsAlt, IReadOnlyList<int> Levels, IReadOnlyList<bool> Strong, IReadOnlyList<bool> Relic, IReadOnlyList<string> RelicName, IReadOnlyList<string> Merit)>
                {
                    (entry.CharacterName, false, entry.JobLevels, entry.StrongJobs, entry.RelicFlags, entry.RelicNames, entry.MeritJobs)
                };
                if (entry.Alt1Name is not null) { characters.Add((entry.Alt1Name, true, entry.Alt1JobLevels, entry.Alt1StrongJobs, entry.Alt1RelicFlags, entry.Alt1RelicNames, entry.Alt1MeritJobs)); }
                if (entry.Alt2Name is not null) { characters.Add((entry.Alt2Name, true, entry.Alt2JobLevels, entry.Alt2StrongJobs, entry.Alt2RelicFlags, entry.Alt2RelicNames, entry.Alt2MeritJobs)); }

                <div class="card jr-card">
                    <div class="jr-card-head">
                        <div class="jr-av">@InitialsFor(entry.CharacterName)</div>
                        <div class="jr-id">
                            <div class="jr-name">@entry.CharacterName</div>
                            <div class="jr-rank">@(entry.Rank ?? "Member")</div>
                        </div>
                    </div>

                    @foreach (var ch in characters)
                    {
                        var leveled = ch.Levels
                            .Select((lvl, i) => new
                            {
                                Name = Model.JobCatalog[i],
                                Level = lvl,
                                Strong = i < ch.Strong.Count && ch.Strong[i],
                                Relic = i < ch.Relic.Count && ch.Relic[i],
                                RelicName = i < ch.RelicName.Count ? ch.RelicName[i] : "",
                                Merit = i < ch.Merit.Count ? ch.Merit[i] : ""
                            })
                            .Where(x => x.Level > 0)
                            .OrderByDescending(x => x.Level)
                            .ToList();

                        <div class="jr-char">
                            @if (ch.IsAlt)
                            {
                                <div class="jr-char-label">@ch.Label <span class="jr-alt-tag">alt</span></div>
                            }
                            @if (leveled.Count == 0)
                            {
                                <div class="jr-empty">No jobs entered</div>
                            }
                            else
                            {
                                <div class="jr-pills">
                                    @foreach (var job in leveled)
                                    {
                                        var tipParts = new List<string>();
                                        if (job.Relic) { tipParts.Add(string.IsNullOrWhiteSpace(job.RelicName) ? "Relic weapon" : "Relic: " + job.RelicName); }
                                        if (job.Strong && !string.IsNullOrWhiteSpace(job.Merit)) { tipParts.Add("Merits: " + job.Merit); }
                                        else if (job.Strong) { tipParts.Add("Merited"); }
                                        var tip = tipParts.Count > 0 ? string.Join(" · ", tipParts) : null;
                                        <span class="jr-pill @(job.Strong ? "jr-pill--strong" : "") @(job.Relic ? "relic-flame" : "")" title="@tip"><span class="jr-pill-job">@job.Name</span><span class="jr-pill-lvl">@job.Level</span>@if (job.Strong) {<span class="jr-pill-strong">★</span>}</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
}

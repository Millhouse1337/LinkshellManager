@model LinkshellManagerDiscordApp.ViewModels.ManageTeamViewModel
@{
    ViewData["Title"] = "Manage Team";
    ViewData["BodyClass"] = "lsm-page";
    var message = ViewBag.Message as string;
    var selectedLinkshell = Model.Linkshells.FirstOrDefault(l => l.Id == Model.SelectedLinkshellId);
    // appUserId -> current credit / absent streaks (consecutive recent counting events).
    var memberStreaks = ViewBag.MemberStreaks as Dictionary<string, LinkshellManagerDiscordApp.Services.MemberStreaks>
        ?? new Dictionary<string, LinkshellManagerDiscordApp.Services.MemberStreaks>();
    var biddableDkp = ViewBag.BiddableDkp as Dictionary<string, double>
        ?? new Dictionary<string, double>();
}

@functions {
    // Tag color for the single membership Status (auto-driven Active/Inactive by
    // attendance, with Pending as the manual state).
    // Rank tier icon shown beside the rank tag (matches the Activity rank icons).
    static string RankIcon(string? rank) => (rank ?? "").ToLowerInvariant() switch
    {
        "leader" => "👑",
        "officer" => "⭐",
        "trial" => "🌱",
        _ => "🛡️"
    };

    static string StatusClass(string? status) =>
        string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase) ? "success"
        : string.Equals(status, "Pending", StringComparison.OrdinalIgnoreCase) ? "warning"
        : string.Equals(status, "Inactive", StringComparison.OrdinalIgnoreCase) ? "danger"
        : "default";
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Manage Team</h1>
        <div class="page-sub">
            @if (selectedLinkshell != null)
            {
                <span>@selectedLinkshell.LinkshellName</span>
                <span class="dot"> · </span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <span><span class="num">@Model.TotalCount</span> of <span class="num">@Model.TotalMembers</span> members</span>
            }
            else
            {
                <span><span class="num">@Model.TotalMembers</span> member@(Model.TotalMembers == 1 ? "" : "s")</span>
            }
        </div>
    </div>
    @if (Model.CanManage)
    {
        <div class="page-actions">
            <a class="btn primary" asp-action="SearchPlayers">+ Add members</a>
        </div>
    }
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="card fade d2">
        <div class="empty">
            <div style="font-size:15px;color:var(--fg);font-weight:500;margin-bottom:6px">@message</div>
        </div>
    </div>
}
else
{
    @* Linkshell switching lives in the side nav / Customize Linkshell — the
       per-page switch card was removed to keep one switch entry point. *@

    @* The Game Addon (att) pairing card lives on /Linkshell/Customize now;
       moved here so it sits next to the rest of the linkshell-wide settings. *@

    <div class="card fade d3">
        <div class="card-head">
            <div class="card-title">Members</div>
            <form asp-action="Index" method="get" id="manageTeamFilterForm"
                  style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                <input type="hidden" name="selectedLinkshellId" value="@Model.SelectedLinkshellId" />
                <input type="text" name="search" value="@Model.SearchTerm"
                       placeholder="Search character…" class="form-control"
                       style="height:32px;min-width:200px" />
                @* App Sync filter: defaults ON so the roster leads with members
                   the linkshell actually has app + DKP tracking on. Toggling it
                   re-submits the form so the server can re-query with the new
                   filter state (pagination is server-side here). The hidden
                   "false" sentinel guarantees an unchecked box still sends a
                   value -- browsers omit unchecked inputs otherwise. *@
                <label style="display:flex;align-items:center;gap:4px;font-size:12px;color:var(--fg-2);white-space:nowrap;cursor:pointer">
                    <input type="hidden" name="appSync" value="false" />
                    <input type="checkbox" name="appSync" value="true"
                           @(Model.AppSyncOnly ? "checked" : "")
                           onchange="document.getElementById('manageTeamFilterForm').submit()" />
                    App Sync
                </label>
                <button type="submit" class="btn sm">Search</button>
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <a class="btn sm ghost" asp-action="Index"
                       asp-route-selectedLinkshellId="@Model.SelectedLinkshellId"
                       asp-route-appSync="@(Model.AppSyncOnly ? "true" : "false")">Clear</a>
                }
            </form>
        </div>
        @if (Model.Members.Count == 0)
        {
            <div class="empty">
                @(string.IsNullOrWhiteSpace(Model.SearchTerm)
                    ? "No members found for this linkshell."
                    : "No members match your search.")
            </div>
        }
        else
        {
            <style>
                /* Scrollable roster: bound the height and keep the column headers
                   pinned while scrolling. The themed header is normally transparent,
                   so give the sticky cells the panel background to avoid bleed-through. */
                .roster-scroll { max-height: 60vh; overflow-y: auto; overflow-x: auto; }
                .roster-scroll table.themed thead th {
                    position: sticky;
                    top: 0;
                    z-index: 2;
                    background: var(--surface, #121216);
                }
            </style>
            <div class="roster-scroll">
            <table class="table themed">
                <thead>
                    <tr>
                        <th>Character</th>
                        <th>Rank</th>
                        <th>Status</th>
                        <th style="text-align:right" title="Consecutive recent events credited toward active status">Active credit</th>
                        <th style="text-align:right" title="Consecutive recent events missed (no active credit)">Absent streak</th>
                        <th style="text-align:right">DKP</th>
                        <th>Joined</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Model.Members)
                    {
                        <tr>
                            <td>
                                <div>
                                    @(member.CharacterName ?? member.AppUser?.CharacterName ?? "—")
                                    @if (member.AppUser?.IsPlaceholder == true)
                                    {
                                        <span class="tag" style="font-size:10px" title="Player who hasn't synced their account — created by a leader">Unsynced</span>
                                    }
                                </div>
                                @{
                                    var altNames = new[] { member.AppUser?.AltCharacterName1, member.AppUser?.AltCharacterName2 }
                                        .Where(a => !string.IsNullOrWhiteSpace(a))
                                        .ToList();
                                }
                                @if (altNames.Count > 0)
                                {
                                    <div style="font-size:11px;color:var(--fg-3)">Alts: @string.Join(", ", altNames)</div>
                                }
                            </td>
                            <td><span class="tag">@RankIcon(member.Rank) @(member.Rank ?? "—")</span></td>
                            <td><span class="tag @StatusClass(member.Status)">@(member.Status ?? "Active")</span></td>
                            @{ var streaks = memberStreaks.GetValueOrDefault(member.AppUserId ?? string.Empty); }
                            <td style="text-align:right">
                                <span class="tag @(streaks.Credit > 0 ? "success" : "")" title="Consecutive recent events credited toward active status">@streaks.Credit</span>
                            </td>
                            <td style="text-align:right">
                                <span class="tag @(streaks.Absent > 0 ? "danger" : "")" title="Consecutive recent events missed (no active credit)">@streaks.Absent</span>
                            </td>
                            <td class="num" style="text-align:right">
                                @((member.LinkshellDkp ?? 0).ToString("N0"))
                                @if (biddableDkp.TryGetValue(member.AppUserId ?? string.Empty, out var bd) && System.Math.Abs(bd - (member.LinkshellDkp ?? 0)) > 0.0001)
                                {
                                    <div style="font-size:11px;color:var(--fg-3)" title="Biddable now = balance − bids you're winning − DKP spent on loot in a live event">@bd.ToString("0.##") biddable</div>
                                }
                            </td>
                            <td style="font-size:12px;color:var(--fg-3)">
                                @(member.DateJoined.HasValue ? member.DateJoined.Value.ToString("MMM d, yyyy") : "—")
                            </td>
                            <td style="text-align:right">
                                <div style="display:inline-flex;gap:6px;justify-content:flex-end">
                                    <a class="btn ghost sm" asp-action="MemberProfile" asp-route-id="@member.Id">View Profile</a>
                                    @if (Model.CanManage)
                                    {
                                        <button type="button" class="btn primary sm js-modify-rank"
                                                data-id="@member.Id"
                                                data-rank="@member.Rank"
                                                data-status="@member.Status"
                                                data-credit="@streaks.Credit"
                                                data-absent="@streaks.Absent"
                                                data-name="@(member.CharacterName ?? member.AppUser?.CharacterName)">
                                            Modify
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <div style="display:flex;align-items:center;gap:8px;padding:12px 16px;border-top:1px solid var(--border)">
                    @if (Model.PageNumber > 1)
                    {
                        <a class="btn sm" asp-action="Index"
                           asp-route-selectedLinkshellId="@Model.SelectedLinkshellId"
                           asp-route-search="@Model.SearchTerm"
                           asp-route-appSync="@(Model.AppSyncOnly ? "true" : "false")"
                           asp-route-page="@(Model.PageNumber - 1)">Prev</a>
                    }
                    <span class="muted" style="font-size:12px">Page @Model.PageNumber of @Model.TotalPages</span>
                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <a class="btn sm" asp-action="Index"
                           asp-route-selectedLinkshellId="@Model.SelectedLinkshellId"
                           asp-route-search="@Model.SearchTerm"
                           asp-route-appSync="@(Model.AppSyncOnly ? "true" : "false")"
                           asp-route-page="@(Model.PageNumber + 1)">Next</a>
                    }
                </div>
            }
        }
    </div>
}

@if (Model.CanManage)
{
    <div class="mt-modal" id="modifyRankModal" role="dialog" aria-modal="true">
        <div class="mt-modal__backdrop" data-mt-close="1"></div>
        <div class="mt-modal__dialog">
            <form asp-action="ModifyRankStatus" method="post" class="mt-modal__content">
                @Html.AntiForgeryToken()
                <div class="mt-modal__header">
                    <h5 class="mt-modal__title">Modify rank &amp; status</h5>
                    <button type="button" class="mt-modal__close" data-mt-close="1" aria-label="Close">&times;</button>
                </div>
                <div class="mt-modal__body">
                    <input type="hidden" name="Id" id="modifyId" />
                    <div class="field" style="margin-bottom:12px">
                        <label>Character</label>
                        <div id="modifyName" style="color:var(--fg-3)"></div>
                    </div>
                    <div class="field">
                        <label for="modifyRank">Rank</label>
                        <select name="Rank" id="modifyRank" class="form-select" required>
                            @foreach (var rank in LinkshellManagerDiscordApp.ViewModels.ManageTeamViewModel.RankOptions)
                            {
                                <option value="@rank">@rank</option>
                            }
                        </select>
                    </div>
                    <div class="field" style="margin-top:12px">
                        <label for="modifyStatus">Status</label>
                        <select name="Status" id="modifyStatus" class="form-select" required>
                            @foreach (var status in LinkshellManagerDiscordApp.ViewModels.ManageTeamViewModel.StatusOptions)
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                        <small style="color:var(--fg-3)">Set <strong>Active</strong> or <strong>Inactive</strong> manually. If automatic activity tracking is on for this linkshell, attendance may recompute this later.</small>
                    </div>
                    <div class="field" style="margin-top:12px">
                        <label for="modifyStreakType">Streak count override</label>
                        <div style="display:flex;gap:8px;align-items:center">
                            <select name="StreakType" id="modifyStreakType" class="form-select" style="flex:1">
                                <option value="credit">Active streak (green)</option>
                                <option value="absent">Absence streak (red)</option>
                            </select>
                            <input type="number" name="StreakCount" id="modifyStreakCount" class="form-control" min="0" step="1" style="width:90px" />
                        </div>
                        <small style="color:var(--fg-3)">Override the counted streak. Choose which streak the number targets — that controls the color and drives Active/Inactive until the next event recompute.</small>
                    </div>
                </div>
                <div class="mt-modal__footer">
                    <button type="button" class="btn ghost" data-mt-close="1">Cancel</button>
                    <button type="submit" class="btn primary">Save changes</button>
                </div>
            </form>
        </div>
    </div>

    <script src="~/js/manage-team.js" asp-append-version="true" defer></script>
}

@model DashboardViewModel
@inject LinkshellManagerDiscordApp.Services.AdminOverrideService AdminOverride
@{
    // AppUserIds carrying the app-wide admin override (empty when it is switched off).
    var adminAppUserIds = await AdminOverride.GetActiveAdminAppUserIdsAsync(Context.RequestAborted);
    ViewData["Title"] = "Dashboard";
    ViewData["BodyClass"] = "lsm-page";

    string RosterAvClass(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "a";
        var h = 0;
        foreach (var ch in name) { h = (h * 31 + ch) & 0x7fffffff; }
        return new[] { "a", "b", "c", "d", "e" }[h % 5];
    }

    string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var ini = string.Concat(parts.Select(p => p[0])).ToUpperInvariant();
        return ini.Length > 2 ? ini[..2] : ini;
    }

    string RelativeEventTime(DateTime? when)
    {
        if (!when.HasValue) return "TBD";
        var delta = when.Value - DateTime.UtcNow;
        var abs = delta.Duration();
        var prefix = delta.TotalSeconds < 0 ? "" : "in ";
        var suffix = delta.TotalSeconds < 0 ? " ago" : "";
        if (abs.TotalMinutes < 60) return $"{prefix}{(int)abs.TotalMinutes}m{suffix}";
        if (abs.TotalHours < 24) return $"{prefix}{(int)abs.TotalHours}h{suffix}";
        if (abs.TotalDays < 14) return $"{prefix}{(int)abs.TotalDays}d{suffix}";
        return when.Value.ToString("MMM d");
    }
}

@if (!string.IsNullOrEmpty(Model.BannerUrl))
{
    <img class="lsm-dash-banner fade d1" src="@Model.BannerUrl" alt="Linkshell banner" />
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <div class="page-sub">
            @if (!string.IsNullOrWhiteSpace(Model.SelectedLinkshellName))
            {
                <span>@Model.SelectedLinkshellName</span>
                <span>·</span>
            }
            <span><span class="num">@Model.TotalMembers</span> members</span>
            <span class="live-dot">Live</span>
        </div>
    </div>

</div>

@if (Model.Linkshells.Count == 0)
{
    <div class="card fade d2">
        <div class="empty">
            <div style="font-size:15px;color:var(--fg);font-weight:500;margin-bottom:6px">No linkshells yet</div>
            <div style="margin-bottom:12px">Create your first linkshell to start managing memberships and events.</div>
            <a class="btn primary" asp-controller="Linkshell" asp-action="Create">Create linkshell</a>
        </div>
    </div>
}
else
{
    <div class="stat-strip fade d2">
        <div class="stat-cell">
            <div class="stat-cell-label">Linkshell</div>
            <div class="stat-cell-value stat-cell-value--text">@(Model.SelectedLinkshellName ?? "—")</div>
        </div>
        @if (Model.EnableItems)
        {
            <div class="stat-cell">
                <div class="stat-cell-label">Items</div>
                <div class="stat-cell-value">@Model.ItemCount</div>
            </div>
        }
        @if (Model.EnableRevenue)
        {
            <div class="stat-cell">
                @* "Revenue" was never what this number was — it is the gil the linkshell holds, and it
                   also disagreed with the Finances page, which summed raw values and ignored outflows. *@
                <div class="stat-cell-label">@LinkshellManagerDiscordApp.Services.TreasuryLabels.CashOnHand</div>
                <div class="stat-cell-value">@Model.RevenueTotal.ToString("N0")</div>
            </div>
        }
        <div class="stat-cell">
            <div class="stat-cell-label">Upcoming Events</div>
            <div class="stat-cell-value">@Model.UpcomingEvents</div>
        </div>
        <div class="stat-cell">
            <div class="stat-cell-label">Upcoming Auctions</div>
            <div class="stat-cell-value">@Model.UpcomingAuctionsCount</div>
        </div>
        @if (Model.EnableToDs)
        {
            <div class="stat-cell">
                <div class="stat-cell-label">Upcoming ToDs</div>
                <div class="stat-cell-value">@Model.UpcomingTodsCount</div>
            </div>
        }
    </div>

    <div class="card fade d2" style="margin-top:16px;margin-bottom:16px">
        <div class="card-head">
            <div class="card-title">Rules</div>
            <a class="card-link" asp-controller="Rule" asp-action="Index">View all</a>
        </div>
        @if (Model.Rules.Count == 0)
        {
            <div class="empty">No rules defined yet.</div>
        }
        else
        {
            @* Same Discord-message shape as the Rules page, compressed to a preview row. *@
            <div class="dc-mini">
                @{ var ruleRow = 0; }
                @foreach (var rule in Model.Rules)
                {
                    var ruleBadge = LinkshellManagerDiscordApp.Utils.RuleContent.Badge(rule.Category, ruleRow);
                    ruleRow++;
                    <a class="dc-mini-row @ruleBadge.Accent" asp-controller="Rule" asp-action="Index">
                        <div class="dc-mini-avatar" aria-hidden="true">@ruleBadge.Icon</div>
                        <div class="dc-mini-body">
                            <div class="dc-mini-head">
                                @if (!string.IsNullOrWhiteSpace(rule.Author))
                                {
                                    <span class="dc-mini-author">@rule.Author</span>
                                }
                                <span class="dc-mini-title">@rule.Title</span>
                                <span class="dc-mini-time">@rule.RelativeTime</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(rule.Details))
                            {
                                <div class="dc-mini-text">@LinkshellManagerDiscordApp.Utils.DiscordMarkdown.ToPlainText(rule.Details)</div>
                            }
                        </div>
                    </a>
                }
            </div>
        }
    </div>

    <div class="card fade d2" style="margin-top:16px;margin-bottom:16px">
        <div class="card-head">
            <div class="card-title">Recent Announcements</div>
            <a class="card-link" asp-controller="Announcement" asp-action="Index">View all</a>
        </div>
        @if (Model.RecentAnnouncements.Count == 0)
        {
            <div class="empty">No recent announcements found.</div>
        }
        else
        {
            @* Same Discord-message shape as the Announcements page, compressed to a preview row. *@
            <div class="dc-mini">
                @{ var annRow = 0; }
                @foreach (var ann in Model.RecentAnnouncements)
                {
                    var annBadge = LinkshellManagerDiscordApp.Utils.RuleContent.Badge(ann.Category, annRow);
                    annRow++;
                    <a class="dc-mini-row @annBadge.Accent" asp-controller="Announcement" asp-action="Index">
                        <div class="dc-mini-avatar" aria-hidden="true">@annBadge.Icon</div>
                        <div class="dc-mini-body">
                            <div class="dc-mini-head">
                                @if (!string.IsNullOrWhiteSpace(ann.Author))
                                {
                                    <span class="dc-mini-author">@ann.Author</span>
                                }
                                <span class="dc-mini-title">@ann.Title</span>
                                <span class="dc-mini-time">@ann.RelativeTime</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(ann.Details))
                            {
                                <div class="dc-mini-text">@LinkshellManagerDiscordApp.Utils.DiscordMarkdown.ToPlainText(ann.Details)</div>
                            }
                        </div>
                    </a>
                }
            </div>
        }
    </div>

    <div class="grid">
        <div class="col">
            <div class="card fade d3">
                <div class="card-head">
                    <div class="card-title">Upcoming Events</div>
                    <a class="card-link" asp-controller="Event" asp-action="Create">+ Create event</a>
                </div>
                @if (Model.Events.Count == 0 && Model.UpcomingRepops.Count == 0)
                {
                    <div class="empty">No active events for this linkshell.</div>
                }
                else
                {
                    <div class="list">
                        @foreach (var repop in Model.UpcomingRepops)
                        {
                            <a class="row plain" asp-controller="Tod" asp-action="Index">
                                <div class="row-main">
                                    <div class="row-title">
                                        @repop.MonsterName
                                        <span class="tag warning">Repop</span>
                                    </div>
                                    <div class="row-meta">
                                        <span>Window opens @repop.RepopTime.ToString("ddd MMM d, HH:mm:ss") UTC</span>
                                    </div>
                                </div>
                                <div class="row-time warn">
                                    <span class="num">@repop.TimeLabel</span>
                                    <div class="row-time-sub">until open</div>
                                </div>
                                <div class="row-cta">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M9 6l6 6-6 6"/></svg>
                                </div>
                            </a>
                        }
                        @foreach (var evt in Model.Events)
                        {
                            // The whole row opens the read-only event board (the "View" page
                            // every member can reach, same as Event System → Timed Events →
                            // View) — never the manager-only Edit page, which 403s for members.
                            var href = Url.Action("Start", "Event", new { eventId = evt.Id });
                            var isLive = evt.CommencementStartTime.HasValue;
                            <a class="row plain" href="@href">
                                <div class="row-main">
                                    <div class="row-title">
                                        @(evt.EventName ?? "Untitled event")
                                        @if (!string.IsNullOrWhiteSpace(evt.EventType))
                                        {
                                            <span class="tag">@evt.EventType</span>
                                        }
                                        @if (isLive)
                                        {
                                            <span class="tag success">Live</span>
                                        }
                                    </div>
                                    <div class="row-meta">
                                        @if (!string.IsNullOrWhiteSpace(evt.EventLocation))
                                        {
                                            <span>@evt.EventLocation</span>
                                            <span class="dot">·</span>
                                        }
                                        <span>@(evt.StartTime?.ToString("ddd MMM d, HH:mm:ss") ?? "Start TBD")</span>
                                    </div>
                                </div>
                                <div class="row-time @(isLive ? "warn" : "")">
                                    <span class="num">@(evt.StartTime?.ToString("HH:mm") ?? "—")</span>
                                    <div class="row-time-sub">@RelativeEventTime(evt.StartTime)</div>
                                </div>
                                <div class="row-cta">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M9 6l6 6-6 6"/></svg>
                                </div>
                            </a>
                        }
                    </div>
                }
            </div>

            <div class="card fade d4">
                <div class="card-head">
                    <div class="card-title">Recent activity</div>
                    <a class="card-link" asp-controller="EventHistory" asp-action="Index">Full log</a>
                </div>
                @if (Model.RecentActivity.Count == 0)
                {
                    <div class="empty">No activity yet.</div>
                }
                else
                {
                    <div class="act-list">
                        @foreach (var item in Model.RecentActivity)
                        {
                            <div class="act-row">
                                <div class="act-when">@item.RelativeTime</div>
                                <div class="act-dot @item.DotClass"></div>
                                <div class="act-text">
                                    <strong>@item.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                                    {
                                        <span> · @item.Subtitle</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="card fade d5">
                <div class="card-head">
                    <div class="card-title">Linkshell roster</div>
                    <a class="card-link" asp-controller="ManageTeam" asp-action="Index">Manage team</a>
                </div>
                @if (Model.Members.Count == 0)
                {
                    <div class="empty">No members found for this linkshell yet.</div>
                }
                else
                {
                    <div style="display:flex;align-items:center;gap:8px;padding:8px 16px;border-bottom:1px solid var(--border)">
                        <input id="dashRosterSearch" type="text" class="input"
                               placeholder="Filter roster (character, rank, job…)…"
                               style="flex:1;min-width:180px" maxlength="64" autocomplete="off" />
                        @* Show Jobs swaps Rank/DKP/Status for each member's leveled jobs
                           (main + alts) — the same toggle the Discord Activity's dashboard
                           roster has. Every cell is pre-rendered, so the checkbox only flips
                           a class on the list; while it is on, the search also reaches the
                           pre-baked job names/levels in data-jobs. *@
                        <label style="display:flex;align-items:center;gap:4px;font-size:12px;color:var(--fg-2);white-space:nowrap;cursor:pointer">
                            <input type="checkbox" id="dashRosterShowJobs" />
                            Show Jobs
                        </label>
                        <span id="dashRosterCount" style="font-size:12px;color:var(--fg-3);white-space:nowrap"></span>
                    </div>

                    <div id="dashRosterList">
                        <div class="roster-head">
                            <div></div>
                            <div>Character</div>
                            <div class="roster-col-jobs">Jobs</div>
                            <div class="roster-col-rank">Rank</div>
                            <div class="roster-col-dkp" style="text-align:right">DKP</div>
                            <div class="roster-col-status">Status</div>
                        </div>
                        @* Render the FULL roster (no Server-side Take). The client-side
                           JS below paginates at 5 per page and applies the live search
                           filter, matching the Linkshell Details page's pattern. *@
                        @foreach (var m in Model.Members)
                        {
                            var name = m.CharacterName ?? m.AppUser?.UserName ?? "Unknown";
                            var rank = m.Rank ?? "Member";
                            var status = m.Status ?? "Active";
                            var statusClass = status.Equals("Active", StringComparison.OrdinalIgnoreCase)
                                ? "success"
                                : status.Equals("Pending", StringComparison.OrdinalIgnoreCase)
                                    ? "warning"
                                    : "";
                            var alts = string.Join(", ", new[] { m.AppUser?.AltCharacterName1, m.AppUser?.AltCharacterName2 }
                                .Where(alt => !string.IsNullOrWhiteSpace(alt)));
                            // "App" tag: this member has actually opened/synced the app —
                            // an app account alone (AppUserId) only means one exists.
                            var hasSyncedApp = m.AppUserId != null && Model.SyncedAppUserIds.Contains(m.AppUserId);

                            // Main + alts with their leveled jobs, computed once and used for
                            // both the pills and the pre-baked job search key. Empty for
                            // members with no app account — there is no profile to read.
                            var jobs = Model.MemberJobs.TryGetValue(m.Id, out var jobEntry) ? jobEntry : null;
                            var characters = new List<(string Label, bool IsAlt, IReadOnlyList<int> Levels, IReadOnlyList<bool> Strong, IReadOnlyList<bool> Relic, IReadOnlyList<string> RelicName, IReadOnlyList<string> Merit)>();
                            if (jobs is not null)
                            {
                                characters.Add((jobs.CharacterName, false, jobs.JobLevels, jobs.StrongJobs, jobs.RelicFlags, jobs.RelicNames, jobs.MeritJobs));
                                if (jobs.Alt1Name is not null) { characters.Add((jobs.Alt1Name, true, jobs.Alt1JobLevels, jobs.Alt1StrongJobs, jobs.Alt1RelicFlags, jobs.Alt1RelicNames, jobs.Alt1MeritJobs)); }
                                if (jobs.Alt2Name is not null) { characters.Add((jobs.Alt2Name, true, jobs.Alt2JobLevels, jobs.Alt2StrongJobs, jobs.Alt2RelicFlags, jobs.Alt2RelicNames, jobs.Alt2MeritJobs)); }
                            }
                            var rendered = characters.Select(ch => new
                            {
                                ch.Label,
                                ch.IsAlt,
                                Jobs = ch.Levels
                                    .Select((lvl, i) => new
                                    {
                                        Name = i < Model.JobCatalog.Count ? Model.JobCatalog[i] : string.Empty,
                                        Level = lvl,
                                        Strong = i < ch.Strong.Count && ch.Strong[i],
                                        Relic = i < ch.Relic.Count && ch.Relic[i],
                                        RelicName = i < ch.RelicName.Count ? ch.RelicName[i] : "",
                                        Merit = i < ch.Merit.Count ? ch.Merit[i] : ""
                                    })
                                    .Where(job => job.Level > 0)
                                    .OrderByDescending(job => job.Level)
                                    .ToList()
                            }).ToList();

                            // Pre-baked lowercased haystacks the JS filter matches against.
                            // Keeps filtering O(1) per row at search time; data-jobs only
                            // counts while the jobs view is on.
                            var searchKey = (name + " " + rank + " " + status + " " + alts).ToLowerInvariant();
                            var jobsKey = string.Join(" ", rendered
                                .SelectMany(ch => ch.Jobs.Select(job => job.Name + " " + job.Level).Prepend(ch.Label)))
                                .ToLowerInvariant();
                            <div class="roster-row" data-search="@searchKey" data-jobs="@jobsKey">
                                <div class="roster-av @RosterAvClass(name)">@Initials(name)</div>
                                <div>
                                    <div class="roster-name">
                                        @name
                                        @if (hasSyncedApp)
                                        {
                                            <span class="roster-synced" title="Has opened and synced the app at least once">App</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(alts))
                                    {
                                        <div class="roster-name-sub">Alts: @alts</div>
                                    }
                                </div>
                                <div class="roster-jobs">
                                    @if (rendered.Count == 0)
                                    {
                                        <div class="jr-empty">No jobs entered</div>
                                    }
                                    @foreach (var ch in rendered)
                                    {
                                        <div class="jr-char">
                                            @* The row's Character column already names the main,
                                               so only alts need a label of their own. *@
                                            @if (ch.IsAlt)
                                            {
                                                <div class="jr-char-label">@ch.Label <span class="jr-alt-tag">alt</span></div>
                                            }
                                            @if (ch.Jobs.Count == 0)
                                            {
                                                <div class="jr-empty">No jobs entered</div>
                                            }
                                            else
                                            {
                                                <div class="jr-pills">
                                                    @foreach (var job in ch.Jobs)
                                                    {
                                                        var tipParts = new List<string>();
                                                        if (job.Relic) { tipParts.Add(string.IsNullOrWhiteSpace(job.RelicName) ? "Relic weapon" : "Relic: " + job.RelicName); }
                                                        if (job.Strong && !string.IsNullOrWhiteSpace(job.Merit)) { tipParts.Add("Merits: " + job.Merit); }
                                                        else if (job.Strong) { tipParts.Add("Merited"); }
                                                        var tip = tipParts.Count > 0 ? string.Join(" · ", tipParts) : null;
                                                        <span class="jr-pill @(job.Strong ? "jr-pill--strong" : "") @(job.Relic ? "relic-flame" : "")" title="@tip"><span class="jr-pill-job">@job.Name</span><span class="jr-pill-lvl">@job.Level</span>@if (job.Strong) {<span class="jr-pill-strong">★</span>}</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="roster-rank roster-col-rank">
                                    @rank
                                    @if (adminAppUserIds.Contains(m.AppUserId ?? string.Empty))
                                    {
                                        <span class="tag accent" title="App-wide admin override: full permissions in every linkshell they belong to.">🔧 ADMIN</span>
                                    }
                                </div>
                                <div class="roster-dkp roster-col-dkp">@((m.LinkshellDkp ?? 0).ToString("0.##"))</div>
                                <div class="roster-col-status"><span class="tag @statusClass">@status</span></div>
                            </div>
                        }
                    </div>

                    <div style="display:flex;align-items:center;gap:8px;padding:10px 16px;border-top:1px solid var(--border)">
                        <button type="button" class="btn sm" id="dashRosterPrev" disabled>← Prev</button>
                        <span id="dashRosterPageLabel" style="font-size:12px;color:var(--fg-3);min-width:90px;text-align:center">Page 1 / 1</span>
                        <button type="button" class="btn sm" id="dashRosterNext" disabled>Next →</button>
                    </div>

                    <script nonce="@Html.CspNonce()">
                        (function () {
                            var PAGE_SIZE = 5;
                            var list      = document.getElementById('dashRosterList');
                            var search    = document.getElementById('dashRosterSearch');
                            var showJobs  = document.getElementById('dashRosterShowJobs');
                            var prevBtn   = document.getElementById('dashRosterPrev');
                            var nextBtn   = document.getElementById('dashRosterNext');
                            var pageLabel = document.getElementById('dashRosterPageLabel');
                            var countEl   = document.getElementById('dashRosterCount');
                            if (!list) { return; }

                            var rows = Array.prototype.slice.call(list.querySelectorAll('.roster-row'));
                            var state = { page: 1, filtered: rows };

                            function render() {
                                var totalPages = Math.max(1, Math.ceil(state.filtered.length / PAGE_SIZE));
                                if (state.page > totalPages) { state.page = totalPages; }
                                var start = (state.page - 1) * PAGE_SIZE;
                                var end   = start + PAGE_SIZE;
                                for (var i = 0; i < rows.length; i++) { rows[i].style.display = 'none'; }
                                var slice = state.filtered.slice(start, end);
                                for (var j = 0; j < slice.length; j++) { slice[j].style.display = ''; }
                                if (pageLabel) { pageLabel.textContent = 'Page ' + state.page + ' / ' + totalPages; }
                                if (countEl) {
                                    countEl.textContent = (state.filtered.length === rows.length)
                                        ? (rows.length + ' members')
                                        : (state.filtered.length + ' of ' + rows.length + ' members');
                                }
                                if (prevBtn) { prevBtn.disabled = (state.page <= 1); }
                                if (nextBtn) { nextBtn.disabled = (state.page >= totalPages); }
                            }

                            function applyFilter() {
                                var q = (search ? search.value : '').trim().toLowerCase();
                                var jobsOn = showJobs ? showJobs.checked : false;
                                // One class swaps the whole list into the jobs view; the
                                // cells themselves are already rendered either way.
                                list.classList.toggle('roster--jobs', jobsOn);
                                state.filtered = rows.filter(function (r) {
                                    if (q === '') { return true; }
                                    if ((r.getAttribute('data-search') || '').indexOf(q) >= 0) { return true; }
                                    // Job names/levels join the search only while they show.
                                    return jobsOn && (r.getAttribute('data-jobs') || '').indexOf(q) >= 0;
                                });
                                state.page = 1;
                                render();
                            }

                            if (search) { search.addEventListener('input', applyFilter); }
                            if (showJobs) { showJobs.addEventListener('change', applyFilter); }
                            if (prevBtn) {
                                prevBtn.addEventListener('click', function () {
                                    if (state.page > 1) { state.page--; render(); }
                                });
                            }
                            if (nextBtn) {
                                nextBtn.addEventListener('click', function () {
                                    var total = Math.max(1, Math.ceil(state.filtered.length / PAGE_SIZE));
                                    if (state.page < total) { state.page++; render(); }
                                });
                            }

                            applyFilter();
                        })();
                    </script>
                }
            </div>
        </div>

        <div class="col">
            @if (Model.EnableToDs)
            {
            <div class="card fade d3">
                <div class="card-head">
                    <div class="card-title">ToD Tracker</div>
                    <a class="card-link" asp-controller="ToD" asp-action="Index">All HNMs</a>
                </div>
                @if (Model.TodTracker.Count == 0)
                {
                    <div class="empty">No tracked windows yet. Log a ToD to start tracking.</div>
                }
                else
                {
                    <div class="tod-tracker-list">
                        @foreach (var entry in Model.TodTracker)
                        {
                            <div class="tod-tracker-row">
                                <div class="tod-tracker-av @entry.StatusTagClass"></div>
                                <div class="tod-tracker-main">
                                    <div class="tod-tracker-head">
                                        <span class="tod-tracker-name">@entry.MonsterName</span>
                                        <span class="tag @entry.StatusTagClass">@entry.StatusLabel</span>
                                    </div>
                                    <div class="tod-tracker-bar">
                                        <div class="tod-tracker-bar-fill @entry.StatusTagClass" style="width:@(entry.ProgressPercent.ToString("0.##"))%"></div>
                                    </div>
                                </div>
                                <div class="tod-tracker-time">
                                    <div class="num">@entry.TimeLabel</div>
                                    <div class="tod-tracker-sub">@entry.TimeSubLabel</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            }

            @if (Model.EnableHnmSection)
            {
            <div class="card fade d4">
                <div class="card-head">
                    <div class="card-title">HNM Claims (last @Model.HnmClaimsWindowDays days)</div>
                </div>
                @if (Model.HnmClaims.Count == 0)
                {
                    <div class="empty">No claims in the last @Model.HnmClaimsWindowDays days.</div>
                }
                else
                {
                    <div class="donut-wrap">
                        <svg class="donut" viewBox="0 0 42 42">
                            <circle class="donut-track" cx="21" cy="21" r="15.9155" fill="none" stroke-width="4"></circle>
                            @{
                                double offset = 25;
                            }
                            @foreach (var claim in Model.HnmClaims)
                            {
                                var dash = claim.Percent;
                                var gap = 100 - dash;
                                <circle class="donut-seg donut-seg-@claim.ColorClass" cx="21" cy="21" r="15.9155" fill="none" stroke-width="4"
                                        stroke-dasharray="@(dash.ToString("0.##")) @(gap.ToString("0.##"))"
                                        stroke-dashoffset="@(offset.ToString("0.##"))"></circle>
                                offset = (offset - dash + 100) % 100;
                            }
                            <text x="21" y="20" text-anchor="middle" class="donut-value">@Model.HnmClaimsTotal</text>
                            <text x="21" y="25" text-anchor="middle" class="donut-label">CLAIMS</text>
                        </svg>
                        <div class="donut-legend">
                            @foreach (var claim in Model.HnmClaims)
                            {
                                <div class="donut-legend-row">
                                    <span class="donut-swatch donut-seg-@claim.ColorClass"></span>
                                    <span class="donut-legend-name">@claim.MonsterName</span>
                                    <span class="donut-legend-stats"><span class="num">@claim.Count</span> · @(claim.Percent.ToString("0.#"))%</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
            }

            <div class="card fade d5">
                <div class="card-head">
                    <div class="card-title">News &amp; updates</div>
                    <a class="card-link" asp-controller="DkpHistory" asp-action="Index">Full log</a>
                </div>
                @if (Model.NewsUpdates.Count == 0)
                {
                    <div class="empty">No recent updates yet.</div>
                }
                else
                {
                    <div class="news-list">
                        @foreach (var news in Model.NewsUpdates)
                        {
                            <div class="news-row">
                                <div class="news-icon donut-seg-@news.ColorClass"></div>
                                <div class="news-main">
                                    <div class="news-title">@news.Title</div>
                                    @if (!string.IsNullOrWhiteSpace(news.Subtitle))
                                    {
                                        <div class="news-sub">@news.Subtitle</div>
                                    }
                                </div>
                                <div class="news-meta">
                                    @if (news.Dkp.HasValue)
                                    {
                                        <div><span class="num">@news.Dkp.Value.ToString("N0")</span> dkp</div>
                                    }
                                    <div class="news-time">@news.RelativeTime</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

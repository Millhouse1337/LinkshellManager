@model LinkshellManagerDiscordApp.ViewModels.WindowEventsViewModel

@* The OPEN attendance-event cards, rendered inside Current Field Activity on the Event System
   page beside the camps that produced them.

   This partial used to render TWICE — a 'live' slice here and an 'archive' slice carrying the
   unlinked-snapshot list — switched by a required ViewData["AttendanceSection"] key. The unlinked
   list moved to its own top-level section (Views/Event/_UnlinkedSnapshots.cshtml), because it is
   live triage rather than archive leftovers and is now the only landing place for an unverified
   capture. With one mount left the switch, and the double-render hazards it existed to manage
   (TempData consumed by whichever slice ran first, a duplicated datalist id), are gone.

   The WindowEvent TempData alerts are still surfaced once by Event/Index.cshtml above every
   section rather than here — several sections can raise them now, not just this one.

   The bespoke `.attendance-page` re-theme the old standalone page carried did NOT come along: it
   was written for a view that opted out of the lsm theme (ViewData["BodyClass"] = ""), and
   Event/Index is a themed lsm-page. The base .we-* rules in site.css style these cards. *@

@if (Model.OpenEvents.Count > 0)
{
    <div class="card fade d3" style="margin-bottom:14px">
        <div class="card-head">
            <div class="card-title"><span class="attendance-crystal"></span> HNM Events <span class="tag">@Model.OpenEvents.Count</span></div>
        </div>
        <div class="we-open-list">
            @foreach (var ev in Model.OpenEvents)
            {
                @* By FULL PATH, not by name. A bare "_WindowEventCard" is resolved against the
                   executing CONTROLLER's folder (/Views/<controller>/ then /Views/Shared/), never
                   against the folder this partial happens to live in. That is fine while
                   WindowEvents renders it, and throws "The partial view was not found" the moment
                   the Event System page mounts this section -- which it does, so /Event 500'd for
                   every linkshell that had an open attendance event. Same rule applies to every
                   partial reference in this folder: it is mounted cross-controller. *@
                @await Html.PartialAsync("~/Views/WindowEvents/_WindowEventCard.cshtml", ev, new ViewDataDictionary(ViewData)
                {
                    ["LinkshellId"] = Model.LinkshellId,
                    ["CanManage"] = Model.CanManage,
                    ["IsClosed"] = false,
                })
            }
        </div>
    </div>
}

@using LinkshellManagerDiscordApp.Utils
@model LinkshellManagerDiscordApp.ViewModels.MemberProfileViewModel
@{
    ViewData["Title"] = "Member profile";
    ViewData["BodyClass"] = "lsm-page";

    string InitialsFor(string? name)
    {
        var initials = string.Concat((name ?? "?")
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(w => w[0])).ToUpperInvariant();
        if (string.IsNullOrEmpty(initials)) { initials = "?"; }
        return initials.Length > 2 ? initials[..2] : initials;
    }

    // Main + each named alt, as labeled characters to render (with their character
    // slot: 0 = main, 1 = alt 1, 2 = alt 2 — used for the peer-feedback fetch).
    var characters = new List<(string Label, bool IsAlt, int Slot, IReadOnlyList<int> Levels, IReadOnlyList<bool> Strong, IReadOnlyList<bool> Relic, IReadOnlyList<string> RelicName, IReadOnlyList<string> Merit, IReadOnlyList<int> Gear, IReadOnlyList<int> Skill)>
    {
        (Model.Entry.CharacterName, false, 0, Model.Entry.JobLevels, Model.Entry.StrongJobs, Model.Entry.RelicFlags, Model.Entry.RelicNames, Model.Entry.MeritJobs, Model.Entry.GearRatings, Model.Entry.SkillRatings)
    };
    if (Model.Entry.Alt1Name is not null) { characters.Add((Model.Entry.Alt1Name, true, 1, Model.Entry.Alt1JobLevels, Model.Entry.Alt1StrongJobs, Model.Entry.Alt1RelicFlags, Model.Entry.Alt1RelicNames, Model.Entry.Alt1MeritJobs, Model.Entry.Alt1GearRatings, Model.Entry.Alt1SkillRatings)); }
    if (Model.Entry.Alt2Name is not null) { characters.Add((Model.Entry.Alt2Name, true, 2, Model.Entry.Alt2JobLevels, Model.Entry.Alt2StrongJobs, Model.Entry.Alt2RelicFlags, Model.Entry.Alt2RelicNames, Model.Entry.Alt2MeritJobs, Model.Entry.Alt2GearRatings, Model.Entry.Alt2SkillRatings)); }
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">@Model.Entry.CharacterName</h1>
        <div class="page-sub">
            @if (!string.IsNullOrWhiteSpace(Model.LinkshellName))
            {
                <span>@Model.LinkshellName</span>
                <span class="dot"> · </span>
            }
            <span>@(Model.Entry.Rank ?? "Member")</span>
        </div>
    </div>
    <div class="page-actions">
        <a class="btn ghost" asp-action="Index" asp-route-selectedLinkshellId="@Model.LinkshellId">Back to team</a>
    </div>
</div>

<div class="card jr-card jr-card--profile fade d2" style="max-width:920px">
    <div class="jr-card-head">
        <div class="jr-av">@InitialsFor(Model.Entry.CharacterName)</div>
        <div class="jr-id">
            <div class="jr-name">@Model.Entry.CharacterName</div>
            <div class="jr-rank">@(Model.Entry.Rank ?? "Member")</div>
        </div>
    </div>

    <div class="jr-jobs-head">
        <div style="font-weight:500;color:var(--fg);font-size:13px">Jobs</div>
        <button type="button" class="btn ghost sm" id="jrShowAll">Show all jobs</button>
    </div>

    <div id="jrJobs">
    @foreach (var ch in characters)
    {
        var leveled = ch.Levels
            .Select((lvl, i) => new
            {
                Name = Model.JobCatalog[i],
                Level = lvl,
                Strong = i < ch.Strong.Count && ch.Strong[i],
                Relic = i < ch.Relic.Count && ch.Relic[i],
                RelicName = i < ch.RelicName.Count ? ch.RelicName[i] : "",
                Merit = i < ch.Merit.Count ? ch.Merit[i] : "",
                Gear = i < ch.Gear.Count ? ch.Gear[i] : 0,
                Skill = i < ch.Skill.Count ? ch.Skill[i] : 0
            })
            .Where(x => x.Level > 0)
            .OrderByDescending(x => x.Level)
            .ToList();

        // The character's leveled subjobs (37+), for the hover popover on each 75 pill.
        var subPool = ch.Levels
            .Select((lvl, i) => new { Name = Model.JobCatalog[i], Level = lvl })
            .Where(x => x.Level >= ProfileJobLevels.SubJobMinLevel)
            .OrderByDescending(x => x.Level)
            .ToList();

        <div class="jr-char">
            @if (ch.IsAlt)
            {
                <div class="jr-char-label">@ch.Label <span class="jr-alt-tag">alt</span></div>
            }
            @if (leveled.Count == 0)
            {
                <div class="jr-empty">No jobs entered</div>
            }
            else
            {
                <div class="jr-pills">
                    @foreach (var job in leveled)
                    {
                        var tipParts = new List<string>();
                        if (job.Relic) { tipParts.Add(string.IsNullOrWhiteSpace(job.RelicName) ? "Relic weapon" : "Relic: " + job.RelicName); }
                        if (job.Strong && !string.IsNullOrWhiteSpace(job.Merit)) { tipParts.Add("Merits: " + job.Merit); }
                        else if (job.Strong) { tipParts.Add("Merited"); }
                        var tip = tipParts.Count > 0 ? string.Join(" · ", tipParts) : null;
                        var isMax = job.Level >= ProfileJobLevels.MaxLevel;
                        var subs = subPool.Where(s => s.Name != job.Name).ToList();
                        <span class="jr-pill @(job.Strong ? "jr-pill--strong" : "") @(job.Relic ? "relic-flame" : "") @(isMax ? "" : "jr-pill--sub-hidden")" data-lvl="@job.Level" tabindex="@(isMax ? 0 : -1)" title="@tip"><span class="jr-pill-job">@job.Name</span><span class="jr-pill-lvl">@job.Level</span>@if (job.Strong) {<span class="jr-pill-strong">★</span>}@if (isMax)
                        {
                            <span class="jr-subpop"><span class="jr-subpop-title">Leveled subs (37+)</span>@if (subs.Count == 0){<span class="jr-subpop-empty">None</span>}@foreach (var s in subs){<span class="jr-subchip">@s.Name<span class="lvl">@s.Level</span></span>}</span>
                        }</span>
                    }
                </div>
            }
        </div>
    }
    </div>
</div>

@if (Model.TargetAppUserId is not null)
{
    var peerConfig = System.Text.Json.JsonSerializer.Serialize(new
    {
        linkshellId = Model.LinkshellId,
        targetAppUserId = Model.TargetAppUserId,
        jobs = Model.JobCatalog,
        slots = characters.Select(c => new { slot = c.Slot, name = c.Label, isAlt = c.IsAlt })
    });

    <div class="card jr-card jr-card--profile fade d3" style="max-width:920px;margin-top:16px">
        <div style="font-weight:600;color:var(--fg);font-size:14px">Ratings</div>
        <div id="memberPeer" style="font-size:12px;color:var(--fg-3)">Loading ratings…</div>
    </div>

    <script id="member-peer-config" type="application/json" nonce="@Html.CspNonce()">@Html.Raw(peerConfig)</script>
    <script src="~/js/member-peer.js" nonce="@Html.CspNonce()" asp-append-version="true"></script>
}

<script nonce="@Html.CspNonce()">
    (function () {
        var btn = document.getElementById('jrShowAll');
        var jobs = document.getElementById('jrJobs');
        if (!btn || !jobs) { return; }
        btn.addEventListener('click', function () {
            var on = jobs.classList.toggle('jr-show-all');
            btn.textContent = on ? 'Show 75s only' : 'Show all jobs';
        });
    })();
</script>

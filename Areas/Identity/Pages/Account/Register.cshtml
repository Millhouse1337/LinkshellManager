@page
@model LinkshellManagerDiscordApp.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
    var returnUrl = Model.ReturnUrl ?? "/";
    var discordLoginHref = $"/auth/discord/login?returnUrl={Uri.EscapeDataString(returnUrl)}";
    var loginHref = string.IsNullOrWhiteSpace(Model.ReturnUrl)
        ? "/Identity/Account/Login"
        : $"/Identity/Account/Login?returnUrl={Uri.EscapeDataString(Model.ReturnUrl)}";
}

<div class="auth-card">
    <div class="auth-brand">
        <span class="brand-mark">LS</span>
        <span class="brand-name">LinkshellManager</span>
    </div>

    <span class="auth-badge">First-time setup</span>
    <h1 class="auth-title">Create your account</h1>
    <p class="auth-sub">
        New accounts are created from your Discord identity so the website and Discord Activity always resolve to the same app user.
    </p>

    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <div class="auth-actions">
        <a class="btn primary" href="@discordLoginHref">Continue with Discord</a>
        <a class="btn" href="@loginHref">Already have access?</a>
    </div>

    <div class="auth-meta">
        Your Discord profile will be used to populate your character name and avatar.
    </div>
</div>

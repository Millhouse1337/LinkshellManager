@model IEnumerable<LinkshellManagerDiscordApp.ViewModels.ManageItemViewModel>
@{
    ViewData["Title"] = "Items";
    ViewData["BodyClass"] = "lsm-page";
    var canManage = (bool)(ViewBag.CanManage ?? false);
    var linkshellName = ViewBag.LinkshellName as string;

    // Stockpile is what the linkshell still holds; Sold is the archive. Sold items are kept — the gil
    // entry points at them, and "what did that Osode go for" is a real question — but a stash you can
    // still sell from should not be padded out with things already gone.
    var showingSold = string.Equals(ViewBag.View as string, "sold", StringComparison.OrdinalIgnoreCase);
    var stockpile = Model.Where(item => !item.IsSold).ToList();
    // Most recently sold first: the archive only grows, and the newest sale is the interesting one.
    var sold = Model.Where(item => item.IsSold).OrderByDescending(item => item.UpdatedAt).ToList();
    var shown = showingSold ? sold : stockpile;
    var soldTotal = sold.Sum(item => item.SoldPrice ?? 0);
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Items</h1>
        <div class="page-sub">
            @if (!string.IsNullOrWhiteSpace(linkshellName))
            {
                <span>@linkshellName</span>
                <span class="dot"> · </span>
            }
            <span><span class="num">@stockpile.Count</span> item@(stockpile.Count == 1 ? "" : "s") in the stash</span>
            @if (sold.Count > 0)
            {
                <span class="dot"> · </span>
                <span><span class="num">@sold.Count</span> sold</span>
            }
        </div>
    </div>
    @if (canManage)
    {
        <div class="page-actions">
            <a class="btn primary" asp-action="AddItem">+ Add item</a>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="card fade d2">
        <div class="empty">
            <div style="font-size:15px;color:var(--fg);font-weight:500;margin-bottom:6px">No items yet</div>
            <div style="margin-bottom:12px">
                @if (canManage)
                {
                    <span>Track gear, consumables, or gil reserves for your linkshell.</span>
                }
                else
                {
                    <span>No items have been added for your linkshell.</span>
                }
            </div>
            @if (canManage)
            {
                <a class="btn primary" asp-action="AddItem">Add item</a>
            }
        </div>
    </div>
}
else
{
    <div class="card fade d2">
        <div class="card-head">
            <div style="display:flex;gap:6px;align-items:center">
                <a class="btn sm @(showingSold ? "ghost" : "primary")" asp-action="Index">Stockpile</a>
                <a class="btn sm @(showingSold ? "primary" : "ghost")"
                   asp-action="Index" asp-route-view="sold">Sold</a>
            </div>
            <span class="tag">
                @if (showingSold)
                {
                    @($"{sold.Count} sold · {soldTotal:N0} gil")
                }
                else
                {
                    @($"{stockpile.Count} items · {stockpile.Sum(item => item.Quantity)} qty")
                }
            </span>
        </div>

        @if (shown.Count == 0)
        {
            <div class="empty" style="padding:24px 16px">
                @if (showingSold)
                {
                    <span>Nothing sold yet. Items move here once they are marked sold, with what they went for.</span>
                }
                else
                {
                    <span>Everything in the stash has been sold. The Sold tab has the @sold.Count of them.</span>
                }
            </div>
        }
        else
        {
        <table class="table themed">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Type</th>
                    <th style="text-align:right">Quantity</th>
                    <th>Notes</th>
                    <th>Added by</th>
                    @if (canManage)
                    {
                        <th style="text-align:right">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in shown)
                {
                    <tr>
                        <td style="font-weight:500">
                            @item.ItemName
                            @if (item.IsSold)
                            {
                                <span class="tag success" style="margin-left:6px">Sold @((item.SoldPrice ?? 0).ToString("N0")) gil</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.ItemType))
                            {
                                <span class="tag">@item.ItemType</span>
                            }
                            else
                            {
                                <span style="color:var(--fg-4)">—</span>
                            }
                        </td>
                        <td class="num" style="text-align:right">@item.Quantity</td>
                        <td style="color:var(--fg-3)">@(item.Notes ?? "")</td>
                        <td style="font-size:12px;color:var(--fg-3)">
                            @if (!string.IsNullOrWhiteSpace(item.CreatedByCharacterName))
                            {
                                <div>@item.CreatedByCharacterName</div>
                            }
                            <div>@item.CreatedAt.ToString("MMM d, yyyy")</div>
                        </td>
                        @if (canManage)
                        {
                            <td style="text-align:right">
                                <div style="display:inline-flex;gap:6px;flex-wrap:wrap;justify-content:flex-end">
                                    @if (!item.IsSold)
                                    {
                                        <button type="button" class="btn primary sm js-sell"
                                                data-item-id="@item.Id" data-item-name="@item.ItemName">Sell</button>
                                        <a class="btn ghost sm" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                                    }
                                    else
                                    {
                                        <form asp-action="Unsell" asp-route-id="@item.Id" method="post" style="display:inline"
                                              onsubmit="return confirm('Undo this sale? An opposite entry cancels the gil out in the Treasury — the original stays in the list, so nothing disappears.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn ghost sm">Unsell</button>
                                        </form>
                                    }
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline"
                                          onsubmit="return confirm('Delete this item?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn ghost sm" style="color:var(--danger)">Delete</button>
                                    </form>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        }
    </div>
}

@if (canManage)
{
    <!-- Sell modal: a single shared dialog; the per-row "Sell" button fills in the
         item id/name. Posts to MarkSold, which records the income in Finances. -->
    <div id="sellModal" style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.55);align-items:center;justify-content:center;padding:16px">
        <div class="card" style="max-width:420px;width:100%">
            <div class="card-head">
                <div class="card-title">Sell item</div>
            </div>
            <form asp-action="MarkSold" method="post" style="padding:14px 16px;display:flex;flex-direction:column;gap:12px">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="sellItemId" />
                <div style="font-size:13px;color:var(--fg-3)">
                    Mark <strong id="sellItemName" style="color:var(--fg)"></strong> as sold. The amount is added to
                    your linkshell's Finances as income.
                </div>
                <label style="display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--fg-3)">
                    Sale price (gil)
                    <input type="number" name="salePrice" id="sellPrice" min="0" step="1" required
                           inputmode="numeric" placeholder="e.g. 500000" />
                </label>
                <div style="display:flex;gap:8px;justify-content:flex-end">
                    <button type="button" class="btn ghost sm" id="sellCancel">Cancel</button>
                    <button type="submit" class="btn primary sm">Confirm sale</button>
                </div>
            </form>
        </div>
    </div>

    <script nonce="@Html.CspNonce()">
        (function () {
            var modal = document.getElementById('sellModal');
            var idInput = document.getElementById('sellItemId');
            var nameEl = document.getElementById('sellItemName');
            var priceInput = document.getElementById('sellPrice');
            function open(id, name) {
                idInput.value = id;
                nameEl.textContent = name;
                priceInput.value = '';
                modal.style.display = 'flex';
                priceInput.focus();
            }
            function close() { modal.style.display = 'none'; }
            document.querySelectorAll('.js-sell').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    open(btn.getAttribute('data-item-id'), btn.getAttribute('data-item-name'));
                });
            });
            var cancel = document.getElementById('sellCancel');
            if (cancel) { cancel.addEventListener('click', close); }
            modal.addEventListener('click', function (e) { if (e.target === modal) { close(); } });
        })();
    </script>
}

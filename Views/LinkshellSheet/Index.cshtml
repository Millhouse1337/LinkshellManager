@model LinkshellManagerDiscordApp.ViewModels.LinkshellSheetViewModel
@{
    ViewData["Title"] = "Import DKP";
    var preview = Model.TemplatePreview;
    // Live sync auto-pushes the export sheet, so it only makes sense once that
    // sheet exists (created on the Export DKP page) and Google is connected.
    var hasSheet = !string.IsNullOrWhiteSpace(Model.SpreadsheetId) && Model.IsOAuthConnected;
}

@functions {
    // "2026-05-15 18:59" -> "May 15th 2026 06:59 pm". ConnectedAt is stored UTC;
    // we keep the UTC tag so the timestamp stays unambiguous.
    static string PrettyUtc(DateTime utc)
    {
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        var day = utc.Day;
        var suffix = (day % 100) is >= 11 and <= 13
            ? "th"
            : (day % 10) switch { 1 => "st", 2 => "nd", 3 => "rd", _ => "th" };
        var month = utc.ToString("MMMM", ci);
        var time = utc.ToString("hh:mm", ci);
        var meridiem = utc.ToString("tt", ci).ToLowerInvariant();
        return $"{month} {day}{suffix} {utc.Year} {time} {meridiem}";
    }
}

<div class="page-head fade d1 sheet-head">
    <div>
        <h1 class="page-title">Import DKP</h1>
        <div class="page-sub">
            <span>Connect Google, then import your existing DKP from a spreadsheet</span>
            @if (!string.IsNullOrWhiteSpace(Model.LinkshellName))
            {
                <span class="dot"> · </span>
                <span>@Model.LinkshellName</span>
            }
        </div>
    </div>

    @* Live sync toggle (top right) — auto-pushes the export sheet whenever DKP changes. *@
    <form asp-action="ToggleLiveSync" asp-route-linkshellId="@Model.LinkshellId" method="post" id="liveSyncForm" class="sheet-livesync">
        <div class="sheet-livesync__text">
            <span class="sheet-livesync__title">Live sync</span>
            <span class="sheet-livesync__state">
                @if (Model.LiveSyncEnabled)
                {
                    <text>On — sheet auto-updates</text>
                }
                else if (hasSheet)
                {
                    <text>Off</text>
                }
                else
                {
                    <text>Set up Export DKP first</text>
                }
            </span>
        </div>
        <input type="hidden" name="enabled" id="liveSyncEnabled" value="@(Model.LiveSyncEnabled ? "true" : "false")" />
        <input type="checkbox" class="switch" id="liveSyncToggle"
               @(Model.LiveSyncEnabled ? "checked" : "")
               @(hasSheet ? "" : "disabled")
               title="@(hasSheet ? "Auto-update your Google Sheet whenever DKP changes" : "Create your export sheet on the Export DKP page first")" />
    </form>
</div>

<style nonce="@Html.CspNonce()">
    .sheet-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .sheet-livesync { display: flex; align-items: center; gap: 10px; margin: 0; }
    .sheet-livesync__text { display: flex; flex-direction: column; align-items: flex-end; line-height: 1.25; }
    .sheet-livesync__title { font-size: 13px; font-weight: 600; color: var(--fg-2); }
    .sheet-livesync__state { font-size: 11px; color: var(--fg-3); }

    /* Space the stacked step cards apart so each reads as its own block. */
    .sheet-cards > .card { margin-bottom: 16px; }
    .sheet-cards > .card:last-child { margin-bottom: 0; }

    /* The numbered step badge in each card head. */
    .step-badge {
        display: inline-flex; align-items: center; justify-content: center;
        width: 22px; height: 22px; margin-right: 8px;
        border-radius: 999px; background: var(--accent); color: #fff;
        font-size: 12px; font-weight: 700; flex: 0 0 auto; vertical-align: middle;
    }

    .sheet-cards .form-row { display: flex; flex-direction: column; gap: 6px; }
    .sheet-cards .form-row + .form-row { margin-top: 14px; }
    .sheet-cards .form-row > label,
    .sheet-cards .form-row > span:first-child { font-size: 13px; font-weight: 500; color: var(--fg-2); }
    .sheet-cards .form-row > small { font-size: 12px; color: var(--fg-3); line-height: 1.6; }

    .sheet-upload { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end; margin-top: 12px; }
    .sheet-upload .file-field { display: flex; flex-direction: column; gap: 6px; }
    .sheet-upload .file-field > span { font-size: 13px; font-weight: 500; color: var(--fg-2); }
    .sheet-upload input[type=file] { max-width: 360px; }

    .import-table { width: 100%; border-collapse: collapse; font-size: 13px; margin-top: 8px; }
    .import-table th { text-align: left; padding: 6px 10px; color: var(--fg-3); font-weight: 600; }
    .import-table td { padding: 6px 10px; border-top: 1px solid var(--border, #222); }
    .import-table .num { text-align: right; }
</style>

<div class="sheet-cards">

@if (TempData["SheetImportError"] is string err)
{
    <div class="alert alert-danger fade d2">@err</div>
}
@if (TempData["SheetConfigError"] is string cfgErr)
{
    <div class="alert alert-danger fade d2">@cfgErr</div>
}
@if (TempData["SheetConfigSuccess"] is string ok)
{
    <div class="alert alert-success fade d2">@ok</div>
}
@if (TempData["SheetImportSuccess"] is string imp)
{
    <div class="alert alert-success fade d2">@imp</div>
}

@if (!Model.IsOAuthConfigured)
{
    <div class="card fade d2">
        <div class="card-head">
            <div class="card-title">Google OAuth not configured</div>
        </div>
        <div class="empty">
            The server admin must set <code>GoogleSheets:ClientId</code> and <code>GoogleSheets:ClientSecret</code> in app configuration to enable Google sync. You can still import a DKP file below.
        </div>
    </div>
}
else
{
    <div class="card fade d2">
        <div class="card-head">
            <div class="card-title"><span class="step-badge">1</span>Connect Google account</div>
        </div>
        <div style="padding:12px 16px">
            @if (Model.IsOAuthConnected)
            {
                <p style="margin-top:0">
                    Connected as <strong>@Model.ConnectedGoogleEmail</strong>
                    @if (Model.ConnectedAtUserLocal.HasValue)
                    {
                        <text> · since @PrettyUtc(Model.ConnectedAtUserLocal.Value)</text>
                        @if (!string.IsNullOrWhiteSpace(Model.ConnectedAtTimeZoneLabel))
                        {
                            <text> (@Model.ConnectedAtTimeZoneLabel)</text>
                        }
                    }
                    else if (Model.ConnectedAt.HasValue)
                    {
                        <text> · since @PrettyUtc(Model.ConnectedAt.Value) UTC</text>
                    }
                </p>
                <form asp-action="Disconnect" asp-route-linkshellId="@Model.LinkshellId" method="post" style="display:inline">
                    <button type="submit" class="btn" onclick="return confirm('Disconnect Google? Sync will pause until you reconnect.');">Disconnect</button>
                </form>
                <form asp-action="Connect" asp-route-linkshellId="@Model.LinkshellId" method="post" style="display:inline;margin-left:6px">
                    <button type="submit" class="btn">Reconnect a different account</button>
                </form>
                <p style="margin:12px 0 0;font-size:12px;color:var(--fg-3)">
                    Next: head to <a asp-action="Export" asp-route-linkshellId="@Model.LinkshellId">Export DKP</a> to create your sheet and push DKP to Google.
                </p>
            }
            else
            {
                <p style="margin-top:0">Authorize LSManager to create and manage a single DKP spreadsheet for this linkshell. You'll see Google's consent screen — LSManager only ever sees the one sheet it creates, never your other spreadsheets.</p>
                <form asp-action="Connect" asp-route-linkshellId="@Model.LinkshellId" method="post">
                    <button type="submit" class="btn btn-primary">Connect Google account</button>
                </form>
            }
        </div>
    </div>
}

<div class="card fade d3">
    <div class="card-head">
        <div class="card-title"><span class="step-badge">2</span>Import your DKP</div>
    </div>
    <div style="padding:12px 16px">
        <p style="margin-top:0">
            Already tracking DKP in a spreadsheet? Bring it in here. Lay it out like the template —
            headers <strong>Member Name</strong>, <strong>Alt 1</strong>, <strong>Alt 2</strong>,
            <strong>Current DKP</strong>, <strong>Total DKP</strong>, <strong>Total DKP Spent</strong> —
            then upload the file. Members match by name (alts count too); <em>Current DKP</em> sets each
            member's balance and <em>Total / Total Spent</em> seed their lifetime totals.
        </p>

        <ol style="margin:0 0 4px;padding-left:20px;color:var(--fg-2);font-size:13px;line-height:1.8">
            <li><strong>View template</strong> to download a sample, then fill it in with your members.</li>
            <li><strong>Upload</strong> the saved <code>.xlsx</code> (or <code>.csv</code>) below and <strong>Preview</strong> it.</li>
            <li>Check the matches, then <strong>Save import</strong>.</li>
        </ol>

        <div style="margin-top:10px">
            <a class="btn" asp-action="DownloadSampleTemplate" asp-route-linkshellId="@Model.LinkshellId">View template (.xlsx)</a>
        </div>

        <form asp-action="ImportPreview" asp-route-linkshellId="@Model.LinkshellId" method="post" enctype="multipart/form-data" class="sheet-upload">
            <label class="file-field">
                <span>Upload your DKP file</span>
                <input class="input" type="file" name="file" accept=".xlsx,.csv" required />
            </label>
            <button type="submit" class="btn btn-primary">Preview import</button>
        </form>
    </div>

    @if (preview is not null)
    {
        <div style="padding:0 16px 14px">
            <div style="margin:6px 0 4px;font-size:14px">
                <span style="color:#4ade80">@preview.MatchedCount matched</span> ·
                <span style="color:#fbbf24">@preview.UnmatchedCount not in roster</span>
                @if (!string.IsNullOrWhiteSpace(Model.ImportFileName))
                {
                    <text> · file <code>@Model.ImportFileName</code></text>
                }
            </div>

            @if (preview.Rows.Count == 0)
            {
                <div class="empty">No rows found in the file. Check the headers match the template.</div>
            }
            else
            {
                <table class="import-table">
                    <thead><tr>
                        <th>Member</th>
                        <th class="num">Current (file → app)</th>
                        <th class="num">Total</th>
                        <th class="num">Spent</th>
                        <th>Match</th>
                    </tr></thead>
                    <tbody>
                    @foreach (var row in preview.Rows)
                    {
                        <tr>
                            <td>@row.Name</td>
                            <td class="num">
                                @if (row.Matched)
                                {
                                    <span>@row.OldCurrent.ToString("0.##") → <strong>@row.NewCurrent.ToString("0.##")</strong></span>
                                }
                                else
                                {
                                    <span>@row.NewCurrent.ToString("0.##")</span>
                                }
                            </td>
                            <td class="num">@row.Total.ToString("0.##")</td>
                            <td class="num">@row.Spent.ToString("0.##")</td>
                            <td>
                                @if (row.Matched)
                                {
                                    <span style="color:#4ade80">✓ matched</span>
                                }
                                else
                                {
                                    <span style="color:#fbbf24">no member</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>

                <form asp-action="ImportCommit" asp-route-linkshellId="@Model.LinkshellId" method="post" style="margin-top:12px">
                    <input type="hidden" name="payload" value="@Model.ImportPayloadJson" />
                    <input type="hidden" name="fileName" value="@Model.ImportFileName" />
                    <button type="submit" class="btn btn-primary" onclick="return confirm('Save this import? It sets each matched member’s Current DKP and seeds their lifetime Total / Total Spent.');">Save import</button>
                </form>
            }
        </div>
    }
</div>

</div>@* /.sheet-cards *@

@section Scripts {
    <script nonce="@Html.CspNonce()">
        (function () {
            var toggle = document.getElementById('liveSyncToggle');
            if (!toggle) { return; }
            toggle.addEventListener('change', function () {
                document.getElementById('liveSyncEnabled').value = toggle.checked ? 'true' : 'false';
                document.getElementById('liveSyncForm').submit();
            });
        })();
    </script>
}

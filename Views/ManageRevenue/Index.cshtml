@model IEnumerable<LinkshellManagerDiscordApp.ViewModels.ManageRevenueViewModel>
@{
    ViewData["Title"] = "Revenue";
    ViewData["BodyClass"] = "lsm-page";
    var canManage = (bool)(ViewBag.CanManage ?? false);
    var linkshellName = ViewBag.LinkshellName as string;
    var totalValue = (long)(ViewBag.TotalValue ?? 0L);
    var moneyIn = (long)(ViewBag.MoneyIn ?? 0L);
    var moneyOut = (long)(ViewBag.MoneyOut ?? 0L);
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">Revenue</h1>
        <div class="page-sub">
            @if (!string.IsNullOrWhiteSpace(linkshellName))
            {
                <span>@linkshellName</span>
                <span class="dot"> · </span>
            }
            <span><span class="num">@Model.Count()</span> entr@(Model.Count() == 1 ? "y" : "ies")</span>
            <span class="dot"> · </span>
            <span>In <span class="num">@moneyIn.ToString("N0")</span></span>
            <span class="dot"> · </span>
            <span>Out <span class="num">@moneyOut.ToString("N0")</span></span>
            <span class="dot"> · </span>
            <span>Gil on hand <span class="num">@totalValue.ToString("N0")</span></span>
        </div>
    </div>
    @if (canManage)
    {
        <div class="page-actions">
            <a class="btn primary" asp-action="AddIncome">+ Add income</a>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="card fade d2">
        <div class="empty">
            <div style="font-size:15px;color:var(--fg);font-weight:500;margin-bottom:6px">No income recorded yet</div>
            <div style="margin-bottom:12px">
                @if (canManage)
                {
                    <span>Log AH sales, mercenary work, or donations to track your linkshell's revenue.</span>
                }
                else
                {
                    <span>No revenue entries have been added for your linkshell.</span>
                }
            </div>
            @if (canManage)
            {
                <a class="btn primary" asp-action="AddIncome">Add income</a>
            }
        </div>
    </div>
}
else
{
    <div class="card fade d2">
        <div class="card-head">
            <div class="card-title">Income ledger</div>
        </div>
        <table class="table themed">
            <thead>
                <tr>
                    <th>When</th>
                    <th>Source</th>
                    <th>Category</th>
                    <th>Details</th>
                    <th>Logged by</th>
                    <th style="text-align:right">Value</th>
                    @if (canManage)
                    {
                        <th style="text-align:right">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model)
                {
                    <tr>
                        <td style="font-size:12px;color:var(--fg-3)">@entry.OccurredAt.ToString("MMM d, yyyy")</td>
                        <td><span class="tag">@entry.EntryType</span></td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(entry.Category))
                            {
                                <span>@entry.Category</span>
                            }
                            else
                            {
                                <span style="color:var(--fg-4)">—</span>
                            }
                        </td>
                        <td style="color:var(--fg-3)">@(entry.Details ?? "")</td>
                        <td style="font-size:12px;color:var(--fg-3)">@(entry.CreatedByCharacterName ?? "")</td>
                        <td class="num" style="text-align:right;font-weight:500">@entry.Value.ToString("N0")</td>
                        @if (canManage)
                        {
                            <td style="text-align:right">
                                <div style="display:inline-flex;gap:6px;flex-wrap:wrap">
                                    <a class="btn ghost sm" asp-action="Edit" asp-route-id="@entry.Id">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@entry.Id" method="post" style="display:inline"
                                          onsubmit="return confirm('Delete this revenue entry?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn ghost sm" style="color:var(--danger)">Delete</button>
                                    </form>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

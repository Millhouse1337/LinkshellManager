@model LinkshellManagerDiscordApp.ViewModels.WindowEventRow
@using LinkshellManagerDiscordApp.Models
@{
    var linkshellId = (int)(ViewData["LinkshellId"] ?? 0);
    var canManage = (bool)(ViewData["CanManage"] ?? false);
    var isClosed = (bool)(ViewData["IsClosed"] ?? false);
    string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value!;
    string Jobs(WindowCombinedMemberRow row)
    {
        var main = string.IsNullOrWhiteSpace(row.MainJob) ? "-" : row.MainJob + (row.MainJobLevel?.ToString() ?? "");
        var sub = string.IsNullOrWhiteSpace(row.SubJob) ? "-" : row.SubJob + (row.SubJobLevel?.ToString() ?? "");
        return $"{main}/{sub}";
    }
}

<details class="card fade d4" open style="margin-top:14px">
    <summary style="padding:12px 16px;cursor:pointer;list-style:revert">
        <strong style="font-size:16px">@Dash(Model.Name)</strong>
        <span style="color:var(--fg-muted,#888)"> &middot; </span>
        <strong>@Model.FirstCapturedDisplay</strong>
        <span style="color:var(--fg-muted,#888)"> &middot; </span>
        <span>@Model.CombinedMemberCount unique member@(Model.CombinedMemberCount == 1 ? "" : "s")</span>
        <span style="color:var(--fg-muted,#888)"> &middot; </span>
        <span>@Model.SnapshotCount snapshot@(Model.SnapshotCount == 1 ? "" : "s")</span>
        @if (Model.DuplicateSnapshotCount > 0)
        {
            <span style="display:inline-block;margin-left:6px;padding:1px 8px;border-radius:10px;background:rgba(251,191,36,0.15);color:#fbbf24;font-size:12px">
                @Model.DuplicateSnapshotCount duplicate review
            </span>
        }
        @if (isClosed)
        {
            <span style="display:inline-block;margin-left:6px;padding:1px 8px;border-radius:10px;background:rgba(148,163,184,0.15);color:#cbd5e1;font-size:12px">Closed</span>
        }
    </summary>

    @if (canManage)
    {
        <div style="padding:0 16px 8px 32px;display:flex;flex-wrap:wrap;gap:8px;align-items:center">
            <form asp-action="Rename" asp-route-linkshellId="@linkshellId" asp-route-windowEventId="@Model.Id" method="post" style="display:flex;gap:6px;align-items:center">
                @Html.AntiForgeryToken()
                <input type="text" name="name" value="@Model.Name" maxlength="128" required />
                <button type="submit" class="btn sm">Rename</button>
            </form>
            @if (isClosed)
            {
                <form asp-action="Reopen" asp-route-linkshellId="@linkshellId" asp-route-windowEventId="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn sm">Reopen</button>
                </form>
            }
            else
            {
                <form asp-action="Close" asp-route-linkshellId="@linkshellId" asp-route-windowEventId="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn sm ghost">Close</button>
                </form>
            }
        </div>
    }

    <div style="padding:8px 16px 16px 32px">
        <div style="font-size:13px;color:var(--fg-muted,#888);margin-bottom:6px">
            Combined roster excludes snapshots marked duplicate or ignored.
        </div>
        <div style="overflow-x:auto">
            <table style="width:100%;max-width:840px;border-collapse:collapse;font-size:13px">
                <thead>
                    <tr>
                        <th style="text-align:left;padding:6px 10px">Character</th>
                        <th style="text-align:left;padding:6px 10px">Jobs</th>
                        <th style="text-align:left;padding:6px 10px">Zone</th>
                        <th style="text-align:right;padding:6px 10px">Snapshots</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var member in Model.CombinedMembers)
                {
                    <tr style="border-top:1px solid var(--border,#222)">
                        <td style="padding:6px 10px"><strong>@member.CharacterName</strong></td>
                        <td style="padding:6px 10px">@Jobs(member)</td>
                        <td style="padding:6px 10px">@Dash(member.Zone)</td>
                        <td style="padding:6px 10px;text-align:right">@member.SnapshotCount</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div style="padding:0 16px 16px 32px">
        <div class="card-title" style="font-size:14px;margin-bottom:6px">Posted snapshots</div>
        @foreach (var snapshot in Model.Snapshots)
        {
            <details style="border-top:1px solid var(--border,#222)">
                <summary style="padding:8px 0;cursor:pointer;list-style:revert">
                    <strong>@snapshot.CapturedAtDisplay</strong>
                    <span style="color:var(--fg-muted,#888)"> &middot; </span>
                    <span>Posted by <strong>@Dash(snapshot.CapturedByCharacterName)</strong></span>
                    <span style="color:var(--fg-muted,#888)"> &middot; </span>
                    <span>@snapshot.EntryCount member@(snapshot.EntryCount == 1 ? "" : "s")</span>
                    @if (snapshot.SnapshotStatus != AttendanceSnapshotStatuses.Active)
                    {
                        <span style="display:inline-block;margin-left:6px;padding:1px 8px;border-radius:10px;background:rgba(251,191,36,0.15);color:#fbbf24;font-size:12px">
                            @snapshot.SnapshotStatus
                        </span>
                    }
                </summary>
                @if (canManage)
                {
                    <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin:0 0 8px 24px">
                        <form asp-action="SetSnapshotStatus" asp-route-linkshellId="@linkshellId" asp-route-snapshotId="@snapshot.Id" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="status" value="@AttendanceSnapshotStatuses.Active" />
                            <button type="submit" class="btn sm" @(snapshot.SnapshotStatus == AttendanceSnapshotStatuses.Active ? "disabled" : "")>Use</button>
                        </form>
                        <form asp-action="SetSnapshotStatus" asp-route-linkshellId="@linkshellId" asp-route-snapshotId="@snapshot.Id" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="status" value="@AttendanceSnapshotStatuses.Duplicate" />
                            <button type="submit" class="btn sm ghost">Mark duplicate</button>
                        </form>
                        <form asp-action="SetSnapshotStatus" asp-route-linkshellId="@linkshellId" asp-route-snapshotId="@snapshot.Id" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="status" value="@AttendanceSnapshotStatuses.Ignored" />
                            <button type="submit" class="btn sm ghost">Ignore</button>
                        </form>
                    </div>
                }
                @await Html.PartialAsync("_WindowSnapshotEntries", snapshot)
            </details>
        }
    </div>
</details>

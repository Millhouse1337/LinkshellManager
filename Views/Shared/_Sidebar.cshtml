            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="10" r="2"/><path d="M3 20c0-3 3-5 6-5s6 2 6 5M15 20c0-2 2-3 4-3s4 1 4 3"/></svg>
            Manage Team
            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M9 6l6 6-6 6"/></svg>
        </button>
        <div id="nav-team" class="nav-sub">
            <a class="nav-sub-item @IsSubActive("ManageTeam", "Index")" asp-controller="ManageTeam" asp-action="Index">View Team</a>
            <a class="nav-sub-item @IsSubActive("ManageTeam", "JobsRoster")" asp-controller="ManageTeam" asp-action="JobsRoster">Jobs Roster</a>
            @if (Allow(p => p.CanManageMembers))
            {
                <a class="nav-sub-item create @IsSubActive("ManageTeam", "SearchPlayers")" asp-controller="ManageTeam" asp-action="SearchPlayers">Add Members</a>
            }
            <a class="nav-sub-item @IsSubActive("ManageTeam", "ViewInvites")" asp-controller="ManageTeam" asp-action="ViewInvites">View Invites</a>
        </div>

        @* Items and Gil moved out to their own Treasury section below. Management is people:
           roster, ranks, invites, DKP, loot. *@

        <button type="button" class="nav-item nav-group @IsExpanded("DkpHistory", "DkpAdjustment", "DkpSheet")" data-target="#nav-dkp">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="9"/><path d="M8 12h8M12 8v8"/></svg>
            DKP
            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M9 6l6 6-6 6"/></svg>
        </button>
        <div id="nav-dkp" class="nav-sub">
            <a class="nav-sub-item @IsSubActive("DkpHistory", "Index")" asp-controller="DkpHistory" asp-action="Index">View DKP</a>
            @if (Allow(p => p.CanAuditDkp))
            {
                <a class="nav-sub-item create @IsSubActive("DkpAdjustment", "Index")" asp-controller="DkpAdjustment" asp-action="Index">DKP Adjustments</a>
            }
            @if (activeLinkshellId.HasValue)
            {
                <a class="nav-sub-item @IsSubActive("DkpSheet")" asp-controller="DkpSheet" asp-action="Index" asp-route-linkshellId="@activeLinkshellId.Value">DKP Sheet</a>
            }
        </div>

        <button type="button" class="nav-item nav-group @IsExpanded("LootHistory")" data-target="#nav-loot">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M7 8h10l2 12H5z"/><path d="M9 8a3 3 0 0 1 6 0"/><path d="M10 13h4"/></svg>
            Loot

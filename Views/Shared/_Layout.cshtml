@using Microsoft.AspNetCore.Identity
@using LinkshellManagerDiscordApp.Data
@using Microsoft.EntityFrameworkCore
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject ApplicationDbContext DbContext

@{
    var isSignedIn = SignInManager.IsSignedIn(User);
    AppUser? currentUser = isSignedIn ? await UserManager.GetUserAsync(User) : null;
    if (isSignedIn && currentUser is null)
    {
        // Auth cookie present but the backing user can no longer be resolved (deleted or stale claim).
        // Bounce to login rather than rendering an unstyled, navless shell.
        Context.Response.Redirect("/Identity/Account/Login?expired=1");
        return;
    }
    var pageTitle = ViewData["Title"]?.ToString() ?? "Dashboard";
    var profileImage = currentUser?.ProfileImage is { Length: > 0 }
        ? $"data:image/png;base64,{Convert.ToBase64String(currentUser.ProfileImage)}"
        : null;

    string? activeLinkshellName = null;
    string? activeLinkshellInitials = null;
    string activeLinkshellType = LinkshellManagerDiscordApp.Models.LinkshellTypes.Both;
    string? activeRole = null;
    LinkshellManagerDiscordApp.Models.LinkshellRole? activePermissions = null;
    // Feature toggles that gate sidebar groups. Default true so a user with no
    // active linkshell still sees the nav (matches the sidebar's fail-open).
    bool activeEnableMissions = true;
    bool activeEnableEndgame = true;
    if (currentUser is not null && currentUser.PrimaryLinkshellId.HasValue)
    {
        var activeLinkshellId = currentUser.PrimaryLinkshellId.Value;
        var ls = await DbContext.Linkshells
            .AsNoTracking()
            .FirstOrDefaultAsync(l => l.Id == activeLinkshellId);
        if (ls is not null)
        {
            activeLinkshellName = ls.LinkshellName;
            activeLinkshellType = LinkshellManagerDiscordApp.Models.LinkshellTypes.Normalize(ls.LinkshellType);
            activeEnableMissions = ls.EnableMissions;
            activeEnableEndgame = ls.EnableEndgame;
            activeLinkshellInitials = string.Concat(
                (ls.LinkshellName ?? "LS")
                    .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                    .Select(w => w[0]))
                .ToUpperInvariant();
            if (activeLinkshellInitials.Length > 2)
            {
                activeLinkshellInitials = activeLinkshellInitials[..2];
            }

            var membership = await DbContext.AppUserLinkshells
                .AsNoTracking()
                .FirstOrDefaultAsync(link =>
                    link.AppUserId == currentUser.Id &&
                    link.LinkshellId == activeLinkshellId);
            activeRole = membership?.Rank;

            // Resolve the LinkshellRole row whose Name matches the user's rank
            // so the sidenav can hide entries the user lacks permission to use.
            // Falls back to "Member" when the rank string doesn't resolve, which
            // matches the controllers' GetEffectiveRoleAsync behavior.
            var rankName = string.IsNullOrWhiteSpace(activeRole) ? "Member" : activeRole.Trim();
            activePermissions = await DbContext.LinkshellRoles
                .AsNoTracking()
                .FirstOrDefaultAsync(r => r.LinkshellId == activeLinkshellId && r.Name == rankName);
            if (activePermissions is null)
            {
                activePermissions = await DbContext.LinkshellRoles
                    .AsNoTracking()
                    .FirstOrDefaultAsync(r => r.LinkshellId == activeLinkshellId && r.Name == "Member");
            }
        }
    }

    ViewData["ActiveLinkshellId"] = currentUser?.PrimaryLinkshellId;
    ViewData["ActiveLinkshellType"] = activeLinkshellType;
    ViewData["ActiveEnableMissions"] = activeEnableMissions;
    ViewData["ActiveEnableEndgame"] = activeEnableEndgame;
    ViewData["ActiveLinkshellName"] = activeLinkshellName;
    ViewData["ActiveLinkshellInitials"] = activeLinkshellInitials;
    ViewData["ActiveRole"] = activeRole;
    ViewData["ActivePermissions"] = activePermissions;

    var displayName = currentUser?.CharacterName ?? currentUser?.UserName ?? "User";
    var avatarInitials = string.Concat(
            (displayName ?? "U")
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Select(w => w[0]))
            .ToUpperInvariant();
    if (string.IsNullOrEmpty(avatarInitials)) { avatarInitials = "U"; }
    if (avatarInitials.Length > 2) { avatarInitials = avatarInitials[..2]; }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle · LinkshellManager</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/lsm-theme.css" asp-append-version="true" />
</head>
<body>
    @if (isSignedIn && currentUser is not null)
    {
        <div class="app">
            <partial name="_Sidebar" />

            <div class="main">
                <div class="topbar">
                    <div class="crumbs">
                        @if (!string.IsNullOrWhiteSpace(activeLinkshellName))
                        {
                            <span>@activeLinkshellName</span>
                            <span class="sep">/</span>
                        }
                        <span class="here">@pageTitle</span>
                    </div>

                    <div class="topbar-clock" id="topbar-clock" aria-live="off"
                         data-clock-tz="@(currentUser?.TimeZone ?? string.Empty)">
                        <span class="topbar-clock__time" data-clock-time>--:--</span>
                        <span class="topbar-clock__zone" data-clock-zone></span>
                    </div>

                    <div class="topbar-actions">
                        <a class="avatar-btn" asp-controller="Account" asp-action="Profile" title="Profile">
                            @if (profileImage is not null)
                            {
                                <img class="avatar-img" src="@profileImage" alt="" />
                            }
                            else
                            {
                                <span class="avatar">@avatarInitials</span>
                            }
                            <span class="avatar-name">@displayName</span>
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                            <button type="submit" class="icon-btn" title="Sign out" aria-label="Sign out">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M15 4h4a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-4"/><path d="M10 17l-5-5 5-5"/><path d="M5 12h11"/></svg>
                            </button>
                        </form>
                    </div>
                </div>

                <div class="content @(ViewData["BodyClass"])">
                    @RenderBody()
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="auth-shell">
            @RenderBody()
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/sidebar.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model EventSystemPageViewModel
@{
    // Section 3a: EVENTS PENDING DKP POST — events that have ENDED and whose DKP nobody has
    // posted yet. The officer's work queue, and the reason it sits below Pending Events: it is
    // what is left to settle, not the live board. The Activity mounts
    // <app-attendance-sections section="archive"> in the same slot.
    //
    // This block used to be the full closed-event archive, which put it in competition with Past
    // Events: an ended camp archives its EventHistory at End Camp, so the same camp appeared in
    // both, and neither list said whether anyone had actually been paid. Past Events now means
    // SETTLED and this means OUTSTANDING. The complete closed archive, posted rows included, is
    // still on WindowEventsController.History.
    //
    // The membership rule lives in AttendanceSectionsBuilder.ApplyPendingDkpPostFilter.
    //
    // Only rendered when Model.Attendance is non-null, so ClosedAttendance is non-null too.
    var closed = Model.ClosedAttendance!;
    var from = closed.TotalCount == 0 ? 0 : ((closed.Page - 1) * closed.PageSize) + 1;
    var to = Math.Min(closed.Page * closed.PageSize, closed.TotalCount);
}

<div class="page-head fade d4" id="attendance-archive" style="margin-top:22px;margin-bottom:12px">
    <div>
        <h2 class="page-title" style="font-size:16px">Events Pending DKP Post</h2>
        <div class="page-sub">
            <span>Ended events whose DKP has not been posted to the sheet yet</span>
        </div>
    </div>
</div>

@* Unlinked snapshots used to render above this block; they are their own section now
   (Views/Event/_UnlinkedSnapshots.cshtml), since triage of an unpaid capture is live work. *@
<div class="card fade d4" style="margin-bottom:14px">
    <div class="card-head">
        @* Titled to match the Activity's closed-events block (attendance-sections.component.html). *@
        <div class="card-title">
            Awaiting DKP Post
            <span class="tag">@closed.TotalCount</span>
        </div>
    </div>
    <div style="padding:12px 16px">
        @* asp-fragment has no form equivalent, so the anchor is carried by the submit handler in
           Index.cshtml via data-anchor. The other section's state rides along as hidden inputs so
           searching here doesn't reset Past Events. *@
        <form method="get" asp-action="Index" data-anchor="attendance-archive"
              style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
            <input type="hidden" name="pastQ" value="@Model.PastEvents.Query" />
            <input type="hidden" name="pastPage" value="@Model.PastEvents.Page" />
            <input class="input" type="text" name="attQ" value="@closed.Query"
                   placeholder="Search by event name, poster, or member…" style="min-width:280px;flex:1" />
            <button type="submit" class="btn primary sm">Search</button>
            @if (!string.IsNullOrWhiteSpace(closed.Query))
            {
                <a class="btn ghost sm" asp-action="Index"
                   asp-route-pastQ="@Model.PastEvents.Query" asp-route-pastPage="@Model.PastEvents.Page"
                   asp-fragment="attendance-archive">Clear</a>
            }
            <span style="margin-left:auto;font-size:12px;color:var(--fg-3)">
                @if (closed.TotalCount == 0) { <text>No results</text> }
                else { <text>Showing @from–@to of @closed.TotalCount</text> }
            </span>
        </form>
    </div>
</div>

@if (closed.Events.Count == 0)
{
    <div class="card fade d4">
        <div class="empty" style="padding:16px">
            @if (string.IsNullOrWhiteSpace(closed.Query))
            {
                <text>
                    Nothing is waiting on a DKP post. Ended camps and closed attendance events
                    appear here until someone posts them to the sheet, then move to Past Events.
                </text>
            }
            else
            {
                <text>No events awaiting a DKP post match "<strong>@closed.Query</strong>".</text>
            }
        </div>
    </div>
}
else
{
    @foreach (var ev in closed.Events)
    {
        @* IsClosed reflects the event's REAL status rather than being hardcoded true, because
           this list now also holds ended camps, which are Status=Open (see
           HnmCampReviewHandoffService). Hardcoding it offered them a "Reopen" button for a state
           they were never in, and hid the "Close" one.

           It does NOT control whether the roster can be edited or posted -- _WindowEventCard gates
           both on PostedToSheetAt, and every card in this section is by definition unposted. That
           is the point of the section: the "Post to DKP sheet" button is right here. *@
        @await Html.PartialAsync("../WindowEvents/_WindowEventCard", ev, new ViewDataDictionary(ViewData)
        {
            ["LinkshellId"] = closed.LinkshellId,
            ["CanManage"] = closed.CanManage,
            ["IsClosed"] = ev.Status == WindowEventStatuses.Closed,
        })
    }

    @if (closed.TotalPages > 1)
    {
        <div class="fade d4" style="display:flex;gap:8px;align-items:center;justify-content:center;margin-top:12px">
            @if (closed.Page > 1)
            {
                <a class="btn ghost sm" asp-action="Index"
                   asp-route-attQ="@closed.Query" asp-route-attPage="@(closed.Page - 1)"
                   asp-route-pastQ="@Model.PastEvents.Query" asp-route-pastPage="@Model.PastEvents.Page"
                   asp-fragment="attendance-archive">← Prev</a>
            }
            <span style="font-size:13px;color:var(--fg-3)">Page @closed.Page of @closed.TotalPages</span>
            @if (closed.Page < closed.TotalPages)
            {
                <a class="btn ghost sm" asp-action="Index"
                   asp-route-attQ="@closed.Query" asp-route-attPage="@(closed.Page + 1)"
                   asp-route-pastQ="@Model.PastEvents.Query" asp-route-pastPage="@Model.PastEvents.Page"
                   asp-fragment="attendance-archive">Next →</a>
            }
        </div>
    }
}

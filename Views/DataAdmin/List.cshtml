@model DataAdminListViewModel
@{
    ViewData["Title"] = Model.DisplayName;
    ViewData["BodyClass"] = "lsm-page";
}

<div class="page-head fade d1">
    <div>
        <div class="page-eyebrow"><a asp-action="Index">Data Admin</a></div>
        <h1 class="page-title">@Model.DisplayName</h1>
        <div class="page-sub">
            <span><span class="num">@Model.Total.ToString("N0")</span> row@(Model.Total == 1 ? "" : "s")</span>
            <span style="color:var(--fg-3)">@Model.TableName</span>
        </div>
    </div>
    <div class="page-actions">
        <a class="btn ghost" asp-action="Index">Back</a>
    </div>
</div>

<partial name="~/Views/DataAdmin/_Flash.cshtml" />

<div class="card fade d2">
    <div class="card-head" style="gap:12px;flex-wrap:wrap;align-items:center">
        <div style="flex:1;min-width:220px">
            @if (string.IsNullOrEmpty(Model.SearchHint))
            {
                <span style="color:var(--fg-3);font-size:12px">No text columns to search.</span>
            }
            else
            {
                <input id="q" class="form-control" type="search" value="@Model.Query.Search" placeholder="Search @Model.SearchHint" autocomplete="off" />
            }
        </div>
        @if (Model.ActiveFilters.Count > 0)
        {
            <div style="display:flex;flex-wrap:wrap;gap:6px;align-items:center">
                @foreach (var filter in Model.ActiveFilters)
                {
                    <a class="tag accent" asp-action="List" asp-route-slug="@Model.Slug" asp-all-route-data="@Model.RemoveFilterRoute(filter.Column)" title="Remove this filter">
                        @filter.DisplayName: @filter.Label &times;
                    </a>
                }
            </div>
        }
    </div>

    @if (Model.Rows.Count == 0)
    {
        <div class="empty">No rows match.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table themed">
                <thead>
                    <tr>
                        @foreach (var column in Model.Columns)
                        {
                            var isSorted = string.Equals(Model.SortColumn, column.Name, StringComparison.Ordinal);
                            <th style="@(column.IsNumeric ? "text-align:right;" : "")white-space:nowrap">
                                <a asp-action="List" asp-route-slug="@Model.Slug" asp-all-route-data="@Model.SortRoute(column.Name)" style="color:inherit;text-decoration:none" title="Sort by @column.DisplayName">
                                    @column.DisplayName
                                    @if (isSorted)
                                    {
                                        <span aria-hidden="true">@(Model.Descending ? "▼" : "▲")</span>
                                    }
                                </a>
                            </th>
                        }
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            @foreach (var cell in row.Cells)
                            {
                                <td class="@(cell.IsNumeric ? "num" : "")" style="@(cell.IsNumeric ? "text-align:right" : "")">
                                    @if (cell.LinkSlug is not null && cell.LinkKey is not null)
                                    {
                                        <a asp-action="Details" asp-route-slug="@cell.LinkSlug" asp-route-id="@cell.LinkKey">@cell.Text</a>
                                    }
                                    else if (cell.IsEmpty)
                                    {
                                        <span style="color:var(--fg-3)">@cell.Text</span>
                                    }
                                    else
                                    {
                                        @cell.Text
                                    }
                                </td>
                            }
                            <td style="text-align:right">
                                <div style="display:flex;justify-content:flex-end;gap:4px">
                                    <a class="btn ghost sm" asp-action="Details" asp-route-slug="@Model.Slug" asp-route-id="@row.Key">View</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="~/Views/DataAdmin/_Pager.cshtml" model="Model" />
    }
</div>

@section Scripts {
    <script src="~/js/data-admin.js" asp-append-version="true" defer></script>
}

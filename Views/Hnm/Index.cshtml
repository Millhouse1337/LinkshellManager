@model LinkshellManagerDiscordApp.ViewModels.HnmDashboardViewModel
@{
    ViewData["Title"] = "HNM System";
}

<div class="page-head fade d1">
    <div>
        <h1 class="page-title">HNM System</h1>
        <div class="page-sub">
            <span>Per-monster repop schedule, auto-created from the lsm addon's ToD posts</span>
            @if (!string.IsNullOrWhiteSpace(Model.LinkshellName))
            {
                <span class="dot"> · </span>
                <span>@Model.LinkshellName</span>
            }
        </div>
    </div>
</div>

@if (Model.LinkshellId == 0)
{
    <div class="card fade d2">
        <div class="card-head">
            <div class="card-title">No linkshell selected</div>
        </div>
        <div class="empty" style="padding:16px">
            Join a linkshell to view its HNM repop schedule.
        </div>
    </div>
}
else if (!Model.HnmSectionEnabled)
{
    <div class="card fade d2">
        <div class="card-head">
            <div class="card-title">HNM section disabled</div>
        </div>
        <div class="empty" style="padding:16px">
            The HNM dashboard is turned off for this linkshell. A leader can enable it from
            <a asp-controller="Linkshell" asp-action="Customize">Customize Linkshell</a>.
        </div>
    </div>
}
else
{
    <div class="card fade d2">
        <div class="card-head">
            <div class="card-title">Tracked HNMs <span class="tag">@Model.Rows.Count</span></div>
            <div class="card-sub" style="color:var(--fg-muted,#888);font-size:12px">
                Post a ToD via <code>/lsm</code> in-game and the next-repop event is queued automatically.
                Closed events flow through to your AttInput sheet with Entry Type = Kill.
            </div>
        </div>
        <div style="padding:0 0 8px 0">
            @foreach (var row in Model.Rows)
            {
                <details style="border-top:1px solid var(--border,#222)">
                    <summary style="padding:10px 16px;cursor:pointer;list-style:revert">
                        <strong style="font-size:15px">@row.MonsterName</strong>
                        @if (!string.IsNullOrWhiteSpace(row.Zone))
                        {
                            <span style="color:var(--fg-muted,#888)"> · </span>
                            <span>@row.Zone</span>
                        }
                        <span style="color:var(--fg-muted,#888)"> · </span>
                        <span>@row.WindowCount-window</span>
                        @if (row.IsDayTracked && row.DayCycle.HasValue)
                        {
                            <span style="color:var(--fg-muted,#888)"> · </span>
                            <span style="display:inline-block;padding:1px 8px;border-radius:10px;background:rgba(96,165,250,0.15);color:#60a5fa;font-size:12px">Day cycle D1–D@row.DayCycle</span>
                        }
                        @if (row.LatestTod is null)
                        {
                            <span style="color:var(--fg-muted,#888)"> · </span>
                            <span style="color:var(--fg-muted,#888);font-size:12px">No ToD captured yet</span>
                        }
                        else
                        {
                            <span style="color:var(--fg-muted,#888)"> · </span>
                            <span style="font-size:12px">Last ToD <strong>@row.LatestTod.TimeDisplayLocal</strong></span>
                            @if (row.LatestTod.DayNumber.HasValue && row.LatestTod.DayNumber.Value > 0)
                            {
                                <span style="color:var(--fg-muted,#888)"> · </span>
                                <span style="font-size:12px">D@row.LatestTod.DayNumber</span>
                            }
                        }
                        @if (row.LinkedEvent is not null)
                        {
                            <span style="color:var(--fg-muted,#888)"> · </span>
                            <span style="display:inline-block;padding:1px 8px;border-radius:10px;background:rgba(96,165,250,0.15);color:#60a5fa;font-size:12px">
                                Event: @row.LinkedEvent.EventName@(row.LinkedEvent.IsLive ? " (LIVE)" : (row.LinkedEvent.IsEnded ? " (ended)" : ""))
                            </span>
                        }
                        else if (row.LatestTod is not null)
                        {
                            <span style="color:var(--fg-muted,#888)"> · </span>
                            <span style="display:inline-block;padding:1px 8px;border-radius:10px;background:rgba(251,191,36,0.15);color:#fbbf24;font-size:12px">No queued event</span>
                        }
                    </summary>

                    <div style="padding:8px 16px 16px 32px">
                        @if (row.LatestTod is not null)
                        {
                            <div style="margin-bottom:8px;font-size:13px">
                                <strong>Repop:</strong>
                                <span>@row.LatestTod.RepopDisplayLocal</span>
                                @if (!string.IsNullOrWhiteSpace(row.LatestTod.Cooldown))
                                {
                                    <span style="color:var(--fg-muted,#888)"> · </span>
                                    <span>Cooldown @row.LatestTod.Cooldown</span>
                                }
                                @if (row.LatestTod.Claim.HasValue)
                                {
                                    <span style="color:var(--fg-muted,#888)"> · </span>
                                    <span>@(row.LatestTod.Claim.Value ? "Claimed" : "Unclaimed")</span>
                                }
                            </div>
                        }

                        @if (row.LinkedEvent is not null)
                        {
                            <div style="margin-bottom:8px;font-size:13px;padding:8px 12px;border:1px solid var(--border,#222);border-radius:8px">
                                <div>
                                    <strong>Next event:</strong>
                                    <a asp-controller="Event" asp-action="Index" style="color:#60a5fa">@row.LinkedEvent.EventName</a>
                                </div>
                                <div style="color:var(--fg-muted,#888);font-size:12px;margin-top:2px">
                                    Starts @row.LinkedEvent.StartTimeDisplayLocal
                                    @if (row.LinkedEvent.DkpPerHour.HasValue)
                                    {
                                        <span> · @row.LinkedEvent.DkpPerHour DKP/hr</span>
                                    }
                                    @if (row.LinkedEvent.WindowCount.HasValue)
                                    {
                                        <span> · @row.LinkedEvent.WindowCount windows</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(row.LinkedEvent.AttInputEntryType))
                                    {
                                        <span> · AttInput: @row.LinkedEvent.AttInputEntryType</span>
                                    }
                                </div>
                            </div>
                        }

                        @if (row.RecentTods.Count > 0)
                        {
                            <div style="font-size:12px;color:var(--fg-muted,#888);margin-bottom:4px">Recent ToDs</div>
                            <table style="width:100%;max-width:780px;border-collapse:collapse;font-size:12px;margin-bottom:8px">
                                <thead>
                                    <tr>
                                        <th style="text-align:left;padding:4px 8px">ToD</th>
                                        <th style="text-align:left;padding:4px 8px">Repop</th>
                                        <th style="text-align:left;padding:4px 8px">Day</th>
                                        <th style="text-align:left;padding:4px 8px">Claim</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var prev in row.RecentTods)
                                {
                                    <tr style="border-top:1px solid var(--border,#222)">
                                        <td style="padding:4px 8px">@prev.TimeDisplayLocal</td>
                                        <td style="padding:4px 8px">@prev.RepopDisplayLocal</td>
                                        <td style="padding:4px 8px">@(prev.DayNumber.HasValue && prev.DayNumber.Value > 0 ? $"D{prev.DayNumber}" : "—")</td>
                                        <td style="padding:4px 8px">@(prev.Claim.HasValue ? (prev.Claim.Value ? "Claimed" : "Unclaimed") : "—")</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        }

                        @if (row.LinkedSnapshots.Count > 0)
                        {
                            <div style="font-size:12px;color:var(--fg-muted,#888);margin-bottom:4px">Linked attendance snapshots</div>
                            <ul style="margin:0 0 8px 0;padding-left:18px;font-size:12px">
                                @foreach (var snap in row.LinkedSnapshots)
                                {
                                    <li>
                                        @(string.IsNullOrWhiteSpace(snap.Name) ? "(unnamed)" : snap.Name)
                                        <span style="color:var(--fg-muted,#888)"> · </span>
                                        @snap.CapturedAtLocalDisplay
                                        <span style="color:var(--fg-muted,#888)"> · </span>
                                        @snap.EntryCount member@(snap.EntryCount == 1 ? "" : "s")
                                        @if (!string.IsNullOrWhiteSpace(snap.CapturedByCharacterName))
                                        {
                                            <span style="color:var(--fg-muted,#888)"> · </span>
                                            <span>by @snap.CapturedByCharacterName</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </details>
            }
        </div>
    </div>
}
